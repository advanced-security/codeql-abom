       "id": "actions/code-injection/critical",
       "name": "actions/code-injection/critical",
       "properties": {
        "description": "Interpreting unsanitized user input as code allows a malicious user to perform arbitrary\n              code execution.",
        "id": "actions/code-injection/critical",
