       "properties": {
        "description": "The cache can be poisoned by untrusted code, leading to a cache poisoning attack.",
        "id": "actions/cache-poisoning/direct-cache",
        "kind": "path-problem",
        "name": "Cache Poisoning via caching of untrusted files",
        "precision": "high",
