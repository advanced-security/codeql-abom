@inherits LayoutComponentBase
@implements IDisposable
@inject ThemeService Theme
@inject FollowService Follow

<MudThemeProvider @ref="_themeProvider" Theme="Theme.Theme" IsDarkMode="Theme.IsDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    @* One bar owns the whole navigation so grids and graphs keep the page width. *@
    <MudAppBar Elevation="1">
        <Brand MarkColor="@Theme.MarkColor" />

        <nav class="abom-nav ml-8 d-flex align-center">
            <MudButton Href="/codeql" Variant="Variant.Text" Color="Color.Inherit"
                       DropShadow="false" StartIcon="@Icons.Material.Outlined.ManageSearch"
                       Class="@NavClass("/codeql")">CodeQL</MudButton>
            <MudButton Href="/inventory" Variant="Variant.Text" Color="Color.Inherit"
                       DropShadow="false" StartIcon="@Icons.Material.Outlined.ListAlt"
                       Class="@NavClass("/inventory")">Inventory</MudButton>
            <MudButton Href="/explore" Variant="Variant.Text" Color="Color.Inherit"
                       DropShadow="false" StartIcon="@Icons.Material.Outlined.Hub"
                       Class="@NavClass("/explore")">Explorer</MudButton>
        </nav>

        <MudSpacer />
        @* Crawl state stays visible on every page because it changes without a viewer. *@
        <CrawlStatus />
        <MudTooltip Text="@ThemeTooltip">
            <MudIconButton Icon="@ThemeIcon" Color="Color.Inherit" OnClick="CycleTheme"
                           aria-label="@ThemeTooltip" data-abom-theme />
        </MudTooltip>
        <MudTooltip Text="Settings">
            <MudIconButton Icon="@Icons.Material.Outlined.Settings" Color="Color.Inherit"
                           Href="/settings" aria-label="Settings" data-abom-settings />
        </MudTooltip>
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private MudThemeProvider _themeProvider = default!;
    private bool _systemPrefersDark;

    [Inject] private NavigationManager Nav { get; set; } = default!;

    private string Path =>
        "/" + Nav.ToBaseRelativePath(Nav.Uri).TrimStart('/').Split('?')[0];

    private string NavClass(string href) =>
        Path.StartsWith(href, StringComparison.Ordinal) ? "abom-nav-link abom-nav-here" : "abom-nav-link";

    protected override void OnInitialized()
    {
        Theme.Changed += OnThemeChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // The system preference is only readable once the provider has rendered, so the first
        // paint may briefly use the wrong scheme; index.html pre-applies it to avoid a flash.
        _systemPrefersDark = await _themeProvider.GetSystemDarkModeAsync();
        await Theme.InitialiseAsync(_systemPrefersDark);
        await _themeProvider.WatchSystemDarkModeAsync(OnSystemPreferenceChanged);
        await Follow.InitializeAsync();
        StateHasChanged();
    }

    private Task OnSystemPreferenceChanged(bool prefersDark)
    {
        _systemPrefersDark = prefersDark;
        Theme.SystemPreferenceChanged(prefersDark);
        return Task.CompletedTask;
    }

    private async Task CycleTheme()
    {
        var next = Theme.Choice switch
        {
            ThemeChoice.System => ThemeChoice.Light,
            ThemeChoice.Light => ThemeChoice.Dark,
            _ => ThemeChoice.System,
        };
        await Theme.SetAsync(next, _systemPrefersDark);
    }

    private string ThemeIcon => Theme.Choice switch
    {
        ThemeChoice.Light => Icons.Material.Outlined.LightMode,
        ThemeChoice.Dark => Icons.Material.Outlined.DarkMode,
        _ => Icons.Material.Outlined.Contrast,
    };

    private string ThemeTooltip => Theme.Choice switch
    {
        ThemeChoice.Light => "Light. Click for dark.",
        ThemeChoice.Dark => "Dark. Click to follow the system.",
        _ => $"Following the system ({(_systemPrefersDark ? "dark" : "light")}). Click for light.",
    };

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Theme.Changed -= OnThemeChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
