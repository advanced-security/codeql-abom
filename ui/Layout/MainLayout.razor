@inherits LayoutComponentBase
@implements IDisposable
@inject ThemeService Theme
@inject AbomApi Api
@inject FollowService Follow

<MudThemeProvider @ref="_themeProvider" Theme="Theme.Theme" IsDarkMode="Theme.IsDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    @* One bar, and it is the whole navigation. The drawer spent a fixed slice of every page on
       four links that never changed, and the grid and the graph — the two surfaces needing width
       most — are the two that paid for it. *@
    <MudAppBar Elevation="1">
        @* The product name is the way back to the Dashboard, so no second link says it again. *@
        <MudLink Href="/" Underline="Underline.None" Color="Color.Inherit"
                 Class="d-flex align-center abom-brand" data-abom-brand>
            <MudText Typo="Typo.h6">ABOM</MudText>
            <MudText Typo="Typo.caption" Class="ml-2 mud-text-secondary d-none d-sm-flex">
                Actions Bill of Materials
            </MudText>
        </MudLink>

        @* Left to right is the journey: what matches, then what it touches. A list beside a hub
           says which reading each gives of the same scope. *@
        <nav class="abom-nav ml-8 d-flex align-center">
            <MudButton Href="/inventory" Variant="Variant.Text" Color="Color.Inherit"
                       DropShadow="false" StartIcon="@Icons.Material.Outlined.ListAlt"
                       Class="@NavClass("/inventory")">Inventory</MudButton>
            <MudButton Href="/explore" Variant="Variant.Text" Color="Color.Inherit"
                       DropShadow="false" StartIcon="@Icons.Material.Outlined.Hub"
                       Class="@NavClass("/explore")">Explorer</MudButton>
            @* The third reading, and the one neither of the others can give: its unit is a query
               version, where Inventory's is a node and the Explorer's is a relationship. *@
            <MudButton Href="/queries" Variant="Variant.Text" Color="Color.Inherit"
                       DropShadow="false" StartIcon="@Icons.Material.Outlined.Science"
                       Class="@NavClass("/queries")">Queries</MudButton>
        </nav>

        <MudSpacer />
        @* The crawl is the one thing here that runs with nobody watching, so its state is on
           every page rather than several folds down inside Settings. Between the journey and the
           preferences because it is neither: it is what the data is doing right now. *@
        <CrawlStatus />
        <MudTooltip Text="@ThemeTooltip">
            <MudIconButton Icon="@ThemeIcon" Color="Color.Inherit" OnClick="CycleTheme"
                           aria-label="@ThemeTooltip" data-abom-theme />
        </MudTooltip>
        @* Configuration rather than a stop on the journey, so an icon at the far end rather than
           a fourth word competing with the ones that are. *@
        <MudTooltip Text="Settings">
            <MudIconButton Icon="@Icons.Material.Outlined.Settings" Color="Color.Inherit"
                           Href="/settings" aria-label="Settings" data-abom-settings />
        </MudTooltip>
    </MudAppBar>

    <MudMainContent>
        @* Not on the Dashboard: that surface hands over a scope and states nothing else, because a
           second, shorter coverage answer beside the entry points was read as the whole one.
           Not on Queries either: the catalog's unit is a query version, and a banner counting
           repositories and findings is an answer to a question that page is not asking. *@
        @if (!IsDashboard && !IsQueries)
        {
            <CoverageStrip Summary="_summary" />
        }
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private MudThemeProvider _themeProvider = default!;
    private bool _systemPrefersDark;
    private Summary? _summary;

    [Inject] private NavigationManager Nav { get; set; } = default!;

    private string Path =>
        "/" + Nav.ToBaseRelativePath(Nav.Uri).TrimStart('/').Split('?')[0];

    private bool IsDashboard => Path == "/";

    private bool IsQueries => Path.StartsWith("/queries", StringComparison.Ordinal);

    /// <summary>Marks the surface being read, since the bar is now the only thing saying which.</summary>
    private string NavClass(string href) =>
        Path.StartsWith(href, StringComparison.Ordinal) ? "abom-nav-link abom-nav-here" : "abom-nav-link";

    protected override void OnInitialized()
    {
        Theme.Changed += OnThemeChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // The system preference is only readable once the provider has rendered, so the first
        // paint may briefly use the wrong scheme; index.html pre-applies it to avoid a flash.
        _systemPrefersDark = await _themeProvider.GetSystemDarkModeAsync();
        await Theme.InitialiseAsync(_systemPrefersDark);
        await _themeProvider.WatchSystemDarkModeAsync(OnSystemPreferenceChanged);
        await Follow.InitializeAsync();

        _summary = await Api.GetSummaryAsync();
        StateHasChanged();
    }

    private Task OnSystemPreferenceChanged(bool prefersDark)
    {
        _systemPrefersDark = prefersDark;
        Theme.SystemPreferenceChanged(prefersDark);
        return Task.CompletedTask;
    }

    private async Task CycleTheme()
    {
        var next = Theme.Choice switch
        {
            ThemeChoice.System => ThemeChoice.Light,
            ThemeChoice.Light => ThemeChoice.Dark,
            _ => ThemeChoice.System,
        };
        await Theme.SetAsync(next, _systemPrefersDark);
    }

    // Sun, crescent, half-and-half. The dial that meant "auto" sat next to a real settings gear
    // and read as a second one.
    private string ThemeIcon => Theme.Choice switch
    {
        ThemeChoice.Light => Icons.Material.Outlined.LightMode,
        ThemeChoice.Dark => Icons.Material.Outlined.DarkMode,
        _ => Icons.Material.Outlined.Contrast,
    };

    private string ThemeTooltip => Theme.Choice switch
    {
        ThemeChoice.Light => "Light. Click for dark.",
        ThemeChoice.Dark => "Dark. Click to follow the system.",
        _ => $"Following the system ({(_systemPrefersDark ? "dark" : "light")}). Click for light.",
    };

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Theme.Changed -= OnThemeChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
