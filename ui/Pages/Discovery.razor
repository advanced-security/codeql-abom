@page "/discovery"
@implements IDisposable
@inject AbomApi Api
@inject FollowService Follow
@inject ThemeService Theme
@inject NavigationManager Nav

<PageTitle>Discovery — ABOM</PageTitle>

<PageHeader Title="Discovery">
    How complete this picture is. Discovery works outward from the repositories it started from, so
    the queue does drain — and when it does, it keeps watching the references it already analyzed
    for ones that have since moved.
</PageHeader>

@* No tiles here. Analyzed and not-yet-analyzed are the bar and the chips below; what discovery
   started from and advisories are already in the page header. Four boxes restating them pushed
   the one control anyone came for below the fold. *@

@if (_objective is { } objective)
{
    <MudPaper Elevation="0" Outlined="true" Class="pa-3 mb-3 abom-objective">
        <MudText Typo="Typo.subtitle2">What the crawl is working on</MudText>
        <MudText Typo="Typo.body2" Class="mt-1">
            @if (objective.HasOutstanding)
            {
                <span>
                    Completing <b>depth @objective.Working</b>, and nothing deeper is started
                    until it is done.
                </span>
            }
            else if (objective.Progress.Count == 0)
            {
                @* An empty closure and a drained one both report nothing outstanding. Reading
                   the first as the second announces complete coverage of nothing, which is the
                   one claim a first run must not make. *@
                <span>
                    <b>Nothing has been enumerated yet</b>, so there is nothing to be outstanding.
                    This is not a statement about coverage.
                </span>
            }            else
            {
                @* Not "depth 0": a complete closure is a different statement from work at the
                   shallowest depth, and reporting a number would invent one. *@
                <span>
                    <b>Nothing outstanding.</b> Every reference reached has been analyzed
                    &mdash; as far as depth @objective.MaxDepth, which is the cap exploration
                    may not pass.
                </span>
            }
        </MudText>

        @if (objective.Progress.Count > 0)
        {
            <div class="abom-objective-depths mt-2">
                @foreach (var depth in objective.Progress)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Color="@(depth.Available == 0 ? Color.Success : Color.Default)"
                             title="@DepthSplit(depth)">
                        depth @depth.Depth: @depth.Settled.ToString("N0") of
                        @depth.Total.ToString("N0")
                    </MudChip>
                }
            </div>
            @* These count settled work and the tier chips count analyzed, so on a corpus with
               anything unavailable the two decompositions of one queue do not sum alike. Stating
               the rule once is what lets a reader reconcile them. *@
            @if (UnavailableAcrossDepths > 0)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Settled counts what is finished: analyzed, plus
                    <b>@UnavailableAcrossDepths.ToString("N0")</b> that could not be fetched and
                    will not be attempted again. Tier figures elsewhere count analyzed only.
                </MudText>
            }
        }

        @if (LastCycle is { } last)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">
                Last cycle took <b>@Seconds(last.Millis)s</b>: @last.Fetches.ToString("N0")
                fetches, @last.Builds.ToString("N0") database builds,
                @last.Probes.ToString("N0") reference probes. It analyzed
                @last.Analyzed.ToString("N0"), skipped @last.Skipped.ToString("N0") already on
                record and discovered @last.Discovered.ToString("N0").
                @if (last.Drifted > 0)
                {
                    <span>@last.Drifted.ToString("N0") had moved since they were analyzed.</span>
                }
            </MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                @objective.Totals.Cycles.ToString("N0") cycles recorded, totalling
                @Seconds(objective.Totals.Millis)s across
                @objective.Totals.Fetches.ToString("N0") fetches and
                @objective.Totals.Probes.ToString("N0") probes.
            </MudText>
        }
        else
        {
            @* Nothing recorded is not zero spend. *@
            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">
                No cycle has run yet, so there is nothing to say about what discovery costs here.
            </MudText>
        }
    </MudPaper>
}

@if (_pollError is { } failure)
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">
        This view could not reach the server: @failure
    </MudAlert>
}

@if (_state.Status.Problem is { } problem)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
        @problem.Reason — @problem.Remedy
    </MudAlert>
}
else if (!string.IsNullOrEmpty(_state.Status.LastError))
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
        Discovery hit a problem and carried on: @_state.Status.LastError
    </MudAlert>
}

@if (_properties is not null && _properties.Breakdown.Values.Count > 0)
{
    <MudPaper Elevation="0" Outlined="true" Class="pa-3 mb-3">
        <MudText Typo="Typo.body1">Coverage by @_properties.Breakdown.Name</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
            How much of each group has been examined. A repository nothing has queued counts
            toward its group and not toward what was examined, because it has not been looked at
            rather than looked at and found clean.
        </MudText>
        <div class="d-flex flex-wrap gap-4">
            @foreach (var group in _properties.Breakdown.Values)
            {
                <div class="d-flex flex-column">
                    <MudText Typo="Typo.body2">
                        @group.Value@(group.IsDefault ? " (organization default)" : string.Empty)
                    </MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @group.Analyzed of @group.Repositories examined
                    </MudText>
                </div>
            }
        </div>
    </MudPaper>
}

<MudPaper Elevation="0" Outlined="true" Class="pa-3 mb-3">
    <div class="d-flex align-center flex-wrap gap-3">
        <MudButton Size="Size.Small" Variant="Variant.Filled"
                   Color="@(IsRunning ? Color.Default : Color.Primary)"
                   StartIcon="@(IsRunning ? Icons.Material.Filled.Pause : Icons.Material.Filled.PlayArrow)"
                   Disabled="@(_busy || _state.Status.IsPausing)" OnClick="ToggleRunning"
                   data-abom-run
                   title="Analysis clones each repository, builds a CodeQL database and runs the bound suites. Enumeration, which only lists what is under a declared account, is a separate act and happens when the declaration is saved.">
            @(_state.Status.IsPausing ? "Pausing…" : IsRunning ? "Pause analysis" : "Start analysis")
        </MudButton>
        <QueueBar State="_state" />
        <MudText Typo="Typo.body2">@StateSentence</MudText>
        <MudSpacer />
        <FollowControl LastUpdated="_lastPoll" />
    </div>

    @* The other act. Enumeration lists what is under a declared account and costs seconds;
       analysis builds a database per repository and costs minutes. Nothing records enumeration as
       an event, so its result is read from the owned tier, which is what it writes at depth 0. *@
    @if (_declared is { } declared)
    {
        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1"
                 data-abom-enumeration>
            @if (declared.Count == 0)
            {
                <span>
                    No account is declared, so nothing has been enumerated as yours. Declare one in
                    <MudLink Href="/settings">Settings</MudLink> to list the repositories
                    underneath it. Anything already in the queue arrived as a dependency.
                </span>
            }
            else if (TierOf("owned").Total == 0)
            {
                @* Not "0 repositories": a declaration that has enumerated nothing yet is a
                   different state from an account that turned out to be empty. *@
                <span>
                    @string.Join(", ", declared.Select(a => a.Owner)) declared. Nothing has been
                    enumerated under it yet.
                </span>
            }
            else
            {
                <span>
                    Enumeration found <b>@TierOf("owned").Total.ToString("N0")</b> repositories
                    under @string.Join(", ", declared.Select(a => a.Owner)); analysis has covered
                    @TierOf("owned").Analyzed.ToString("N0").
                </span>
            }
        </MudText>
    }
    @* Wrapping is owned by .abom-run-row, not by the flex-wrap utility, whose !important would
       win against the media query that holds the controls on one line. *@
    <div class="d-flex align-center gap-2 mt-1 abom-run-row">
        @if (RecountShare is { } share)
        {
            @* Beside the sentence it quantifies, not beside the state: it measures arrivals, not
               progress through the queue. *@
            <MudProgressCircular Color="Color.Info" Size="Size.Small" Value="@share"
                                 Min="0" Max="100" aria-label="@RecountHint" />
        }
        @* The sentence absorbs the slack and shrinks, rather than a spacer absorbing it and
           pushing the controls off the line. A third tier made that difference visible: the
           spacer held 110px it would not give back, so the third button wrapped. *@
        <MudText Typo="Typo.caption" Class="mud-text-secondary abom-run-note">@DetailSentence</MudText>
        @* The verb once, the tiers three times, because three buttons repeating "Re-analyze" spend
           the width on the word rather than on what it applies to. *@
        <MudText Typo="Typo.caption" Class="mud-text-secondary abom-requeue-label">Re-analyze</MudText>
        @* What it will cost is on the button, because pressing it spends minutes of cloning and
           database building that nothing here can take back. *@
        @foreach (var tier in Tiers)
        {
            <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="@_busy"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Class="abom-requeue abom-requeue-tier"
                       OnClick="@(() => Requeue(tier))"
                       title="@RequeueHint(tier)">
                @($"{tier} ({TierOf(tier).Analyzed:N0})")
            </MudButton>
        }
        @* No count on this one, deliberately: how much is out of date is only knowable by
           resolving the bound packs through CodeQL, and doing that on every poll would spend a
           subprocess a minute to price a button. It is a subset of the tiers beside it, and what
           it selected is reported the moment it runs. *@
        <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="@_busy"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   Class="abom-requeue abom-requeue-stale"
                   OnClick="RequeueStale"
                   title="Re-analyze only what has not been analyzed by the packs and CodeQL version currently in use. Cheaper than a tier: everything already on record is left alone. How much that is has to be worked out by resolving the packs, so it is reported after it runs rather than before.">
            out of date
        </MudButton>
    </div>

    @* Its own line rather than beside the tier buttons: a field that takes typing is a different
       kind of control from a button that takes one press, and the row above already wraps. *@
    <div class="d-flex align-center gap-2 mt-1 abom-run-row abom-requeue-repo">
        <MudText Typo="Typo.caption" Class="mud-text-secondary abom-requeue-label">Or one repository</MudText>
        <MudTextField T="string" @bind-Value="_requeueRepo" Placeholder="owner/name"
                      Immediate="true" Disabled="@_busy" Margin="Margin.Dense"
                      Variant="Variant.Text" Class="abom-requeue-field"
                      OnKeyDown="OnRequeueKey" />
        @* Ahead of the ranking, because someone who has just fixed something is asking for that
           one answer, and filing it behind nine hundred better-scored items refuses the request
           in all but name. *@
        <MudButton Size="Size.Small" Variant="Variant.Text"
                   Disabled="@(_busy || string.IsNullOrWhiteSpace(_requeueRepo))"
                   StartIcon="@Icons.Material.Filled.Refresh" Class="abom-requeue"
                   OnClick="RequeueRepository"
                   title="Re-analyze the dependencies this repository names, ahead of everything else in the queue.">
            Re-analyze
        </MudButton>
        @if (_requeueNote is { } note)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@note</MudText>
        }
    </div>

    @* One box: what the crawl is doing and what it is configured to do belong together, and a
       second outlined panel cost 40px of chrome to say so. *@
    <MudDivider Class="my-2" />

    @if (_loading && _suites is null)
    {
        <MudText Typo="Typo.subtitle2">What each tier is analyzed with</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Reading the binding&hellip;</MudText>
    }
    else if (_suites is null)
    {
        @* A read that failed and a read still arriving look identical if both just wait, and a
           section with no binding to summarize must not fold shut over the reason it has none. *@
        <MudText Typo="Typo.subtitle2">What each tier is analyzed with</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Could not read what each tier is bound to, so nothing is shown rather than a binding
            that might be wrong. A server older than this interface has no such endpoint.
        </MudText>
    }
    else if (_suites.Available.Count == 0)
    {
        <MudText Typo="Typo.subtitle2">What each tier is analyzed with</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            No suites were found on disk. That is not the same as none being configured &mdash;
            a tier may name a suite from an installed pack, which would still run.
        </MudText>
    }
    else
    {
        @* The binding stays on screen folded or not: hiding it would turn "direct runs findings"
           into something a reader has to go looking for, and assume the default otherwise. *@
        <button type="button" class="abom-fold-toggle" @onclick="ToggleConfig"
                aria-expanded="@(_configOpen ? "true" : "false")">
            <MudIcon Size="Size.Small" Icon="@(_configOpen
                ? Icons.Material.Filled.ExpandMore
                : Icons.Material.Filled.ChevronRight)" />
            <span class="abom-fold-text">
                <span class="abom-fold-title">What each tier is analyzed with</span>
                <span class="abom-fold-summary">@BindingSummary()</span>
            </span>
        </button>
        @foreach (var tier in Tiers.Where(t => BoundCount(t) == 0))
        {
            @* An empty binding is a legitimate instruction, so it is stated rather than corrected,
               and stated outside the fold because it is state rather than a control. *@
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">
                Nothing is bound to @tier, so its dependencies are fetched and left unanalyzed.
            </MudText>
        }
        @if (_configOpen)
        {
            <MudSimpleTable Dense="true" Hover="true" Striped="false"
                            Class="abom-grid abom-table abom-config-grid mt-2">
                <thead>
                    <tr>
                        <th>Suite</th>
                        @foreach (var tier in Tiers)
                        {
                            @* The reason a tier is worth more or less work belongs on the tier, not
                               in a paragraph above the grid that names neither. *@
                            @* Size decides what binding a suite here costs; analyzed decides what
                               re-analyzing costs. Stating only the second made a tier read as
                               empty the moment it was re-analyzed. *@
                            <th class="abom-tier-head">
                                <span class="abom-tier-name">@tier</span>
                                <span class="abom-tier-why">@TierWhy(tier)</span>
                                @if (TierOf(tier).HoldsRepositories)
                                {
                                    @* Two different kinds of work, and the operator's own
                                       repositories are not something they depend on. *@
                                    <span class="abom-tier-count" data-abom-tier-split="@tier">
                                        @TierOf(tier).Repositories.ToString("N0") repositories,
                                        @TierOf(tier).Dependencies.ToString("N0") dependencies
                                    </span>
                                    <span class="abom-tier-count mud-text-secondary">
                                        @TierOf(tier).RepositoriesAnalyzed.ToString("N0") and
                                        @TierOf(tier).DependenciesAnalyzed.ToString("N0") analyzed
                                    </span>
                                }
                                else
                                {
                                    <span class="abom-tier-count">
                                        @TierOf(tier).Total.ToString("N0") dependencies
                                    </span>
                                    <span class="abom-tier-count mud-text-secondary">
                                        @TierOf(tier).Analyzed.ToString("N0") analyzed
                                    </span>
                                }
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var suite in _suites.Available)
                    {
                        <tr>
                            <td>
                                <button type="button" class="abom-suite-toggle"
                                        @onclick="@(() => ToggleSuiteDetail(suite))"
                                        aria-expanded="@(IsSuiteOpen(suite) ? "true" : "false")">
                                    <MudIcon Size="Size.Small" Icon="@(IsSuiteOpen(suite)
                                        ? Icons.Material.Filled.ExpandMore
                                        : Icons.Material.Filled.ChevronRight)" />
                                    <span class="abom-fold-text">
                                        <span class="abom-path">@SuiteLabel(suite)</span>
                                        <span class="abom-fold-summary">@SuiteSummary(suite)</span>
                                    </span>
                                </button>
                            </td>
                            @foreach (var tier in Tiers)
                            {
                                <td>
                                    <MudTooltip Text="@BindHint(tier, suite)">
                                        <MudCheckBox T="bool" Dense="true" Size="Size.Small"
                                                     Color="Color.Primary" Disabled="@_busy"
                                                     Value="@IsBound(tier, suite)"
                                                     ValueChanged="@(_ => ToggleSuite(tier, suite))" />
                                    </MudTooltip>
                                </td>
                            }
                        </tr>
                        @if (IsSuiteOpen(suite) && Detail(suite) is { } detail)
                        {
                            <tr>
                                <td colspan="@(Tiers.Length + 1)">
                                    @foreach (var p in detail.Packs)
                                    {
                                        <div class="abom-pack">
                                            <span class="abom-path">@p.Name</span>
                                            <span class="abom-fold-summary">@p.Version</span>
                                        </div>
                                        <ul class="abom-query-list">
                                            @foreach (var id in p.Queries)
                                            {
                                                <li class="abom-path">@id</li>
                                            }
                                        </ul>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </MudSimpleTable>
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">
                A change takes effect on the next round. Dependencies already analyzed keep their
                current results until that tier is re-analyzed.
            </MudText>
        }
    }
</MudPaper>

<div class="d-flex align-center flex-wrap gap-2 mb-3">
    <MudChipSet T="string" SelectedValue="_status" SelectedValueChanged="OnStatusChanged"
                SelectionMode="SelectionMode.SingleSelection" CheckMark="true">
        @foreach (var filter in Filters)
        {
            <MudChip T="string" Value="@filter.Value" Size="Size.Small" Variant="Variant.Text"
                     title="@FilterHint(filter.Value)">
                @* Hue is what ties a filter to its slice of the bar above, which is why the bar
                   needs no separate legend. *@
                @if (filter.Value == AdvisoryFilter)
                {
                    <MudIcon Icon="@Icons.Material.Filled.Campaign" Size="Size.Small"
                             Class="mr-1" />
                }
                else if (filter.Value == BuildTimeFilter)
                {
                    <MudIcon Icon="@Icons.Material.Filled.Build" Size="Size.Small" Class="mr-1" />
                }
                else if (filter.Value != "")
                {
                    <span class="abom-legend-dot abom-legend-dot-sm"
                          style="--abom-legend-color:@DiscoveryColor(filter.Value)"></span>
                }
                @filter.Label @CountOf(filter.Value)
            </MudChip>
        }
    </MudChipSet>
</div>

@if (_status == AdvisoryFilter)
{
    @* Naming is not adjudicating. An advisory names a package and a version range; whether the
       reference observed here falls inside that range is not something this list decides, and a
       reader who takes the filter for a verdict has been misled by us rather than by the data. *@
    <MudAlert Severity="Severity.Normal" Dense="true" Variant="Variant.Outlined" Class="mb-3">
        A published advisory names these dependencies. That is not a finding about your use of
        them: the advisory applies to a version range, and most references here are floating tags
        that nothing can resolve to a version. <MudLink Href="/remediation">Remediation</MudLink>
        shows each advisory's range and the references actually observed, side by side.
    </MudAlert>
}

@if (_status == BuildTimeFilter)
{
    <MudAlert Severity="Severity.Normal" Dense="true" Variant="Variant.Outlined" Class="mb-3">
        These run only inside their own project's CI, building or releasing the action you use.
        Nothing in your organization executes them — but whoever controls that pipeline controls
        the version you receive, which is why they are analyzed too.
    </MudAlert>
}

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_items.Count == 0)
{
    @* An empty grid with a pager says nothing: it reads the same whether there are none or the
       query failed. On a view about what is not known, that is the worst available answer. *@
    <MudAlert Severity="Severity.Normal" Dense="true" Variant="Variant.Outlined">@EmptySentence</MudAlert>
}
else
{
    <MudDataGrid T="FrontierItem" Items="_items" Dense="true" Hover="true" Bordered="false"
                 SortMode="SortMode.Single" Filterable="false" RowsPerPage="30" Class="abom-grid">
        <Columns>
            <PropertyColumn Property="x => x.Score" Title="Score">
                <CellTemplate>
                    <MudTooltip Text="How much of your organization depends on this, and how likely analyzing it is to turn up more. The highest scores are analyzed first.">
                        <span class="abom-num">
                            @context.Item.Score.ToString("0")
                        </span>
                    </MudTooltip>
                </CellTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.NodeKey" Title="Dependency">
                <CellTemplate>
                    <MudTooltip Text="Show what is waiting on this in the Explorer.">
                        <MudLink Href="@DependentsLink(context.Item.NodeKey)">
                            @context.Item.NodeKey<span class="abom-ref">@RefSuffix(context.Item)</span>
                        </MudLink>
                    </MudTooltip>
                </CellTemplate>
            </PropertyColumn>

            @* Redundant while a single state is chosen: every row would read the same. *@
            @if (MixedStates)
            {
                <TemplateColumn Title="State" Sortable="false">
                    <CellTemplate>
                        <MudTooltip Text="@StateHint(context.Item)">
                            @* Same dot and hue as the chip that filters to this state, so the
                               mixed view is read with the key already learned above it. *@
                            <span class="abom-status-cell">
                                <span class="abom-legend-dot abom-legend-dot-sm"
                                      style="--abom-legend-color:@DiscoveryColor(context.Item.State)"></span>
                                <span class="@StateClass(context.Item.State)">@StateLabel(context.Item.State)</span>
                            </span>
                        </MudTooltip>
                    </CellTemplate>
                </TemplateColumn>
            }

            @* The tier rather than the raw hop count. Score and directness correlate, so depth
               reads as a constant 1 down the whole default view while what a reader needs is
               whether this is theirs to fix and which suites ran on it. The hops stay in the
               tooltip, where they explain the tier rather than standing in for it. *@
            <TemplateColumn Title="Tier" Sortable="false">
                <CellTemplate>
                    <MudTooltip Text="@TierRowHint(context.Item)">
                        <span class="abom-status-cell">@TierLabel(context.Item.Tier)</span>
                    </MudTooltip>
                </CellTemplate>
            </TemplateColumn>

            @* Only where it varies. Under the build-time filter every row reads the same. *@
            @if (_status != BuildTimeFilter)
            {
                <TemplateColumn Title="Runs in" Sortable="false">
                    <CellTemplate>
                        <MudTooltip Text="@SupplyChainHint(context.Item.SupplyChain)">
                            <span class="abom-status-cell">@SupplyChainLabel(context.Item.SupplyChain)</span>
                        </MudTooltip>
                    </CellTemplate>
                </TemplateColumn>
            }

            @* Only under the state it belongs to. In a mixed view these are blank on most rows
               and still cost the width that pushed the Note column off the screen. *@
            @if (_status == "running")
            {
                <TemplateColumn Title="Started" Sortable="false">
                    <CellTemplate>
                        @if (context.Item.State == "running")
                        {
                            <MudTooltip Text="How long this analysis has been running. A clone, a database build and a query.">
                                <span class="abom-num">@Elapsed(context.Item.ClaimedAt)</span>
                            </MudTooltip>
                        }
                    </CellTemplate>
                </TemplateColumn>
            }

            @if (_status == "retrying")
            {
                <TemplateColumn Title="Next try" Sortable="false">
                    <CellTemplate>
                        @if (context.Item.Attempts > 0)
                        {
                            <MudTooltip Text="@($"{context.Item.Attempts} attempts so far.")">
                                <span class="abom-num">@Clock(context.Item.NextAttemptAt)</span>
                            </MudTooltip>
                        }
                    </CellTemplate>
                </TemplateColumn>
            }

            @if (MixedStates || _status == "done")
            {
                <PropertyColumn Property="x => x.AnalysisCount" Title="Analyses">
                    <CellTemplate>
                        @if (context.Item.AnalysisCount > 1)
                        {
                            <MudTooltip Text="Re-analyzed after its ref moved.">
                                <span>@context.Item.AnalysisCount</span>
                            </MudTooltip>
                        }
                        else
                        {
                            <span>@context.Item.AnalysisCount</span>
                        }
                    </CellTemplate>
                </PropertyColumn>

                <TemplateColumn Title="Analyzed commit" Sortable="false">
                    <CellTemplate>
                        @if (!string.IsNullOrEmpty(context.Item.ResolvedSha))
                        {
                            <MudTooltip Text="The commit this was analyzed at. The reference may point somewhere else by now. Opens what it depends on.">
                                <MudLink Href="@UsesLink(context.Item.NodeKey)" Class="abom-rule">
                                    @context.Item.ResolvedSha[..Math.Min(12, context.Item.ResolvedSha.Length)]
                                </MudLink>
                            </MudTooltip>
                        }
                    </CellTemplate>
                </TemplateColumn>

                @* Blank rather than a date for anything never analyzed: a row with no results is
                   not a row analyzed long ago, and only one of those is worth re-running. *@
                <TemplateColumn Title="Last analyzed" Sortable="false">
                    <CellTemplate>
                        @if (!string.IsNullOrEmpty(context.Item.AnalyzedAt))
                        {
                            <MudTooltip Text="@($"Analyzed {Clock(context.Item.AnalyzedAt)}. Re-analyzing this tier replaces it.")">
                                <span class="abom-num">@Ago(context.Item.AnalyzedAt)</span>
                            </MudTooltip>
                        }
                    </CellTemplate>
                </TemplateColumn>

                @* What actually ran, never what the tier is bound to now. A row analyzed before
                   run identity landed says so: "no findings" means nothing until you know
                   whether anything looked for any. *@
                <TemplateColumn Title="Analyzed with" Sortable="false">
                    <CellTemplate>
                        @if (context.Item.SuitesKnown)
                        {
                            <MudTooltip Text="@SuitesTooltip(context.Item)">
                                <span class="abom-rule">@SuitesLabel(context.Item)</span>
                            </MudTooltip>
                        }
                        else if (!string.IsNullOrEmpty(context.Item.AnalyzedAt))
                        {
                            <MudTooltip Text="This row was analyzed before the suites that ran were recorded, so what looked at it is unknown. Re-analyzing it records them.">
                                <span class="mud-text-secondary">not recorded</span>
                            </MudTooltip>
                        }
                    </CellTemplate>
                </TemplateColumn>
            }

            <TemplateColumn Title="Used by" Sortable="false">
                <CellTemplate>
                    @* Collapsed by default: 220 repositories name one version of actions/checkout,
                       and a row is not the place to list them. The count is exact, the names are a
                       preview, and the note stays because it says how the crawl reached this. *@
                    @if (context.Item.UsedByCount > 0)
                    {
                        <details class="abom-usedby">
                            <summary>@UsedByLabel(context.Item)</summary>
                            <ul>
                                @foreach (var repo in context.Item.UsedBy)
                                {
                                    <li>@repo</li>
                                }
                                @if (context.Item.UsedByCount > context.Item.UsedBy.Count)
                                {
                                    <li class="mud-text-secondary">
                                        <MudLink Href="@NodeUsersLink(context.Item)" Typo="Typo.caption">
                                            and @(context.Item.UsedByCount - context.Item.UsedBy.Count) more
                                        </MudLink>
                                    </li>
                                }
                            </ul>
                        </details>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@Note(context.Item)</MudText>
                    }
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="FrontierItem" />
        </PagerContent>
    </MudDataGrid>
}

@* Deliberately last and quiet: removal is rare, and the two halves are separated because only
   one of them is reversible. *@
<MudText Typo="Typo.subtitle2" Class="mt-8 mb-1">Removing what you no longer own</MudText>
@if (_declared is { Count: 0 })
{
    @* Pruning is defined against a declared closure, so with none the server refuses. That is a
       state this page can explain, and it is not read at all rather than reported as a fault. *@
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-8" data-abom-prune-undeclared>
        Nothing is declared, so there is no closure to be outside of. Declare an account in
        <MudLink Href="/settings">Settings</MudLink> before removing anything.
    </MudText>
}
else if (_prune is null)
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary">Reading what is outside your scope…</MudText>
}
else if (_prune.RemovesNothing)
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary" data-abom-prune-clean>
        Everything here is reachable from what you declared. Nothing to remove.
        @if (_pruneOutcome is not null)
        {
            <span data-abom-prune-outcome> @_pruneOutcome</span>
        }
    </MudText>
    @if (_prune.Tombstoned > 0)
    {
        <div class="d-flex flex-wrap align-center gap-3 mb-8 mt-2">
            <MudTooltip Text="Delete what is already removed, permanently. Only re-analysis can rebuild it, and every open page reloads.">
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                           Disabled="_pruning" OnClick="@(() => Prune(true))" data-abom-prune-compact>
                    Delete @_prune.Tombstoned.ToString("N0") permanently
                </MudButton>
            </MudTooltip>
        </div>
    }
}
else
{
    <MudText Typo="Typo.body2" Class="mb-2" data-abom-prune-summary>
        @_prune.Declared declared @(_prune.Declared == 1 ? "repository reaches" : "repositories reach")
        @_prune.Reachable. Outside that: <b>@_prune.Removed.Nodes.ToString("N0")</b> nodes and
        <b>@_prune.Removed.Edges.ToString("N0")</b> edges across
        <b>@_prune.Removed.Repositories.ToString("N0")</b> repositories@(_prune.Removed.Queued > 0
            ? $", and {_prune.Removed.Queued:N0} queued dependencies that would otherwise be analyzed and come back"
            : "").
    </MudText>
    <div class="d-flex flex-wrap align-center gap-3 mb-8">
        <MudTooltip Text="Take these out of every view. Nothing is deleted yet, and re-analysis brings back anything you declare again.">
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="_pruning"
                       OnClick="@(() => Prune(false))" data-abom-prune-mark>
                @(_pruning ? "Working…" : "Remove from view")
            </MudButton>
        </MudTooltip>
        <MudTooltip Text="Delete what is already removed, permanently. Only re-analysis can rebuild it, and every open page reloads.">
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                       Disabled="_pruning" OnClick="@(() => Prune(true))" data-abom-prune-compact>
                Delete permanently
            </MudButton>
        </MudTooltip>
        @if (_pruneOutcome is not null)
        {
            <MudText Typo="Typo.body2" data-abom-prune-outcome>@_pruneOutcome</MudText>
        }
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "status")] public string? StatusParam { get; set; }

    private IReadOnlyList<FrontierItem> _items = [];
    private DiscoveryState _state = new();
    // Null until read. Enumeration is not recorded as an event anywhere, so what it produced is
    // only observable as the owned tier, and the declaration is what says whether to expect any.
    private IReadOnlyList<DeclaredAccount>? _declared;

    // No depth holds a single reference, so nothing has entered the closure at all. A drained
    // closure reports the same zero outstanding, and telling them apart is the difference
    // between complete coverage and none.
    private bool NothingEnumerated => _objective is { } objective && objective.Progress.Count == 0;
    private Objective? _objective;

    // The most recent cycle, or null when none has been recorded. Never a zero-valued stand-in:
    // a database that has never run a cycle is not one that ran and cost nothing.
    private CycleSpend? LastCycle =>
        _objective is { Recent.Count: > 0 } ? _objective.Recent[0] : null;

    // Settled is analyzed plus what could not be fetched, so a depth chip and a tier chip count
    // different things and only agree when nothing is unavailable.
    private int UnavailableAcrossDepths =>
        _objective is { } o ? o.Progress.Sum(d => d.Settled - d.Done) : 0;

    private static string DepthSplit(DepthProgress d)
    {
        var unavailable = d.Settled - d.Done;
        return unavailable > 0
            ? $"{d.Done:N0} analyzed, {unavailable:N0} unavailable — {d.Settled:N0} settled of {d.Total:N0}."
            : $"{d.Done:N0} analyzed of {d.Total:N0}.";
    }

    private static string Seconds(long millis) => (millis / 1000.0).ToString("N1");
    private bool _loading = true;
    private bool _busy;
    private DateTime? _lastPoll;
    private string? _pollError;
    private Timer? _timer;
    private TimeSpan _beat;
    private string? _requeueRepo;
    private string? _requeueNote;

    /// <summary>The beat a state that is on its way somewhere else is watched on.</summary>
    private static readonly TimeSpan Settling = TimeSpan.FromSeconds(2);

    // Queued first: this grid is about what is left to do. Ordering by score alone buries every
    // pending item under work that has already finished.
    private string _status = "queued";
    private PropertiesView? _properties;

    private sealed record Filter(string Value, string Label);

    // All first, then alphabetical: a reader looking for one name should not have to learn an
    // ordering to find it. The hues still tie each chip to its slice of the bar, which is what
    // the bar is keyed by now that position no longer matches.
    private static readonly Filter[] Filters =
    [
        new("", "All"),
        new("done", "Analyzed"),
        new(BuildTimeFilter, "Build-time only"),
        new("running", "Discovering"),
        new(AdvisoryFilter, "Has advisories"),
        new("queued", "Queued"),
        new("retrying", "Retrying"),
        new("unavailable", "Unavailable"),
    ];

    // Not a queue state but a property of the dependency, so it gets an icon rather than a state
    // hue: a grey dot in a row of state colors would read as a sixth state.
    private const string AdvisoryFilter = "advisories";

    // Also not a state: it says who runs the dependency, not where it sits in the queue.
    private const string BuildTimeFilter = "buildTime";

    // Counted from the graph rather than the queue, because it is exactly the population the
    // queue has no row for.
    private const string UpstreamOnlyKey = "upstreamOnly";

    // Owning a dependency is a different answer to "what can you do about this" than naming it,
    // and it is not a depth: an owned action is reached wherever the graph places it. Depth 1 is
    // what a starting repository names itself; anything further arrives through an
    // intermediary that may belong to someone else.
    //
    // Owned is offered only once an identity has established it. With none, a column reading zero
    // would assert the operator owns no dependency, which nothing has shown.
    private string[] Tiers => _suites?.Verified == true
        ? ["owned", "direct", "transitive"]
        : ["direct", "transitive"];

    private IReadOnlyDictionary<string, TierCount> _tiers => _state.Tiers;

    private TierCount TierOf(string tier) =>
        _tiers.TryGetValue(tier, out var c) ? c : new TierCount();

    private static string TierLabel(string tier) => string.IsNullOrEmpty(tier) ? "—" : tier;

    // The hop count explains the tier rather than replacing it: 1 is named directly, more than 1
    // arrives through an intermediary. Owned is neither, which is why it says so instead.
    private static string TierRowHint(FrontierItem item) => item.Tier switch
    {
        "owned" => $"You are verified against this account, so this is yours to change. Reached in {item.Depth} hop{(item.Depth == 1 ? "" : "s")}.",
        "direct" => "A repository discovery started from names this itself, so it can be changed there.",
        _ => $"Reached through an intermediary someone else may own, {item.Depth} hops out.",
    };

    private SuiteBinding? _suites;

    private IReadOnlyList<string> BoundTo(string tier) =>
        _suites is not null && _suites.Tiers.TryGetValue(tier, out var s) ? s : [];

    private bool IsBound(string tier, string suite) => BoundTo(tier).Contains(suite);

    private int BoundCount(string tier) => BoundTo(tier).Count;

    // Stated per column, because the whole point of the grid is that the tiers deserve different
    // work, and a reader deciding that is looking at the column.
    private static string TierWhy(string tier) => tier switch
    {
        "owned" => "you own these",
        "direct" => "your repositories name these",
        _ => "reached through something else",
    };

    // Configuration is changed a few times a month and the queue is why the page is open, so the
    // control folds. What it is set to does not: see plans/ui/discovery-config.md.
    private bool _configOpen;

    private void ToggleConfig() => _configOpen = !_configOpen;

    private string BindingSummary() => string.Join(" · ", Tiers.Select(tier =>
    {
        var bound = BoundTo(tier);
        return bound.Count == 0
            ? $"{tier}: nothing"
            : $"{tier}: {string.Join(", ", bound.Select(SuiteLabel))}";
    }));

    private readonly HashSet<string> _openSuites = [];

    private bool IsSuiteOpen(string suite) => _openSuites.Contains(suite);

    private void ToggleSuiteDetail(string suite)
    {
        if (!_openSuites.Remove(suite))
        {
            _openSuites.Add(suite);
        }
    }

    private SuiteDetail? Detail(string suite) =>
        _suites is not null && _suites.Contents.TryGetValue(suite, out var d) ? d : null;

    // A suite has no version of its own, so the line carries the packs behind it. A suite no
    // crawl has resolved has no count to state, and saying 0 would assert a measurement.
    private string SuiteSummary(string suite)
    {
        if (Detail(suite) is not { } detail)
        {
            return "not yet resolved";
        }
        var versions = string.Join(", ", detail.Packs.Select(p => p.Version).Distinct());
        var queries = $"{detail.QueryCount:N0} {(detail.QueryCount == 1 ? "query" : "queries")}";
        return string.IsNullOrEmpty(versions) ? queries : $"{versions} · {queries}";
    }

    // The path is how the binding is stored and what an operator would grep for, so the label
    // shortens it without inventing a name the suite does not have.
    private static string SuiteLabel(string suite)
    {
        var name = suite.Split('/').LastOrDefault() ?? suite;
        return name.EndsWith(".qls", StringComparison.Ordinal) ? name[..^4] : name;
    }

    private string BindHint(string tier, string suite) => IsBound(tier, suite)
        ? $"Stop running {SuiteLabel(suite)} on the {tier} tier. Results already recorded stay until that tier is re-analyzed."
        : $"Run {SuiteLabel(suite)} on the {tier} tier from the next round. Its {TierOf(tier).Analyzed:N0} analyzed dependencies pick it up only when re-analyzed.";

    private async Task ToggleSuite(string tier, string suite)
    {
        _busy = true;
        try
        {
            var next = BoundTo(tier).ToList();
            if (!next.Remove(suite))
            {
                next.Add(suite);
            }
            _suites = await Api.SetTierSuitesAsync(tier, next);
        }
        finally
        {
            _busy = false;
        }
    }

    private string RequeueHint(string tier) => tier switch
    {
        "owned" => TierOf(tier).HoldsRepositories
            ? $"Re-analyze the {TierOf(tier).Repositories:N0} repositories you own ({TierOf(tier).RepositoriesAnalyzed:N0} analyzed) and the {TierOf(tier).Dependencies:N0} dependencies in those same accounts ({TierOf(tier).DependenciesAnalyzed:N0} analyzed). These are the ones you can change yourself."
            : $"Re-analyze the {TierOf(tier).Analyzed:N0} analyzed of {TierOf(tier).Total:N0} dependencies belonging to accounts you are verified against. These are the ones you can change yourself, whatever depth they were reached at.",
        "direct" => $"Re-analyze the {TierOf(tier).Analyzed:N0} analyzed of {TierOf(tier).Total:N0} dependencies your repositories name directly, with the query suite currently configured. Nothing already known is cleared while it runs.",
        _ => $"Re-analyze the {TierOf(tier).Analyzed:N0} analyzed of {TierOf(tier).Total:N0} dependencies reached through an intermediary. This is the larger tier and takes correspondingly longer.",
    };

    private async Task Requeue(string tier)
    {
        _busy = true;
        try
        {
            _state = await Api.RequeueTierAsync(tier);
            await Load();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RequeueStale() => await Select(
        () => Api.RequeueStaleAsync(),
        got => got.Requeued > 0
            ? $"{got.Requeued:N0} requeued as out of date against CodeQL {got.CliVersion} "
              + $"and {got.Packs} packs."
            // A current corpus is the normal outcome after a crawl, and silence here reads as a
            // button that did not work.
            : $"Nothing is out of date against CodeQL {got.CliVersion} and {got.Packs} packs.");

    private async Task RequeueRepository()
    {
        var name = (_requeueRepo ?? string.Empty).Trim();
        if (name.Length == 0)
        {
            return;
        }
        await Select(
            () => Api.RequeueRepositoryAsync(name),
            got => got switch
            {
                { Requeued: > 0 } =>
                    $"{got.Requeued:N0} requeued for {name}, {got.Expedited:N0} ahead of the ranking.",
                // Already queued is not the same as unknown, and the request — run this next —
                // was still answered.
                { Expedited: > 0 } =>
                    $"{name} was already queued. {got.Expedited:N0} moved ahead of the ranking.",
                // Otherwise the operator is left watching a crawl that will never reach what
                // they asked about.
                _ => $"Nothing analyzed for {name} to requeue.",
            });
    }

    private async Task OnRequeueKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await RequeueRepository();
        }
    }

    private async Task Select(Func<Task<RequeueResult>> ask, Func<RequeueResult, string> say)
    {
        _busy = true;
        try
        {
            var got = await ask();
            _requeueNote = say(got);
            await Load();
        }
        catch (Exception ex)
        {
            _requeueNote = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    // Filtering on advisories says nothing about how far along any of these are, so the rows can
    // still be in any state and the view owes the reader the same columns "All" gives.
    private bool MixedStates => _status is "" or AdvisoryFilter or BuildTimeFilter;

    private bool IsRunning => _state.Status.IsRunning;

    private string CountOf(string state) =>
        state == "" ? string.Empty : _state.Count(state).ToString("N0");

    private string DiscoveryColor(string state) =>
        Theme.Palette.Discovery.TryGetValue(state, out var c) ? c : Theme.Palette.Muted;

    // Filling towards the next automatic recount. Null when there is nothing to say: no
    // threshold reported, or nothing has arrived since the last one.
    private double? RecountShare
    {
        get
        {
            var threshold = _state.Status.ReachThreshold;
            var pending = _state.Status.ReachPending;
            if (threshold <= 0 || pending <= 0)
            {
                return null;
            }
            // A full ring means "due". How far past the threshold it went is in the sentence
            // beside it, where a number can say it exactly.
            return Math.Min(100d, pending * 100d / threshold);
        }
    }

    // The ring's accessible name. It is a graphic beside prose, so it needs to say the same
    // thing the prose does rather than leaving a screen reader with an unlabeled figure.
    private string RecountHint
    {
        get
        {
            var threshold = _state.Status.ReachThreshold;
            var pending = _state.Status.ReachPending;
            if (pending >= threshold)
            {
                return $"Recount due: {pending:N0} dependencies have arrived, past the "
                       + $"{threshold:N0} that trigger one.";
            }
            return $"{pending:N0} of {threshold:N0} dependencies towards the next recount of "
                   + "usage counts.";
        }
    }

    // Every filter, not only the obscure ones: "Build-time only" is meaningless on sight, but so
    // is "Discovering" to anyone who has not already worked out that this is a queue.
    private static string FilterHint(string value) => value switch
    {
        "" => "Every dependency the graph knows about, whatever state it is in.",
        "done" => "Fetched and analyzed, so what these depend on is in the graph.",
        "running" => "Being fetched and analyzed right now.",
        "queued" => "Waiting to be analyzed. Nothing has looked inside these yet, so whatever they depend on is missing from the graph.",
        "retrying" => "Fetching failed and is scheduled to be tried again.",
        "unavailable" => "Nothing can be fetched: the repository is gone, private, or the reference names no repository at all. These will not be retried.",
        AdvisoryFilter => "A published security advisory names these dependencies. Being named is not a finding about your use of them — the advisory covers a version range, and most references here are floating tags.",
        BuildTimeFilter => "These run only inside their own project's CI, building or releasing the action you use. Nothing in your organization executes them — but whoever controls that pipeline controls the version you receive, which is why they are analyzed too.",
        _ => string.Empty,
    };

    // Short, because the bar beside it carries the shape and the filters below carry the counts.
    //
    // The figure is how many run at once, not how many are outstanding. Those are different
    // numbers — a round takes on far more than it processes at a time — and showing both without
    // saying which was which read as a contradiction.
    private string StateSentence => _state.Status.State switch
    {
        "working" => $"Analyzing {_state.Status.Concurrency} repositories at a time.{SkipSuffix}",
        "idle" => $"Running, nothing to analyze right now.{SkipSuffix}",
        "pausing" => _state.Running > 0
            ? $"Finishing {_state.Running} already started."
            : "Finishing what has already started.",
        "paused" => $"Stopped.{SkipSuffix}",
        // Never started is not the same as interrupted, and saying "paused" sends the reader
        // looking for the failure that stopped it.
        _ => "Not started.",
    };

    // A re-analysis of work already on record settles everything it claims and analyzes none of
    // it, so every counter beside this one stays put and the loop reads as hung. Absent when
    // nothing was skipped: a standing "0 already on record" is noise on a first crawl.
    private string SkipSuffix =>
        _state.Status.Skipped > 0
            ? $" Settled {_state.Status.Skipped:N0} already on record without re-analyzing them."
            : string.Empty;

    // One dim line under the bar, and only what the reader cannot see already: what starting
    // costs when it is stopped, how stale the sizing is when it is running.
    //
    // Clock time, not "just now": this line is only redrawn when the page loads or a refresh
    // lands, so a relative phrase silently becomes false the longer someone sits looking at it.
    private string DetailSentence
    {
        get
        {
            if (!IsRunning)
            {
                return "Downloads and analyzes each queued dependency, up to "
                       + $"{_state.Status.Concurrency} at a time. Safe to stop and resume.";
            }
            if (string.IsNullOrEmpty(_state.Version.ReachRecomputedAt))
            {
                return "Nothing counted yet, so the Explorer draws new dependencies at a "
                       + "neutral size rather than as unused.";
            }
            var counted = TimeText.DayAndTime(_state.Version.ReachRecomputedAt);
            var pending = _state.Status.ReachPending;
            var threshold = _state.Status.ReachThreshold;
            if (pending <= 0 || threshold <= 0)
            {
                return $"Usage counts last worked out {counted}.";
            }
            if (pending >= threshold)
            {
                return $"Usage counts last worked out {counted}. {pending:N0} dependencies have "
                       + $"arrived since, past the {threshold:N0} that trigger a recount, so they "
                       + "will be counted at the end of this cycle.";
            }
            return $"Usage counts last worked out {counted}. {pending:N0} of {threshold:N0} "
                   + "dependencies towards the next recount; until then the Explorer sizes nodes "
                   + "on the previous count.";
        }
    }

    // A drained queue is the normal resting state, not an achievement. It is also not a complete
    // picture while dependencies remain that nothing has looked inside, so this reports the gap
    // rather than implying there is none.
    private string DrainedSentence
    {
        get
        {
            // A queue that never held anything is not one that emptied. Offering to re-check
            // prior work names work that was never done, and Start has nothing to claim until
            // something is declared to start from.
            if (NothingEnumerated)
            {
                return _declared is { Count: 0 }
                    ? "Nothing is waiting because nothing has been enumerated. Declare an "
                      + "account in Settings, and the repositories underneath it become the "
                      + "starting point."
                    : "Nothing is waiting because nothing has been enumerated yet.";
            }
            var next = IsRunning
                ? "Discovery now re-checks what it already analyzed and requeues anything whose reference has moved."
                : "Press Start to re-check what was already analyzed for references that have moved.";
            var unanalyzed = _state.Count(UpstreamOnlyKey);
            if (unanalyzed == 0)
            {
                return $"Nothing is waiting. {next}";
            }
            return "Nothing is waiting, which is not the same as nothing left to look at: "
                   + $"{unanalyzed:N0} dependencies appear in the graph that nothing has yet "
                   + $"analyzed, so whatever they pull in is not represented. {next}";
        }
    }

    private string EmptySentence => _status switch
    {
        "queued" => DrainedSentence,
        "retrying" => "No dependency has failed and been rescheduled.",
        "running" => IsRunning
            ? "Nothing is being analyzed at this moment. The next batch starts shortly."
            : "Nothing is being analyzed. Press Start to begin.",
        "done" => "No dependency has been analyzed yet.",
        "unavailable" => "No dependency has been found unfetchable.",
        AdvisoryFilter => "No dependency here is named by a published advisory. That is not a clean bill of health: advisories name exact packages, and a floating tag may still resolve into a vulnerable range.",
        _ => "The queue is empty.",
    };

    private static string Elapsed(string timestamp) => Since(timestamp) switch
    {
        null => string.Empty,
        var span when span < TimeSpan.FromMinutes(1) => $"{(int)span.Value.TotalSeconds}s",
        var span => $"{(int)span.Value.TotalMinutes}m",
    };

    // Coarser than Elapsed, which dates work in flight. Staleness is read in days and weeks, and
    // a column of minute counts down a settled queue would say nothing at a glance.
    private static string Ago(string timestamp) => Since(timestamp) switch
    {
        null => string.Empty,
        var span when span < TimeSpan.FromHours(1) => $"{(int)span.Value.TotalMinutes}m",
        var span when span < TimeSpan.FromDays(1) => $"{(int)span.Value.TotalHours}h",
        var span when span < TimeSpan.FromDays(28) => $"{(int)span.Value.TotalDays}d",
        var span => $"{(int)(span.Value.TotalDays / 7)}w",
    };

    private static TimeSpan? Since(string timestamp) =>
        DateTime.TryParse(timestamp, null,
            System.Globalization.DateTimeStyles.AdjustToUniversal, out var at)
            ? DateTime.UtcNow - at
            : null;

    private static string Clock(string timestamp) =>
        DateTime.TryParse(timestamp, null,
            System.Globalization.DateTimeStyles.AdjustToUniversal, out var at)
            ? at.ToLocalTime().ToString("HH:mm")
            : string.Empty;

    // A name is a package; a reference is what runs. Findings, advisories and pinning all attach
    // to the second, so a row never shows the first alone. An empty ref is the default branch —
    // a real answer, and not the same as having no reference.
    private static string RefSuffix(FrontierItem item) =>
        string.IsNullOrEmpty(item.Ref) ? " (default branch)" : "@" + item.Ref;

    // "220 repositories" and "12 yours" are different decisions: the second is what the operator
    // can change. Never printed as "0 yours" — with no verified account that is an unanswered
    // question, not a count of none, the same rule the pinning split follows.
    private static string UsedByLabel(FrontierItem item)
    {
        var total = item.UsedByCount == 1 ? "1 repository" : $"{item.UsedByCount:N0} repositories";
        return item.UsedByOwned > 0 ? $"{total} · {item.UsedByOwned:N0} yours" : total;
    }

    // The preview stops at five, and the node page holds the rest. The reference travels with
    // the key: the row is one version, and the node page would otherwise answer for the package.
    private static string NodeUsersLink(FrontierItem item) =>
        $"/node/{item.NodeKey}?ref={Uri.EscapeDataString(item.Ref)}";

    // The pack name alone in the cell, versions in the tooltip: two packs at full identity is
    // more than a grid cell holds, and the name is what distinguishes "only the graph was
    // extracted" from "security queries also ran".
    private static string SuitesLabel(FrontierItem item) =>
        string.Join(", ", item.Suites.Select(ShortSuite));

    private static string SuitesTooltip(FrontierItem item) =>
        string.Join("\n", item.Suites) +
        (string.IsNullOrEmpty(item.CliVersion) ? string.Empty : $"\nCodeQL {item.CliVersion}");

    // `advanced-security/abom-actions-graph-extraction-src@2.26.4` is the pack this repository
    // publishes; in a column about what ran, the owner and the version are noise.
    private static string ShortSuite(string suite)
    {
        var name = suite.Split('@')[0];
        var slash = name.LastIndexOf('/');
        return slash < 0 ? name : name[(slash + 1)..];
    }

    // Its callers, not its dependencies: a queued dependency has no dependencies recorded yet,
    // which is exactly why it is queued. The filter travels too, so the way back lands here.
    private string DependentsLink(string nodeKey) =>
        $"/explore?selection={Uri.EscapeDataString(nodeKey)}&direction=in&from=discovery"
        + (string.IsNullOrEmpty(_status) ? "" : $"&status={_status}");

    private string UsesLink(string nodeKey) =>
        $"/explore?selection={Uri.EscapeDataString(nodeKey)}&direction=out&from=discovery"
        + (string.IsNullOrEmpty(_status) ? "" : $"&status={_status}");

    // reason is set only when something went wrong; discoveredFrom says why it is queued at all.
    private static string Note(FrontierItem item) =>
        !string.IsNullOrEmpty(item.Reason) ? item.Reason
        : !string.IsNullOrEmpty(item.DiscoveredFrom) ? $"named by {item.DiscoveredFrom}"
        : string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (StatusParam is not null && Filters.Any(f => f.Value == StatusParam))
        {
            _status = StatusParam;
        }
        Follow.Changed += OnFollowChanged;
        await Load();
    }

    private async Task Load()
    {
        _state = await Api.GetDiscoveryAsync();
        _declared = await Api.GetOwnedScopeAsync();
        _objective = await Api.GetObjectiveAsync();
        _properties = await Api.GetPropertiesAsync();
        _items = await Api.GetFrontierAsync(_status, top: 400);
        _suites = await Api.GetTierSuitesAsync();
        // Skipped rather than attempted when nothing is declared: the server refuses to prune
        // against an empty closure, and that refusal would otherwise land in LastError and be
        // reported as an unreachable server on every first run.
        _prune = _declared is { Count: 0 } ? null : await Api.GetPruneAsync();
        // A read that failed returns an empty result rather than throwing, so the transport's
        // own account of what went wrong is the only thing that separates "nothing here" from
        // "could not ask".
        _pollError = Api.LastError;
        _lastPoll = DateTime.UtcNow;
        _loading = false;
        ApplyFollow();
    }

    private PruneView? _prune;
    private bool _pruning;
    private string? _pruneOutcome;

    private async Task Prune(bool compact)
    {
        _pruning = true;
        _pruneOutcome = null;
        try
        {
            var done = await Api.PruneAsync(compact);
            _pruneOutcome = done is null
                ? "Nothing came back."
                : compact
                    ? $"Deleted {done.Removed.Nodes:N0} nodes and {done.Removed.Edges:N0} edges."
                    : $"Removed {done.Removed.Nodes:N0} nodes and {done.Removed.Edges:N0} edges from view"
                      + (done.Removed.Queued > 0 ? $", and {done.Removed.Queued:N0} queued dependencies." : ".");
            // Re-read rather than trusting the response: what is left is the question the next
            // decision turns on, and the answer to "what did that cost" is a different one.
            await Load();
        }
        catch (HttpRequestException e)
        {
            _pruneOutcome = "Nothing was removed: " + e.Message;
        }
        finally
        {
            _pruning = false;
        }
    }

    private async Task OnStatusChanged(string value)
    {
        _status = value ?? string.Empty;
        // Otherwise the previous filter's answer stays on screen until the new one lands, and a
        // view whose job is separating "none" from "not looked yet" states one before asking.
        _loading = true;
        _items = [];
        // In the address rather than only in memory, so leaving for the Explorer and coming back
        // returns to the same filter. Replaced, not pushed: changing a filter is not a
        // navigation, and stacking them would make Back walk through every chip.
        Nav.NavigateTo(
            Nav.GetUriWithQueryParameter("status", string.IsNullOrEmpty(_status) ? null : _status),
            forceLoad: false, replace: true);
        await Load();
    }

    private async Task ToggleRunning()
    {
        _busy = true;
        try
        {
            _state = await Api.SetDiscoveryAsync(!IsRunning);
            await Load();
        }
        catch (Exception ex)
        {
            // A refused or failed control request must say so: the button otherwise appears to
            // work and the loop never starts.
            _pollError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void OnFollowChanged()
    {
        ApplyFollow();
        InvokeAsync(StateHasChanged);
    }

    private void ApplyFollow()
    {
        // A loop on its way out of a state has disabled the control that would say it arrived,
        // so it is watched on its own beat rather than the reader's: five minutes of "Pausing…"
        // after the pause finished reads as a page that stopped working.
        var beat = _state.Status.IsPausing && Follow.Interval > Settling ? Settling : Follow.Interval;
        if (_timer is not null && beat == _beat)
        {
            return;
        }
        _timer?.Dispose();
        _beat = beat;
        _timer = new Timer(async _ =>
        {
            // Nothing awaits a timer callback, so an exception raised inside it is discarded:
            // following would keep ticking against a server that had stopped answering, with
            // the page frozen on stale data and no sign of why.
            try
            {
                await Load();
            }
            catch (Exception ex)
            {
                _pollError = ex.Message;
            }
            await InvokeAsync(StateHasChanged);
        }, null, beat, beat);
    }

    private static string StateLabel(string state) => state switch
    {
        "done" => "analyzed",
        "queued" => "queued",
        "retrying" => "retrying",
        "running" => "discovering",
        "unavailable" => "unavailable",
        _ => state,
    };

    private static string StateHint(FrontierItem item) => item.State switch
    {
        "queued" => "Referenced by something already analyzed. Nothing has looked inside it yet, so whatever it depends on is not in this picture.",
        "retrying" => $"Fetching it failed {item.Attempts} times. It is waiting before trying again.",
        "running" => "Being fetched and analyzed now. Anything it names will appear as it is found.",
        "done" => "We know what this depends on, as of the commit shown.",
        "unavailable" => "Nothing can be fetched for it, and it will not be retried.",
        _ => item.State,
    };

    private static string StateClass(string state) => state switch
    {
        "done" => "abom-status-done",
        "unavailable" => "abom-status-unavailable",
        _ => "abom-status-queued",
    };

    private static string SupplyChainLabel(string chain) =>
        chain == "build_time" ? "their CI" : "your workflows";

    private static string SupplyChainHint(string chain) => chain == "build_time"
        ? "Only this dependency's own project runs it, in their release pipeline. Nothing here executes it — but a compromised pipeline is how a bad version reaches you, so it is still analyzed."
        : "Something here executes this, directly or through an action it calls.";

    public void Dispose()
    {
        Follow.Changed -= OnFollowChanged;
        _timer?.Dispose();
    }
}
