@page "/settings"
@using Abom.WebAssembly.Models
@using Abom.WebAssembly.Services
@using System.Text.Json
@inject AbomApi Api
@inject AccountService Accounts
@inject PromptMemory Prompts

<PageTitle>Settings — ABOM</PageTitle>

<PageHeader Title="Settings">
    What you claim as yours, and what discovery does with it. Which GitHub accounts are yours is
    something you state, not something we infer. Discovery
    crawls only what these accounts reach, and every page reports its figures split into what you
    can change and what you cannot &mdash; both halves, always. <code>gh</code> is asked whether
    you still have the access you claim; it never decides what is yours.
</PageHeader>

@if (Accounts.Declared is null)
{
    <MudProgressLinear Indeterminate="true" Class="my-8" />
}
else
{
    <MudText Typo="Typo.subtitle2" Class="mb-1">Accounts you own</MudText>
    @* gh is asked before the reader is: the first screen lists what could be declared rather than
       asking for a name the page could have looked up. *@
    <div class="d-flex flex-wrap align-center gap-3 mb-3" data-abom-identity>
        @if (_checking)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
            <MudText Typo="Typo.body2" data-abom-checking>Asking gh which accounts you belong to&hellip;</MudText>
        }
        else if (_checkError is not null)
        {
            <MudText Typo="Typo.body2" Class="abom-unconfirmed" data-abom-check-failed>
                ABOM could not ask gh: @_checkError
            </MudText>
        }
        else if (_problem is not null)
        {
            <MudAlert Dense="true" Severity="Severity.Warning" Variant="Variant.Outlined">
                <MudText Typo="Typo.body2">@_problem.Reason</MudText>
                <MudText Typo="Typo.body2" Class="mt-2">@_problem.Remedy</MudText>
                <MudText Typo="Typo.caption" Class="mt-2 mud-text-secondary">
                    Until this is fixed nothing counts as yours and every figure is reported undivided.
                    That is not a claim that you own nothing. Declaring by name still works.
                </MudText>
            </MudAlert>
        }
        else if (Accounts.Identity.Authenticated)
        {
            <MudText Typo="Typo.body2">
                Verified as <b>@Accounts.Identity.Login</b> on @Accounts.Identity.Host@(Accounts.Identity.VerifiedAt is { } at
                    ? $", checked {at.ToLocalTime():yyyy-MM-dd HH:mm}" : string.Empty).
            </MudText>
        }
        else
        {
            <MudText Typo="Typo.body2">
                No accounts verified yet, so every figure is reported undivided.
            </MudText>
        }
        <MudTooltip Text="Ask gh which accounts you belong to. It never decides what is yours; it only confirms the access you claim.">
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="_checking"
                       StartIcon="@Icons.Material.Filled.Refresh" OnClick="Refresh" data-abom-check>
                @(Accounts.Identity.Authenticated ? "Check with gh again" : "Check with gh")
            </MudButton>
        </MudTooltip>
    </div>
    @if (_draft.Count == 0)
    {
        <MudAlert Dense="true" Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">
            <MudText Typo="Typo.body2">
                Nothing is declared, so discovery will not start.
            </MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Declare an account below, or run
                <code>codeql-abom own --db &lt;db&gt; --org &lt;name&gt;</code>.
            </MudText>
        </MudAlert>
    }
    else
    {
        @if (Held.Any())
        {
            <MudAlert Dense="true" Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-2">
                <MudText Typo="Typo.body2" data-abom-held="@string.Join(",", Held)">
                    Not counted as yours: @string.Join(", ", Held).
                </MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    gh listed the accounts you belong to and did not name these, so nothing they
                    hold roots a crawl, a bill of materials or any figure on any page. Undeclare
                    them, or regain access and check with gh again.
                </MudText>
            </MudAlert>
        }
        <MudSimpleTable Dense="true" Hover="true" Striped="false" FixedHeader="true"
                        Class="abom-grid abom-table abom-grid-windowed abom-declared-grid mb-2">
            <thead>
                <tr>
                    <th><HeaderTip Tip="The account the declaration says is yours.">Account</HeaderTip></th><th><HeaderTip Tip="Whether the declaration names your user account or an organization.">Kind</HeaderTip></th><th><HeaderTip Tip="The role gh reports for you in that account, when it can read memberships.">Role</HeaderTip></th><th><HeaderTip Tip="Whether discovery should use this declaration when it decides what to crawl.">On</HeaderTip></th><th><HeaderTip Tip="Whether the declaration covers every repository in the account or only the named repositories.">Scope</HeaderTip></th>
                    <th><HeaderTip Tip="What gh has confirmed, contradicted or could not check about your access.">Access</HeaderTip></th><th><HeaderTip Tip="When ABOM last listed repositories under this account and whether any declared repositories are missing.">Repository listing</HeaderTip></th><th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in _draft)
                {
                    <tr>
                        <td>
                            @if (a.Contradicted)
                            {
                                <MudTooltip Text="@($"The accounts gh lists for you do not include {a.Owner}. The declaration is kept so you can correct it, but nothing it holds is counted as yours.")">
                                    <span class="abom-unconfirmed" data-abom-declared="@a.Owner">@a.Owner</span>
                                </MudTooltip>
                            }
                            else
                            {
                                <span class="abom-owned-mark" data-abom-declared="@a.Owner">@a.Owner</span>
                            }
                        </td>
                        <td>@(a.Kind == "user" ? "Your account" : "Organization")</td>
                        <td data-abom-role="@a.Owner">
                            @{ var seen = Membership(a.Owner); }
                            @if (seen is null)
                            {
                                <MudTooltip Text="The gh result lists the accounts you belong to, and this account is not among them, so the role behind this declaration is unknown.">
                                    <span class="abom-unconfirmed">not reported</span>
                                </MudTooltip>
                            }
                            else if (!seen.CanDeclare)
                            {
                                <MudTooltip Text="@($"A {seen.Role} cannot change anything in this account, so this declaration claims more than the access behind it.")">
                                    <span class="abom-unconfirmed">@seen.Role</span>
                                </MudTooltip>
                            }
                            else
                            {
                                <span class="mud-text-secondary">@seen.Role</span>
                            }
                        </td>
                        <td>
                            @* The column heading names the whole column, not this row's box. *@
                            <MudCheckBox T="bool" Dense="true" Size="Size.Small" Value="a.Enabled"
                                         ValueChanged="@(v => SetEnabled(a, v))"
                                         aria-label="@($"Crawl {a.Owner}")"
                                         data-abom-enabled="@a.Owner" />
                        </td>
                        <td class="abom-scope-cell">
                            <div class="d-flex flex-wrap align-center gap-2">
                                <MudCheckBox T="bool" Dense="true" Size="Size.Small"
                                             Value="a.IncludesOnly"
                                             ValueChanged="@(v => SetIncludesOnly(a, v))"
                                             Label="only these repositories"
                                             data-abom-restrict="@a.Owner" />
                            </div>
                            @if (a.IncludesOnly)
                            {
                                <div class="abom-includes" data-abom-includes="@a.Owner">
                                    @foreach (var name in a.Names())
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                                 OnClose="@(_ => Choose(a, name, false))"
                                                 data-abom-include="@name">
                                            @name
                                            @if (Unlisted(a, name))
                                            {
                                                <MudTooltip Text="@($"GitHub did not list {name} under {a.Owner}. It stays declared until you remove it.")">
                                                    <span class="abom-unconfirmed" data-abom-include-unlisted="@name">&nbsp;not listed</span>
                                                </MudTooltip>
                                            }
                                        </MudChip>
                                    }
                                    @if (ListingOf(a.Owner) is null)
                                    {
                                        <MudTooltip Text="@($"Ask GitHub, with your gh token, which repositories {a.Owner} holds. Nothing is chosen for you.")">
                                            <MudButton Size="Size.Small" Variant="Variant.Text"
                                                       StartIcon="@Icons.Material.Filled.Checklist"
                                                       OnClick="@(() => OpenChooser(a))"
                                                       data-abom-choose-repos="@a.Owner">
                                                Choose repositories
                                            </MudButton>
                                        </MudTooltip>
                                    }
                                </div>
                                <div class="abom-property-scopes" data-abom-property-scopes="@a.Owner">
                                    @for (var i = 0; i < a.Clauses.Count; i++)
                                    {
                                        var clause = a.Clauses[i];
                                        var saved = SavedClause(a.Owner, clause);
                                        var defaults = DefaultTerms(a.Owner, clause, saved);
                                        <div class="abom-property-scope" data-abom-property-scope>
                                            <div class="abom-property-scope-line">
                                                <span class="abom-property-scope-terms">
                                                    <span class="mud-text-secondary">@(i > 0 || a.Names().Length > 0 ? "or carrying " : "carrying ")</span>@TermsMarkup(clause)
                                                </span>
                                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                                               aria-label="Remove this property scope"
                                                               title="Remove this property scope from the draft. Nothing changes until you save."
                                                               OnClick="@(() => RemoveScope(a, clause))"
                                                               data-abom-remove-scope />
                                            </div>
                                            <div class="abom-property-scope-notes mud-typography-caption">
                                                @if (saved is { Held: true })
                                                {
                                                    <div class="abom-unconfirmed" data-abom-scope-held>Held, counting nothing: @saved.HeldReason.</div>
                                                }
                                                else if (LiveCount(a.Owner, clause) is { } live)
                                                {
                                                    <div class="mud-text-secondary" data-abom-scope-count
                                                         title="Counted against what GitHub reported through your gh token. Archived repositories are left out, because no listing records them.">
                                                        @CountText.Of(live, "carries", "carry") it on GitHub now
                                                    </div>
                                                }
                                                else if (saved is not null)
                                                {
                                                    <div class="mud-text-secondary" data-abom-scope-count
                                                         title="Repositories recorded under this account whose values, as last read, carry every term.">
                                                        @CountText.Of(saved.Matching, "repository carries", "repositories carry") it
                                                    </div>
                                                }
                                                else if (PropertyReadOf(a.Owner) is { Loading: true })
                                                {
                                                    <div class="mud-text-secondary">counting&hellip;</div>
                                                }
                                                else
                                                {
                                                    <div class="abom-unconfirmed">not counted until saved</div>
                                                }
                                                @if (defaults.Count > 0)
                                                {
                                                    <div class="abom-unconfirmed" data-abom-scope-default>
                                                        @DefaultSentence(defaults) This scope takes in every repository nobody set,
                                                        and every one created later, without anyone deciding.
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                    @* A person's account has no custom properties, so only an organization offers a scope by one. *@
                                    @if (a.Kind != "user" && ScopeEditorOf(a.Owner) is null)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Text"
                                                   StartIcon="@Icons.Material.Filled.Sell"
                                                   OnClick="@(() => OpenScopeEditor(a))"
                                                   title="@($"Ask GitHub, with your gh token, which custom properties {a.Owner} defines, to cover the repositories carrying the values you choose.")"
                                                   data-abom-add-scope="@a.Owner">
                                            Add property scope
                                        </MudButton>
                                    }
                                    @if (!a.IsNew && a.Clauses.Count > 0)
                                    {
                                        var judged = ListingFor(a.Owner);
                                        <MudText Typo="Typo.caption" Class="d-block mud-text-secondary" data-abom-scopes-judged="@a.Owner">
                                            @if (judged.PropertiesJudgedAt.Length > 0)
                                            {
                                                <span>Values judged</span>
                                                <time datetime="@judged.PropertiesJudgedAt" title="@judged.PropertiesJudgedAt">@TimeText.DayAndTime(judged.PropertiesJudgedAt)</time>
                                                @if (judged.PropertiesUnjudged > 0)
                                                {
                                                    <span class="abom-unconfirmed">; @CountText.Of(judged.PropertiesUnjudged, "repository", "repositories") not judged, because
                                                        @(judged.PropertiesUnjudged == 1 ? "its values" : "their values") did not arrive whole. Unknown is not a mismatch.</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="abom-unconfirmed">Values not judged yet: no full listing has read them.</span>
                                            }
                                        </MudText>
                                    }
                                </div>
                            }
                            @if (a.IncludesOnly && a.NamesNothing)
                            {
                                <MudText Typo="Typo.caption" Class="abom-unconfirmed">
                                    names no repository and no property scope, so it covers nothing
                                </MudText>
                            }
                        </td>
                        <td data-abom-access="@a.Owner">
                            @* A row not yet saved has no stored declaration for gh to have answered about. *@
                            @if (a.IsNew)
                            {
                                <span class="mud-text-secondary">checked by gh once saved</span>
                            }
                            else
                            {
                            @switch (a.State)
                            {
                                case "confirmed":
                                    <span class="mud-text-secondary">confirmed by gh</span>
                                    break;
                                case "contradicted":
                                    <MudTooltip Text="The gh answer did not list this account. The declaration is kept so you can correct it, and nothing it holds is counted until you do.">
                                        <span class="abom-unconfirmed">gh does not list this</span>
                                    </MudTooltip>
                                    break;
                                default:
                                    @if (!Accounts.Identity.CanReadMemberships && Accounts.Identity.Authenticated)
                                    {
                                        <MudTooltip Text="Nothing on record says this token can read organization memberships, so gh can neither confirm nor contradict this. Check with gh to record it; if it still says this, the token needs read:org.">
                                            <span class="abom-unconfirmed" data-abom-uncheckable="@a.Owner">cannot be checked</span>
                                        </MudTooltip>
                                    }
                                    else
                                    {
                                        <MudTooltip Text="The gh check has not answered yet, so nothing is established either way. Press Check with gh to record the result.">
                                            <span class="abom-unconfirmed">not confirmed by gh</span>
                                        </MudTooltip>
                                    }
                                    break;
                            }
                            }
                            @if (a.Unaccounted)
                            {
                                <MudTooltip Text="This row predates the record of how a declaration arrives, so nobody can say who wrote it. Save the declaration to account for it.">
                                    <div><span class="abom-unconfirmed" data-abom-unaccounted="@a.Owner">source unknown</span></div>
                                </MudTooltip>
                            }
                        </td>
                        <td class="abom-listing-cell" data-abom-listing="@a.Owner">
                            @if (a.IsNew)
                            {
                                <MudText Typo="Typo.caption" Class="d-block mud-text-secondary">Listed from GitHub once saved.</MudText>
                            }
                            else
                            {
                            var listing = ListingFor(a.Owner);
                            <MudText Typo="Typo.caption" Class="d-block">
                                Route: @(listing.Route switch { "graphql" => "GraphQL", "rest" => "REST", "" => "not recorded", _ => listing.Route })
                            </MudText>
                            @if (listing.ListedAt.Length > 0)
                            {
                                <MudText Typo="Typo.caption" Class="d-block">
                                    Full listing:
                                    <time datetime="@listing.ListedAt" title="@listing.ListedAt" data-abom-listed-at>@TimeText.DayAndTime(listing.ListedAt)</time>
                                </MudText>
                                @* Only a full listing establishes absence, so only here may nothing be missing. *@
                                @if (listing.Missing.Count == 0)
                                {
                                    <MudText Typo="Typo.caption" Class="d-block mud-text-secondary" data-abom-listing-complete>
                                        Nothing declared is missing from it.
                                    </MudText>
                                }
                                else
                                {
                                    <div data-abom-listing-missing="@a.Owner">
                                        <MudText Typo="Typo.caption" Class="d-block abom-unconfirmed">
                                            @CountText.Of(listing.Missing.Count, "declared repository is", "declared repositories are")
                                            missing from it, and no longer yours:
                                        </MudText>
                                        <ul class="abom-trace">
                                            @foreach (var gone in listing.Missing)
                                            {
                                                <li>
                                                    <MudText Typo="Typo.caption">
                                                        <span class="abom-path">@gone.Repository</span>, since
                                                        <time datetime="@gone.MissingAt" title="@gone.MissingAt" data-abom-missing-at>@TimeText.DayAndTime(gone.MissingAt)</time>
                                                    </MudText>
                                                </li>
                                            }
                                        </ul>
                                        <MudText Typo="Typo.caption" Class="d-block mud-text-secondary">
                                            Nothing was removed. What only these reached is offered under
                                            Removing what you no longer own, which says what it takes before anything goes.
                                        </MudText>
                                    </div>
                                }
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Class="d-block abom-unconfirmed">No full listing recorded</MudText>
                            }
                            @if (listing.SweptAt.Length > 0)
                            {
                                <MudText Typo="Typo.caption" Class="d-block">
                                    Changes checked:
                                    <time datetime="@listing.SweptAt" title="@listing.SweptAt" data-abom-swept-at>@TimeText.DayAndTime(listing.SweptAt)</time>
                                </MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Class="d-block mud-text-secondary">Changes checked: not recorded</MudText>
                            }
                            @if (listing.HighCreated.Length > 0 || listing.HighPushed.Length > 0)
                            {
                                <details class="mud-typography-caption">
                                    <summary>Observed changes</summary>
                                    <div>
                                        Newest repository created:
                                        @if (listing.HighCreated.Length > 0)
                                        {
                                            <time datetime="@listing.HighCreated" title="@listing.HighCreated" data-abom-high-created>@TimeText.DayAndTime(listing.HighCreated)</time>
                                        }
                                        else
                                        {
                                            <span>not recorded</span>
                                        }
                                    </div>
                                    <div>
                                        Newest push:
                                        @if (listing.HighPushed.Length > 0)
                                        {
                                            <time datetime="@listing.HighPushed" title="@listing.HighPushed" data-abom-high-pushed>@TimeText.DayAndTime(listing.HighPushed)</time>
                                        }
                                        else
                                        {
                                            <span>not recorded</span>
                                        }
                                    </div>
                                </details>
                            }
                            }
                        </td>
                        <td>
                            <MudTooltip Text="@($"Stop treating {a.Owner} as yours. Nothing already analyzed is deleted.")">
                                <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                           OnClick="@(() => Undeclare(a))"
                                           data-abom-undeclare="@a.Owner">
                                    Undeclare
                                </MudButton>
                            </MudTooltip>
                        </td>
                    </tr>
                    @if (ListingOf(a.Owner) is { } chooser)
                    {
                        <tr class="abom-include-chooser-row">
                            <td colspan="8" data-abom-chooser="@a.Owner">
                                @if (chooser.Loading)
                                {
                                    <MudText Typo="Typo.body2">Asking GitHub which repositories @a.Owner holds&hellip;</MudText>
                                }
                                else if (chooser.Error is not null || chooser.Answer?.Problem is not null)
                                {
                                    @if (chooser.Answer?.Problem is { } p)
                                    {
                                        <MudText Typo="Typo.body2" Class="abom-unconfirmed">@p.Reason</MudText>
                                        <MudText Typo="Typo.body2">@p.Remedy</MudText>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.body2" Class="abom-unconfirmed">GitHub could not be asked: @chooser.Error</MudText>
                                    }
                                    <div class="abom-owner-field mt-2" data-abom-includes-typed="@a.Owner">
                                        <MudTextField T="string" Value="@string.Join(", ", a.Names())"
                                                      ValueChanged="@(v => SetIncludesTyped(a, v))"
                                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                                      Label="Name them instead" Placeholder="repo, other-repo" />
                                    </div>
                                }
                                else if (chooser.Answer is { } answer)
                                {
                                    var matching = Matching(chooser).ToList();
                                    <div class="d-flex flex-wrap align-center gap-3 mb-1">
                                        <div data-abom-repo-filter="@a.Owner">
                                            <SearchField Value="@chooser.Filter" ValueChanged="@(v => chooser.Filter = v ?? string.Empty)"
                                                         Placeholder="@($"Filter {answer.Repositories.Count:N0} repositories")" />
                                        </div>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                            @CountText.Of(answer.Repositories.Count, "repository", "repositories") in @a.Owner, as your gh token sees them.
                                        </MudText>
                                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => CloseChooser(a))"
                                                   title="Close this list. What you chose stays in the draft until you save or discard it."
                                                   data-abom-chooser-done="@a.Owner">Done</MudButton>
                                    </div>
                                    <div class="abom-repo-options">
                                        @foreach (var r in matching.Take(OfferedAtOnce))
                                        {
                                            <div class="abom-repo-option" data-abom-repo-option="@r.Name">
                                                <MudCheckBox T="bool" Dense="true" Size="Size.Small"
                                                             Value="@a.Has(r.Name)"
                                                             ValueChanged="@(v => Choose(a, r.Name, v))"
                                                             Label="@r.Name" />
                                                @if (Tags(r) is { Length: > 0 } tags)
                                                {
                                                    <span class="abom-repo-tags mud-text-secondary mud-typography-caption">@tags</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                    @if (matching.Count > OfferedAtOnce)
                                    {
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block" data-abom-repo-more="@a.Owner">
                                            @(matching.Count - OfferedAtOnce) more match; narrow the filter to see them.
                                        </MudText>
                                    }
                                    else if (matching.Count == 0)
                                    {
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                                            @(answer.Repositories.Count == 0 ? $"GitHub lists no repository in {a.Owner}." : "No repository matches the filter.")
                                        </MudText>
                                    }
                                }
                            </td>
                        </tr>
                    }
                    @if (ScopeEditorOf(a.Owner) is { } editor)
                    {
                        var read = PropertyReadOf(a.Owner);
                        <tr class="abom-include-chooser-row">
                            <td colspan="8" data-abom-scope-editor="@a.Owner">
                                @if (read is null || read.Answer is null && read.Error is null)
                                {
                                    <MudText Typo="Typo.body2">Asking GitHub which custom properties @a.Owner defines&hellip;</MudText>
                                }
                                else if (read.Error is not null || read.Answer?.Problem is not null)
                                {
                                    <div class="d-flex flex-wrap align-center gap-3">
                                        @if (read.Answer?.Problem is { } p)
                                        {
                                            <div>
                                                <MudText Typo="Typo.body2" Class="abom-unconfirmed">@p.Reason</MudText>
                                                <MudText Typo="Typo.body2">@p.Remedy</MudText>
                                            </div>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.body2" Class="abom-unconfirmed">GitHub could not be asked: @read.Error</MudText>
                                        }
                                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => CloseScopeEditor(a))"
                                                   title="Close this panel. Nothing in the draft changes."
                                                   data-abom-scope-editor-done="@a.Owner">Close</MudButton>
                                    </div>
                                }
                                else if (read.Answer is { } answer)
                                {
                                    <div class="d-flex flex-wrap align-center gap-3 mb-1">
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                            Custom properties @a.Owner defines, as your gh token sees them, counted over
                                            @CountText.Of(answer.Repositories, "repository", "repositories"). Archived repositories are left
                                            out, because no listing records them. A repository must carry every value you choose.
                                        </MudText>
                                        <div data-abom-value-filter="@a.Owner">
                                            <SearchField Value="@editor.Filter" ValueChanged="@(v => editor.Filter = v ?? string.Empty)"
                                                         Placeholder="Filter values" />
                                        </div>
                                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => CloseScopeEditor(a))"
                                                   title="Close this panel. Scopes already added stay in the draft until you save or discard it."
                                                   data-abom-scope-editor-done="@a.Owner">Done</MudButton>
                                    </div>
                                    @if (answer.Definitions.Count == 0)
                                    {
                                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@a.Owner defines no custom property.</MudText>
                                    }
                                    <div class="abom-property-choices">
                                        @foreach (var d in answer.Definitions)
                                        {
                                            <div class="abom-property-choice" data-abom-property-choice="@d.Name">
                                                <div>
                                                    <code>@d.Name</code>
                                                    <span class="mud-text-secondary mud-typography-caption">&nbsp;@TypeText(d.ValueType)</span>
                                                </div>
                                                @if (!d.Declarable)
                                                {
                                                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block" data-abom-property-refused>@d.Reason</MudText>
                                                }
                                                else
                                                {
                                                    @if (d.Description.Length > 0)
                                                    {
                                                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@d.Description</MudText>
                                                    }
                                                    var values = d.Values.Where(v => string.IsNullOrWhiteSpace(editor.Filter)
                                                        || v.Value.Contains(editor.Filter.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
                                                    @foreach (var v in values.Take(OfferedAtOnce))
                                                    {
                                                        <div class="abom-repo-option" data-abom-property-value="@v.Value">
                                                            <MudCheckBox T="bool" Dense="true" Size="Size.Small"
                                                                         Value="@editor.Has(d.Name, v.Value)"
                                                                         ValueChanged="@(on => Compose(editor, d, v.Value, on))"
                                                                         Label="@v.Value" />
                                                            <span class="abom-repo-tags mud-text-secondary mud-typography-caption">@CountText.Of(v.Repositories, "repository", "repositories")</span>
                                                            @if (v.IsDefault)
                                                            {
                                                                <span class="abom-repo-tags abom-unconfirmed mud-typography-caption" data-abom-value-default>given to every repository nobody set</span>
                                                            }
                                                        </div>
                                                    }
                                                    @if (values.Count > OfferedAtOnce)
                                                    {
                                                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                                                            @(values.Count - OfferedAtOnce) more values; narrow the filter to see them.
                                                        </MudText>
                                                    }
                                                    else if (values.Count == 0)
                                                    {
                                                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                                                            @(d.Values.Count == 0 ? "No repository carries a value for it." : "No value matches the filter.")
                                                        </MudText>
                                                    }
                                                }
                                            </div>
                                        }
                                    </div>
                                    <div class="d-flex flex-wrap align-center gap-3 mt-2" data-abom-scope-draft>
                                        @if (editor.Composing.Count == 0)
                                        {
                                            <MudText Typo="Typo.body2" Class="mud-text-secondary">Choose the values a repository must carry.</MudText>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.body2">
                                                <span>New scope: repositories carrying </span>@TermsMarkup(editor.Composing)
                                                @if (editor.Composing.Count == 1 && OfferedValue(answer, editor.Composing[0]) is { } only)
                                                {
                                                    <span class="mud-text-secondary">, @CountText.Of(only.Repositories, "repository", "repositories") now</span>
                                                }
                                            </MudText>
                                        }
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                                   Disabled="@(!CanAddScope(a, editor))" OnClick="@(() => AddScope(a, editor))"
                                                   title="Add this scope to the draft, beside the others. Nothing changes until you save."
                                                   data-abom-scope-add>Add this scope</MudButton>
                                        @if (editor.Composing.Count > 0 && !CanAddScope(a, editor))
                                        {
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary" data-abom-scope-duplicate>
                                                This scope is already in the declaration.
                                            </MudText>
                                        }
                                    </div>
                                    @if (ChosenDefaults(answer, editor.Composing) is { Count: > 0 } chosen)
                                    {
                                        <MudText Typo="Typo.caption" Class="abom-unconfirmed d-block mt-1" data-abom-draft-default>
                                            @foreach (var (term, count) in chosen)
                                            {
                                                <span>@term.Name = @term.Value is what @a.Owner gives every repository nobody set otherwise, and @CountText.Of(count, "repository carries", "repositories carry") it now. </span>
                                            }
                                            A scope naming it takes in each of them, and every repository created later, without anyone deciding.
                                        </MudText>
                                    }
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </MudSimpleTable>
    }

    @if (Accounts.Identity.Accounts.Count > 0)
    {
        @* Both folds start closed: a list of every declarable account buries the one row a reader came for. *@
        <div data-abom-memberships class="mb-4">
            <MudText Typo="Typo.subtitle2" Class="mt-4">Accounts gh says you can declare</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-1">
                You are an owner or admin of these. Nothing is declared until you choose one and save.
            </MudText>
            @if (Declarable.Any())
            {
                <div>
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => _declarableOpen = !_declarableOpen)"
                               EndIcon="@(_declarableOpen ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                               aria-expanded="@(_declarableOpen ? "true" : "false")"
                               title="Show or hide the accounts gh reports where you are an owner or admin."
                               data-abom-declarable-toggle>
                        @(_declarableOpen ? "Hide" : "Show") the @CountText.Of(Declarable.Count(), "account", "accounts") you can declare
                    </MudButton>
                </div>
            }
            @* Rendered only once open, so folded means absent rather than present but invisible. *@
            @if (_declarableOpen && Declarable.Any())
            {
                <MudSimpleTable Dense="true" Hover="true" Striped="false"
                                Class="abom-grid abom-table abom-membership-grid mt-1 mb-2">
                    <thead>
                        <tr>
                            <th><HeaderTip Tip="The user or organization gh reports you belong to.">Account</HeaderTip></th>
                            <th><HeaderTip Tip="Whether gh reports this as your user account or an organization.">Kind</HeaderTip></th>
                            <th><HeaderTip Tip="The role gh reports for you in that account.">Role</HeaderTip></th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Declarable)
                        {
                            <tr>
                                <td>@m.Owner</td>
                                <td>@(m.Kind == "user" ? "Your account" : "Organization")</td>
                                <td>@m.Role</td>
                                <td>
                                    <span data-abom-membership="@m.Owner">
                                        @if (InDraft(m.Owner))
                                        {
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary">declared</MudText>
                                        }
                                        else
                                        {
                                            <MudTooltip Text="@($"State that {m.Owner} is yours. Nothing is written until you save.")">
                                                <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                                           OnClick="@(() => Declare(m.Owner, m.Kind))"
                                                           data-abom-declare="@m.Owner">
                                                    Declare
                                                </MudButton>
                                            </MudTooltip>
                                        }
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
            else if (!Declarable.Any())
            {
                <MudText Typo="Typo.body2" Class="mb-2">
                    gh reports no account where you are an owner or admin.
                </MudText>
            }
            @if (Members.Any())
            {
                <div>
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => _membersOpen = !_membersOpen)"
                               EndIcon="@(_membersOpen ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                               aria-expanded="@(_membersOpen ? "true" : "false")"
                               title="Show or hide the accounts gh reports where your role cannot declare them."
                               data-abom-members-toggle>
                        @(_membersOpen ? "Hide" : "Show") @Members.Count() more you belong to without a role that can declare
                    </MudButton>
                </div>
                @if (_membersOpen)
                {
                    <MudSimpleTable Dense="true" Hover="true" Striped="false"
                                    Class="abom-grid abom-table abom-membership-grid mt-1">
                        <tbody>
                            @foreach (var m in Members)
                            {
                                <tr>
                                    <td>@m.Owner</td>
                                    <td>@(m.Kind == "user" ? "Your account" : "Organization")</td>
                                    <td>@m.Role</td>
                                    <td>
                                        <MudTooltip Text="@($"You are a {m.Role} here, which cannot change anything in this account.")"><span data-abom-membership="@m.Owner" class="mud-text-secondary mud-typography-caption">not yours to declare</span></MudTooltip>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
            }
        </div>
    }

    <div class="d-flex flex-wrap align-center gap-3 mb-2">
        <div data-abom-new-owner class="abom-owner-field">
            <MudTextField T="string" Value="_typedOwner" ValueChanged="OnTypedOwnerChanged"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Placeholder="account name" Label="Declare an account by name" />
        </div>
        <MudTooltip Text="For an account gh cannot see. Ownership is stated, not inferred, so this is allowed — it stays flagged as unconfirmed.">
            <MudButton Size="Size.Small" Variant="Variant.Outlined"
                       Disabled="@(string.IsNullOrWhiteSpace(_typedOwner))"
                       OnClick="DeclareTyped" data-abom-declare-typed>
                Declare
            </MudButton>
        </MudTooltip>
    </div>

    @if (_preview is { } p && Dirty)
    {
        <MudAlert Dense="true" Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-2">
            <MudText Typo="Typo.body2">
                @p.RootsNow &rarr; @p.RootsNext repositories declared directly,
                reaching @p.ClosureNow &rarr; @p.ClosureNext,
                with @p.QueuedNow &rarr; @p.QueuedNext queued dependencies.
            </MudText>
            @if (p.LeavingCount > 0)
            {
                <MudText Typo="Typo.body2" Class="mt-1">
                    Leaving (@p.LeavingCount): @string.Join(", ", p.Leaving)@(p.Truncated ? ", …" : "")
                </MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    This work stops. Nothing already analyzed is deleted.
                </MudText>
            }
            @if (p.EnteringCount > 0)
            {
                <MudText Typo="Typo.body2" Class="mt-1">
                    Entering (@p.EnteringCount): @string.Join(", ", p.Entering)@(p.Truncated ? ", …" : "")
                </MudText>
            }
            @if (p.NotJudged > 0)
            {
                <MudText Typo="Typo.body2" Class="mt-1" data-abom-preview-unjudged>
                    @CountText.Of(p.NotJudged, "repository", "repositories") on record could not be judged
                    by a property scope, because no values have been read for
                    @(p.NotJudged == 1 ? "it" : "them"). They neither enter nor stay until a listing of the account reads them.
                </MudText>
            }
            @foreach (var held in p.Held)
            {
                <MudText Typo="Typo.body2" Class="mt-1 abom-unconfirmed" data-abom-preview-held>
                    <span>@held.Owner's scope carrying </span>@TermsMarkup(held.Terms)<span> counts nothing in these
                    figures: @held.Reason.</span>
                </MudText>
            }
            @if (p.Held.Count > 0)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                    Saving reads each organization's custom properties before judging its scopes, and one
                    a property's own settings rule out is refused rather than saved.
                </MudText>
            }
            @* A held scope already says why it counts nothing; this sentence would call that intent. *@
            @if (p.ReachesNothing && _draft.Count > 0 && p.Held.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mt-1">
                    This declaration reaches nothing discovery has found yet. That is a statement of
                    intent rather than a mistake, and every figure stays empty until discovery
                    finds something under it.
                </MudText>
            }
        </MudAlert>
    }

    <div class="d-flex flex-wrap align-center gap-3 mb-6">
        <MudTooltip Text="Write this declaration. It replaces what is stored, and bounds everything discovery does next.">
            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                       Disabled="@(!Dirty || _saving)" OnClick="Save" data-abom-save>
                @(_saving ? "Saving…" : "Save")
            </MudButton>
        </MudTooltip>
        <MudTooltip Text="Throw away these edits and go back to what is stored.">
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="@(!Dirty || _saving)"
                       OnClick="Discard" data-abom-discard>
                Discard
            </MudButton>
        </MudTooltip>
        @if (!Dirty && _saved)
        {
            <span data-abom-next-action>
                @if (Accounts.ScopeDeclared)
                {
                    <MudText Typo="Typo.body2">
                        Saved. Analysis of what these accounts reach starts under
                        <b>How discovery runs</b> below; nothing runs until you press Start.
                    </MudText>
                }
                else
                {
                    <MudText Typo="Typo.body2">Saved. Nothing is declared, so discovery stays stopped.</MudText>
                }
            </span>
        }
        @if (_saveError is not null)
        {
            <MudText Typo="Typo.body2" Class="abom-unconfirmed">@_saveError</MudText>
        }
    </div>

    @if (_enumerating || _enumeration is not null || _enumerateError is not null)
    {
        <MudAlert Dense="true" Variant="Variant.Outlined" Class="mb-6"
                  Severity="@(_enumerateError is not null || _enumeration?.Failed.Count > 0
                                ? Severity.Warning : Severity.Info)">
            <div data-abom-enumeration>
                @if (_enumerating)
                {
                    <MudText Typo="Typo.body2">Asking GitHub what these accounts hold…</MudText>
                }
                else if (_enumerateError is not null)
                {
                    <MudText Typo="Typo.body2">
                        The declaration was saved, but nothing was enumerated: @_enumerateError
                    </MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Until it runs, this declaration bounds what discovery would accept and adds
                        no repository to it.
                    </MudText>
                }
                else if (_enumeration is not null)
                {
                    <MudText Typo="Typo.body2">
                        @CountText.Of(_enumeration.Found, "repository", "repositories")
                        found: @_enumeration.Added new,
                        @_enumeration.Promoted already here as a dependency,
                        @_enumeration.Unchanged unchanged.
                    </MudText>
                    @foreach (var account in _enumeration.Accounts)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block" data-abom-enumerated="@account.Owner">
                            @account.Owner: @CountText.Of(account.Found, "repository", "repositories")@(account.Left > 0
                                ? $", {account.Left:N0} left your property scopes" : "")@(account.PropertiesUnjudged > 0
                                ? $", {account.PropertiesUnjudged:N0} not judged because their property values did not arrive whole" : "")
                        </MudText>
                    }
                    @foreach (var failure in _enumeration.Failed)
                    {
                        <MudText Typo="Typo.caption" Class="abom-unconfirmed d-block">
                            @failure.Owner could not be reached: @failure.Error
                        </MudText>
                    }
                    @if (_enumeration.QueueError is not null)
                    {
                        <MudText Typo="Typo.caption" Class="abom-unconfirmed d-block">
                            Recorded, but not queued for analysis: @_enumeration.QueueError
                        </MudText>
                    }
                    else if (_enumeration.Queued > 0)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                            @_enumeration.Queued queued for analysis. Nothing runs until you press
                            Start in Discovery.
                        </MudText>
                    }
                }
            </div>
        </MudAlert>
    }
}

<MudText Typo="Typo.subtitle2" Class="mt-8 mb-1">How discovery runs</MudText>
<MudText Typo="Typo.body2" Class="mb-3 mud-text-secondary">
    Analysis starts here; what each tier is analyzed with is chosen on the
    <MudLink Href="/codeql?tab=suites"
             title="Open the CodeQL page where each tier's query suites are chosen.">CodeQL page</MudLink>. How far it has got
    is read where the results are: the
    <MudLink Href="/inventory?unit=coverage"
             title="Open the coverage unit showing which dependencies have been analyzed, queued or unavailable.">Coverage unit</MudLink> lists what is analyzed, queued
    and unavailable one dependency at a time, and the
    <MudLink Href="/explore"
             title="Open the Explorer graph colored by analysis coverage.">Explorer</MudLink> colors the graph by it.
</MudText>

<DiscoveryControls LinkToSettings="false" Changed="@(() => Accounts.ReloadScopeAsync())" />

<PoolMeters />

<CodeScanningWrites />

<MudText Typo="Typo.subtitle2" Class="mt-8 mb-1" id="agent-tools">What agent sessions run on</MudText>
<MudText Typo="Typo.body2" Class="mb-3 mud-text-secondary">
    Each check is the server's own, run when this page asked. A path saved here is used ahead of
    <code>--codeql</code>, <code>--copilot-cli</code> and <code>COPILOT_CLI_PATH</code>, and only
    after the server has run it. A Copilot CLI is used from the next session; a CodeQL CLI from the
    next start. <b>Use default</b> forgets the saved path.
</MudText>
<AuthoringReadinessPanel Editable="true" />

@* Raised rather than waited for. The check runs at startup off the request path, and what it
   found is a decision somebody has to make rather than a section they have to go and find.
   Removal is never automatic: this asks, and "Not now" is a complete answer.

   Rendered only while it is open. A MudDialog that is merely invisible still renders its focus
   trap, whose four sentinels are focusable and have no accessible name. *@
@if (_stalePrompt && _staleness is not null)
{
    <MudDialog @ref="_staleDialog" @bind-Visible="_stalePrompt" Options="@(new DialogOptions {
                   CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true })">
        <TitleContent>
            <MudText Typo="Typo.h6">Some of this is no longer reachable from what you own</MudText>
        </TitleContent>
        <DialogContent>
            <MudText Typo="Typo.body2" Class="mb-2" data-abom-stale-summary>
                Checked at startup: your @_staleness.View.Declared declared
                @(_staleness.View.Declared == 1 ? "repository reaches" : "repositories reach")
                @_staleness.View.Reachable. Outside that sit @StaleText(_staleness.View.Removed).
            </MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Removing takes them out of every view and out of the crawl's queue. No analysis is
                deleted, and anything a later analysis finds again comes back.
            </MudText>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="DismissStale"
                       title="Leave this no-longer-reachable work visible and close this prompt."
                       data-abom-stale-dismiss>Not now</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_stalePruning"
                       OnClick="AcceptStale"
                       title="Take what is no longer reachable out of every view and out of the queue, without deleting any analysis."
                       data-abom-stale-accept>
                @(_stalePruning ? "Working\u2026" : "Remove from view")
            </MudButton>
        </DialogActions>
    </MudDialog>
}

<PruneControl />

<MudText Typo="Typo.subtitle2" Class="mt-8 mb-1">Accounts holding repositories discovery started from</MudText>
<MudText Typo="Typo.body2" Class="mb-3 mud-text-secondary">
    Seeded repositories, not analyzed ones &mdash; an account can hold every one of its seeds with
    nothing analyzed yet, which is what the figures above report. Holding one does not make an
    account yours either: <code>actions</code> owns <code>actions/cache</code>, which arrives as a
    seed, and that is why it appears here and why belonging is checked rather than assumed.
</MudText>

@if (_candidates is null)
{
    <MudProgressLinear Indeterminate="true" Class="my-8" />
}
else
{
    <SearchField Value="@_search" ValueChanged="@(v => _search = v)"
                 Placeholder="Filter accounts" Class="mb-3" />

    <MudDataGrid T="OwnerCandidate" Items="Filtered" Dense="true" Hover="true" Bordered="false"
                 SortMode="SortMode.Multiple" Filterable="false" FixedHeader="true"
                 Class="abom-grid abom-grid-windowed" RowsPerPage="25">
        <Columns>
            <TemplateColumn Title="Yours" Sortable="false">
                <HeaderTemplate><HeaderTip Tip="Whether you have declared this account as yours, whole or only some of its repositories.">Yours</HeaderTip></HeaderTemplate>
                <CellTemplate>
                    @if (Accounts.IsDeclared(context.Item.Owner) && Accounts.IsDeclaredInPart(context.Item.Owner))
                    {
                        <MudTooltip Text="Declared in part: only the repositories you named, or that carry a property scope's values, are yours.">
                            <span data-abom-candidate-declared="@context.Item.Owner" data-abom-extent="part">
                                <MudIcon Icon="@Icons.Material.Outlined.Person" Size="Size.Small"
                                         Color="Color.Primary" Class="abom-owned-mark" />
                            </span>
                        </MudTooltip>
                    }
                    else if (Accounts.IsDeclared(context.Item.Owner))
                    {
                        <MudTooltip Text="Declared: you have stated this account is yours.">
                            <span data-abom-candidate-declared="@context.Item.Owner" data-abom-extent="whole">
                                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small"
                                         Color="Color.Primary" Class="abom-owned-mark" />
                            </span>
                        </MudTooltip>
                    }
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.Owner" Title="Account">
                <HeaderTemplate><HeaderTip Tip="An account that holds at least one starting point.">Account</HeaderTip></HeaderTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Repositories" Title="Seeded">
                <HeaderTemplate><HeaderTip Tip="How many starting points discovery has found under this account.">Seeded</HeaderTip></HeaderTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Findings" Title="Findings">
                <HeaderTemplate><HeaderTip Tip="How many findings CodeQL rules reported in this account's starting points.">Findings</HeaderTip></HeaderTemplate>
            </PropertyColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="OwnerCandidate" />
        </PagerContent>
    </MudDataGrid>
}

@code {
    private IReadOnlyList<OwnerCandidate>? _candidates;
    private Staleness? _staleness;
    private MudDialog? _staleDialog;
    private bool _stalePrompt;
    private bool _stalePruning;
    private string _search = string.Empty;
    private bool _checking;
    private AccountProblem? _problem;

    private readonly List<Draft> _draft = [];
    private string _typedOwner = string.Empty;
    private bool _declarableOpen;
    private bool _membersOpen;
    private string? _checkError;
    private ScopePreview? _preview;
    private bool _saving;
    private bool _saved;
    private string? _saveError;
    private bool _enumerating;
    private EnumerationReport? _enumeration;
    private string? _enumerateError;

    // The whole declaration is edited before any of it is written, matching SetOwnedScope, which
    // replaces wholesale. A page sending a diff would be assembling one nobody could check.
    private sealed class Draft
    {
        public string Owner { get; init; } = string.Empty;
        public string Kind { get; init; } = "organization";
        public bool Enabled { get; set; } = true;
        public bool IncludesOnly { get; set; }

        /// <summary>The repositories named, in the order chosen. Kept even when GitHub does not
        /// list one: the declaration is the reader's statement, not the listing's.</summary>
        public List<string> Chosen { get; set; } = [];

        /// <summary>What gh said about the stored row. Server-decided; a row not yet written has
        /// none, because gh has not been asked about a declaration that does not exist.</summary>
        public string State { get; init; } = string.Empty;

        public string DeclaredBy { get; init; } = string.Empty;

        /// <summary>Added in this session and not yet written.</summary>
        public bool IsNew { get; init; }

        public bool Contradicted => State == "contradicted";

        // An unsaved row is not unaccounted for; it is about to be accounted for by the save.
        public bool Unaccounted => !IsNew && string.IsNullOrEmpty(DeclaredBy);

        /// <summary>Property scopes, each the terms a repository must all carry. Edited whole:
        /// a scope is added or removed, never changed in place.</summary>
        public List<List<PropertyTerm>> Clauses { get; set; } = [];

        public bool NamesNothing => Names().Length == 0 && Clauses.Count == 0;

        public bool Has(string repo) => Chosen.Contains(repo, StringComparer.OrdinalIgnoreCase);

        public string[] Names() => Chosen
            .Select(n => n.Trim()).Where(n => n.Length > 0)
            .Distinct(StringComparer.OrdinalIgnoreCase).ToArray();

        // IncludesOnly travels as it was set rather than being derived from Names() being empty:
        // deriving it is exactly how clearing the last include would widen an account to all of
        // its repositories without anyone saying so.
        public DeclaredAccount ToAccount() => new()
        {
            Owner = Owner,
            Kind = Kind,
            Enabled = Enabled,
            IncludesOnly = IncludesOnly,
            Includes = Names(),
            Properties = Clauses.Select(c => new PropertyClause { Terms = [.. c] }).ToList(),
        };
    }

    private IReadOnlyList<DeclaredAccount> DraftAccounts =>
        _draft.Select(d => d.ToAccount()).ToList();

    private bool Dirty => Canonical(DraftAccounts) != Canonical(Accounts.Declared ?? []);

    private static string Canonical(IEnumerable<DeclaredAccount> accounts) =>
        string.Join(";", accounts
            .OrderBy(a => a.Owner, StringComparer.OrdinalIgnoreCase)
            .Select(a => string.Join("|",
                a.Owner.ToLowerInvariant(), a.Kind, a.Enabled, a.IncludesOnly,
                string.Join(",", a.Includes.OrderBy(i => i, StringComparer.OrdinalIgnoreCase)),
                string.Join("+", a.Properties.Select(c => ClauseKey(c.Terms)).Order(StringComparer.Ordinal)))));

    // A value may hold any character, so a scope is keyed by its JSON rather than by a delimiter.
    private static string ClauseKey(IEnumerable<PropertyTerm> terms) =>
        JsonSerializer.Serialize(terms
            .Select(t => new[] { t.Name.ToLowerInvariant(), t.Value })
            .OrderBy(t => t[0], StringComparer.Ordinal).ThenBy(t => t[1], StringComparer.Ordinal));

    private bool InDraft(string owner) =>
        _draft.Any(d => string.Equals(d.Owner, owner, StringComparison.OrdinalIgnoreCase));

    // Your own account first, then by name. Eligibility is the server's answer, never the role read here.
    private IEnumerable<OwnedAccount> Declarable =>
        Accounts.Identity.Accounts.Where(a => a.CanDeclare)
            .OrderByDescending(a => a.Kind == "user")
            .ThenBy(a => a.Owner, StringComparer.OrdinalIgnoreCase);

    private IEnumerable<OwnedAccount> Members =>
        Accounts.Identity.Accounts.Where(a => !a.CanDeclare)
            .OrderBy(a => a.Owner, StringComparer.OrdinalIgnoreCase);

    private OwnedAccount? Membership(string owner) =>
        Accounts.Identity.Accounts.FirstOrDefault(
            a => string.Equals(a.Owner, owner, StringComparison.OrdinalIgnoreCase));

    private EnumerationMarks ListingFor(string owner) =>
        Accounts.Declared?.FirstOrDefault(
            account => string.Equals(account.Owner, owner, StringComparison.OrdinalIgnoreCase))
            ?.Enumeration ?? new();

    // Declarations the server is refusing to honor. Named rather than counted, because the point
    // is for the operator to recognize one they never meant to make.
    private IEnumerable<string> Held =>
        _draft.Where(a => a.Contradicted).Select(a => a.Owner);

    private IEnumerable<OwnerCandidate> Filtered =>
        (_candidates ?? []).Where(c =>
            string.IsNullOrWhiteSpace(_search) ||
            c.Owner.Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await Accounts.EnsureLoadedAsync();
        _problem = Accounts.Identity.Problem;
        SeedDraft();
        // The page's first action, not a GET's side effect: nothing on record means the reader has
        // never been asked about, and asking once per visit keeps a broken gh from re-running.
        if (Accounts.NothingOnRecord && !Accounts.CheckAttempted)
        {
            _ = CheckOnArrival();
        }
        _candidates = await Api.GetOwnerCandidatesAsync();
        _staleness = await Api.GetStalenessAsync();
        // Only a finished check that could measure and found something opens this. A check still
        // running, or one that had no closure to measure against, says nothing at all.
        _stalePrompt = (_staleness?.HasSomethingToRemove ?? false) && !Prompts.Dismissed(_staleness!.CheckedAt);
    }

    // Only what it removes: a prompt reading "0 nodes and 0 edges" left the 4 it did remove unsaid.
    private static string StaleText(PruneRemoval r)
    {
        static string Count(int n, string one, string many) => $"{n:N0} {(n == 1 ? one : many)}";
        var graph = new List<string>();
        if (r.Nodes > 0) graph.Add(Count(r.Nodes, "node", "nodes"));
        if (r.Edges > 0) graph.Add(Count(r.Edges, "edge", "edges"));
        var parts = new List<string>();
        if (graph.Count > 0)
        {
            parts.Add(string.Join(" and ", graph) + (r.Repositories > 0
                ? $" across {Count(r.Repositories, "repository", "repositories")}" : ""));
        }
        if (r.Queued > 0) parts.Add(Count(r.Queued, "queued dependency", "queued dependencies"));
        return string.Join(", and ", parts);
    }

    private async Task DismissStale()
    {
        if (_staleDialog is not null) await _staleDialog.CloseAsync();
        _stalePrompt = false;
        if (_staleness is not null) Prompts.Dismiss(_staleness.CheckedAt);
    }

    private async Task AcceptStale()
    {
        _stalePruning = true;
        try
        {
            await Api.PruneAsync(compact: false);
            // Re-read rather than trusting the response: what is left is what the next decision
            // turns on, and "what did that cost" is a different question.
            _staleness = await Api.GetStalenessAsync();
        }
        finally
        {
            _stalePruning = false;
            await DismissStale();
        }
    }

    private void SeedDraft()
    {
        _draft.Clear();
        foreach (var a in Accounts.Declared ?? [])
        {
            _draft.Add(new Draft
            {
                Owner = a.Owner,
                Kind = a.Kind,
                Enabled = a.Enabled,
                IncludesOnly = a.IncludesOnly,
                Chosen = [.. a.Includes],
                Clauses = a.Properties.Select(c => c.Terms.ToList()).ToList(),
                State = a.State,
                DeclaredBy = a.DeclaredBy,
            });
        }
        _preview = null;
    }

    private async Task Declare(string owner, string kind)
    {
        if (string.IsNullOrWhiteSpace(owner) || InDraft(owner)) return;
        _draft.Add(new Draft { Owner = owner.Trim(), Kind = kind, Enabled = true, IsNew = true });
        await Changed();
    }

    private async Task DeclareTyped()
    {
        var owner = _typedOwner.Trim();
        if (owner.Length == 0) return;
        var known = Membership(owner);
        // An account gh does not report stays declarable, because ownership is stated rather than
        // inferred. One gh *does* report, with a role that can change nothing, is a different
        // answer: gh was asked and said no.
        if (known is { CanDeclare: false })
        {
            _saveError = $"gh reports you as a {known.Role} of {known.Owner}, "
                         + "which cannot change anything there.";
            return;
        }
        _typedOwner = string.Empty;
        await Declare(owner, known?.Kind ?? "organization");
    }

    private void OnTypedOwnerChanged(string value) => _typedOwner = value ?? string.Empty;

    private async Task Undeclare(Draft account)
    {
        _draft.Remove(account);
        await Changed();
    }

    private async Task SetEnabled(Draft account, bool value)
    {
        account.Enabled = value;
        await Changed();
    }

    private async Task SetIncludesOnly(Draft account, bool value)
    {
        account.IncludesOnly = value;
        await Changed();
    }

    private async Task SetIncludesTyped(Draft account, string value)
    {
        account.Chosen = [.. (value ?? string.Empty).Split(
            ',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)];
        await Changed();
    }

    private async Task Choose(Draft account, string repo, bool chosen)
    {
        account.Chosen.RemoveAll(n => string.Equals(n, repo, StringComparison.OrdinalIgnoreCase));
        if (chosen) account.Chosen.Add(repo);
        await Changed();
    }

    private sealed class Listing
    {
        public bool Loading { get; set; }
        public AccountRepositories? Answer { get; set; }
        public string? Error { get; set; }
        public string Filter { get; set; } = string.Empty;
    }

    // Owners whose picker is open, and what GitHub answered for each. Read only once opened.
    private readonly Dictionary<string, Listing> _listings = new(StringComparer.OrdinalIgnoreCase);

    // Enough to recognize what is wanted; a filter narrows the rest rather than a scroll of thousands.
    private const int OfferedAtOnce = 50;

    private Listing? ListingOf(string owner) => _listings.GetValueOrDefault(owner);

    private bool Listed(Draft account, string repo) =>
        ListingOf(account.Owner)?.Answer is { Problem: null } answer
        && answer.Repositories.Any(r => string.Equals(r.Name, repo, StringComparison.OrdinalIgnoreCase));

    private bool Unlisted(Draft account, string repo) =>
        ListingOf(account.Owner)?.Answer is { Problem: null } && !Listed(account, repo);

    private static string Tags(AccountRepository r) => string.Join(" \u00b7 ", new[]
    {
        r.Private ? "private" : null, r.Archived ? "archived" : null, r.Fork ? "fork" : null,
    }.OfType<string>());

    private static IEnumerable<AccountRepository> Matching(Listing listing) =>
        (listing.Answer?.Repositories ?? []).Where(r =>
            string.IsNullOrWhiteSpace(listing.Filter) ||
            r.Name.Contains(listing.Filter.Trim(), StringComparison.OrdinalIgnoreCase));

    private async Task OpenChooser(Draft account)
    {
        var listing = new Listing { Loading = true };
        _listings[account.Owner] = listing;
        try
        {
            listing.Answer = await Accounts.RepositoriesAsync(account.Owner);
        }
        catch (HttpRequestException e)
        {
            listing.Error = e.Message;
        }
        catch (JsonException)
        {
            listing.Error = "the answer could not be read";
        }
        finally
        {
            listing.Loading = false;
        }
    }

    private void CloseChooser(Draft account) => _listings.Remove(account.Owner);

    private sealed class PropertyRead
    {
        public bool Loading { get; set; }
        public AccountProperties? Answer { get; set; }
        public string? Error { get; set; }

        /// <summary>How many repositories carry each scope now, by <see cref="ClauseKey"/>.</summary>
        public Dictionary<string, int> Counts { get; } = new(StringComparer.Ordinal);
    }

    private sealed class ScopeEditor
    {
        public string Filter { get; set; } = string.Empty;

        /// <summary>The scope being built, in the order its values were chosen.</summary>
        public List<PropertyTerm> Composing { get; } = [];

        public bool Has(string name, string value) => Composing.Any(t =>
            string.Equals(t.Name, name, StringComparison.OrdinalIgnoreCase) && t.Value == value);
    }

    // What GitHub last said each organization defines and carries; kept after the panel closes,
    // because the counts it gave are still what the lines show.
    private readonly Dictionary<string, PropertyRead> _propertyReads = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, ScopeEditor> _scopeEditors = new(StringComparer.OrdinalIgnoreCase);

    private PropertyRead? PropertyReadOf(string owner) => _propertyReads.GetValueOrDefault(owner);

    private ScopeEditor? ScopeEditorOf(string owner) => _scopeEditors.GetValueOrDefault(owner);

    // Read from the stored declaration rather than copied into the draft, so a judgement made after
    // the draft was seeded, such as enumeration reading the schema, is what the line shows.
    private PropertyClause? SavedClause(string owner, IReadOnlyList<PropertyTerm> clause) =>
        Accounts.Declared?.FirstOrDefault(a => string.Equals(a.Owner, owner, StringComparison.OrdinalIgnoreCase))
            ?.Properties.FirstOrDefault(c => ClauseKey(c.Terms) == ClauseKey(clause));

    private int? LiveCount(string owner, IReadOnlyList<PropertyTerm> clause) =>
        PropertyReadOf(owner) is { Answer.Problem: null } read && read.Counts.TryGetValue(ClauseKey(clause), out var n)
            ? n : null;

    private static PropertyValueCount? OfferedValue(AccountProperties answer, PropertyTerm term) =>
        answer.Definitions.FirstOrDefault(d => string.Equals(d.Name, term.Name, StringComparison.OrdinalIgnoreCase))
            ?.Values.FirstOrDefault(v => v.Value == term.Value);

    // Either source suffices: the schema recorded when the scope was judged, or what GitHub says
    // now. Warning once too often costs a sentence; once too few hides a scope that grows itself.
    private List<PropertyTerm> DefaultTerms(string owner, IReadOnlyList<PropertyTerm> clause, PropertyClause? saved)
    {
        var recorded = saved?.Defaults ?? [];
        var answer = PropertyReadOf(owner)?.Answer;
        return clause.Where(t =>
            recorded.Contains(t.Name, StringComparer.OrdinalIgnoreCase) ||
            answer is { Problem: null } && OfferedValue(answer, t) is { IsDefault: true }).ToList();
    }

    private static List<(PropertyTerm Term, int Count)> ChosenDefaults(AccountProperties answer, IEnumerable<PropertyTerm> terms) =>
        terms.Select(t => (Term: t, Offered: OfferedValue(answer, t)))
            .Where(x => x.Offered is { IsDefault: true })
            .Select(x => (x.Term, x.Offered!.Repositories)).ToList();

    // The line above already shows the value, which can run to a path; the property is enough.
    private static string DefaultSentence(IReadOnlyList<PropertyTerm> terms) =>
        $"The value of {string.Join(" and ", terms.Select(t => t.Name).Distinct(StringComparer.OrdinalIgnoreCase))} "
        + "here is the organization's default.";

    private static string TypeText(string valueType) => valueType switch
    {
        "single_select" => "one of a list",
        "multi_select" => "any of a list",
        "true_false" => "true or false",
        "string" => "text",
        "url" => "a URL",
        "" => "type not reported",
        _ => valueType,
    };

    private static RenderFragment TermsMarkup(IReadOnlyList<PropertyTerm> terms) => __builder =>
    {
        for (var j = 0; j < terms.Count; j++)
        {
            if (j > 0)
            {
                <span class="mud-text-secondary"> and </span>
            }
            <span class="abom-property-term"><code>@terms[j].Name</code> = <code>@terms[j].Value</code></span>
        }
    };

    private async Task OpenScopeEditor(Draft account)
    {
        _scopeEditors[account.Owner] = new ScopeEditor();
        await CountScopes(account);
    }

    private void CloseScopeEditor(Draft account) => _scopeEditors.Remove(account.Owner);

    // Asks GitHub what the organization defines, and how many repositories carry each drafted scope.
    private async Task CountScopes(Draft account)
    {
        var read = PropertyReadOf(account.Owner) ?? new PropertyRead();
        _propertyReads[account.Owner] = read;
        read.Loading = true;
        read.Error = null;
        var clauses = account.Clauses.Select(c => (IReadOnlyList<PropertyTerm>)c.ToList()).ToList();
        try
        {
            var answer = await Api.ReadAccountPropertiesAsync(account.Owner, clauses);
            read.Answer = answer;
            read.Counts.Clear();
            for (var i = 0; i < clauses.Count && i < answer.ClauseCounts.Count; i++)
            {
                read.Counts[ClauseKey(clauses[i])] = answer.ClauseCounts[i];
            }
        }
        catch (HttpRequestException e)
        {
            read.Error = e.Message;
        }
        catch (JsonException)
        {
            read.Error = "the answer could not be read";
        }
        finally
        {
            read.Loading = false;
        }
    }

    // One value per property, unless the property holds several: no repository can carry two
    // values of one that holds one, so choosing another replaces the first.
    private static void Compose(ScopeEditor editor, PropertyChoice property, string value, bool chosen)
    {
        editor.Composing.RemoveAll(t => string.Equals(t.Name, property.Name, StringComparison.OrdinalIgnoreCase)
                                        && (t.Value == value || !property.MultiSelect));
        if (chosen) editor.Composing.Add(new PropertyTerm { Name = property.Name, Value = value });
    }

    private static bool CanAddScope(Draft account, ScopeEditor editor) =>
        editor.Composing.Count > 0 && account.Clauses.All(c => ClauseKey(c) != ClauseKey(editor.Composing));

    private async Task AddScope(Draft account, ScopeEditor editor)
    {
        if (!CanAddScope(account, editor)) return;
        account.Clauses.Add([.. editor.Composing]);
        editor.Composing.Clear();
        await Changed();
        await CountScopes(account);
    }

    private async Task RemoveScope(Draft account, List<PropertyTerm> clause)
    {
        account.Clauses.Remove(clause);
        await Changed();
    }

    private async Task Changed()
    {
        _saved = false;
        _saveError = null;
        await RefreshPreview();
    }

    private async Task RefreshPreview()
    {
        if (!Dirty)
        {
            _preview = null;
            return;
        }
        try
        {
            _preview = await Api.PreviewOwnedScopeAsync(DraftAccounts);
        }
        catch (HttpRequestException)
        {
            // A preview that cannot be fetched must not block the edit. Saying nothing about the
            // consequence is honest; refusing to let the operator declare would not be.
            _preview = null;
        }
    }

    private async Task Save()
    {
        _saving = true;
        _saveError = null;
        _enumeration = null;
        _enumerateError = null;
        try
        {
            await Api.SetOwnedScopeAsync(DraftAccounts);
            await Accounts.ReloadScopeAsync();
            SeedDraft();
            _saved = true;
        }
        catch (HttpRequestException e)
        {
            _saveError = "The declaration was not saved: " + e.Message;
            return;
        }
        finally
        {
            _saving = false;
        }

        await Enumerate();
    }

    /// <summary>
    /// Turns the saved declaration into repositories.
    ///
    /// It runs after the write rather than beside it: enumerating a scope the server has not been
    /// told about yet would crawl the previous declaration. A failure here leaves the declaration
    /// saved — it is a separate fact and undoing the write would lose an edit the operator made.
    /// </summary>
    private async Task Enumerate()
    {
        _enumerating = true;
        try
        {
            _enumeration = await Api.EnumerateOwnedScopeAsync();
            await Accounts.ReloadScopeAsync();
        }
        catch (HttpRequestException e)
        {
            _enumerateError = e.Message;
        }
        catch (JsonException)
        {
            // The save already succeeded. Letting an unreadable answer take the page down with
            // it would lose the confirmation of an edit that was written.
            _enumerateError = "the answer could not be read";
        }
        finally
        {
            _enumerating = false;
        }
    }

    private async Task Discard()
    {
        SeedDraft();
        _saved = false;
        _saveError = null;
        _enumeration = null;
        _enumerateError = null;
        await Task.CompletedTask;
    }

    private async Task CheckOnArrival()
    {
        await Refresh();
        await InvokeAsync(StateHasChanged);
    }

    private async Task Refresh()
    {
        _checking = true;
        _checkError = null;
        try
        {
            await Accounts.RefreshAsync();
            _problem = Accounts.Identity.Problem;
            // Membership decides the marks, so the list has to be re-read alongside it.
            _candidates = await Api.GetOwnerCandidatesAsync();
        }
        catch (HttpRequestException e)
        {
            // Not gh answering no: the server could not be asked, which the page says as such.
            _checkError = e.Message;
        }
        catch (JsonException)
        {
            _checkError = "the answer could not be read";
        }
        finally
        {
            _checking = false;
        }
    }
}
