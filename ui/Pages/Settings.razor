@page "/settings"
@using Abom.WebAssembly.Models
@using Abom.WebAssembly.Services
@inject AccountService Accounts
@inject DeclarationService Declaration
@inject AbomApi Api
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Settings — ABOM</PageTitle>

<PageHeader Title="Settings">
    What you claim as yours, what discovery does with it, and how ABOM is set up.
</PageHeader>

@* One strip, one part in view, as on the CodeQL page. *@
<div class="abom-units d-flex flex-wrap align-center gap-1 mb-3" role="tablist" data-abom-tabs>
    @foreach (var (key, label, tip) in Tabs)
    {
        <Tip Text="@tip" Placement="Placement.Bottom">
            <MudButton Size="Size.Small" DropShadow="false"
                       Variant="@(_tab == key ? Variant.Filled : Variant.Text)"
                       Color="@(_tab == key ? Color.Primary : Color.Default)"
                       Class="@(_tab == key ? "abom-unit-selected" : null)"
                       role="tab" aria-selected="@(_tab == key ? "true" : "false")"
                       aria-controls="@($"settings-{key}")"
                       OnClick="@(() => Choose(key))" data-abom-tab="@key">
                @label
                @if (Badge(key) is { } badge)
                {
                    <span class="abom-tab-badge" data-abom-tab-badge>@badge</span>
                }
            </MudButton>
        </Tip>
    }
</div>

@* Accounts says it beside Confirm; every other tab says it here, so no figure reads as empty. *@
@if (_tab != TabAccounts)
{
    <DeclarationState />
}

@* The declaration stays drawn while another tab is open, so an edit not yet saved survives a switch;
   leaving Settings still asks before it is lost. *@
<div class="abom-settings-panel" role="tabpanel" id="settings-accounts" hidden="@(_tab != TabAccounts)"
     data-abom-settings-panel="accounts">
    <SettingsAccounts DirtyChanged="@(dirty => _dirty = dirty)" />
</div>

@if (_tab != TabAccounts)
{
    <div class="abom-settings-panel" role="tabpanel" id="@($"settings-{_tab}")" data-abom-settings-panel="@_tab">
        @switch (_tab)
        {
            case TabCodeScanning:
                <CodeScanningWrites />
                break;
            case TabAgentSessions:
                <SettingsAgentSessions />
                break;
            case TabData:
                <PruneControl />
                break;
            case TabYou:
                <WhoYouAre Reader="@(Accounts.Declared is null ? null : Accounts.Identity)" />
                break;
            default:
                <SettingsDiscovery />
                break;
        }
    </div>
}

@code {
    private const string TabDiscovery = "discovery";
    private const string TabAccounts = "accounts";
    private const string TabCodeScanning = "code-scanning";
    private const string TabAgentSessions = "agent-sessions";
    private const string TabData = "data";
    private const string TabYou = "you";

    private static readonly (string Key, string Label, string Tip)[] Tabs =
    [
        (TabDiscovery, "Discovery", "Start and steer the crawl, see what each tier runs, and set what each kind of work may spend."),
        (TabAccounts, "Accounts", "Declare the GitHub accounts and repositories that are yours."),
        (TabCodeScanning, "Code scanning", "Preview and turn on Actions in each declared repository's default setup."),
        (TabAgentSessions, "Agent sessions", "Check and set the tools Copilot authoring sessions run with."),
        (TabData, "Data", "Remove what the declared scope no longer reaches."),
        (TabYou, "You", "See who you are signed in as, your role and what it lets you do."),
    ];

    // Where the page's sections were addressed before it had tabs, so no link into it breaks.
    private static readonly Dictionary<string, string> Anchors = new(StringComparer.Ordinal)
    {
        ["declared-accounts"] = TabAccounts,
        ["agent-tools"] = TabAgentSessions,
        ["you"] = TabYou,
    };

    [SupplyParameterFromQuery(Name = "tab")] public string? TabParam { get; set; }

    private string _tab = TabDiscovery;
    private ScopeDecision? _decision;
    private AuthoringReadiness? _readiness;
    private bool _dirty;

    protected override async Task OnInitializedAsync()
    {
        Accounts.Changed += Redraw;
        Declaration.Changed += Reread;
        _decision = await Declaration.ReadAsync();
        _readiness = await Api.GetAuthoringReadinessAsync();
    }

    // A word on a tab that needs you, so it is found without opening each; never a colour alone.
    private string? Badge(string tab) => tab switch
    {
        TabAccounts when _dirty => "unsaved",
        TabAccounts when DeclarationService.Unconfirmed(_decision) => "confirm",
        TabAgentSessions when _readiness?.FirstProblem is not null => "problem",
        _ => null,
    };

    private void Reread() => _ = InvokeAsync(async () =>
    {
        _decision = await Declaration.ReadAsync();
        StateHasChanged();
    });

    protected override void OnParametersSet()
    {
        var fragment = new Uri(Nav.Uri).Fragment.TrimStart('#');
        _tab = Tabs.Any(t => t.Key == TabParam) ? TabParam!
            : Anchors.TryGetValue(fragment, out var tab) ? tab
            : TabDiscovery;
    }

    private void Choose(string tab)
    {
        _tab = tab;
        Nav.NavigateTo($"/settings?tab={tab}", new NavigationOptions { ReplaceHistoryEntry = true });
    }

    private void Redraw() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Accounts.Changed -= Redraw;
        Declaration.Changed -= Reread;
    }
}
