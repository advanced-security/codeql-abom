@page "/codeql"
@inject NavigationManager Nav

<PageTitle>CodeQL — ABOM</PageTitle>

<PageHeader Title="CodeQL">
    Every finding comes from a CodeQL query. Ask for one, follow each version through its stages,
    see where it ran and what it found, and choose what the crawl runs.
</PageHeader>

@* One strip, one part in view, as with Inventory's units. *@
<div class="abom-units d-flex flex-wrap align-center gap-1 mb-3" role="tablist" data-abom-tabs>
    @foreach (var (key, label, tip) in Tabs)
    {
        <Tip Text="@tip" Placement="Placement.Bottom">
            <MudButton Size="Size.Small" DropShadow="false"
                       Variant="@(_tab == key ? Variant.Filled : Variant.Text)"
                       Color="@(_tab == key ? Color.Primary : Color.Default)"
                       Class="@(_tab == key ? "abom-unit-selected" : null)"
                       role="tab" aria-selected="@(_tab == key ? "true" : "false")"
                       OnClick="@(() => Choose(key))" data-abom-tab="@key">@label</MudButton>
        </Tip>
    }
</div>

@switch (_tab)
{
    case TabCatalog:
        <QueryCatalogView FocusQuery="@(QueryParam ?? string.Empty)" />
        break;
    case TabRuns:
        <AnalysisRuns FocusRun="@(RunParam ?? 0)" />
        break;
    case TabSuites:
        <TierSuites />
        break;
    case TabAudit:
        <AuditLog />
        break;
    default:
        <QueryRequests FocusRequest="@(RequestParam ?? 0)" />
        break;
}

@code {
    private const string TabRequests = "requests";
    private const string TabCatalog = "catalog";
    private const string TabRuns = "runs";
    private const string TabSuites = "suites";
    private const string TabAudit = "audit";

    // Audit sits beside the work it explains, before the crawl's suite controls.
    private static readonly (string Key, string Label, string Tip)[] Tabs =
    [
        (TabRequests, "Requests", "Ask for a new CodeQL query, or a fix to one, from examples."),
        (TabCatalog, "Query catalog", "Every query version ABOM holds, its stage, and where it ran."),
        (TabRuns, "Runs", "Query runs over a scope, and what each found."),
        (TabAudit, "Audit log", "Search recorded agent observations, session permissions and reproduction evidence."),
        (TabSuites, "Suites", "Choose which query suites each crawl tier runs."),
    ];

    [SupplyParameterFromQuery(Name = "tab")] public string? TabParam { get; set; }

    /// <summary>A run to open on arrival, such as the one the Inventory just started.</summary>
    [SupplyParameterFromQuery(Name = "run")] public long? RunParam { get; set; }

    /// <summary>A query to open on arrival, such as the one a request is about.</summary>
    [SupplyParameterFromQuery(Name = "query")] public string? QueryParam { get; set; }

    /// <summary>A request to open on arrival, such as one a catalog row names.</summary>
    [SupplyParameterFromQuery(Name = "request")] public long? RequestParam { get; set; }

    private string _tab = TabRequests;

    protected override void OnParametersSet() =>
        _tab = Tabs.Any(t => t.Key == TabParam) ? TabParam! : TabRequests;

    private void Choose(string tab)
    {
        _tab = tab;
        Nav.NavigateTo($"/codeql?tab={tab}", new NavigationOptions { ReplaceHistoryEntry = true });
    }
}
