@page "/node/{*Key}"
@implements IDisposable
@inject AbomApi Api
@inject NavigationManager Nav
@inject ScopeService Scope
@inject IJSRuntime Js

<PageTitle>@(Key ?? "Node") — ABOM</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_detail is null && IsAccount)
{
    @* An account is drawn in the graph as a roll-up of what it owns rather than something the
       scan recorded, so it has no page of its own. Saying it might be unanalyzed would be
       false: it is on screen precisely because its members were analyzed. *@
    <MudAlert Dense="true" Severity="MudBlazor.Severity.Info" Variant="Variant.Outlined">
        <MudText Typo="Typo.body2">
            <span class="abom-rule">@AccountName</span> is an account, not a dependency.
        </MudText>
        <MudText Typo="Typo.caption">
            It stands for everything it owns rather than for anything recorded in its own right.
            See <MudLink Href="@($"/explore?q={AccountName}")" Typo="Typo.caption"
                         title="Open the Explorer with this account name as the search term.">its dependencies</MudLink>,
            or <MudLink Href="/inventory?ref=tag" Typo="Typo.caption"
                        title="Open Inventory filtered to tag references, so you can review pinning.">how its references are pinned</MudLink>.
        </MudText>
    </MudAlert>
}
else if (_detail is null)
{
    <MudAlert Dense="true" Severity="MudBlazor.Severity.Warning" Variant="Variant.Outlined">
        <MudText Typo="Typo.body2">Nothing here is named <span class="abom-rule">@Key</span>.</MudText>
        <MudText Typo="Typo.caption">
            That is not the same as it being unused: it may sit behind a dependency that has not
            been analyzed. <MudLink Href="/inventory?unit=coverage" Typo="Typo.caption"
                                    title="Open the coverage view in Inventory to see what has been analyzed.">Check coverage</MudLink>.
        </MudText>
    </MudAlert>
}
else
{
    <div class="abom-node-head d-flex flex-wrap align-center gap-3 mb-1">
        <nav class="abom-crumb" aria-label="Where this is listed" data-abom-node-crumb>
            <MudLink Href="@InventoryHref" data-abom-node-inventory
                     title="Open Inventory, keeping the filters it can apply.">Inventory</MudLink>
            @if (ListedIn is { } listed)
            {
                <span class="abom-crumb-sep mud-text-secondary" aria-hidden="true">/</span>
                <MudLink Href="@listed.Href" data-abom-node-unit="@listed.Unit"
                         title="@($"Open the {listed.Label} list, keeping the filters it can apply.")">@listed.Label</MudLink>
            }
            <span class="abom-crumb-sep mud-text-secondary" aria-hidden="true">/</span>
            <MudText Typo="Typo.h5" HtmlTag="h1" Class="abom-title-mono abom-page-title" title="@KindLabel">@_detail.Key</MudText>
        </nav>
        @if (_detail.Owned || !string.IsNullOrEmpty(_detail.Origin))
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                     title="Whose this is: owned where your declaration covers its repository, otherwise how its repository arrived."
                     data-abom-node-origin>
                @OriginText.Of(_detail.Origin, _detail.Owned)
            </MudChip>
        }
        @* The pivot to the graph is a deliberate click, never where a name lands you. Each carries
           the terms its own surface applies; the rest would be refused there. *@
        <MudLink Href="@ExplorerHref" Class="abom-icon-link"
                 title="Open this in the Explorer, with the filters the Explorer can apply."
                 data-abom-node-explorer>
            <MudIcon Icon="@Icons.Material.Outlined.Hub" Size="Size.Small" />
            Open in Explorer
        </MudLink>
    </div>

    <div class="abom-scopebar d-flex flex-wrap align-center gap-2 mb-2">
        <FilterPicker Surface="uses" Changed="OnPickerChanged" />
    </div>

    <div id="abom-node-layout"
         class="abom-node-layout @(FigureBeside ? "abom-node-layout-side" : null) @(FigureBeside && !FigureExpanded ? "abom-node-layout-rail" : null)"
         data-abom-node-layout="@(FigureBeside ? "side" : "top")">
    <div class="abom-node-main">
    @if (DrawsFigure && !FigureBeside)
    {
        <ClosureFigure Key="@_detail.Key" Predicate="@UsesPredicate" Side="false" SideChanged="SetFigureBeside"
                       @bind-Expanded="FigureExpanded" />
    }
    else if (_detail.Kind == "repo")
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3" data-abom-figure-repository>
            A repository runs nothing itself: each of its workflows draws what runs it and what it runs.
        </MudText>
    }

    @if (OnlyTriggered)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3" data-abom-node-triggered>
            Its triggers run this workflow; no <code>uses:</code> line names it, so it has no versions in use and nothing here runs it.
        </MudText>
    }
    else
    {
    <MudPaper Elevation="0" Outlined="true" Class="pa-3 mb-3" data-abom-node-versions>
        <MudText Typo="Typo.subtitle2" HtmlTag="h2">Versions in use</MudText>
        <ActionVersions Key="@_detail.Key" Predicate="@UsesPredicate" ReferenceHref="ReferenceHref" />
    </MudPaper>

    @if (_uses?.Change is { } change)
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-3 mb-3" data-abom-tag-change>
            <MudText Typo="Typo.subtitle2" HtmlTag="h2">If this tag changes</MudText>
            @if (change.Fixed)
            {
                <MudText Typo="Typo.body2">
                    <span class="abom-ref">@change.Reference</span> is a commit, which does not move.
                    Whoever runs it keeps running it until they change the reference themselves.
                </MudText>
            }
            else
            {
                <MudText Typo="Typo.body2" Class="mb-2" data-abom-tag-names-now>
                    @if (change.NamesNow.Length > 0)
                    {
                        <span><span class="abom-ref">@change.Reference</span> names
                            <code title="@change.NamesNow">@CommitText.Short(change.NamesNow)</code> now.</span>
                    }
                    else
                    {
                        <span>Nothing has resolved <span class="abom-ref">@change.Reference</span>, so ABOM has
                            no reading of what it names now.</span>
                    }
                    If it moved, in this scope:
                </MudText>
                @* Never summed: one is a reference to change, the other waits on an intermediary. *@
                <div class="abom-tag-change-groups">
                    @ChangeGroup("direct", "name it themselves and would run the new commit", change.Direct)
                    @ChangeGroup("transitive", "reach it through something they name, and would follow it", change.Transitive)
                    @ChangeGroup("kept", "are kept where they are by a lock until they lock again", change.Kept)
                </div>
            }
        </MudPaper>
    }

    <MudPaper Elevation="0" Outlined="true" Class="pa-3 mb-3" data-abom-node-uses>
        <MudText Typo="Typo.subtitle2" HtmlTag="h2">What <code>uses:</code> this</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
            Not whether a name appears somewhere, but whether something runs it: which repository,
            by which reference, at which commit, through whom, and guarded by what.
            @if (_uses?.Change is null)
            {
                <span data-abom-tag-change-hint>Choose one reference in Versions in use to see who moves if it changes.</span>
            }
        </MudText>
        @if (_usesRefusal is { Length: > 0 })
        {
            <MudAlert Dense="true" Severity="MudBlazor.Severity.Info" Variant="Variant.Outlined"
                      data-abom-uses-refusal>@_usesRefusal</MudAlert>
        }
        else
        {
            <MudDataGrid T="NodeUse" ServerData="LoadUses" @ref="_usesGrid" Dense="true" Hover="true"
                         Bordered="false" SortMode="SortMode.Single" Filterable="false" RowsPerPage="25"
                         ShowColumnOptions="false" FixedHeader="true"
                         Class="abom-grid abom-grid-windowed abom-grid-captioned abom-uses-grid"
                         data-abom-uses-table>
                <Columns>
                    <HierarchyColumn T="NodeUse">
                        <CellTemplate>
                            <MudIconButton Size="Size.Small"
                                           Icon="@(context.Open ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)"
                                           aria-label="@($"Show how {context.Item.Repository} arrives")"
                                           aria-expanded="@(context.Open ? "true" : "false")"
                                           title="@($"{(context.Open ? "Hide" : "Show")} how {context.Item.Repository} reaches this action.")"
                                           OnClick="@(() => context.Actions.ToggleHierarchyVisibilityForItemAsync())"
                                           data-abom-use-detail />
                        </CellTemplate>
                    </HierarchyColumn>
                    <PropertyColumn Property="u => u.Repository" Title="Repository"
                                    HeaderClass="abom-identity-col" CellClass="abom-identity-col">
                        <HeaderTemplate><HeaderTip Tip="The repository that runs this action. Click it to find that repository in the inventory.">Repository</HeaderTip></HeaderTemplate>
                        <CellTemplate>
                            <MudLink Href="@($"/inventory?unit=repositories&q={Uri.EscapeDataString(context.Item.Repository)}")"
                                     Typo="Typo.caption" Class="abom-rule"
                                     title="@($"Find {context.Item.Repository} in the repository inventory.")"
                                     data-abom-use-repository="@context.Item.Repository">
                                @context.Item.Repository
                            </MudLink>
                            @if (context.Item.Origin == "upstream")
                            {
                                <span class="abom-ref ml-1">upstream</span>
                            }
                        </CellTemplate>
                    </PropertyColumn>
                    <PropertyColumn Property="u => u.Reference" Title="Reference">
                        <HeaderTemplate><HeaderTip Tip="The version written after the @@ in the uses: line that brings this action in.">Reference</HeaderTip></HeaderTemplate>
                        <CellTemplate>
                            @if (context.Item.Hops > 0)
                            {
                                <span class="abom-ref" data-abom-use-reference>@CommitText.Reference(context.Item.Reference)</span>
                            }
                        </CellTemplate>
                    </PropertyColumn>
                    <PropertyColumn Property="u => u.Commit" Title="Commit it runs">
                        <HeaderTemplate><HeaderTip Tip="The commit this repository actually runs, either the one the reference points to or the one a lock pins.">Commit it runs</HeaderTip></HeaderTemplate>
                        <CellTemplate>
                            @if (context.Item.Commit.Length > 0)
                            {
                                <code title="@context.Item.Commit" data-abom-use-commit>@CommitText.Short(context.Item.Commit)</code>
                            }
                            else if (context.Item.Hops > 0)
                            {
                                <span class="abom-coverage-unknown"
                                      title="Nothing recorded which commit this reference runs.">not known</span>
                            }
                        </CellTemplate>
                    </PropertyColumn>
                    <PropertyColumn Property="u => u.Locked" Title="Chosen by">
                        <HeaderTemplate><HeaderTip Tip="Whether the reference itself or an actions lock decided which commit runs.">Chosen by</HeaderTip></HeaderTemplate>
                        <CellTemplate>
                            <span data-abom-use-chosen>@ChosenBy(context.Item)</span>
                        </CellTemplate>
                    </PropertyColumn>
                    <PropertyColumn Property="u => u.Hops" Title="Relationship">
                        <HeaderTemplate><HeaderTip Tip="Direct means the repository names this action itself. Transitive means it arrives through another action.">Relationship</HeaderTip></HeaderTemplate>
                        <CellTemplate>
                            <MudTooltip Text="@RelationshipHelp(context.Item)">
                                <span class="abom-ref" data-abom-use-relationship>@RelationshipLabel(context.Item.Hops)</span>
                            </MudTooltip>
                        </CellTemplate>
                    </PropertyColumn>
                    <PropertyColumn Property="u => u.Through" Title="Through">
                        <HeaderTemplate><HeaderTip Tip="For a transitive use, the action that brings this one in.">Through</HeaderTip></HeaderTemplate>
                        <CellTemplate>
                            @if (context.Item.Through.Length > 0)
                            {
                                <MudLink Href="@($"/node/{context.Item.Through}")" Typo="Typo.caption"
                                         Class="abom-rule"
                                         title="@($"Open the details page for {context.Item.Through}.")">@context.Item.Through</MudLink>
                            }
                        </CellTemplate>
                    </PropertyColumn>
                    <PropertyColumn Property="u => u.WorkflowCount" Title="Workflows" CellClass="abom-num">
                        <HeaderTemplate><HeaderTip Tip="How many of the repository's workflows lead to this action.">Workflows</HeaderTip></HeaderTemplate>
                    </PropertyColumn>
                    <PropertyColumn Property="u => u.Lines" Title="uses: lines">
                        <HeaderTemplate><HeaderTip Tip="How many of the repository's own uses: lines name this action. Only a direct use has any.">uses: lines</HeaderTip></HeaderTemplate>
                        <CellTemplate>
                            @if (context.Item.Hops == 1)
                            {
                                <span class="abom-num">@context.Item.Lines</span>
                            }
                            else
                            {
                                <span class="abom-faint" title="It names no reference to this itself, so there is nothing of its own to edit.">—</span>
                            }
                        </CellTemplate>
                    </PropertyColumn>
                    <PropertyColumn Property="u => u.ConditionCount" Title="Conditions">
                        <HeaderTemplate><HeaderTip Tip="How many if: conditions sit on the route to this action. ABOM shows them as written and does not decide whether they hold.">Conditions</HeaderTip></HeaderTemplate>
                        <CellTemplate>
                            @if (context.Item.Conditions.Count == 0)
                            {
                                <span class="mud-text-secondary">none</span>
                            }
                            else
                            {
                                <span title="@string.Join("\n", context.Item.Conditions.Select(c => c.Condition))">
                                    @CountText.Of(context.Item.Conditions.Count, "if:", "if:s")
                                </span>
                            }
                        </CellTemplate>
                    </PropertyColumn>
                </Columns>
                <ChildRowContent>
                    <div class="abom-row-detail" data-abom-use-route="@context.Item.Repository">
                        <div class="abom-path">@string.Join(" → ", context.Item.Path)</div>
                        @if (context.Item.Conditions.Count == 0)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                Every step on this route is unconditional.
                            </MudText>
                        }
                        else
                        {
                            @foreach (var c in context.Item.Conditions)
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    only when <span class="abom-path">@c.Condition</span> — on a step in @c.In
                                </MudText>
                            }
                        }
                        @if (context.Item.Workflows.Count > 0)
                        {
                            <MudText Typo="Typo.caption" Class="d-block mt-1">From</MudText>
                            <ul class="abom-ref-users-list">
                                @foreach (var w in context.Item.Workflows)
                                {
                                    <li><MudLink Href="@($"/node/{w}")" Typo="Typo.caption"
                                                 title="@($"Open the details page for {w}.")">@w</MudLink></li>
                                }
                            </ul>
                        }
                    </div>
                </ChildRowContent>
                <PagerContent>
                    <MudDataGridPager T="NodeUse" />
                </PagerContent>
            </MudDataGrid>
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2" data-abom-uses-said>
                @UsesSummary()
                @if (_uses is { HiddenUpstream: > 0 } u)
                {
                    @(" ")
                    <span data-abom-uses-hidden-upstream>
                        @CountText.Of(u.HiddenUpstream, "upstream repository also runs it and is", "upstream repositories also run it and are")
                        not listed, because nobody here changes them.
                        <MudLink Href="@UpstreamHref" Typo="Typo.caption"
                                 title="Also list the upstream repositories that run this action.">List them too</MudLink>.
                    </span>
                }
                @if (_uses is { Unanalyzed: > 0 } p)
                {
                    @(" ")
                    <span>
                        @CountText.Of(p.Unanalyzed, "queued dependency has", "queued dependencies have") not been
                        analyzed; a route that runs only through one cannot appear here.
                    </span>
                }
            </MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                Conditions are printed exactly as the workflow wrote them. Whether one holds on any
                given run is not something static analysis settles, so ABOM reports the expression
                rather than deciding it.
            </MudText>
        }
    </MudPaper>
    }

    <MudGrid Spacing="3">
        <MudItem xs="12" md="6">
            <MudPaper Elevation="0" Outlined="true" Class="pa-3">
                <MudText Typo="Typo.subtitle2" HtmlTag="h2" GutterBottom="true">Findings by rule</MudText>
                @if (_detail.RulesUnread.Count > 0)
                {
                    <MudText Typo="Typo.caption" Class="abom-coverage-unknown d-block mb-1" data-abom-rules-unread>
                        No findings run has analyzed the commit @string.Join(" and ", _detail.RulesUnread.Select(CommitText.Reference))
                        resolves to, so nothing is known about its code there.
                    </MudText>
                }
                @if (_detail.Rules.Count == 0)
                {
                    @if (_detail.RulesUnread.Count < Scope.Spec.At.Count || Scope.Spec.At.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            No rule fired against this node@(Scope.Spec.At.Count > 0 ? $" at {AtText}" : "").
                        </MudText>
                    }
                }
                else
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-1"
                             data-abom-node-severity>@SeverityText.Summary(NodeSeverity())</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-1">
                        @(Scope.Spec.At.Count > 0
                            ? $"In its own code, at the commit {AtText} resolves to."
                            : "In its own code, at every version analyzed. Versions in use says what each reference's commit carries.")
                    </MudText>
                    @foreach (var r in _detail.Rules)
                    {
                        <div class="d-flex justify-space-between align-center gap-2" data-abom-rule="@r.RuleId">
                            <span class="abom-rule">@r.RuleId</span>
                            <span class="d-flex align-center gap-1 abom-nowrap">
                                @foreach (var source in r.Sources)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                             data-abom-rule-source="@source">@QueryCatalogView.SourceText(source)</MudChip>
                                }
                                @if (r.Unsourced > 0)
                                {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary" data-abom-rule-unsourced>
                                        @(r.Unsourced == r.Count ? "source not recorded" : $"source not recorded for {r.Unsourced}")
                                    </MudText>
                                }
                                <span data-abom-rule-band><SeverityChip Severity="@r.Severity.Worst" /></span>
                                <span class="abom-num">@r.Count</span>
                            </span>
                        </div>
                    }
                }
            </MudPaper>
        </MudItem>

        @if (_detail.Uses.Count > 0 || _detail.UsesUnread.Count > 0)
        {
            <MudItem xs="12" md="6">
                <MudPaper Elevation="0" Outlined="true" Class="pa-3">
                    <MudText Typo="Typo.subtitle2" HtmlTag="h2">Uses @CountText.Of(_detail.Uses.Count, "dependency", "dependencies")</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2" data-abom-uses-at>
                        @(Scope.Spec.At.Count > 0
                            ? $"What this pulls in at {AtText}, as that commit declared it, and how many times."
                            : "What this pulls in, as its most recent analysis declared it, and how many times.")
                    </MudText>
                    @if (_detail.UsesUnread.Count > 0)
                    {
                        <MudText Typo="Typo.caption" Class="abom-coverage-unknown d-block mb-2">
                            Nothing recorded what the commit @string.Join(" and ", _detail.UsesUnread.Select(CommitText.Reference))
                            resolves to uses.
                        </MudText>
                    }
                    <MudSimpleTable Dense="true" Hover="true" Striped="false" FixedHeader="true"
                                    Class="abom-grid abom-table abom-grid-windowed">
                        <thead>
                            <tr>
                                <th><HeaderTip Tip="An action or workflow that this one uses. Click it to open its details.">Dependency</HeaderTip></th>
                                <th><HeaderTip Tip="The versions this one names it by in its uses: lines.">References</HeaderTip></th>
                                <th><HeaderTip Tip="How many uses: lines in this one name that dependency."><code>uses:</code> lines</HeaderTip></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var n in _detail.Uses.Take(25))
                            {
                                <tr>
                                    <td>
                                        <MudLink Href="@($"/node/{n.Key}")" Typo="Typo.caption" Class="abom-rule"
                                                 title="@($"Open the details page for {n.Key}.")">
                                            @n.Key
                                        </MudLink>
                                    </td>
                                    <td><RefList Refs="@n.Refs" Max="3" /></td>
                                    <td class="abom-num">@n.Count</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                    @if (_detail.Uses.Count > 25)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            and @(_detail.Uses.Count - 25) more
                        </MudText>
                    }
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
    </div>
    @if (DrawsFigure && FigureBeside)
    {
        <aside class="abom-node-aside" data-abom-node-aside>
            <ClosureFigure Key="@_detail.Key" Predicate="@UsesPredicate" Side="true" SideChanged="SetFigureBeside"
                           @bind-Expanded="FigureExpanded" />
        </aside>
    }
    </div>
}

@code {
    [Parameter] public string? Key { get; set; }

    /// <summary>Where the reader last put the figure, kept across pages.</summary>
    private const string FigurePlacementKey = "abom.figurePlacement";

    private bool FigureBeside { get; set; }

    /// <summary>
    /// A workflow no uses: line names: only its triggers run it, so it has no versions and no
    /// callers. Decided by the count, never the kind; a workflow can be called by a local path.
    /// </summary>
    private bool OnlyTriggered => _detail is { Kind: "workflow", NamedBy: 0 };

    // Open on arrival, and kept wherever the reader moves the figure.
    private bool FigureExpanded { get; set; } = true;

    /// <summary>Every kind that runs something or is run draws one; owned or not decides the order.</summary>
    private bool DrawsFigure => _detail?.Kind is "workflow" or "reusable_workflow" or "action"
        or "composite_action" or "docker_image";

    private async Task SetFigureBeside(bool beside)
    {
        FigureBeside = beside;
        await Js.InvokeVoidAsync("abomTheme.save", FigurePlacementKey, beside ? "side" : "top");
    }

    private NodeDetail? _detail;
    private bool _loading = true;
    private IReadOnlyList<FilterTerm> _terms = [];
    private MudDataGrid<NodeUse>? _usesGrid;
    private NodeUsesPage? _uses;
    private string? _usesRefusal;
    private string? _loadedKey;
    private string? _loadedAt;

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    /// <summary>
    /// How wide the page must be, in px, for the tables and the figure to share it: narrower, the
    /// figure shrank to text a reader cannot read and the tables lost columns to scrolling.
    /// </summary>
    private const int SideBySideWidth = 1700;

    private bool _placementRead;

    // Read once the page has a body to measure: the reader's choice, or else the room there is.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_placementRead || _detail is null) return;
        _placementRead = true;
        var saved = await Js.InvokeAsync<string?>("abomTheme.load", FigurePlacementKey);
        var beside = saved switch
        {
            "side" => true,
            "top" => false,
            _ => (await Js.InvokeAsync<BoxSize?>("abomTheme.measure", "abom-node-layout"))?.Width >= SideBySideWidth,
        };
        if (beside != FigureBeside)
        {
            FigureBeside = beside;
            StateHasChanged();
        }
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    // Runs on parameter change too, so following a neighbor link reloads rather than sticking.
    protected override async Task OnParametersSetAsync()
    {
        Scope.ReadFrom(Nav.Uri);
        if (_terms.Count == 0)
        {
            _terms = await Api.GetFilterTermsAsync();
        }
        if (Key == _loadedKey && At == _loadedAt) return;
        _loading = true;
        _uses = null;
        _usesRefusal = null;
        await LoadDetail();
        _loading = false;
    }

    // What the node holds and uses is read at the references asked for, so a new one reloads it.
    private async Task LoadDetail()
    {
        _detail = string.IsNullOrEmpty(Key) ? null : await Api.GetNodeAsync(Key, At);
        (_loadedKey, _loadedAt) = (Key, At);
    }

    /// <summary>The scope's references alone, the one term the node's own details apply.</summary>
    private string At => new ViewSpec { At = Scope.Spec.At }.ToQueryString();

    // "v4" or "v4 and v5", for saying which versions a section was read at.
    private string AtText => string.Join(" and ", Scope.Spec.At.Select(CommitText.Reference));

    // A reference chosen in the versions table, or a term set or removed in the bar, is a new
    // address; reading it here is what keeps the page and the address one answer.
    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var before = Scope.ToQueryString();
        Scope.ReadFrom(Nav.Uri);
        if (Scope.ToQueryString() == before) return;
        await InvokeAsync(async () =>
        {
            if (At != _loadedAt) await LoadDetail();
            StateHasChanged();
            if (_usesGrid is not null) await _usesGrid.ReloadServerData();
        });
    }

    private async Task OnPickerChanged()
    {
        Nav.NavigateTo(PageHref(Scope.Spec), new NavigationOptions { ReplaceHistoryEntry = true });
        if (_usesGrid is not null) await _usesGrid.ReloadServerData();
    }

    private string PageHref(ViewSpec spec)
    {
        var query = spec.ToQueryString();
        return $"/node/{Key}" + (query.Length > 0 ? "?" + query : "");
    }

    /// <summary>The scope as the uses surface applies it; the rest stay in the address, named.</summary>
    private string UsesPredicate => Scope.PredicateFor(_terms, "uses");

    private string ReferenceHref(string reference) => PageHref(Scope.Spec with { At = [reference] });

    private string UpstreamHref => PageHref(Scope.Spec with { Origins = ["seed", "upstream"] });

    private string ExplorerHref
    {
        get
        {
            var scope = Scope.PredicateFor(_terms, "graph");
            var selection = "selection=" + Uri.EscapeDataString(_detail?.Key ?? Key ?? "");
            return "/explore?" + (scope.Length > 0 ? scope + "&" : "") + selection;
        }
    }

    private string InventoryHref
    {
        get
        {
            var scope = Scope.PredicateFor(_terms, "inventory");
            return "/inventory" + (scope.Length > 0 ? "?" + scope : "");
        }
    }

    // The list that contains this kind. A kind with no unit has no middle crumb.
    private (string Unit, string Label, string Href)? ListedIn
    {
        get
        {
            var (unit, label) = _detail?.Kind switch
            {
                "workflow" or "reusable_workflow" => ("workflows", "Workflows"),
                "action" or "composite_action" or "docker_image" => ("dependencies", "Actions"),
                "job" => ("jobs", "Jobs"),
                "repo" => ("repositories", "Repositories"),
                _ => ("", ""),
            };
            if (unit.Length == 0) return null;
            var scope = Scope.PredicateFor(_terms, "inventory");
            var query = "unit=" + unit + (scope.Length > 0 ? "&" + scope : "");
            return (unit, label, "/inventory?" + query);
        }
    }

    private static readonly Dictionary<string, string> UsesSortTerms = new()
    {
        ["Repository"] = "repository",
        ["Reference"] = "reference",
        ["Commit"] = "commit",
        ["Locked"] = "locked",
        ["Hops"] = "relationship",
        ["Through"] = "through",
        ["WorkflowCount"] = "workflows",
        ["Lines"] = "lines",
        ["ConditionCount"] = "conditions",
    };

    /// <summary>Asks the server for one page of who uses this, ordered across the whole match.</summary>
    private async Task<GridData<NodeUse>> LoadUses(GridState<NodeUse> state)
    {
        var sort = state.SortDefinitions.FirstOrDefault();
        var term = sort is not null && UsesSortTerms.TryGetValue(sort.SortBy, out var t) ? t : null;
        var (page, refusal) = await Api.GetNodeUsesAsync(Key ?? "", UsesPredicate, state.PageSize,
            state.Page * state.PageSize, term, sort?.Descending ?? false);
        _uses = page;
        _usesRefusal = refusal;
        // The sentence under the grid and the change above it sit outside it, and the grid
        // re-renders only itself.
        StateHasChanged();
        return new GridData<NodeUse> { Items = page?.Items ?? [], TotalItems = page?.Total ?? 0 };
    }

    private string UsesSummary()
    {
        if (_uses is null) return "";
        if (_uses.Total == 0)
        {
            return "Nothing in this scope runs it. That is not the same as unused: anything arriving "
                + "only through a dependency that has not been analyzed cannot appear here.";
        }
        return $"Showing {_uses.Items.Count:N0} of {CountText.Of(_uses.Total, "use", "uses")} in this scope, "
            + "one per repository, reference and commit.";
    }

    private RenderFragment ChangeGroup(string kind, string says, IReadOnlyList<string> repositories) => __builder =>
    {
        <div class="abom-tag-change-group" data-abom-tag-change-group="@kind">
            <MudText Typo="Typo.body2">
                <b>@repositories.Count</b> @says.
            </MudText>
            @if (repositories.Count > 0)
            {
                <div class="d-flex flex-wrap gap-1">
                    @foreach (var r in repositories.Take(60))
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@r</MudChip>
                    }
                    @if (repositories.Count > 60)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary align-self-center">
                            and @(repositories.Count - 60) more
                        </MudText>
                    }
                </div>
            }
        </div>
    };

    // What chose the commit: a lock binding this repository, or the reference itself. Nothing
    // recorded is said as such rather than read as either.
    private static string ChosenBy(NodeUse u) =>
        u.Hops == 0 ? "" : u.Locked ? "a lock" : u.Commit.Length > 0 ? "the reference" : "nothing recorded";

    private static string RelationshipLabel(int hops) => hops switch
    {
        0 => "lives here",
        1 => "direct",
        _ => "transitive",
    };

    // Zero hops is not a shorter route; it is the absence of one. Drawing it as "direct" would
    // say the repository calls itself.
    private static string RelationshipHelp(NodeUse u) => u.Hops switch
    {
        0 => "It is in this repository, so it runs without depending on anything.",
        1 => "This repository names it itself, so the reference is its own to change.",
        _ => $"Arrives through {u.Hops - 1} intermediaries somebody else may own.",
    };

    private string KindLabel =>
        ThemeService.KindNames.TryGetValue(_detail?.Kind ?? string.Empty, out var n)
            ? n : (_detail?.Kind ?? string.Empty);

    private SeverityCounts NodeSeverity() => new()
    {
        Critical = _detail!.Rules.Sum(r => r.Severity.Critical),
        High = _detail.Rules.Sum(r => r.Severity.High),
        Medium = _detail.Rules.Sum(r => r.Severity.Medium),
        Low = _detail.Rules.Sum(r => r.Severity.Low),
        Unknown = _detail.Rules.Sum(r => r.Severity.Unknown),
    };

    // The graph draws an account as a node, so its key can be followed here like any other.
    private bool IsAccount => Key?.StartsWith("org:", StringComparison.Ordinal) ?? false;

    private string AccountName => IsAccount ? Key!["org:".Length..] : string.Empty;
}
