@page "/inventory"
@implements IDisposable
@inject AbomApi Api
@inject NavigationManager Nav
@inject ScopeService Scope
@inject ThemeService Theme
@inject AccountService Accounts
@inject RunDraft Draft

<PageTitle>Inventory — ABOM</PageTitle>

@* The heading follows the unit. A third unit added while this asked about two put advisories
   under a paragraph about external dependencies, and every test stayed green. *@
<PageHeader Title="@UnitLabel(_unit)">
    @if (_unit == UnitRepositories)
    {
        @("The repositories you own, most findings first. Advisory routes are split because only " +
          "the direct ones are this repository's own to close — the rest wait on an intermediary.")
    }
    else if (_unit == UnitAdvisories)
    {
        @("Published advisories that reach something you own, ranked by severity against how many " +
          "repositories reach them. The rank is a scheduling aid, not a judgement: both inputs " +
          "stay on screen so you can disagree with it.")
    }
    else if (_unit == UnitWorkflows)
    {
        @("The workflows and reusable workflows in your repositories, most findings first. These " +
          "are what runs, so they are measured by what they contain and what they reach out to — " +
          "nothing depends on a workflow, which is why reach is not a column here.")
    }
    else if (_unit == UnitJobs)
    {
        @("Every job, privileged ones first. A job is where permissions, the runner and the " +
          "triggering events are decided, so these are recorded against the job rather than " +
          "inferred from the workflow around it.")
    }
    else
    {
        @("Every action, composite action and image the organization depends on, widest reach " +
          "first. Origin says whose each one is. The advisory count is how many published " +
          "advisories name the component's repository, not a claim that the references below " +
          "fall inside them.")
    }
</PageHeader>

@* One scope bar. Five stacked control rows put the first data row at y=580 of a 900px viewport,
   so the named views became a menu and the unit switch became the tab strip below. *@
<div class="abom-scopebar d-flex flex-wrap align-center gap-2 mb-2">
    @* Every term this unit applies, behind one button. A control per term costs the width of what
       could be asked rather than what is, and the unit decides which are even offerable. *@
    <FilterPicker Surface="@UnitSurface" Changed="OnPickerChanged" />

    @* A view is a predicate, so choosing one sets the scope rather than navigating anywhere.
       Chips rather than a menu, for the reason the exports are not in one either: MudMenu renders
       its items only once opened, so what is on offer is neither discoverable nor checkable. One
       this unit cannot draw is disabled with the reason, since the refusal it would otherwise
       raise arrives one click too late to help. *@
    <div class="abom-views d-flex flex-wrap align-center gap-1" data-abom-views="1">
        @foreach (var view in _views)
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                     Color="@(IsSelected(view) ? Color.Primary : Color.Default)"
                     Class="@(IsSelected(view) ? "abom-view-selected" : null)"
                     Disabled="@(view.ListingRefuses.Count > 0)"
                     title="@Undrawable(view)"
                     OnClick="@(() => ChooseView(view))"
                     data-abom-view="@view.Name">@view.Label</MudChip>
            @* A built-in is code: the server refuses to delete it, so offering the control would
               be an affordance that cannot work. *@
            @if (!view.Builtin)
            {
                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.Close"
                               aria-label="@($"Forget {view.Label}")"
                               OnClick="@(() => ForgetView(view))"
                               data-abom-forget-view="@view.Name" />
            }
        }
    </div>

    <MudTextField T="string" @bind-Value="_scopeName" Placeholder="Name this scope"
                  Immediate="true" Margin="Margin.Dense"
                  Variant="Variant.Outlined" Class="abom-scope-name"
                  data-abom-scope-name="1" />
    <MudButton Size="Size.Small" DropShadow="false" Variant="Variant.Outlined"
               StartIcon="@Icons.Material.Outlined.BookmarkAdd" OnClick="SaveScope"
               Disabled="@(_scopeName.Trim().Length == 0 || Scope.ToQueryString().Length == 0)"
               data-abom-save-scope="1">Keep</MudButton>

    <MudSpacer />

    @* Two kinds of action, kept apart because they answer to different things. These describe the
       scope and are the same document from every unit, so they say so rather than appearing to
       describe the rows underneath them — and with nothing narrowed there is no scope to describe,
       so the label would be claiming a narrowing that does not exist. *@
    @if (HasScope)
    {
        <span class="abom-scope-actions d-flex align-center gap-1" data-abom-scope-actions>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">this scope:</MudText>
            @* A document narrows by grouping and nothing else, so an export under a scope it
               cannot apply is refused here rather than dropped. The endpoint refuses the same
               terms by name; this is the half that stops a broken download being offered. *@
            <span data-abom-action-reason="bom" title="@ExportRefusal">
                <MudButton Size="Size.Small" DropShadow="false" Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Outlined.Inventory2"
                           Disabled="@(ExportRefusal.Length > 0)"
                           Href="@(ExportRefusal.Length > 0 ? null : BomUrl("cyclonedx"))"
                           Target="_blank" data-abom-action="bom-cyclonedx">
                    CycloneDX
                </MudButton>
                <MudButton Size="Size.Small" DropShadow="false" Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Outlined.Inventory2"
                           Disabled="@(ExportRefusal.Length > 0)"
                           Href="@(ExportRefusal.Length > 0 ? null : BomUrl("spdx"))"
                           Target="_blank" data-abom-action="bom-spdx">
                    SPDX
                </MudButton>
            </span>
        </span>
    }

    @* And this one means *these rows*, so it belongs to the unit and is refused where the unit's
       rows are not things the graph draws. The reason sits on a span outside the button: a
       disabled MudButton suppresses pointer events on its children, so a tooltip inside one never
       fires — and that is the tooltip a reader needs most. *@
    <span data-abom-action-reason="open-in-explorer" title="@GraphActionReason">
        <MudButton Size="Size.Small" DropShadow="false" Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Outlined.Hub"
                   Disabled="@(!UnitDrawsInGraph(_unit))"
                   Href="@(UnitDrawsInGraph(_unit) ? $"/explore?{Scope.ToQueryString()}" : null)"
                   data-abom-action="open-in-explorer">
            Show in Explorer
        </MudButton>
    </span>

    @* Only units whose rows are or live in repositories have a database to run against. *@
    <span data-abom-action-reason="run-queries" title="@RunActionReason">
        <MudButton Size="Size.Small" DropShadow="false" Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Outlined.PlayArrow"
                   Disabled="@(!UnitRunsQueries(_unit) || _choosing)"
                   OnClick="StartChoosing" data-abom-action="run-queries">
            Run queries
        </MudButton>
    </span>
</div>

@if (_choosing && UnitRunsQueries(_unit))
{
    <MudPaper Outlined="true" Class="pa-3 mb-3" data-abom-run-draft>
        <div class="d-flex flex-wrap align-center gap-2">
            <MudText Typo="Typo.body2">Run</MudText>
            @foreach (var q in _picked)
            {
                @* A named button: MudChip's close icon cannot be named and reads as "Close". *@
                <span class="d-inline-flex align-center" data-abom-run-picked="@q.QueryId">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                        @q.QueryId <code class="ml-1">@Short(q.QueryVersion)</code>
                    </MudChip>
                    <MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small"
                                   OnClick="@(() => Unpick(q))"
                                   aria-label="@($"Remove {q.QueryId} from the run")" />
                </span>
            }
            <div class="abom-run-add">
                <MudSelect T="string" Value="@string.Empty" ValueChanged="Pick" Dense="true"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           Placeholder="@(_picked.Count == 0 ? "Choose a query" : "Add a query")"
                           aria-label="Add a query version to the run">
                    @foreach (var q in _runnable.Where(r => !_picked.Any(p => SameVersion(p, r))))
                    {
                        <MudSelectItem T="string" Value="@VersionKey(q)">@q.QueryId @Short(q.QueryVersion)</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <MudText Typo="Typo.body2" data-abom-run-chosen>
                on @CountText.Of(_chosen.Count, "chosen repository", "chosen repositories")
            </MudText>
            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" DropShadow="false"
                       Disabled="@(!CanStartRun)" OnClick="StartRun" data-abom-run-go>Run</MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" DropShadow="false"
                       OnClick="StopChoosing" data-abom-run-discard>Cancel</MudButton>
        </div>
        @if (_runRefusal is { Length: > 0 } refusedRun)
        {
            <MudAlert Severity="MudBlazor.Severity.Warning" Dense="true" Class="mt-2">@refusedRun</MudAlert>
        }
    </MudPaper>
}

@* Extended narrows the findings and nothing else, so the numbers that stay regular say so. Left
   unsaid, a reader takes every figure on the page for the shape they just chose. *@
@if (Scope.Spec.Mode == "extended")
{
    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2" data-abom-mode-caveat>
        Coverage and dependency reach use regular analysis.
    </MudText>
}

@if (_writeError is { Length: > 0 } wrote)
{
    <MudAlert Severity="MudBlazor.Severity.Warning" Dense="true" Class="mb-3">
        This scope could not be saved: @wrote
    </MudAlert>
}

@if (_refusal is { Length: > 0 } refused)
{
    <MudAlert Severity="MudBlazor.Severity.Warning" Dense="true" Class="mb-3">@refused</MudAlert>
}

@* One scope, reprojected. A unit is a node kind and its columns are its own: listing workflows
   through the actions grid drew reach, total refs and distinct refs as zero for 1,107 of 1,585
   rows, because a workflow is a consumer and nothing depends on it. *@
<div class="abom-units d-flex flex-wrap align-center gap-1 mb-3" role="tablist">
    @foreach (var (key, label) in Units)
    {
        <MudButton Size="Size.Small" DropShadow="false"
                   Variant="@(_unit == key ? Variant.Filled : Variant.Text)"
                   Color="@(_unit == key ? Color.Primary : Color.Default)"
                   Class="@(_unit == key ? "abom-unit-selected" : null)"
                   OnClick="@(() => ChooseUnit(key))"
                   data-abom-unit="@key">@label</MudButton>
    }
</div>

@if (_unit == UnitDependencies)
{
<MudDataGrid T="ActionSummary" ServerData="LoadPage" @ref="_grid" Dense="true" Hover="true"
             Bordered="false" SortMode="SortMode.Single" Filterable="false" RowsPerPage="30"
             ShowColumnOptions="false" FixedHeader="true" Class="abom-grid abom-grid-windowed abom-grid-captioned">
    <Columns>
        <TemplateColumn Title="" Sortable="false" Hidden="@(!_choosing)" CellClass="abom-row-actions">
            <CellTemplate>
                @if (RepositoryOf(context.Item) is { Length: > 0 } repository)
                {
                    @ChooseBox(repository)
                }
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.NodeKey" Title="Name"
                        HeaderClass="abom-identity-col" CellClass="abom-identity-col">
            <CellTemplate>
                @* A name goes to the thing itself. The graph is a pivot you choose, not
                   somewhere a list drops you. *@
                <IdentityCell Reference="@context.Item.NodeKey"
                              Href="@($"/node/{Uri.EscapeDataString(context.Item.NodeKey)}")" />
            </CellTemplate>
        </PropertyColumn>

        <TemplateColumn Title="" Sortable="false" HeaderClass="abom-row-actions-head"
                        CellClass="abom-row-actions">
            <CellTemplate>
                <RowActions NodeKey="@context.Item.NodeKey" />
            </CellTemplate>
        </TemplateColumn>

        <PropertyColumn Property="x => x.Kind" Title="Type">
            <CellTemplate>
                <MudText Typo="Typo.caption">@TypeLabel(context.Item.Kind)</MudText>
            </CellTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.Origin" Title="Origin">
            <CellTemplate>
                <MudText Typo="Typo.caption">
                    @(context.Item.Origin switch
                    {
                        "seed" => "starting point",
                        "upstream" => "upstream",
                        _ => "external",
                    })
                </MudText>
            </CellTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.DependentRepos" Title="Repos reached" />
        <PropertyColumn Property="x => x.DirectDependents" Title="Total refs" />

        @* One action pinned at forty commits is forty upgrade decisions, which a total
           reference count hides entirely. *@
        <PropertyColumn Property="x => x.DistinctRefs" Title="Distinct refs">
            <CellTemplate>
                <MudTooltip Text="How many different references point at this. Each one is a separate decision to make.">
                    <span class="abom-num">@context.Item.DistinctRefs</span>
                </MudTooltip>
            </CellTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.Findings" Title="Findings" />

        <PropertyColumn Property="x => x.Advisories" Title="Advisories">
            <CellTemplate>
                @if (context.Item.Advisories > 0)
                {
                    <MudTooltip Text="Published advisories naming this repository. Compare the ranges against the references before concluding anything.">
                        <span class="abom-num">@context.Item.Advisories</span>
                    </MudTooltip>
                }
                else
                {
                    <span class="abom-faint">0</span>
                }
            </CellTemplate>
        </PropertyColumn>

        @* Whether the dependency itself was expanded decides if anything downstream is known. *@
        <PropertyColumn Property="x => x.Analyzed" Title="Analyzed">
            <CellTemplate>
                @if (context.Item.Analyzed)
                {
                    <MudText Typo="Typo.caption">yes</MudText>
                }
                else
                {
                    <MudTooltip Text="This dependency has not been analyzed, so whatever it pulls in is missing from this interface.">
                        <MudText Typo="Typo.caption" Class="abom-coverage-unknown">not yet</MudText>
                    </MudTooltip>
                }
            </CellTemplate>
        </PropertyColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="ActionSummary" />
    </PagerContent>
</MudDataGrid>
}

@* A workflow's columns are about what it contains and what it reaches out to, never about being
   reached: nothing depends on a workflow, which is why it left the actions grid. *@
@if (_unit == UnitWorkflows)
{
    <MudDataGrid T="WorkflowRow" ServerData="LoadWorkflows" @ref="_workflowGrid" Dense="true"
                 Hover="true" Bordered="false" SortMode="SortMode.Single" Filterable="false"
                 RowsPerPage="30" ShowColumnOptions="false" FixedHeader="true" Class="abom-grid abom-grid-windowed abom-grid-captioned">
        <Columns>
            <PropertyColumn Property="x => x.NodeKey" Title="Workflow">
                <CellTemplate>
                    <MudTooltip Text="@context.Item.Path">
                        <MudLink Href="@($"/node/{Uri.EscapeDataString(context.Item.NodeKey)}")"
                                 Class="abom-rule abom-trunc">@WorkflowLabel(context.Item)</MudLink>
                    </MudTooltip>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Repository" Title="Repository" />
            <PropertyColumn Property="x => x.Triggers" Title="Runs on">
                <CellTemplate>
                    @if (context.Item.Triggers.Length > 0)
                    {
                        @* Space after each comma so the list wraps between events. *@
                        <span class="abom-ref abom-triggers">@context.Item.Triggers.Replace(",", ", ")</span>
                    }
                    else
                    {
                        @* Absent is not "no triggers": nothing stated them for this workflow. *@
                        <MudTooltip Text="Nothing recorded the events for this workflow.">
                            <span class="abom-coverage-unknown">not recorded</span>
                        </MudTooltip>
                    }
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Jobs" Title="Jobs" />
            <PropertyColumn Property="x => x.Steps" Title="Steps" />
            <PropertyColumn Property="x => x.Dependencies" Title="Dependencies" />
            @* A count, not a flag: two of nine privileged jobs is a different situation from nine
               of nine, and a yes/no reports them alike. *@
            <PropertyColumn Property="x => x.PrivilegedJobs" Title="Privileged jobs">
                <CellTemplate>
                    @if (context.Item.PrivilegedJobs > 0)
                    {
                        <MudTooltip Text="@($"{context.Item.PrivilegedJobs} of {context.Item.Jobs} jobs run with write access or secrets.")">
                            <span class="abom-num">@context.Item.PrivilegedJobs</span>
                        </MudTooltip>
                    }
                    else
                    {
                        <span class="abom-faint">0</span>
                    }
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Findings" Title="Findings" />
        </Columns>
        <PagerContent>
            <MudDataGridPager T="WorkflowRow" />
        </PagerContent>
    </MudDataGrid>
}

@* Every fact the extraction records about a job is recorded against the job, so nothing here is
   aggregated and nothing is inferred from a sibling. *@
@if (_unit == UnitJobs)
{
    <MudDataGrid T="JobRow" ServerData="LoadJobs" @ref="_jobGrid" Dense="true"
                 Hover="true" Bordered="false" SortMode="SortMode.Single" Filterable="false"
                 RowsPerPage="30" ShowColumnOptions="false" FixedHeader="true" Class="abom-grid abom-grid-windowed abom-grid-captioned">
        <Columns>
            <PropertyColumn Property="x => x.JobId" Title="Job">
                <CellTemplate>
                    @* Bounded, because a job id is written by whoever wrote the workflow and some
                       are sentences. Unbounded it pushed five columns off the edge at 1280px. *@
                    <MudTooltip Text="@context.Item.JobId">
                        <span class="abom-trunc">@context.Item.JobId</span>
                    </MudTooltip>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Workflow" Title="Workflow">
                <CellTemplate>
                    <IdentityCell Reference="@context.Item.Workflow"
                                  Href="@($"/node/{Uri.EscapeDataString(context.Item.Workflow)}")" />
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.RunsOn" Title="Runner">
                <CellTemplate>
                    @if (context.Item.RunsOn.Length > 0)
                    {
                        <MudTooltip Text="@context.Item.RunsOn">
                            <span class="abom-ref abom-trunc">@context.Item.RunsOn</span>
                        </MudTooltip>
                    }
                    else
                    {
                        @* A job that calls a reusable workflow has no runner of its own: the
                           called workflow decides. Blank would read as "no runner". *@
                        <MudTooltip Text="This job calls another workflow, which chooses the runner.">
                            <span class="abom-faint">decided elsewhere</span>
                        </MudTooltip>
                    }
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Privileged" Title="Privileged">
                <CellTemplate>
                    @if (context.Item.Privileged)
                    {
                        <MudTooltip Text="This job can write to the repository or read its secrets.">
                            <span class="abom-num">yes</span>
                        </MudTooltip>
                    }
                    else
                    {
                        <span class="abom-faint">no</span>
                    }
                </CellTemplate>
            </PropertyColumn>
            @* Headers carry the prose and the cells hold one word, so the header was setting the
               width: the two below spelled out cost 73px and put Findings — the column this grid
               sorts by — off the right-hand edge at 1280px. *@
            <PropertyColumn Property="x => x.ExternallyTriggerable" Title="External">
                <CellTemplate>
                    <MudTooltip Text="A trigger somebody outside the repository can fire.">
                        <span class="@(context.Item.ExternallyTriggerable ? "abom-num" : "abom-faint")">
                            @(context.Item.ExternallyTriggerable ? "yes" : "no")
                        </span>
                    </MudTooltip>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.PermissionsScope" Title="Permissions">
                <CellTemplate>
                    <MudTooltip Text="Where this job's permissions are set: on the job, on the workflow, or left at the default.">
                        <span class="abom-trunc">@context.Item.PermissionsScope</span>
                    </MudTooltip>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Steps" Title="Steps" />
            <PropertyColumn Property="x => x.Dependencies" Title="Dependencies" />
            <PropertyColumn Property="x => x.Findings" Title="Findings" />
        </Columns>
        <PagerContent>
            <MudDataGridPager T="JobRow" />
        </PagerContent>
    </MudDataGrid>
}

@if (_unit == UnitRepositories)
{
    <MudDataGrid T="RepositorySummary" ServerData="LoadRepositories" @ref="_repoGrid" Dense="true"
                 Hover="true" Bordered="false" SortMode="SortMode.Single" Filterable="false"
                 RowsPerPage="30" ShowColumnOptions="false" FixedHeader="true" Class="abom-grid abom-grid-windowed abom-grid-captioned">
        <Columns>
            <TemplateColumn Title="" Sortable="false" Hidden="@(!_choosing)" CellClass="abom-row-actions">
                <CellTemplate>@ChooseBox(context.Item.FullName)</CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.FullName" Title="Repository">
                <CellTemplate>
                    <MudLink Href="@($"/inventory?unit=repositories&q={Uri.EscapeDataString(context.Item.FullName)}")" Class="abom-rule">
                        @context.Item.FullName
                    </MudLink>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Workflows" Title="Workflows" />
            <PropertyColumn Property="x => x.Dependencies" Title="Dependencies" />
            <PropertyColumn Property="x => x.Findings" Title="Findings" />
            @* Direct is the half this repository can fix itself; the rest wait on an
               intermediary, and collapsing the two would say every route is theirs to close. *@
            <PropertyColumn Property="x => x.DirectExposures" Title="Direct advisory routes" />
            <PropertyColumn Property="x => x.Exposures" Title="All advisory routes" />
        </Columns>
        <PagerContent>
            <MudDataGridPager T="RepositorySummary" />
        </PagerContent>
    </MudDataGrid>
}

@if (_unit == UnitAdvisories)
{
    <MudDataGrid T="RemediationItem" ServerData="LoadAdvisories" @ref="_advisoryGrid" Dense="true"
                 Hover="true" Bordered="false" SortMode="SortMode.None" Filterable="false"
                 RowsPerPage="30" ShowColumnOptions="false" FixedHeader="true" Class="abom-grid abom-grid-windowed abom-grid-captioned">
        <Columns>
            <PropertyColumn Property="x => x.Priority" Title="Score">
                <CellTemplate>
                    <MudTooltip Text="Published severity multiplied by how many repositories reach it. CVSS and EPSS are context and are deliberately not part of this.">
                        <span class="abom-num">@context.Item.Priority</span>
                    </MudTooltip>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Severity" Title="Severity">
                <CellTemplate><SeverityChip Severity="@context.Item.Severity" /></CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.GhsaId" Title="Advisory">
                <CellTemplate>
                    <MudLink Href="@($"https://github.com/advisories/{context.Item.GhsaId}")"
                             Target="_blank" Class="abom-rule">@context.Item.GhsaId</MudLink>
                </CellTemplate>
            </PropertyColumn>
            @* Direct and transitive are different work: one is a version bump here, the other
               waits on somebody else. One combined figure would say they are the same job. *@
            <PropertyColumn Property="x => x.DirectRepos" Title="Direct" />
            <PropertyColumn Property="x => x.TransitiveRepos" Title="Transitive" />
            <PropertyColumn Property="x => x.Summary" Title="Summary" />
        </Columns>
        <PagerContent>
            <MudDataGridPager T="RemediationItem" />
        </PagerContent>
    </MudDataGrid>

    @* The exclusion is correct — these name actions only upstream repositories' own CI uses — and
       it was invisible, which is how a critical one went missing between a strip and a table. *@
    @if (_unreached > 0)
    {
        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">
            @_unreached.ToString("N0") more live @(_unreached == 1 ? "advisory names an action" :
            "advisories name actions") nothing you own uses, so @(_unreached == 1 ? "it is" :
            "they are") not listed here. Not a judgement that @(_unreached == 1 ? "it" : "they")
            cannot matter — no route from anything you own reaches
            @(_unreached == 1 ? "it" : "them") today.
        </MudText>
    }
}

@* A row is a line in a file, not a thing in the corpus. Its columns are the relationship's own —
   what declares it, what it crosses, how its reference is written, and what was reported against
   the line itself — and no other unit carries any of them. *@
@if (_unit == UnitRelationships)
{
    <MudDataGrid T="RelationshipSummary" ServerData="LoadRelationships" @ref="_relationshipGrid"
                 Dense="true" Hover="true" Bordered="false" SortMode="SortMode.None"
                 Filterable="false" RowsPerPage="30" ShowColumnOptions="false" FixedHeader="true"
                 Class="abom-grid abom-grid-windowed abom-grid-captioned-twice">
        <Columns>
            @* Both endpoints go through IdentityCell, which exists because an unbounded key
               pushes the counts off the edge — measured here at 380px over, with five of six
               columns hidden. *@
            <PropertyColumn Property="x => x.Source" Title="Declared by">
                <CellTemplate>
                    <IdentityCell Reference="@context.Item.Source" />
                    @if (context.Item.FilePath.Length > 0)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block abom-trunc">
                            @($"{context.Item.FilePath}:{context.Item.StartLine}")
                        </MudText>
                    }
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Target" Title="Points at">
                <CellTemplate>
                    <IdentityCell Reference="@context.Item.Target" />
                    @* Absent is not a fourth class: an edge whose ends nobody could name has no
                       boundary, which is different from staying inside one repository. *@
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                        @(context.Item.Boundary.Length > 0 ? context.Item.Boundary : "not known")
                    </MudText>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Kind" Title="Relationship">
                <CellTemplate>
                    <MudText Typo="Typo.caption">@EdgeKindLabel(context.Item.Kind)</MudText>
                </CellTemplate>
            </PropertyColumn>
            @* The reference verbatim, because that is the text a reader has to go and edit. *@
            <PropertyColumn Property="x => x.Ref" Title="Reference">
                <CellTemplate>
                    @if (context.Item.Ref.Length > 0)
                    {
                        <span class="abom-trunc abom-rule">@context.Item.Ref</span>
                        @if (context.Item.RefStyle.Length > 0)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                                @context.Item.RefStyle
                            </MudText>
                        }
                    }
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Findings" Title="Findings">
                <CellTemplate>
                    <span class="abom-num">@context.Item.Findings</span>
                    @if (context.Item.Rules.Count > 0)
                    {
                        <MudTooltip Text="@string.Join(", ", context.Item.Rules)">
                            <MudText Typo="Typo.caption"
                                     Class="mud-text-secondary d-block abom-trunc">
                                @string.Join(", ", context.Item.Rules)
                            </MudText>
                        </MudTooltip>
                    }
                </CellTemplate>
            </PropertyColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="RelationshipSummary" />
        </PagerContent>
    </MudDataGrid>

    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">
        Containment is not listed here. A repository holding its workflows is drawn so the canvas
        has somewhere to put them; nothing declares it, so there is no line to go and edit.
    </MudText>
}

@* What the crawl has reached and what it has not. Its columns are the queue's own — a state, the
   tier it was claimed under, how far out it sits and what looked at it — none of which any other
   unit carries. *@
@if (_unit == UnitCoverage)
{
    <div class="d-flex align-center flex-wrap gap-1 mb-3" role="tablist">
        @foreach (var (value, label) in CoverageStates)
        {
            <MudButton Size="Size.Small" DropShadow="false"
                       Variant="@(_coverageState == value ? Variant.Filled : Variant.Text)"
                       Color="@(_coverageState == value ? Color.Primary : Color.Default)"
                       OnClick="@(() => ChooseCoverageState(value))"
                       data-abom-coverage-state="@value">@label</MudButton>
        }
    </div>

    @if (_coverageLoading)
    {
        <MudProgressLinear Indeterminate="true" Class="my-4" />
    }
    else
    {
        <MudDataGrid T="FrontierItem" Items="_coverage" Dense="true" Hover="true" Bordered="false"
                     SortMode="SortMode.Single" Filterable="false" RowsPerPage="30"
                     ShowColumnOptions="false" FixedHeader="true" Class="abom-grid abom-grid-windowed abom-grid-captioned">
            <Columns>
                <PropertyColumn Property="x => x.NodeKey" Title="Dependency">
                    <CellTemplate>
                        <IdentityCell Reference="@context.Item.NodeKey"
                                      Href="@($"/node/{Uri.EscapeDataString(context.Item.NodeKey)}")" />
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.State" Title="State">
                    <CellTemplate>
                        <span class="abom-status-cell">
                            <span class="abom-state-dot mr-1"
                                  style="--abom-state-color:@CoverageColor(context.Item.State)"></span>
                            @CoverageStateLabel(context.Item.State)
                        </span>
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.Tier" Title="Tier">
                    <CellTemplate>
                        <MudText Typo="Typo.caption">
                            @(string.IsNullOrEmpty(context.Item.Tier) ? "—" : context.Item.Tier)
                        </MudText>
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.Depth" Title="Hops" />
                <PropertyColumn Property="x => x.Attempts" Title="Attempts">
                    <CellTemplate>
                        @if (context.Item.Attempts > 0)
                        {
                            <span class="abom-num">@context.Item.Attempts</span>
                        }
                        else
                        {
                            <span class="abom-faint">0</span>
                        }
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.AnalyzedAt" Title="Last analyzed">
                    <CellTemplate>
                        @if (context.Item.AnalyzedAt is { Length: > 0 } at)
                        {
                            <MudText Typo="Typo.caption">@TimeText.DayAndTime(at)</MudText>
                        }
                        else
                        {
                            @* Nothing has analyzed it, so it has no date. A stand-in would be a
                               measurement nobody took. *@
                            <span class="abom-faint">—</span>
                        }
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.Suites" Title="Analyzed with" Sortable="false">
                    <CellTemplate>
                        @if (context.Item.SuitesKnown)
                        {
                            <MudTooltip Text="@string.Join("\n", context.Item.Suites)">
                                <span class="abom-rule">@CoverageSuites(context.Item)</span>
                            </MudTooltip>
                        }
                        else
                        {
                            @* Analyzed before the suites that ran were recorded: unknown, not none. *@
                            <MudTooltip Text="This row was analyzed before the suites that ran were recorded, so what looked at it is unknown. Re-analyzing it records them.">
                                <span class="abom-coverage-unknown">not recorded</span>
                            </MudTooltip>
                        }
                    </CellTemplate>
                </PropertyColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="FrontierItem" />
            </PagerContent>
        </MudDataGrid>
    }
}

@* Stated rather than implied by a pager: the grid used to hold 500 of 1,585 with nothing saying
   so, and a column sorted inside that page answered about the page rather than about the estate. *@
@if (_unit == UnitCoverage)
{
    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">
        Showing @_shown.ToString("N0")@(_shown >= CoverageCap
            ? $" — the first {CoverageCap:N0} the crawl will claim, not the whole queue"
            : ", which is all of them"), ordered by what the crawl will claim next.
    </MudText>
}
else
{
    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">
        Showing @_shown.ToString("N0") of @_total.ToString("N0") matching, ordered by
        @(_sort is { Length: > 0 } s ? ColumnLabel(s) : DefaultOrder(_unit)) across everything that
        matched.
    </MudText>
}

@* A zero that means "measured somewhere you are not looking" is indistinguishable from "nothing is
   wrong" unless the page says where it matched. Every `actions/unpinned-tag` finding sits on a step
   or job node, so the most important rule in the corpus answers 0 among the dependency kinds. *@
@if (_elsewhere.Count > 0)
{
    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">
        This question also matches @ElsewhereText() — not listed here, because
        @(_elsewhere.Count == 1 ? "that kind is" : "those kinds are") inside your workflows rather
        than dependencies of them.
        <MudLink Href="@ElsewhereHref()" Typo="Typo.caption">Show @(_elsewhere.Count == 1
            ? TypeLabel(_elsewhere[0].Kind).ToLowerInvariant() : "them")</MudLink>
    </MudText>
}

@code {
    private const string UnitDependencies = "dependencies";
    private const string UnitWorkflows = "workflows";
    private const string UnitJobs = "jobs";
    private const string UnitRepositories = "repositories";
    private const string UnitAdvisories = "advisories";
    private const string UnitRelationships = "relationships";
    private const string UnitCoverage = "coverage";

    private static readonly (string Key, string Label)[] Units =
    [
        (UnitDependencies, "Actions"),
        (UnitWorkflows, "Workflows"),
        (UnitJobs, "Jobs"),
        (UnitRepositories, "Repositories"),
        (UnitAdvisories, "Advisories"),
        (UnitRelationships, "Relationships"),
        (UnitCoverage, "Coverage"),
    ];

    /// Which side of the server's term declaration this unit is, so the picker offers only what
    /// the unit's endpoint applies rather than what it would refuse by name.
    private string UnitSurface => _unit switch
    {
        UnitWorkflows => "workflows",
        UnitJobs => "jobs",
        UnitRepositories => "repositories",
        UnitAdvisories => "advisories",
        UnitRelationships => "relationships",
        _ => "inventory",
    };

    private IReadOnlyList<FilterTerm> _filterTerms = [];

    /// Why a bill of materials cannot be exported under the current scope, or empty when it can.
    ///
    /// Read from the catalog rather than from a list kept here: the endpoint refuses by name and a
    /// second copy of that set would drift from it.
    private string ExportRefusal
    {
        get
        {
            // Not read yet is not the same as nothing applies. Refusing on an empty catalog would
            // disable the export for a moment on every load, for a reason that is not true.
            if (_filterTerms.Count == 0) return string.Empty;

            var applies = _filterTerms
                .Where(t => t.Surfaces.Contains("document"))
                .Select(t => t.Name)
                .ToHashSet(StringComparer.Ordinal);
            var refused = _filterTerms
                .Where(t => !applies.Contains(t.Name) && SetTerms.Contains(t.Name))
                .Select(t => t.Label)
                .ToArray();
            return refused.Length == 0
                ? string.Empty
                : $"A bill of materials does not narrow by {string.Join(", ", refused)}. "
                  + "Remove those filters to export this scope.";
        }
    }

    /// The term names the current scope actually sets, read through its own serializer.
    private HashSet<string> SetTerms =>
    [
        .. Scope.Spec.ToQueryString()
            .Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Select(p => p.IndexOf('=') is var at && at > 0 ? Uri.UnescapeDataString(p[..at]) : p)
    ];

    /// Whether anything narrows the corpus. With nothing filtered and nothing named there is no
    /// scope, and an action labelled *this scope* would be naming a narrowing that does not exist.
    private bool HasScope => Scope.ToQueryString().Length > 0;

    /// <summary>Whether a unit's rows are things the graph draws.</summary>
    ///
    /// <para>Measured against the crawled organization: the graph holds <c>step</c>, <c>job</c>,
    /// <c>workflow</c>, <c>action</c>, <c>repo</c>, <c>composite_action</c>, <c>org</c>,
    /// <c>reusable_workflow</c> and <c>docker_image</c>. A repository is a node and so is a job;
    /// an advisory is a GHSA identifier and is not. The graph can draw what <em>reaches</em> an
    /// advisory, but that is a different question from drawing the row.</para>
    public static bool UnitDrawsInGraph(string unit) => unit != UnitAdvisories;

    /// Why the graph action is refused, or empty when it applies. A disabled control with no
    /// reason is a dead end a reader has to guess at.
    private string GraphActionReason => UnitDrawsInGraph(_unit)
        ? string.Empty
        : "An advisory is not a node, so these rows cannot be drawn. "
          + "The Actions unit draws what an advisory reaches.";

    private MudDataGrid<ActionSummary>? _grid;
    private MudDataGrid<WorkflowRow>? _workflowGrid;
    private MudDataGrid<JobRow>? _jobGrid;
    private MudDataGrid<RepositorySummary>? _repoGrid;
    private MudDataGrid<RemediationItem>? _advisoryGrid;
    private MudDataGrid<RelationshipSummary>? _relationshipGrid;
    private IReadOnlyList<NamedView> _views = [];
    private string _unit = UnitDependencies;
    private string _search = string.Empty;
    private string _scopeName = string.Empty;
    private string? _writeError;
    private string? _sort;
    private string? _refusal;
    private int _total;
    private int _shown;
    private int _unreached;
    private IReadOnlyList<KindCount> _elsewhere = [];

    // A tab is the one the scope already is, compared as canonical text. That comparison is the
    // whole reason a built-in's predicate is stored canonical rather than however it was typed.
    private bool IsSelected(NamedView view) => Scope.Spec.ToQueryString() == view.Predicate;

    // What the scope bar marks as in force.
    private NamedView? ActiveView => _views.FirstOrDefault(IsSelected);

    private static readonly Dictionary<string, string> SortLabels = new()
    {
        ["nodeKey"] = "name",
        ["kind"] = "type",
        ["origin"] = "origin",
        ["dependentRepos"] = "reach",
        ["directDependents"] = "total refs",
        ["distinctRefs"] = "distinct refs",
        ["findings"] = "findings",
        ["advisories"] = "advisories",
        ["analyzed"] = "analyzed",
    };

    // The grid names a sort by its property; the endpoint names it by its own term. A name absent
    // here is not sent at all, and the server refuses any term it does not have.
    private static readonly Dictionary<string, string> SortTerms = new()
    {
        ["NodeKey"] = "nodeKey",
        ["Kind"] = "kind",
        ["Origin"] = "origin",
        ["DependentRepos"] = "dependentRepos",
        ["DirectDependents"] = "directDependents",
        ["DistinctRefs"] = "distinctRefs",
        ["Findings"] = "findings",
        ["Advisories"] = "advisories",
        ["Analyzed"] = "analyzed",
    };

    private static readonly Dictionary<string, string> RepositorySortTerms = new()
    {
        ["FullName"] = "fullName",
        ["Workflows"] = "workflows",
        ["Dependencies"] = "dependencies",
        ["Findings"] = "findings",
        ["Exposures"] = "exposures",
        ["DirectExposures"] = "directExposures",
    };

    private static readonly Dictionary<string, string> WorkflowSortTerms = new()
    {
        ["NodeKey"] = "nodeKey",
        ["Repository"] = "repository",
        ["Triggers"] = "triggers",
        ["Jobs"] = "jobs",
        ["Steps"] = "steps",
        ["Dependencies"] = "dependencies",
        ["PrivilegedJobs"] = "privileged",
        ["Findings"] = "findings",
    };

    private static readonly Dictionary<string, string> JobSortTerms = new()
    {
        ["JobId"] = "jobId",
        ["Workflow"] = "workflow",
        ["RunsOn"] = "runsOn",
        ["Privileged"] = "privileged",
        ["ExternallyTriggerable"] = "externally",
        ["Steps"] = "steps",
        ["Dependencies"] = "dependencies",
        ["Findings"] = "findings",
    };

    private static string ColumnLabel(string sort) =>
        SortLabels.TryGetValue(sort, out var l) ? l : sort;

    // Named before the click rather than refused after it. The refusal that arrives on selecting a
    // tab is correct and one click too late to be useful.
    private static string Undrawable(NamedView view) =>
        view.ListingRefuses.Count == 0
            ? ""
            : $"This list cannot narrow by {string.Join(", ", view.ListingRefuses)}. "
              + "Open it in the Explorer.";

    private string ElsewhereText() => string.Join(" and ", _elsewhere.Select(
        e => $"{e.Count:N0} {TypeLabel(e.Kind).ToLowerInvariant()}{(e.Count == 1 ? "" : "s")}"));

    // The same scope, naming the kinds it matched, so the reader arrives at the rows rather than at
    // an empty grid a second time.
    private string ElsewhereHref()
    {
        var kinds = "kinds=" + string.Join(",", _elsewhere.Select(e => e.Kind));
        var scope = Scope.ToQueryString();
        return "/inventory?" + (scope.Length > 0 ? kinds + "&" + scope : kinds);
    }

    private static string UnitLabel(string unit) =>
        Units.FirstOrDefault(u => u.Key == unit).Label ?? "Actions";

    // A workflow's key is its full path, which is unreadable at grid width; the repository is its
    // own column, and every workflow in the corpus lives under the same directory, so neither is
    // what tells this row from the next.
    private static string WorkflowLabel(WorkflowRow w) =>
        w.Path.Length > 0 ? KeyText.WorkflowFile(w.Path) : KeyText.Split(w.NodeKey).Name;

    // Each endpoint has its own default, and the line under the grid has to name the one in force.
    private static string DefaultOrder(string unit) => unit switch
    {
        UnitRepositories => "findings",
        UnitAdvisories => "severity and reach",
        UnitWorkflows => "findings",
        UnitJobs => "whether the job is privileged",
        UnitRelationships => "what declares it",
        UnitCoverage => "what the crawl will claim next",
        _ => "reach",
    };
    private static string TypeLabel(string kind) =>
        ThemeService.KindNames.TryGetValue(kind, out var n) ? n : kind;

    // The export carries the scope on screen. One that ignored it would hand somebody a document
    // about the whole organization under the name of one part.
    private string BomUrl(string format) =>
        AbomApi.BomDownloadUrl(format, properties: Scope.Spec.Properties.Select(p => p.ToString()),
            mode: Scope.Spec.Mode);

    // The unit is how the scope is being drawn rather than what it selects, so ScopeService leaves
    // it alone and it travels as its own parameter.
    [SupplyParameterFromQuery(Name = "unit")] public string? UnitParam { get; set; }

    protected override void OnInitialized()
    {
        ReadAddress();
        // Blazor keeps the component when only the query changes, so without this the address says
        // one thing and the grid goes on answering the last one. Browser Back is the same gap.
        Nav.LocationChanged += OnLocationChanged;
        if (Draft.Queries.Count > 0)
        {
            _choosing = true;
            _picked = [.. Draft.Queries];
        }
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    // A run chosen here, or carried from the CodeQL page: the versions and the repositories.
    private bool _choosing;
    private List<AnalysisQueryRef> _picked = [];
    private IReadOnlyList<CatalogQuery> _runnable = [];
    private readonly HashSet<string> _chosen = new(StringComparer.OrdinalIgnoreCase);
    private string? _runRefusal;
    private bool _starting;

    private static bool UnitRunsQueries(string unit) => unit is UnitRepositories or UnitDependencies;

    private string RunActionReason => UnitRunsQueries(_unit)
        ? "Choose repositories here and run query versions over their databases"
        : "Only repositories, and the actions that live in them, have a database to run a query against";

    private bool CanStartRun =>
        !_starting && _picked.Count > 0 && _chosen.Count > 0 && Accounts.Identity.Login.Length > 0;

    // A docker image lives in no repository, so it has no database to choose.
    private static string? RepositoryOf(ActionSummary a) =>
        a.Owner.Length > 0 && a.Repo.Length > 0 ? $"{a.Owner}/{a.Repo}" : null;

    private RenderFragment ChooseBox(string repository) => __builder =>
    {
        <span data-abom-run-choose="@repository">
            <MudCheckBox T="bool" Dense="true" Size="Size.Small" Color="Color.Primary"
                         Value="@_chosen.Contains(repository)"
                         ValueChanged="@((bool on) => Choose(repository, on))"
                         aria-label="@($"Choose {repository}")" />
        </span>
    };

    private void Choose(string repository, bool on)
    {
        if (on)
        {
            _chosen.Add(repository);
        }
        else
        {
            _chosen.Remove(repository);
        }
    }

    private async Task StartChoosing()
    {
        _choosing = true;
        await LoadRunnable();
    }

    private void StopChoosing()
    {
        _choosing = false;
        _chosen.Clear();
        _picked = [];
        _runRefusal = null;
        Draft.Clear();
    }

    // The crawl's own queries build the graph and report nothing, so they are not on offer.
    private async Task LoadRunnable()
    {
        await Accounts.EnsureLoadedAsync();
        var catalog = await Api.GetQueryCatalogAsync();
        _runnable = [.. catalog.Queries.Where(q => !q.Discovery && !q.Lane && q.QueryVersion.Length > 0)];
    }

    private static string VersionKey(CatalogQuery q) => q.QueryId + "\n" + q.QueryVersion;

    private static bool SameVersion(AnalysisQueryRef a, CatalogQuery b) =>
        a.QueryId == b.QueryId && a.QueryVersion == b.QueryVersion;

    private void Pick(string key)
    {
        if (_runnable.FirstOrDefault(r => VersionKey(r) == key) is { } q)
        {
            _picked = [.. _picked, new AnalysisQueryRef { QueryId = q.QueryId, QueryVersion = q.QueryVersion }];
        }
    }

    private void Unpick(AnalysisQueryRef q) => _picked = [.. _picked.Where(p => p != q)];

    private static string Short(string version) => version.Length <= 12 ? version : version[..12];

    /// <summary>Sent by name, so a repository with no findings is still runnable.</summary>
    private async Task StartRun()
    {
        if (!CanStartRun)
        {
            return;
        }
        _starting = true;
        try
        {
            var predicate = "repositories=" + string.Join(",",
                _chosen.Order(StringComparer.Ordinal).Select(Uri.EscapeDataString));
            var (run, refusal) = await Api.StartAnalysisRunAsync(predicate, _picked, Accounts.Identity.Login);
            if (run is null)
            {
                _runRefusal = refusal ?? Api.LastError;
                return;
            }
            var (_, notStarted) = await Api.ExecuteAnalysisRunAsync(run.RowId);
            if (notStarted is not null)
            {
                _runRefusal = $"Run #{run.RowId} is recorded and has not started: {notStarted}";
                return;
            }
            StopChoosing();
            Nav.NavigateTo($"/codeql?tab=runs&run={run.RowId}");
        }
        finally
        {
            _starting = false;
        }
    }

    private void ReadAddress()
    {
        Scope.ReadFrom(Nav.Uri);
        _search = Scope.Spec.Search;
        _unit = Units.Any(u => u.Key == UnitParam) ? UnitParam! : UnitDependencies;
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var before = Scope.ToQueryString() + "&unit=" + _unit;
        ReadAddress();
        if (Scope.ToQueryString() + "&unit=" + _unit == before)
        {
            return;
        }
        StateHasChanged();
        await Reload();
    }

    protected override async Task OnInitializedAsync()
    {
        _views = await Api.GetViewsAsync();
        if (_choosing)
        {
            await LoadRunnable();
        }
        // Read here as well as inside the picker: the export's refusal is a claim this page makes
        // about the scope, and it needs the same declaration the picker offers terms from.
        _filterTerms = await Api.GetFilterTermsAsync();
        // Every other unit is pulled by its grid's ServerData; this one has no server pager, so
        // arriving straight at its address has to fetch it.
        if (_unit == UnitCoverage)
        {
            await LoadCoverage();
        }
    }

    /// <summary>Reprojects the same scope as a different shape.</summary>
    private async Task ChooseUnit(string unit)
    {
        if (_unit == unit) return;
        _unit = unit;
        _sort = null;
        Sync();
        await Reload();
    }

    private void Sync()
    {
        var parts = new List<string> { $"unit={_unit}" };
        var scope = Scope.ToQueryString();
        if (scope.Length > 0) parts.Add(scope);
        Nav.NavigateTo($"/inventory?{string.Join("&", parts)}",
            new NavigationOptions { ReplaceHistoryEntry = true });
    }

    private async Task Reload()
    {
        if (_unit == UnitCoverage) await LoadCoverage();
        else if (_unit == UnitRepositories && _repoGrid is not null) await _repoGrid.ReloadServerData();
        else if (_unit == UnitAdvisories && _advisoryGrid is not null) await _advisoryGrid.ReloadServerData();
        else if (_unit == UnitWorkflows && _workflowGrid is not null) await _workflowGrid.ReloadServerData();
        else if (_unit == UnitJobs && _jobGrid is not null) await _jobGrid.ReloadServerData();
        else if (_unit == UnitRelationships && _relationshipGrid is not null) await _relationshipGrid.ReloadServerData();
        else if (_grid is not null) await _grid.ReloadServerData();
    }

    // The frontier answers with a capped list and no total, so this unit states the cap rather
    // than a figure it was never given. Every other unit is paged by the server.
    private const int CoverageCap = 500;

    private IReadOnlyList<FrontierItem> _coverage = [];
    private string _coverageState = "";
    private bool _coverageLoading;

    private static readonly (string Value, string Label)[] CoverageStates =
    [
        ("", "All"),
        ("done", "Analyzed"),
        ("queued", "Queued"),
        ("running", "Discovering"),
        ("retrying", "Retrying"),
        ("unavailable", "Unavailable"),
    ];

    private async Task LoadCoverage()
    {
        _coverageLoading = true;
        _coverage = [];
        StateHasChanged();
        _coverage = await Api.GetFrontierAsync(_coverageState, top: CoverageCap);
        _shown = _coverage.Count;
        _total = _coverage.Count;
        _coverageLoading = false;
    }

    private async Task ChooseCoverageState(string state)
    {
        _coverageState = state;
        await LoadCoverage();
    }

    private static string CoverageStateLabel(string state) => state switch
    {
        "done" => "analyzed",
        "running" => "discovering",
        _ => state,
    };

    private string CoverageColor(string state) =>
        Theme.Palette.Discovery.TryGetValue(state, out var c) ? c : Theme.Palette.Muted;

    private static string CoverageSuites(FrontierItem item) =>
        string.Join(", ", item.Suites.Select(s =>
        {
            var name = s.Split('@')[0].Split('/').LastOrDefault() ?? s;
            return name.EndsWith(".qls", StringComparison.Ordinal) ? name[..^4] : name;
        }));

    /// <summary>
    /// Loads a named view's predicate into the scope.
    /// </summary>
    ///
    /// Its predicate rather than its name: the endpoint treats `?view=` as the whole question and
    /// refuses it combined with anything else, so sending the name would refuse the next thing the
    /// reader narrowed by.
    private async Task ChooseView(NamedView view)
    {
        Scope.Set(ViewSpec.Parse(view.Predicate));
        _search = Scope.Spec.Search;
        Sync();
        await Reload();
    }

    private async Task OnPickerChanged()
    {
        _search = Scope.Spec.Search;
        Sync();
        await Reload();
    }

    /// <summary>Keeps the scope on screen under a name, so it can be returned to as a tab.</summary>
    private async Task SaveScope()
    {
        var saved = await Api.SaveViewAsync(_scopeName.Trim(), Scope.ToQueryString());
        _writeError = saved is null ? Api.LastError : null;
        if (saved is not null)
        {
            _views = saved;
            _scopeName = string.Empty;
        }
    }

    private async Task ForgetView(NamedView view)
    {
        var left = await Api.ForgetViewAsync(view.Name);
        _writeError = left is null ? Api.LastError : null;
        if (left is not null)
        {
            _views = left;
        }
    }

    /// <summary>
    /// Asks the server for one page, ordered across the whole match.
    ///
    /// The whole predicate is sent, including terms a listing cannot apply, because the endpoint
    /// names those in its refusal and that name is the only thing that tells a reader why their
    /// scope is not narrowing this screen. Deciding here which terms to drop would be a second
    /// copy of the server's declaration, drifting quietly.
    /// </summary>
    private async Task<GridData<ActionSummary>> LoadPage(GridState<ActionSummary> state)
    {
        var sort = state.SortDefinitions.FirstOrDefault();
        _sort = sort is not null && SortTerms.TryGetValue(sort.SortBy, out var term) ? term : null;

        var (page, refusal) = await Api.GetActionsPageAsync(
            Scope.Spec.ToQueryString(), state.PageSize, state.Page * state.PageSize,
            _sort, sort?.Descending ?? false);

        _refusal = refusal;
        _total = page?.Total ?? 0;
        _shown = page?.Items.Count ?? 0;
        _elsewhere = page?.Elsewhere ?? [];
        // The line stating what was left out sits outside the grid, and the grid re-renders only
        // itself, so without this it keeps reporting the page before last.
        StateHasChanged();
        return new GridData<ActionSummary> { Items = page?.Items ?? [], TotalItems = _total };
    }

