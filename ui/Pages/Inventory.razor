        StateHasChanged();
        return new GridData<RepositorySummary> { Items = page?.Items ?? [], TotalItems = _total };
    }

    /// <summary>
    /// One page of the advisories unit, worst first across the whole match.
    /// </summary>
    ///
    /// Ordered by the server and not sortable here: the rank is a place in the whole match, and a
    /// column header offering to re-rank one page would invite a reader to ask a question the rank
    /// cannot answer.
    private async Task<GridData<RemediationItem>> LoadAdvisories(GridState<RemediationItem> state)
    {
        _sort = null;
        var (page, refusal) = await Api.GetAdvisoriesPageAsync(
