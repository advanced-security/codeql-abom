    protected override void OnInitialized()
    {
        ReadAddress();
        // Blazor keeps the component when only the query changes, so without this the address says
        // one thing and the grid goes on answering the last one. Browser Back is the same gap.
        Nav.LocationChanged += OnLocationChanged;
        // A draft carried from the CodeQL page, or left here, opens where repositories are chosen.
        _choosing = Draft.Queries.Count > 0;
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        _ = _rows?.DisposeAsync();
    }

    // The repositories a run drafted here is over; the versions are the shared draft's.
    private bool _choosing;
    private readonly HashSet<string> _chosen = new(StringComparer.OrdinalIgnoreCase);

    // Every repository the scope lists rather than the ones ticked.
    private bool _all;

    private static bool UnitRunsQueries(string unit) => unit is UnitRepositories or UnitDependencies;

    private string RunActionReason => UnitRunsQueries(_unit)
        ? "Choose repositories here and run query versions over their databases"
        : "Only repositories, and the actions that live in them, have a database to run a query against";

    private bool HasPredicate => Scope.Spec.ToQueryString().Length > 0;

    // Why "all" cannot be sent, or empty when it can. An empty selector names nothing rather than
    // everything, so with nothing narrowed there is no scope to send.
    private string ChooseAllReason =>
        !HasPredicate ? "Narrow the scope first: with nothing narrowed there is no scope to send."
        : _refusal is { Length: > 0 } ? "This scope does not list repositories here, so there is nothing to choose."
        : _total == 0 ? "This scope lists no repository."
        : string.Empty;

    // "All" is sent as the scope, so the server resolves it as the Repositories unit lists it.
    // Sent by name otherwise, so a repository with no findings is as runnable as any.
    private string RunPredicate =>
        _all ? Scope.Spec.ToQueryString()
        : _chosen.Count == 0 ? string.Empty
        : "repositories=" + string.Join(",",
            _chosen.Order(StringComparer.Ordinal).Select(Uri.EscapeDataString));

    // A docker image lives in no repository, so it has no database to choose.
    private static string? RepositoryOf(ActionSummary a) =>
        a.Owner.Length > 0 && a.Repo.Length > 0 ? $"{a.Owner}/{a.Repo}" : null;

    private RenderFragment ChooseBox(string repository) => __builder =>
    {
        <span data-abom-run-choose="@repository">
            <MudCheckBox T="bool" Dense="true" Size="Size.Small" Color="Color.Primary"
                         Value="@(_all || _chosen.Contains(repository))" Disabled="@_all"
                         ValueChanged="@((bool on) => Choose(repository, on))"
                         aria-label="@($"Choose {repository}")" />
        </span>
    };

    private void Choose(string repository, bool on)
    {
        if (on)
        {
            _chosen.Add(repository);
        }
        else
        {
            _chosen.Remove(repository);
        }
    }

    private void StartChoosing() => _choosing = true;

    // The draft has already put its versions away; what is left is this page's choice of rows.
    private void StopChoosing()
    {
        _choosing = false;
        _chosen.Clear();
        _all = false;
    }

    private void ReadAddress()
    {
        Scope.ReadFrom(Nav.Uri);
        _search = Scope.Spec.Search;
        _unit = Units.Any(u => u.Key == UnitParam) ? UnitParam! : UnitDependencies;
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var before = Scope.ToQueryString() + "&unit=" + _unit;
        ReadAddress();
        if (Scope.ToQueryString() + "&unit=" + _unit == before)
        {
            return;
        }
        StateHasChanged();
        await Reload();
    }

    protected override async Task OnInitializedAsync()
    {
        // Read here as well as inside the picker: the export's refusal is a claim this page makes
        // about the scope, and it needs the same declaration the picker offers terms from.
        _filterTerms = await Api.GetFilterTermsAsync();
        // Every other unit is pulled by its grid's ServerData; this one has no server pager, so
        // arriving straight at its address has to fetch it.
        if (_unit == UnitCoverage)
        {
            await LoadCoverage();
        }
    }

    /// <summary>Reprojects the same scope as a different shape.</summary>
    private async Task ChooseUnit(string unit)
    {
        if (_unit == unit) return;
        _unit = unit;
        _sort = null;
        _document = null;
        _reviewAsset = null;
        // N actions are not N repositories, so "all" belongs to the Repositories unit alone.
        if (_unit != UnitRepositories)
        {
            _all = false;
        }
        Sync();
        await Reload();
    }

    private void Sync()
    {
        var parts = new List<string> { $"unit={_unit}" };
        var scope = Scope.ToQueryString();
        if (scope.Length > 0) parts.Add(scope);
        Nav.NavigateTo($"/inventory?{string.Join("&", parts)}",
            new NavigationOptions { ReplaceHistoryEntry = true });
    }

    private async Task Reload()
    {
        if (_unit == UnitCoverage) await LoadCoverage();
        else if (_unit == UnitFindings) return;
        else if (_unit == UnitRepositories && _repoGrid is not null) await _repoGrid.ReloadServerData();
        else if (_unit == UnitAdvisories && _advisoryGrid is not null) await _advisoryGrid.ReloadServerData();
        else if (_unit == UnitWorkflows && _workflowGrid is not null) await _workflowGrid.ReloadServerData();
        else if (_unit == UnitJobs && _jobGrid is not null) await _jobGrid.ReloadServerData();
        else if (_unit == UnitRelationships && _relationshipGrid is not null) await _relationshipGrid.ReloadServerData();
        else if (_grid is not null) await _grid.ReloadServerData();
    }

    // The frontier answers with a capped list and no total, so this unit states the cap rather
    // than a figure it was never given. Every other unit is paged by the server.
    private const int CoverageCap = 500;

    private IReadOnlyList<FrontierItem> _coverage = [];
    private string _coverageState = "";
    private bool _coverageLoading;

    private static readonly (string Value, string Label)[] CoverageStates =
    [
        ("", "All"),
        ("done", "Analyzed"),
        ("queued", "Queued"),
        ("running", "Discovering"),
        ("retrying", "Retrying"),
        ("unavailable", "Unavailable"),
        ("nothing", "Nothing to analyze"),
    ];

    private async Task LoadCoverage()
    {
        _coverageLoading = true;
        _coverage = [];
        StateHasChanged();
        _coverage = await Api.GetFrontierAsync(_coverageState, top: CoverageCap);
        _shown = _coverage.Count;
        _total = _coverage.Count;
        _countedUnit = UnitCoverage;
        _coverageLoading = false;
    }

    private async Task ChooseCoverageState(string state)
    {
        _coverageState = state;
        await LoadCoverage();
    }

    private static string CoverageStateLabel(string state) => state switch
    {
        "done" => "analyzed",
        "running" => "discovering",
        _ => state,
    };

    private string CoverageColor(string state) =>
        Theme.Palette.Discovery.TryGetValue(state, out var c) ? c : Theme.Palette.Muted;

    // What the scanning reading is called, and the discovery color it borrows: done for default
    // setup, running for advanced, unavailable for both at once, retrying for a gap, queued for not
    // read yet, and muted for what was never ABOM's to read.
    private static readonly Dictionary<string, (string Label, string Color)> ScanningStates = new()
    {
        ["default"] = ("Default setup", "done"),
        ["advanced"] = ("Advanced setup", "running"),
        ["both"] = ("Both setups", "unavailable"),
        ["off"] = ("Off", "retrying"),
        ["no-actions-code"] = ("No Actions code", ""),
    };

    // The setup and the database, in words under the scanning state.
    private static readonly Dictionary<string, string> SetupWords = new()
    {
        ["default"] = "default setup", ["advanced"] = "advanced setup", ["conflict"] = "setups in conflict",
        ["none"] = "no setup", ["unreadable"] = "setup unreadable", ["not-read"] = "setup not read",
    };

    private static readonly Dictionary<string, string> DatabaseWords = new()
    {
        ["present"] = "Actions database", ["absent"] = "no Actions database", ["not-read"] = "database not read",
    };

    private RenderFragment SetupCell(RepositorySummary r) => builder =>
    {
        var cs = r.CodeScanning;
        var (label, state) = cs.ActionsScanning switch
        {
            "not-owned" => ("Not owned", ""),
            _ when !cs.Known => ("Not read", "queued"),
            var v => ScanningStates.TryGetValue(v, out var known) ? known : ("Not read", "queued"),
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", "abom-setup-cell");
        builder.OpenElement(2, "span");
        builder.AddAttribute(3, "class", cs.ActionsScanning == "not-owned" ? "abom-status-cell mud-text-secondary" : "abom-status-cell");
        builder.AddAttribute(4, "title", SetupTitle(cs, "actionsScanning"));
        builder.AddAttribute(5, "data-abom-setup", $"{r.FullName}:actionsScanning");
        builder.OpenElement(6, "span");
        builder.AddAttribute(7, "class", "abom-state-dot mr-1");
        builder.AddAttribute(8, "style", $"--abom-state-color:{(state.Length == 0 ? Theme.Palette.Muted : CoverageColor(state))}");
        builder.CloseElement();
        builder.AddContent(9, label);
        builder.CloseElement();
        if (cs.Known && cs.ActionsScanning != "not-owned")
        {
            // Default or advanced setup scanning Actions already names the setup; saying it twice says nothing.
            var named = cs.ActionsScanning == cs.Setup && cs.Setup is "default" or "advanced";
            if (!named)
            {
                Detail(builder, 10, r, "setup", SetupWords.GetValueOrDefault(cs.Setup, "setup not known"));
            }
            Detail(builder, 20, r, "actionsDatabase", DatabaseWords.GetValueOrDefault(cs.ActionsDatabase, "database not read"));
        }
        builder.CloseElement();
    };

    private static void Detail(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder, int seq, RepositorySummary r, string column, string words)
    {
        builder.OpenElement(seq, "span");
        builder.AddAttribute(seq + 1, "class", "abom-setup-detail mud-text-secondary");
        builder.AddAttribute(seq + 2, "title", SetupTitle(r.CodeScanning, column));
        builder.AddAttribute(seq + 3, "data-abom-setup", $"{r.FullName}:{column}");
        builder.AddContent(seq + 4, words);
        builder.CloseElement();
    }

    // What each column's value says, before the evidence that put the repository there: one tip
    // repeated across all three explained the class and left "Off" beside it unexplained.
    private static readonly Dictionary<string, string> SetupMeanings = new()
    {
        ["actionsScanning:default"] = "Default setup analyzes this repository's Actions code.",
        ["actionsScanning:advanced"] = "An advanced setup analysis of this repository's Actions code is on record.",
        ["actionsScanning:both"] = "Default setup and an advanced setup analysis both cover this repository's Actions code.",
        ["actionsScanning:off"] = "No code scanning analysis of this repository's Actions code is on record.",
        ["actionsScanning:no-actions-code"] = "No Actions code was found here, so there is nothing for code scanning to analyze.",
        ["actionsScanning:unknown"] = "Not known: the default setup reading or the list of analyses is missing.",
        ["setup:default"] = "Default setup is on.",
        ["setup:advanced"] = "Advanced setup: a CodeQL workflow runs here, or analyses arrive that default setup did not make.",
        ["setup:conflict"] = "Default setup is on while advanced setup also runs here.",
        ["setup:none"] = "Neither default setup nor advanced setup is on.",
        ["setup:unreadable"] = "GitHub would not show this repository's default setup.",
        ["setup:not-read"] = "Default setup has not been read yet.",
        ["setup:unknown"] = "Not known.",
        ["actionsDatabase:present"] = "Code scanning holds an Actions CodeQL database ABOM can pull.",
        ["actionsDatabase:absent"] = "Code scanning holds no Actions CodeQL database for this repository.",
        ["actionsDatabase:not-read"] = "Not read yet whether code scanning holds an Actions CodeQL database.",
    };

    private static string SetupTitle(RepositoryCodeScanning cs, string column)
    {
        if (!cs.Known)
        {
            return "Not read: no code scanning reading has been recorded for this repository.";
        }
        var value = column switch
        {
            "actionsScanning" => cs.ActionsScanning,
            "setup" => cs.Setup,
            _ => cs.ActionsDatabase,
        };
        if (value == "not-owned")
        {
            return "Not owned: outside the declared scope, so ABOM never reads its code scanning.";
        }
        var parts = new List<string>
        {
            SetupMeanings.TryGetValue($"{column}:{value}", out var meaning) ? meaning.TrimEnd('.') : "",
            cs.Evidence.Length > 0 ? char.ToUpperInvariant(cs.Evidence[0]) + cs.Evidence[1..] : "",
        };
        if (column == "actionsDatabase")
        {
            if (cs.DatabaseCommit.Length > 0)
            {
                parts.Add($"Built at {CommitText.Short(cs.DatabaseCommit)}" +
                          (cs.DatabaseUpdatedAt.Length > 0 ? $", updated {TimeText.DayAndTime(cs.DatabaseUpdatedAt)}" : ""));
            }
        }
        else
        {
            if (cs.ConfigurationName.Length > 0)
            {
                parts.Add($"Configuration: {cs.ConfigurationName} ({cs.AttachmentStatus})");
            }
            if (cs.ConfigFile.Length > 0)
            {
                parts.Add($"Configuration file: {cs.ConfigFile}");
            }
            if (cs.ReadAt.Length > 0)
            {
                parts.Add($"Default setup read {TimeText.DayAndTime(cs.ReadAt)}");
            }
        }
        return string.Join(". ", parts.Where(p => p.Length > 0).Distinct(StringComparer.OrdinalIgnoreCase)) + ".";
    }

    private static string RelationshipLockText(RelationshipLock l)
    {
        var commit = CommitText.Short(l.Commit);
        if (l.Via.Length > 0)
        {
            return $"{l.Consumer}'s lock selects {commit} through {l.Via}";
        }
        var workflow = l.Workflow.Split('/')[^1];
        return workflow.Length > 0 ? $"locked to {commit} by {workflow}" : $"locked to {commit}";
    }

    // The version as the queue checks it out: a ref as written, a commit shortened, or the
    // default branch when nothing names one.
    private static string CoverageVersion(FrontierItem item) =>
        item.Ref.Length == 0 ? "default branch"
        : item.Ref.Length == 40 && item.Ref.All(Uri.IsHexDigit) ? "@" + item.Ref[..12]
        : "@" + item.Ref;

    private static string LockedByText(FrontierItem item)
    {
        var first = item.LockedBy.Count > 0 ? item.LockedBy[0] : "";
        var more = item.LockedByCount - (first.Length > 0 ? 1 : 0);
        return more > 0 ? $"locked by {first} and {more:N0} more" : $"locked by {first}";
    }

    // Each pack once: its versions are in the tooltip, and one pack at three versions read as three.
    private static IEnumerable<string> CoverageSuites(FrontierItem item) =>
        item.Suites
            .SelectMany(s => s.Split(' ', StringSplitOptions.RemoveEmptyEntries))
            .Select(s =>
            {
                var name = s.Split('@')[0].Split('/').LastOrDefault() ?? s;
                return name.EndsWith(".qls", StringComparison.Ordinal) ? name[..^4] : name;
            })
            .Distinct();

    /// <summary>
    /// Loads a named view's predicate into the scope.
    /// </summary>
    ///
    /// Its predicate rather than its name: the endpoint treats `?view=` as the whole question and
    /// refuses it combined with anything else, so sending the name would refuse the next thing the
    /// reader narrowed by.
    private async Task ChooseView(NamedView view)
    {
        Scope.Set(ViewSpec.Parse(view.Predicate));
        _search = Scope.Spec.Search;
        Sync();
        await Reload();
    }

    private async Task OnPickerChanged()
    {
        _search = Scope.Spec.Search;
        Sync();
        await Reload();
    }

    /// <summary>
    /// Asks the server for one page, ordered across the whole match.
    ///
    /// The whole predicate is sent, including terms a listing cannot apply, because the endpoint
    /// names those in its refusal and that name is the only thing that tells a reader why their
    /// scope is not narrowing this screen. Deciding here which terms to drop would be a second
    /// copy of the server's declaration, drifting quietly.
    /// </summary>
    // The property groups are counted by, as the server was configured; empty counts none.
    private string _groupProperty = string.Empty;

    private string GroupsTip => _groupProperty.Length > 0
        ? $"How many groups of starting points run this action, where a group is the repositories sharing one value of the {_groupProperty} property. A repository with no value is in no group."
        : "How many groups of starting points run this action. No grouping property is configured, so there are none to count.";

    // A level reach has not counted yet says so: a zero there would say nothing depends on it.
    private static RenderFragment Level(string level, int? count) =>
        @<span class="@(count is null ? "abom-coverage-unknown" : "abom-num")" data-abom-level="@level"
               title="@(count is null ? "ABOM has not counted this yet. It is counted the next time reach is recomputed." : null)">@(count?.ToString("N0") ?? "\u2014")</span>;

    // The row whose versions are open. One at a time: a second would push the first off screen.
    private ActionSummary? _openAction;
    private ElementReference _actionPanel;
    private bool _focusPanel;
    private IJSObjectReference? _rows;

    private bool IsOpen(ActionSummary item) => _openAction?.NodeKey == item.NodeKey;

    private string? ActionRowClass(ActionSummary item, int index) => IsOpen(item) ? "abom-row-open" : null;

    private Task OnActionRowClick(DataGridRowClickEventArgs<ActionSummary> e) => ToggleAction(e.Item);

    private async Task ToggleAction(ActionSummary item)
    {
        if (_grid is null) return;
        var closing = IsOpen(item);
        if (_openAction is { } open)
        {
            await _grid.ToggleHierarchyVisibilityAsync(open);
            _openAction = null;
        }
        if (!closing)
        {
            await _grid.ToggleHierarchyVisibilityAsync(item);
            _openAction = item;
            _focusPanel = true;
        }
    }

    private async Task ActionPanelKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && _openAction is { } open)
        {
            await ToggleAction(open);
        }
    }

    // Focus is for Escape. Scrolling waits for the versions, because until they are drawn nobody
    // knows how much room the panel takes.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusPanel) return;
        _focusPanel = false;
        await _actionPanel.FocusAsync(preventScroll: true);
    }

    private async Task RevealOpenRow()
    {
        _rows ??= await Js.InvokeAsync<IJSObjectReference>("import", "./js/rows.js");
        await _rows.InvokeAsync<bool>("revealRow", ".abom-actions-grid tr.abom-row-open");
    }

    /// <summary>
    /// The details page, carrying the scope this list was drawn under, and narrowed to one
    /// reference when one was chosen. Terms the page does not apply stay in its address, named.
    /// </summary>
    private string DetailsHref(string key, string? reference = null)
    {
        var spec = reference is { Length: > 0 } r ? Scope.Spec with { At = [r] } : Scope.Spec;
        var query = spec.ToQueryString();
        return $"/node/{Uri.EscapeDataString(key)}" + (query.Length > 0 ? "?" + query : "");
    }

    private Task<GridData<ActionSummary>> LoadPage(GridState<ActionSummary> state)
    {
        // A new page is new rows; the one that was open is not among them.
        _openAction = null;
        return LoadUnit<ActionSummary, InventoryPage>(state, "api/actions", SortTerms, page =>
        {
            _groupProperty = page?.GroupProperty ?? string.Empty;
            _elsewhere = page?.Elsewhere ?? [];
            _unsourced = page?.Unsourced ?? 0;
            _unprovided = page?.Unprovided ?? 0;
            _unlisted = page?.Unlisted ?? 0;
        });
    }

    private Task<GridData<WorkflowRow>> LoadWorkflows(GridState<WorkflowRow> state) =>
        LoadUnit<WorkflowRow, WorkflowsPage>(state, "api/workflows", WorkflowSortTerms);

    /// <summary>The jobs unit, whose facts are recorded against the job itself.</summary>
    private Task<GridData<JobRow>> LoadJobs(GridState<JobRow> state) =>
        LoadUnit<JobRow, JobsPage>(state, "api/jobs", JobSortTerms);

    // "All" follows the scope, and a scope that stops listing anything has nothing to send.
    private Task<GridData<RepositorySummary>> LoadRepositories(GridState<RepositorySummary> state) =>
        LoadUnit<RepositorySummary, RepositoriesPage>(state, "api/repositories", RepositorySortTerms,
            _ => _all = _all && ChooseAllReason.Length == 0);

    /// <summary>
    /// The advisories unit, worst first across the whole match.
    /// </summary>
    ///
    /// Not sortable here: the rank is a place in the whole match, and a column header offering to
    /// re-rank one page would invite a reader to ask a question the rank cannot answer.
    private Task<GridData<RemediationItem>> LoadAdvisories(GridState<RemediationItem> state) =>
        LoadUnit<RemediationItem, AdvisoriesPage>(state, "api/remediation", null,
            page => _unreached = page?.Unreached ?? 0);

    private Task<GridData<RelationshipSummary>> LoadRelationships(GridState<RelationshipSummary> state) =>
        LoadUnit<RelationshipSummary, RelationshipsPage>(state, "api/relationships", null, page =>
        {
            _lines = page?.Lines ?? 0;
            _withoutDeclaration = page?.WithoutDeclaration ?? 0;
        });

    // The first commit, and how many more: a row is narrow, and the whole list is in the tooltip.
    private static string DeclaredAtText(IReadOnlyList<string> commits) => commits.Count switch
    {
        0 => "no commit recorded",
        1 => $"at {CommitText.Short(commits[0])}",
        _ => $"at {CommitText.Short(commits[0])} and {commits.Count - 1} more",
    };

    private static string DeclaredAtTip(IReadOnlyList<string> commits) => commits.Count switch
    {
        0 => "No analysis recorded which commit declared this line, so it is not tied to one.",
        1 => $"Declared at commit {commits[0]}, which a reference in use resolves to.",
        _ => $"Declared at the {commits.Count} commits {string.Join(", ", commits.Take(commits.Count - 1))} " +
             $"and {commits[^1]}, which references in use resolve to.",
    };

    /// <summary>
    /// One page of a unit from its own endpoint, ordered across the whole match by the server. What
    /// only one unit reports is cleared for every other, and set by <paramref name="also"/>.
    /// </summary>
    private async Task<GridData<TRow>> LoadUnit<TRow, TPage>(GridState<TRow> state, string path,
        IReadOnlyDictionary<string, string>? sorts, Action<TPage?>? also = null)
        where TPage : class, IPage<TRow>
    {
        var unit = _unit;
        var sort = state.SortDefinitions.FirstOrDefault();
        _sort = sort is not null && sorts is not null && sorts.TryGetValue(sort.SortBy, out var term)
            ? term : null;
        var (page, refusal) = await Api.GetPageAsync<TPage>(path, Scope.Spec.ToQueryString(),
            state.PageSize, state.Page * state.PageSize, _sort, sort?.Descending ?? false);

        _refusal = refusal;
        _total = page?.Total ?? 0;
        _shown = page?.Items.Count ?? 0;
        _countedUnit = unit;
        _elsewhere = [];
        _unsourced = _unprovided = _unlisted = _unreached = _lines = _withoutDeclaration = 0;
        also?.Invoke(page);
        // The lines stating what was left out sit outside the grid, and the grid re-renders only
        // itself, so without this they keep reporting the page before last.
        StateHasChanged();
        return new GridData<TRow> { Items = page?.Items ?? [], TotalItems = _total };
    }

    // `needs:` is ordering rather than use, and a list that called it a dependency would be
    // saying the thing the graph refuses to say.
    private static string EdgeKindLabel(string kind) => kind switch
    {
        "step-uses-action" => "step uses",
        "composite-step-uses-action" => "composite step uses",
        "job-uses-reusable-workflow" => "job calls",
        "job-needs-job" => "job runs after",
        _ => kind,
    };

    private async Task OnSearch(string value)
    {
        _search = value ?? string.Empty;
        Scope.Set(Scope.Spec with { Search = _search });
        // The address is the scope, so a narrowed list can be shared and returned to.
        Sync();
        await Reload();
    }
}
