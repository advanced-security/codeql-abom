@page "/remediation"
@inject AbomApi Api
@inject NavigationManager Nav

<PageTitle>Remediation — ABOM</PageTitle>

<PageHeader Title="Remediation">
    Published severity against how many repositories reach it. CVSS and EPSS are shown for
    context and are deliberately not part of the score.
</PageHeader>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_items.Count == 0)
{
    <MudAlert Dense="true" Severity="MudBlazor.Severity.Info" Variant="Variant.Outlined">
        <MudText Typo="Typo.body2">
            No repository in scope reaches an action named by a live advisory.
        </MudText>
        <MudText Typo="Typo.caption" Class="mt-1">
            That is not the same as nothing being wrong. Check the Discovery view for how much of
            your organization has actually been analyzed.
        </MudText>
    </MudAlert>
}
else
{
    <MudDataGrid T="RemediationItem" Items="_items" Dense="true" Hover="true" Bordered="false"
                 Class="abom-grid"
                 Striped="false" Filterable="false" SortMode="SortMode.Single"
                 Groupable="false" RowsPerPage="25">
        <Columns>
            <HierarchyColumn T="RemediationItem" />

            <PropertyColumn Property="x => x.Priority" Title="Score" SortBy="x => x.Priority"
                            HeaderClass="abom-col-score" CellClass="abom-col-score">
                <CellTemplate>
                    <MudTooltip Text="@($"{context.Item.Severity} severity × {context.Item.TotalRepos} repositories reached")">
                        <span class="abom-strong abom-num">
                            @context.Item.Priority
                        </span>
                    </MudTooltip>
                </CellTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.Severity" Title="Severity"
                            HeaderClass="abom-col-severity" CellClass="abom-col-severity">
                <CellTemplate>
                    <SeverityChip Severity="@context.Item.Severity" />
                    @* CVSS and EPSS sit beside severity as context; they are not in the score. *@
                    @if (context.Item.HasCvss || context.Item.HasEpss)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block abom-metric-note">
                            @if (context.Item.HasCvss)
                            {
                                <span>CVSS @context.Item.CvssV3Score.ToString("0.0")</span>
                            }
                            @if (context.Item.HasEpss)
                            {
                                <span class="@(context.Item.HasCvss ? "ml-1" : null)">
                                    EPSS @((context.Item.EpssPercentage * 100).ToString("0.0"))%
                                </span>
                            }
                        </MudText>
                    }
                </CellTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.GhsaId" Title="Advisory">
                <CellTemplate>
                    <div class="abom-inline">
                        <span class="abom-rule">@context.Item.GhsaId</span>
                        @if (!string.IsNullOrEmpty(context.Item.CveId))
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary abom-rule">
                                @context.Item.CveId
                            </MudText>
                        }
                    </div>
                    <MudTooltip Text="@context.Item.Summary">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary abom-summary">
                            @context.Item.Summary
                        </MudText>
                    </MudTooltip>
                </CellTemplate>
            </PropertyColumn>

            @* Direct and transitive are different work and never collapse into one number. *@
            <PropertyColumn Property="x => x.DirectRepos" Title="Direct"
                            HeaderClass="abom-col-direct" CellClass="abom-col-direct">
                <CellTemplate>
                    <MudTooltip Text="These repositories name the action themselves and can fix it.">
                        <span class="abom-num">@context.Item.DirectRepos</span>
                    </MudTooltip>
                </CellTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.TransitiveRepos" Title="Transitive"
                            HeaderClass="abom-col-transitive" CellClass="abom-col-transitive">
                <CellTemplate>
                    <MudTooltip Text="These reach it through an intermediary that may belong to someone else.">
                        <span class="abom-num @(context.Item.TransitiveRepos > 0 ? null : "abom-faint")">
                            @context.Item.TransitiveRepos
                        </span>
                    </MudTooltip>
                </CellTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.Fixable" Title="Fix"
                            HeaderClass="abom-col-fix" CellClass="abom-col-fix">
                <CellTemplate>
                    @if (context.Item.Fixable)
                    {
                        <MudText Typo="Typo.caption">available</MudText>
                    }
                    else
                    {
                        <MudTooltip Text="No patched version has been published, so this cannot be remediated by bumping a version.">
                            <MudText Typo="Typo.caption" Class="abom-coverage-unknown">none</MudText>
                        </MudTooltip>
                    }
                </CellTemplate>
            </PropertyColumn>
        </Columns>

        <ChildRowContent>
            <MudCard Elevation="0" Class="pa-3">
                <MudText Typo="Typo.subtitle2">Affected actions in use</MudText>
                @foreach (var action in context.Item.Actions)
                {
                    <div class="mt-2">
                        <MudLink Typo="Typo.body2" @onclick="@(() => Explore(action))" Class="abom-clickable">
                            @action
                        </MudLink>
                        <div class="mt-1">
                            <RefList Refs="@RefsFor(action)" />
                        </div>
                    </div>
                }

                <MudDivider Class="my-3" />
                <MudText Typo="Typo.subtitle2">Vulnerable ranges</MudText>
                @foreach (var range in RangesFor(context.Item.GhsaId))
                {
                    <MudText Typo="Typo.body2" Class="abom-ref mt-1">
                        @range.VulnerableRange
                        @(string.IsNullOrEmpty(range.FirstPatched)
                            ? " — no fix published"
                            : $" — fixed in {range.FirstPatched}")
                    </MudText>
                }

                <MudAlert Severity="MudBlazor.Severity.Normal" Dense="true" Variant="Variant.Text" Class="mt-3">
                    <MudText Typo="Typo.caption">
                        Whether a reference above falls inside a range is not decided here. The
                        <span class="abom-rule">actions/*</span> queries make that call; this view
                        reports the advisory and the references side by side.
                    </MudText>
                </MudAlert>
            </MudCard>
        </ChildRowContent>

        <PagerContent>
            <MudDataGridPager T="RemediationItem" />
        </PagerContent>
    </MudDataGrid>
}

@code {
    private IReadOnlyList<RemediationItem> _items = [];
    private IReadOnlyList<AdvisoryReach> _advisories = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _items = await Api.GetRemediationAsync(100);
        _advisories = await Api.GetAdvisoriesAsync(200);
        _loading = false;
    }

    private IReadOnlyList<string> RefsFor(string nodeKey) =>
        _advisories.SelectMany(a => a.Nodes)
                   .FirstOrDefault(n => n.NodeKey == nodeKey)?.References ?? [];

    private IReadOnlyList<AffectedRange> RangesFor(string ghsaId) =>
        _advisories.Where(a => a.GhsaId == ghsaId)
                   .SelectMany(a => a.Ranges)
                   .DistinctBy(r => r.VulnerableRange)
                   .ToList();

    private void Explore(string nodeKey) =>
        Nav.NavigateTo($"/explore?focus={Uri.EscapeDataString(nodeKey)}&view=risk");
}
