@page "/pinning"
@using Abom.WebAssembly.Models
@using Abom.WebAssembly.Services
@inject AbomApi Api
@inject AccountService Accounts

<PageTitle>Version Pinning — ABOM</PageTitle>

<PageHeader Title="Version Pinning">
    How the references in your workflows name what they depend on, and where
    <code>actions/unpinned-tag</code> objected. These are two different measurements, and they are
    kept apart on purpose. Expand any row to go from an owner to the individual
    <code>uses:</code> line.
</PageHeader>

@if (_totals is null)
{
    <MudProgressLinear Indeterminate="true" Class="my-8" />
}
else
{
    <MudGrid Class="mb-2">
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4" Elevation="0" Outlined="true">
                <MudText Typo="Typo.overline" Class="mud-text-secondary">References naming a commit</MudText>
                <MudText Typo="Typo.h4">@_totals.CommitShare.ToString("P1")</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    @_totals.Commit.ToString("N0") of @_totals.Pinnable.ToString("N0") pinnable references
                </MudText>
                <MudProgressLinear Color="Color.Primary" Value="@(_totals.CommitShare * 100)"
                                   Class="mt-3" Rounded="true" Size="Size.Small" />
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4" Elevation="0" Outlined="true">
                <MudText Typo="Typo.overline" Class="mud-text-secondary">Flagged by actions/unpinned-tag</MudText>
                <MudText Typo="Typo.h4">@_totals.Flagged.ToString("N0")</MudText>
                @if (Accounts.AnyVerified)
                {
                    @* Both halves, always: the actionable figure without losing the corpus figure. *@
                    <MudText Typo="Typo.body2">
                        <b>@_totals.FlaggedSplit.Yours.ToString("N0")</b> in your accounts,
                        <span class="mud-text-secondary">@_totals.FlaggedSplit.Elsewhere.ToString("N0") elsewhere</span>
                    </MudText>
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        references the query objected to
                    </MudText>
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4" Elevation="0" Outlined="true">
                <MudText Typo="Typo.overline" Class="mud-text-secondary">Floating, not flagged</MudText>
                <MudText Typo="Typo.h4">@_totals.FloatingUnflagged.ToString("N0")</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    named by tag or branch, but outside the query's scope
                </MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4" Variant="Variant.Outlined">
        <MudText Typo="Typo.body2">
            <b>Why the two numbers differ.</b>
            @_totals.Floating.ToString("N0") references name a tag or branch rather than a commit,
            yet <code>actions/unpinned-tag</code> flagged @_totals.Flagged.ToString("N0") of them —
            it leaves GitHub-owned actions alone. Whether a reference is <i>safely</i> pinned is that
            query's call, not ABOM's; the commit share reports only how each reference is written.
            Repositories whose workflows were never analyzed are absent from these figures, which is
            not the same as their being fully pinned.
        </MudText>
    </MudAlert>

    <MudPaper Elevation="0" Outlined="true" Class="pa-2 mb-3 abom-filters">
        <div class="d-flex flex-wrap align-center gap-3">
            <MudTextField T="string" Value="_search" ValueChanged="OnSearchChanged"
                          DebounceInterval="350" Immediate="true" Label="Name contains"
                          Placeholder="owner, repo, workflow or action" Variant="Variant.Outlined"
                          Margin="Margin.Dense" Clearable="true" ShrinkLabel="true"
                          Class="abom-filter-wide" />

            <MudTooltip Text="How the reference is written, not whether it is safe.">
                <MudSelect T="string" Label="Reference" Value="_refStyle"
                           ValueChanged="OnRefStyleChanged" Dense="true" Margin="Margin.Dense"
                           Variant="Variant.Outlined" ShrinkLabel="true" Class="abom-filter">
                    <MudSelectItem T="string" Value="@("")">any</MudSelectItem>
                    <MudSelectItem T="string" Value="@("commit")">names a commit</MudSelectItem>
                    <MudSelectItem T="string" Value="@("tag")">names a tag</MudSelectItem>
                </MudSelect>
            </MudTooltip>

            <MudCheckBox T="bool" Value="_flaggedOnly" ValueChanged="OnFlaggedChanged"
                         Color="Color.Primary" Size="Size.Small" Dense="true"
                         Label="Flagged by the rule only" />

            <MudSpacer />

            <MudTooltip Text="@ExplorerCaveat">
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Hub" Href="@ExplorerLink">
                    Open this view in the Explorer
                </MudButton>
            </MudTooltip>
        </div>
        @if (_filter.IsActive)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1 d-block">
                Every figure above and below counts only the references this filter admits, so a
                row still equals the sum of the rows beneath it.
            </MudText>
        }
    </MudPaper>

    <PinningLevel Scope="owner" Filter="_filter" RowsPerPage="25"
                  Baseline="@(_totals?.CommitShare ?? 0)" />
}

@code {
    private PinningRow? _totals;
    private PinningQuery _filter = new();
    private string _search = string.Empty;
    private string _refStyle = string.Empty;
    private bool _flaggedOnly;

    private const string ExplorerCaveat =
        "The Explorer filters nodes: it keeps an action if any one of its references is written " +
        "that way. This page counts individual references, so the two will not show equal totals.";

    private string ExplorerLink
    {
        get
        {
            var query = new List<string>();
            if (!string.IsNullOrWhiteSpace(_search)) query.Add($"q={Uri.EscapeDataString(_search)}");
            if (_refStyle == "commit") query.Add("refStyle=sha");
            if (_refStyle == "tag") query.Add("refStyle=tag");
            if (_flaggedOnly) query.Add("rules=actions%2Funpinned-tag");
            return query.Count == 0 ? "/explore" : "/explore?" + string.Join("&", query);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Accounts.EnsureLoadedAsync();
        await Reload();
    }

    private async Task OnSearchChanged(string value)
    {
        _search = value ?? string.Empty;
        await Reload();
    }

    private async Task OnRefStyleChanged(string value)
    {
        _refStyle = value ?? string.Empty;
        await Reload();
    }

    private async Task OnFlaggedChanged(bool value)
    {
        _flaggedOnly = value;
        await Reload();
    }

    private async Task Reload()
    {
        _filter = new PinningQuery
        {
            Search = _search,
            RefStyle = _refStyle,
            FlaggedOnly = _flaggedOnly,
        };
        _totals = await Api.GetPinningTotalsAsync(_filter);
    }
}
