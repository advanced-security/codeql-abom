@page "/"
@inject AbomApi Api

<PageTitle>ABOM — Actions Bill of Materials</PageTitle>

@* No coverage strip here. How complete the picture is belongs to Discovery, which answers it per
   depth, per queue state and per business unit; a second, shorter answer on the landing page was
   read as the whole one. This surface hands over a scope and states nothing it is not the best
   place to state. *@
<PageHeader Title="Actions Bill of Materials">
    Where do you want to start? Each of these opens the Inventory already narrowed to it.
</PageHeader>

<MudGrid Spacing="3">
    @foreach (var s in Entries)
    {
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Elevation="0" Outlined="true" Class="pa-4 abom-section-card"
                      @onclick="@(() => Go(s.Href))" data-abom-entry="@s.Key">
                <div class="d-flex align-center gap-2 mb-2">
                    <MudIcon Icon="@s.Icon" Color="Color.Primary" Size="Size.Small" />
                    <MudLink Href="@s.Href" Typo="Typo.subtitle1">@s.Title</MudLink>
                </div>
                <MudText Typo="Typo.h5" Class="abom-num">@s.Count.ToString("N0")</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@s.Measures</MudText>
            </MudPaper>
        </MudItem>
    }
</MudGrid>

<div class="d-flex flex-wrap align-center gap-2 mt-4">
    <MudText Typo="Typo.caption" Class="mud-text-secondary">Or go straight to</MudText>
    <MudButton Size="Size.Small" DropShadow="false" Variant="Variant.Outlined"
               StartIcon="@Icons.Material.Outlined.Hub" Href="/explore">the graph</MudButton>
    <MudButton Size="Size.Small" DropShadow="false" Variant="Variant.Outlined"
               StartIcon="@Icons.Material.Outlined.TravelExplore" Href="/inventory?unit=coverage"
               data-abom-entry="coverage">what has and has not been analyzed</MudButton>
</div>

@code {
    private Summary _summary = new();

    [Inject] private NavigationManager Nav { get; set; } = default!;

    protected override async Task OnInitializedAsync() => _summary = await Api.GetSummaryAsync();

    private void Go(string href) => Nav.NavigateTo(href);

    private sealed record Entry(string Key, string Title, int Count, string Measures, string Href,
        string Icon);

    // Every control names a count it can produce and the scope that produces it. Nothing here
    // exists because the page looked empty.
    private IEnumerable<Entry> Entries =>
    [
        new("findings", "Workflows with findings", _summary.Findings,
            $"findings across {_summary.Rules} rules, in what you run",
            "/inventory?unit=workflows&flags=findings", Icons.Material.Outlined.PlayCircleOutline),
        new("advisories", "Advisories reaching you", _summary.Advisories,
            $"published advisories, naming {_summary.AffectedActions:N0} actions in use",
            "/inventory?unit=advisories", Icons.Material.Outlined.Build),
        new("actions", "Actions you depend on", _summary.Nodes,
            "nodes in the graph, at every depth",
            "/inventory", Icons.Material.Outlined.Extension),
        new("repositories", "Repositories you own", _summary.OwnedRepos,
            $"declared, reaching {_summary.UpstreamRepos:N0} upstream",
            "/inventory?unit=repositories&scope=owned", Icons.Material.Outlined.FolderOpen),
        new("exposure", "On a route to an advisory", _summary.Exposures,
            "routes from something you own to a live advisory",
            "/inventory?scope=exposure", Icons.Material.Outlined.Route),
    ];
}
