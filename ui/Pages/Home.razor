@page "/"
@inject AbomApi Api
@inject DeclarationService Declaration

<PageTitle>ABOM — Actions Bill of Materials</PageTitle>

@* No coverage strip here. How complete the picture is belongs to Discovery, which answers it per
   depth, per queue state and per business unit; a second, shorter answer on the landing page was
   read as the whole one. This surface hands over a scope and states nothing it is not the best
   place to state. *@
<PageHeader Title="Actions Bill of Materials">
    Learn how to use ABOM, or open the Inventory narrowed to one of the scopes below.
</PageHeader>

<TutorialChecklist />

<DeclarationState />

@if (_read && _summary is null)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" data-abom-summary-unread>
        ABOM could not read its figures just now, so none is shown. Reload the page to ask again.
    </MudAlert>
}

<section class="abom-home-scopes" data-abom-home-scopes aria-labelledby="abom-home-scopes-title">
<h2 id="abom-home-scopes-title" class="mud-typography mud-typography-subtitle1">Explore your inventory</h2>
<MudGrid Spacing="3">
    @foreach (var s in Entries)
    {
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Elevation="0" Outlined="true" Class="pa-4 abom-section-card" title="@s.Tip"
                      @onclick="@(() => Go(s.Href))" data-abom-entry="@s.Key">
                <div class="d-flex align-center gap-2 mb-2">
                    <MudIcon Icon="@s.Icon" Color="Color.Primary" Size="Size.Small" />
                    <MudLink Href="@s.Href" Typo="Typo.subtitle1" title="@s.Tip">@s.Title</MudLink>
                </div>
                @* style-check: off — each card is a link into the scope its figure counts, so the
                   figure is the way in rather than a count tile beside one. *@
                <MudText Typo="Typo.h5" data-abom-count
                         Class="@(Said(s) is null ? "abom-num" : "abom-num abom-coverage-unknown")">
                    @(Said(s) ?? s.Count.ToString("N0"))
                </MudText>
                @* style-check: on *@
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@s.Measures</MudText>
                @if (s.Severity.Length > 0 && Said(s) is null)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block"
                             data-abom-entry-severity>@s.Severity</MudText>
                }
            </MudPaper>
        </MudItem>
    }
</MudGrid>

<div class="d-flex flex-wrap align-center gap-2 mt-4">
    <MudText Typo="Typo.caption" Class="mud-text-secondary">Or go straight to</MudText>
    <MudButton Size="Size.Small" DropShadow="false" Variant="Variant.Outlined"
               StartIcon="@Icons.Material.Outlined.Hub" Href="/explore"
               title="Open the Explorer graph of dependencies.">the graph</MudButton>
    <MudButton Size="Size.Small" DropShadow="false" Variant="Variant.Outlined"
               StartIcon="@Icons.Material.Outlined.TravelExplore" Href="/inventory?unit=coverage"
               title="Open the Inventory coverage unit showing what has and has not been analyzed."
               data-abom-entry="coverage">what has and has not been analyzed</MudButton>
</div>
</section>

@code {
    private Summary? _summary;
    private bool _read;
    private ScopeDecision? _decision;

    [Inject] private NavigationManager Nav { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _summary = await Api.GetSummaryAsync();
        _read = true;
        _decision = await Declaration.ReadAsync();
    }

    private void Go(string href) => Nav.NavigateTo(href);

    private sealed record Entry(string Key, string Title, int Count, string Measures, string Href,
        string Icon, string Tip, bool Owned = false, string Severity = "");

    // What a card says in place of its count, or null when the count stands. Nothing read is not a
    // nought; a declaration nobody confirmed is not an empty one; and nothing declared is an absence
    // of a claim, which the coverage strip says in this same word. Each nought would read as a set
    // examined and found clean.
    private string? Said(Entry e) =>
        !_read ? "\u2026"
        : _summary is null ? "not read"
        : e.Owned && DeclarationService.Unconfirmed(_decision) ? DeclarationWords.NotConfirmed
        : e.Owned && _summary.OwnedRepos == 0 ? "none"
        : null;

    private Summary S => _summary ?? new();

    // Every control names a count it can produce and the scope that produces it. Where a figure
    // can be bounded to the declaration it is, and the total it was drawn from is named beside
    // it: ABOM can hold hundreds of repositories and own none of them, and either half on its
    // own reads as the other.
    private IEnumerable<Entry> Entries =>
    [
        new("findings", "Findings in what you own", S.OwnedFindings,
            $"of {S.Findings:N0} recorded, across {S.Rules} rules",
            "/inventory?unit=workflows&flags=findings", Icons.Material.Outlined.PlayCircleOutline,
            "Open the Inventory at the workflows that have findings.", Owned: true, Severity: SeverityText.Summary(S.OwnedSeverity)),
        new("advisories", "Advisories recorded", S.Advisories,
            $"published advisories, naming {S.AffectedActions:N0} actions in use",
            "/inventory?unit=advisories", Icons.Material.Outlined.Build,
            "Open the Inventory at the published advisories that name an action in use."),
        new("actions", "Dependencies in use", S.Dependencies,
            "actions, composite actions and images your starting points run or hold",
            "/inventory", Icons.Material.Outlined.Extension,
            "Open the Inventory at every action, composite action and image your starting points run or hold."),
        new("repositories", "Repositories you own", S.OwnedRepos,
            $"declared of {S.SeedRepos:N0}",
            "/inventory?unit=repositories&scope=owned", Icons.Material.Outlined.FolderOpen,
            "Open the Inventory at the repositories you declared as yours.", Owned: true),
        new("exposure", "On a route to an advisory", S.OwnedExposures,
            $"from a repository you declared, of {S.Exposures:N0} recorded",
            "/inventory?scope=exposure", Icons.Material.Outlined.Route,
            "Open the Inventory at the actions on a route from a repository you declared to an advisory.",
            Owned: true),
    ];
}
