@page "/explore"
@implements IAsyncDisposable
@inject AbomApi Api
@inject ThemeService Theme
@inject IJSRuntime Js
@inject NavigationManager Nav
@inject FollowService Follow

<PageTitle>Explorer — ABOM</PageTitle>

<MudPaper Elevation="0" Class="pa-2 mb-2 abom-filters" Outlined="true">
    <div class="d-flex flex-wrap align-center gap-2">
        <MudTextField T="string" Value="_search" ValueChanged="OnSearchChanged" Immediate="false"
                      DebounceInterval="300" Label="Name contains"
                      Placeholder="repo, workflow or action" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Clearable="true" ShrinkLabel="true"
                      Class="abom-filter-wide" />

        <MudSelect T="string" Label="Origin" MultiSelection="true" SelectedValues="_origins"
                   SelectedValuesChanged="OnOriginsChanged" Dense="true" Margin="Margin.Dense"
                   Variant="Variant.Outlined" Class="abom-filter" ShrinkLabel="true"
                   MultiSelectionTextFunc="@(v => v.Count == 0 ? "any" : $"{v.Count} selected")">
            <MudSelectItem T="string" Value="@("seed")">In scope</MudSelectItem>
            <MudSelectItem T="string" Value="@("upstream")">Upstream</MudSelectItem>
            <MudSelectItem T="string" Value="@("external")">Dependency</MudSelectItem>
        </MudSelect>

        <MudSelect T="string" Label="CodeQL rule" MultiSelection="true" SelectedValues="_rules"
                   SelectedValuesChanged="OnRulesChanged" Dense="true" Margin="Margin.Dense"
                   Variant="Variant.Outlined" Class="abom-filter" ShrinkLabel="true"
                   MultiSelectionTextFunc="@(v => v.Count == 0 ? "any" : $"{v.Count} selected")">
            @foreach (var r in _ruleIds)
            {
                <MudSelectItem T="string" Value="@r">@r</MudSelectItem>
            }
        </MudSelect>

        @* Lexical only. Whether a reference is safe is actions/unpinned-tag's call, not ours. *@
        <MudTooltip Text="How the reference is written, not whether it is safe. For that, filter by the actions/unpinned-tag rule.">
            <MudSelect T="string" Label="Reference" Value="_refStyle" ValueChanged="OnRefStyleChanged"
                       Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                       ShrinkLabel="true" Class="abom-filter">
                <MudSelectItem T="string" Value="@("any")">any</MudSelectItem>
                <MudSelectItem T="string" Value="@("sha")">commit SHA</MudSelectItem>
                <MudSelectItem T="string" Value="@("tag")">tag or branch</MudSelectItem>
            </MudSelect>
        </MudTooltip>

        <MudTooltip Text="Show only nodes used by at least this many repositories. Leave blank for all.">
            <MudNumericField T="int?" Value="_minReach" ValueChanged="OnMinReachChanged" Min="1"
                             Label="Used by ≥" Placeholder="any" Variant="Variant.Outlined"
                             Margin="Margin.Dense" Clearable="true" ShrinkLabel="true"
                             Class="abom-filter-narrow" />
        </MudTooltip>

        <MudChipSet T="string" SelectedValues="_flags" SelectedValuesChanged="OnFlagsChanged"
                    SelectionMode="SelectionMode.MultiSelection" CheckMark="true" Size="Size.Small">
            <MudChip T="string" Value="@("findings")" Variant="Variant.Outlined">has findings</MudChip>
            <MudChip T="string" Value="@("advisory")" Variant="Variant.Outlined">has advisory</MudChip>
            <MudChip T="string" Value="@("unanalyzed")" Variant="Variant.Outlined">not analyzed</MudChip>
        </MudChipSet>
    </div>

    <div class="d-flex flex-wrap align-center gap-3 mt-2">
        <MudToggleGroup T="string" Value="_view" ValueChanged="OnViewChanged"
                        Size="Size.Small" Color="Color.Primary" CheckMark="false"
                        SelectionMode="SelectionMode.SingleSelection" Class="abom-views">
            @foreach (var v in Views)
            {
                @* The tooltip has to sit outside the item: a disabled MudToggleItem suppresses
                   pointer events on its children, so the one tooltip a reader needs -- the one
                   saying why it is disabled -- was the one that could never fire. *@
                <MudToggleItem T="string" Value="@v.Key" Disabled="@(v.NeedsSelection && !HasSelection)">
                    <span class="abom-view-label" title="@ViewTooltip(v)">@v.Label</span>
                </MudToggleItem>
            }
        </MudToggleGroup>
        <MudCheckBox T="bool" Value="_use3d" ValueChanged="On3dChanged" Color="Color.Primary"
                     Size="Size.Small" Dense="true" Label="3D" />
        <MudSelect T="string" Label="Group by" Value="_groupBy" ValueChanged="OnGroupByChanged"
                   Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                   ShrinkLabel="true" Class="abom-filter">
            <MudSelectItem T="string" Value="@("owner")">Owner</MudSelectItem>
            <MudSelectItem T="string" Value="@("repo")">Repository</MudSelectItem>
            <MudSelectItem T="string" Value="@("workflow")">Workflow path</MudSelectItem>
            <MudSelectItem T="string" Value="@("none")">Nothing</MudSelectItem>
        </MudSelect>
        <MudTooltip Text="Collapse each group into a single node. Click one to open it again.">
            <MudCheckBox T="bool" Value="_collapsed" ValueChanged="OnCollapsedChanged"
                         Color="Color.Primary" Size="Size.Small" Dense="true" Label="Collapse"
                         Disabled="@(_groupBy == "none")" />
        </MudTooltip>
        @if (_groupBy == "workflow" && !ShowSteps)
        {
            @* Actions are referenced by workflows rather than held in one, so with steps folded
               away there is little left for this grouping to gather. *@
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                turn on Step to group by workflow
            </MudText>
        }
        <MudTooltip Text="Watch the layout arrange itself and the selection's dependencies flow, or hold everything still.">
            <MudCheckBox T="bool" Value="_animate" ValueChanged="OnAnimateChanged"
                         Color="Color.Primary" Size="Size.Small" Dense="true"
                         Label="Animate" />
        </MudTooltip>

        @if (!string.IsNullOrEmpty(_isolated))
        {
            <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined" Size="Size.Small"
                     OnClose="ClearSelection" CloseIcon="@Icons.Material.Filled.Close">
                only @_isolated
            </MudChip>
            <MudSelect T="int" Label="Hops" Value="_hops" ValueChanged="OnHopsChanged" Dense="true"
                       Margin="Margin.Dense" Variant="Variant.Outlined" ShrinkLabel="true"
                       Class="abom-filter-narrow">
                <MudSelectItem T="int" Value="0">all</MudSelectItem>
                @for (var h = 1; h <= 6; h++)
                {
                    var v = h;
                    <MudSelectItem T="int" Value="@v">@v</MudSelectItem>
                }
            </MudSelect>
            <MudTooltip Text="@DirectionMeaning">
                <MudSelect T="string" Label="Follow" Value="_direction"
                           ValueChanged="OnDirectionChanged" Dense="true" Margin="Margin.Dense"
                           Variant="Variant.Outlined" ShrinkLabel="true" Class="abom-filter">
                    @foreach (var d in Directions)
                    {
                        <MudSelectItem T="string" Value="@d.Key">@d.Label</MudSelectItem>
                    }
                </MudSelect>
            </MudTooltip>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="ClearSelection">
                Back to the whole graph
            </MudButton>
            @if (CameFromDiscovery)
            {
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Search" Href="@BackToDiscovery">
                    Back to Discovery
                </MudButton>
            }
        }
        else if (HasSelection)
        {
            <MudText Typo="Typo.caption" Class="abom-rule">@SelectionLabel</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                @(_selected.Count > 1
                    ? "cmd or ctrl click to add and remove"
                    : "double-click to show only its dependencies · cmd or ctrl click to compare")
            </MudText>
        }
        @if (_selected.Count == 1)
        {
            @* One node, one detail page: the link would be ambiguous for several. *@
            <MudLink Href="@($"/node/{_selected[0]}")" Typo="Typo.caption">open details</MudLink>
        }
        <MudSpacer />
        <MudTooltip Text="@(_showLegend ? "Hide the key and give the graph the full width." : "Show the node and edge key, and filter by it.")">
            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ToggleKeyPanel"
                       EndIcon="@(_showLegend ? Icons.Material.Filled.ChevronRight : Icons.Material.Filled.ChevronLeft)">
                Nodes &amp; edges
            </MudButton>
        </MudTooltip>
    </div>
</MudPaper>

@* Key and canvas side by side: there is far more room left-to-right than up-and-down, and the
   checkboxes are only useful while you can see what they are changing. *@
<div class="abom-explore">
    <MudPaper Elevation="0" Outlined="true" Class="pa-0 abom-explore-canvas">
        <div class="abom-graph-wrap">
            <div id="abom-graph" class="abom-graph-host"></div>
            @if (_busy)
            {
                <div class="@(_animate ? "abom-graph-busy" : "abom-graph-busy abom-graph-busy-opaque")">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" />
                    <MudText Typo="Typo.caption" Class="mt-2">@_busyMessage</MudText>
                </div>
            }
        </div>
    </MudPaper>

    @if (_showLegend)
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-2 abom-explore-key abom-keypanel">
            @if (_view == "frontier")
            {
                @* Hue means something else in this view, so the key has to say so where the
                   reader is looking, not leave the kind colors below to be misread. *@
                <div class="d-flex align-center abom-key-head">
                    <span class="abom-key-title">COLOR: DISCOVERY STATE</span>
                </div>
                @foreach (var state in ThemeService.DiscoveryNames)
                {
                    <div class="abom-key-row">
                        <span class="abom-legend-dot"
                              style="--abom-legend-color:@DiscoveryColor(state.Key)"></span>
                        <span class="abom-key-label">@state.Value</span>
                    </div>
                }
                <div class="abom-key-row">
                    <span class="abom-legend-dot"
                          style="--abom-legend-color:@Theme.Palette.Muted"></span>
                    <span class="abom-key-label">never a dependency</span>
                </div>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">
                    Rings are how far each dependency sits from the repositories you review. The
                    colors below filter which nodes are shown, not what they are colored.
                </MudText>
            }
            <div class="d-flex align-center abom-key-head">
                <MudCheckBox T="bool?" Value="@AllNodesChecked" ValueChanged="OnAllNodesChanged"
                             TriState="true" Dense="true" Size="Size.Small" Color="Color.Primary" />
                <span class="abom-key-title">SHOW ALL NODES</span>
                @if (Theme.HasKindOverrides)
                {
                    <MudTooltip Text="Put every node kind back to its default color.">
                        <MudIconButton Icon="@Icons.Material.Filled.FormatColorReset" Size="Size.Small"
                                       OnClick="ResetColors" Class="ml-1" />
                    </MudTooltip>
                }
            </div>
            @foreach (var kind in ThemeService.KindNames)
            {
                var k = kind.Key;
                <div class="abom-key-row">
                    <MudCheckBox T="bool" Value="@_kinds.Contains(k)" Dense="true"
                                 Size="Size.Small" Color="Color.Primary"
                                 ValueChanged="@(_ => ToggleKind(k))" />
                    @KindGlyph(k)
                    <MudTooltip Text="@KindHelp(k)" Placement="Placement.Left">
                        <span class="abom-key-label" @onclick="@(() => ToggleKind(k))">@kind.Value</span>
                    </MudTooltip>
                    @* Color is reassignable per kind and per scheme: a hue that reads well on
                       black rarely does on white. *@
                    <MudTooltip Text="Change this kind's color.">
                        <input type="color" class="abom-swatch" value="@KindColor(k)"
                               @onchange="@(e => SetColor(k, e.Value?.ToString()))" />
                    </MudTooltip>
                </div>
            }

            <div class="d-flex align-center abom-key-head mt-3">
                <MudCheckBox T="bool?" Value="@AllEdgesChecked" ValueChanged="OnAllEdgesChanged"
                             TriState="true" Dense="true" Size="Size.Small" Color="Color.Primary" />
                <span class="abom-key-title">SHOW ALL EDGES</span>
            </div>
            @foreach (var e in EdgeKinds)
            {
                var c = e.Key;
                <MudTooltip Text="@e.Help" Placement="Placement.Left">
                    <div class="abom-key-row" @onclick="@(() => ToggleEdge(c))">
                        <MudCheckBox T="bool" Value="@_edgeClasses.Contains(c)" Dense="true"
                                     Size="Size.Small" Color="Color.Primary"
                                     ValueChanged="@(_ => ToggleEdge(c))" />
                        <span class="abom-legend-line" style="--abom-legend-color:@EdgeColor(c)"></span>
                        <span>@e.Label</span>
                    </div>
                </MudTooltip>
            }

            <div class="abom-key-head mt-3"><span class="abom-key-title">STATE</span></div>
            @* A caption, not a control: the rows above are clickable and this one never was. *@
            <div class="abom-key-note">
                <span class="abom-legend-ring" style="--abom-legend-color:@Theme.Palette.Focus"></span>
                @if (!HasSelection)
                {
                    <span>nothing selected &mdash; click a node to mark it and dim the rest</span>
                }
                else
                {
                    <span class="abom-key-selected">@SelectionLabel</span>
                }
            </div>
            @* Color carries kind and only kind. Saying so stops the key implying that a
               repository under review and one fetched as a dependency look different here. *@
            <div class="abom-key-note">
                <span>in scope and upstream are not colored apart &mdash; use the Origin filter</span>
            </div>
            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2 d-block">
                @PositionMeaning
            </MudText>
        </MudPaper>
    }
</div>

<div class="d-flex flex-wrap align-center gap-3 mt-1">
    <MudText Typo="Typo.caption" Class="mud-text-secondary">
        @if (_loading)
        {
            <span>Loading the whole graph…</span>
        }
        else if (_collapsed)
        {
            @* Grouped, not filtered: nothing was removed, so saying "hidden" would be wrong. *@
            <span>
                <b>@_counts.Nodes.ToString("N0")</b> groups by @GroupByLabel, gathered from
                @_counts.Total.ToString("N0") nodes
                <span class="mud-text-secondary">· click a group to expand it</span>
            </span>
        }
        else
        {
            <span>
                Showing <b>@_counts.Nodes.ToString("N0")</b> nodes out of
                @_counts.Total.ToString("N0") total
                @if (_counts.Hidden > 0)
                {
                    <span>(@_counts.Hidden.ToString("N0") nodes hidden by filters)</span>
                }
                @* Folding is a different mechanism from the filters, so it gets its own clause
                   rather than being counted as "hidden". *@
                @if (!ShowSteps)
                {
                    <span class="mud-text-secondary">
                        · individual <code>uses:</code> steps counted as part of their workflow
                    </span>
                }
            </span>
        }
        @if (_arrived > 0)
        {
            <span class="mud-text-secondary">
                · @_arrived.ToString("N0") arrived from a running expansion
            </span>
        }
        @if (_pollError is { } failure)
        {
            <span class="abom-status-unavailable">· could not refresh: @failure</span>
        }
    </MudText>
    <MudSpacer />
    <FollowControl LastUpdated="_lastPoll" />
</div>

@code {
    [SupplyParameterFromQuery(Name = "selection")] public string? SelectionParam { get; set; }
    [SupplyParameterFromQuery(Name = "view")] public string? ViewParam { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? SearchParam { get; set; }
    [SupplyParameterFromQuery(Name = "refStyle")] public string? RefStyleParam { get; set; }
    [SupplyParameterFromQuery(Name = "rules")] public string? RulesParam { get; set; }
    [SupplyParameterFromQuery(Name = "origins")] public string? OriginsParam { get; set; }
    [SupplyParameterFromQuery(Name = "kinds")] public string? KindsParam { get; set; }
    [SupplyParameterFromQuery(Name = "flags")] public string? FlagsParam { get; set; }
    [SupplyParameterFromQuery(Name = "minReach")] public int? MinReachParam { get; set; }
    [SupplyParameterFromQuery(Name = "direction")] public string? DirectionParam { get; set; }
    [SupplyParameterFromQuery(Name = "from")] public string? FromParam { get; set; }
    [SupplyParameterFromQuery(Name = "status")] public string? StatusParam { get; set; }

    // NeedsSelection marks a view whose force reads hop distance from a selected node. Without
    // one it has nothing to measure from, so it is disabled rather than silently inert.
    private sealed record ViewOption(string Key, string Label, string Meaning,
        bool NeedsSelection = false);
    private sealed record Counts(int Nodes, int Edges, int Hidden, int Total);

    private sealed record MergeResult(
        bool Reset, long Generation, int Nodes, int Edges, IReadOnlyList<string> Rules)
    {
        public IReadOnlyList<string> Rules { get; init; } = Rules ?? [];
    }

    private long _generation;
    private int _arrived;
    private DateTime? _lastPoll;
    private string? _pollError;
    private Timer? _followTimer;

    // Which way a neighborhood is walked. "What does this pull in" and "who is waiting on this"
    // are different questions, and a queued dependency has no answer to the first at all.
    private string _direction = "both";

    private sealed record DirectionOption(string Key, string Label, string Meaning);

    private static readonly DirectionOption[] Directions =
    [
        new("both", "Both ways", "Everything connected to the selection, either way round."),
        new("out", "What it uses", "Only what the selection depends on, recursively."),
        new("in", "What uses it", "Only what depends on the selection, recursively."),
    ];

    private static readonly ViewOption[] Views =
    [
        new("neighborhood", "Neighborhood",
            "Position is structural: clusters are groups that share dependencies."),
        new("priority", "Priority",
            "Distance from the center is remediation priority — closer is more urgent."),
        new("ownership", "Who can fix it",
            "Close in is yours to change; further out, someone else owns the fix.",
            NeedsSelection: true),
        new("distance", "Distance",
            "Rings are hops from the selected node.", NeedsSelection: true),
        new("frontier", "Coverage",
            "Color is how much is known about each dependency. Rings are how far it sits from "
            + "the repositories you review. Grey means it was never a dependency."),
    ];

    private static readonly Dictionary<string, string> Kinds = ThemeService.KindNames;

    private sealed record EdgeKind(string Key, string Label, string Help);

    private static readonly EdgeKind[] EdgeKinds =
    [
        new("sameRepo", "Same repo",
            "Both ends live in the same repository: internal wiring rather than a supply-chain hop."),
        new("sameOwner", "Same org/owner",
            "Crosses repositories but stays with one account. Same repo wins over this."),
        new("crossOwner", "Cross org/owner",
            "The two ends belong to different accounts. This is where the supply chain starts."),
    ];

    private static readonly Dictionary<string, string> KindHelpText = new()
    {
        ["org"] = "An account, user or organization alike. Holds the repositories and actions beneath it, and is the broadest way to see who your organization depends on.",
        ["repo"] = "A repository. Connected to the workflows and composite actions it holds.",
        ["workflow"] = "A workflow file. Where `uses:` references are written.",
        ["reusable_workflow"] = "A workflow other repositories can call. Its own dependencies become theirs.",
        ["composite_action"] = "An action built from steps. Counts as an action, not a workflow.",
        ["action"] = "An action being depended on.",
        ["docker_image"] = "A container image referenced by a step.",
        ["job"] = "A job within a workflow. Only present when steps are shown; otherwise counted as part of its workflow.",
        ["step"] = "One individual `uses:` line. Off by default: there are 14,645 of them.",
    };

    private string KindHelp(string kind) =>
        KindHelpText.TryGetValue(kind, out var h) ? h : kind;

    private string EdgeColor(string cls) => cls switch
    {
        "sameRepo" => Theme.Palette.EdgeSameRepo,
        "sameOwner" => Theme.Palette.EdgeSameOwner,
        _ => Theme.Palette.EdgeCrossOwner,
    };

    /// <summary>The legend glyph matches the geometry the renderer actually draws.</summary>
    private RenderFragment KindGlyph(string kind) => builder =>
    {
        var color = KindColor(kind);
        builder.AddMarkupContent(0, kind switch
        {
            "org" => $"<svg class='abom-glyph' viewBox='0 0 16 16'><polygon points='8,2.5 13.2,6.3 11.2,12.5 4.8,12.5 2.8,6.3' fill='{color}'/></svg>",
            "repo" => $"<svg class='abom-glyph' viewBox='0 0 16 16'><rect x='3' y='3' width='10' height='10' fill='{color}'/></svg>",
            "workflow" => $"<svg class='abom-glyph' viewBox='0 0 16 16'><circle cx='8' cy='8' r='5.5' fill='{color}'/></svg>",
            "reusable_workflow" => $"<svg class='abom-glyph' viewBox='0 0 16 16'><polygon points='8,2 14,8 8,14 2,8' fill='{color}'/></svg>",
            "composite_action" => $"<svg class='abom-glyph' viewBox='0 0 16 16'><polygon points='8,2 14,14 2,14' fill='{color}'/></svg>",
            "action" => $"<svg class='abom-glyph' viewBox='0 0 16 16'><polygon points='8,2 13.2,5 13.2,11 8,14 2.8,11 2.8,5' fill='{color}'/></svg>",
            "docker_image" => $"<svg class='abom-glyph' viewBox='0 0 16 16'><rect x='3.5' y='3' width='9' height='10' rx='4.5' fill='{color}'/></svg>",
            _ => $"<svg class='abom-glyph' viewBox='0 0 16 16'><polygon points='8,4 13,13 3,13' fill='{color}'/></svg>",
        });
    };

    private bool? AllNodesChecked => _kinds.Count == Kinds.Count ? true
        : _kinds.Count == 0 ? false : null;

    private bool? AllEdgesChecked => _edgeClasses.Count == EdgeKinds.Length ? true
        : _edgeClasses.Count == 0 ? false : null;

    private async Task SetColor(string kind, string? color)
    {
        await Theme.SetKindColorAsync(kind, color);
        await PushPalette();
    }

    private async Task ResetColors()
    {
        await Theme.ResetKindColorsAsync();
        await PushPalette();
    }

    private async Task PushPalette()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("setPalette", "abom-graph", Theme.Palette);
            // A shape carries its color in a material built when the mesh was created, so it
            // has to be rebuilt rather than merely repainted.
            await _module.InvokeVoidAsync("rebuildNodes", "abom-graph");
        }
    }

    private async Task ToggleKind(string kind)
    {
        var next = new HashSet<string>(_kinds);
        if (!next.Remove(kind)) next.Add(kind);
        var wasShowingSteps = ShowSteps;
        _kinds = next;
        // Steps are a different payload, not a different predicate.
        if (ShowSteps != wasShowingSteps) await LoadGraph();
        else await Refilter();
    }

    private async Task ToggleEdge(string cls)
    {
        var next = new HashSet<string>(_edgeClasses);
        if (!next.Remove(cls)) next.Add(cls);
        _edgeClasses = next;
        await Refilter();
    }

    private async Task OnAllNodesChanged(bool? value)
    {
        var wasShowingSteps = ShowSteps;
        _kinds = value == true ? Kinds.Keys.ToHashSet() : [];
        if (ShowSteps != wasShowingSteps) await LoadGraph();
        else await Refilter();
    }

    private async Task OnAllEdgesChanged(bool? value)
    {
        _edgeClasses = value == true ? EdgeKinds.Select(e => e.Key).ToHashSet() : [];
        await Refilter();
    }

    private string _view = "neighborhood";
    private string _search = string.Empty;
    private string _refStyle = "any";
    private int? _minReach;
    private int _hops;
    private bool _use3d = true;
    private bool _animate = true;
    // Open by default: the key is beside the canvas rather than over it, and its checkboxes are
    // the primary way to narrow the graph.
    private bool _showLegend = true;
    private bool _loading = true;
    private bool _busy = true;
    private string _busyMessage = "Loading the whole graph…";
    private List<string> _selected = [];
    private string _groupBy = "owner";
    private bool _collapsed;

    private string GroupByLabel => _groupBy switch
    {
        "repo" => "repository",
        "workflow" => "workflow path",
        _ => "owner",
    };
    private string _isolated = string.Empty;
    // Everything visible on arrival except steps and jobs, which only exist in the expanded
    // payload and would add 20,000 nodes.
    private static readonly string[] OffByDefault = ["step", "job"];

    private IReadOnlyCollection<string> _kinds =
        ThemeService.KindNames.Keys.Where(k => k != "step" && k != "job").ToHashSet();
    private IReadOnlyCollection<string> _origins = [];
    private IReadOnlyCollection<string> _rules = [];
    private IReadOnlyCollection<string> _edgeClasses =
        new HashSet<string> { "sameRepo", "sameOwner", "crossOwner" };
    private IReadOnlyCollection<string> _flags = [];
    private IReadOnlyList<string> _ruleIds = [];
    private Counts _counts = new(0, 0, 0, 0);
    private IJSObjectReference? _module;
    private DotNetObjectReference<Explorer>? _self;
    private bool _ready;

    private bool ShowSteps => _kinds.Contains("step") || _kinds.Contains("job");

    // Kinds and edge classes are allow-lists that start full, so "narrowed" means something has
    // been switched *off*, not that a list is non-empty.
    private bool IsNarrowed =>
        !string.IsNullOrEmpty(_isolated) || !string.IsNullOrWhiteSpace(_search)
        || _origins.Any() || _rules.Any() || _flags.Any()
        || _refStyle != "any" || _minReach > 0
        || _edgeClasses.Count != EdgeKinds.Length
        || _kinds.Count != Kinds.Count - OffByDefault.Length;

    private string PositionMeaning =>
        Views.FirstOrDefault(v => v.Key == _view)?.Meaning ?? string.Empty;

    private bool HasSelection => _selected.Count > 0;

    private string SelectionLabel => _selected.Count switch
    {
        0 => string.Empty,
        1 => _selected[0],
        <= 3 => string.Join(", ", _selected),
        _ => $"{_selected.Count} nodes selected",
    };

    /// <summary>The canvas changes width when the key opens, so it has to be re-measured.</summary>
    private async Task ToggleKeyPanel()
    {
        _showLegend = !_showLegend;
        StateHasChanged();
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("resize", "abom-graph");
        }
    }

    private string ViewTooltip(ViewOption v) =>
        v.NeedsSelection && !HasSelection
            ? "Select a node first."
            : v.Meaning;

    private string KindColor(string kind) =>
        Theme.Palette.Kinds.TryGetValue(kind, out var c) ? c : Theme.Palette.Muted;

    private string DiscoveryColor(string state) =>
        Theme.Palette.Discovery.TryGetValue(state, out var c) ? c : Theme.Palette.Muted;

    protected override void OnInitialized()
    {
        _isolated = SelectionParam ?? string.Empty;
        _selected = string.IsNullOrEmpty(_isolated) ? [] : [_isolated];
        if (!string.IsNullOrEmpty(_isolated)) _hops = 1;
        if (!string.IsNullOrEmpty(ViewParam)) _view = ViewParam;
        if (Directions.Any(d => d.Key == DirectionParam)) _direction = DirectionParam!;

        // Handed over from another page, so the reader arrives at what they were already looking
        // at rather than at the whole corpus again.
        _search = SearchParam ?? string.Empty;
        if (!string.IsNullOrEmpty(RefStyleParam)) _refStyle = RefStyleParam;
        if (MinReachParam is > 0) _minReach = MinReachParam;
        if (SplitParam(RulesParam) is { Count: > 0 } rules) _rules = rules;
        if (SplitParam(OriginsParam) is { Count: > 0 } origins) _origins = origins;
        if (SplitParam(FlagsParam) is { Count: > 0 } flags) _flags = flags;
        if (SplitParam(KindsParam) is { Count: > 0 } kinds) _kinds = kinds;

        Theme.Changed += OnThemeChanged;
        Follow.Changed += OnFollowChanged;
    }

    private static HashSet<string> SplitParam(string? value) =>
        string.IsNullOrWhiteSpace(value)
            ? []
            : value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                   .ToHashSet();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/graph.js");
        _self = DotNetObjectReference.Create(this);
        await _module.InvokeAsync<bool>("create", "abom-graph", _use3d, _self);
        await _module.InvokeVoidAsync("setPalette", "abom-graph", Theme.Palette);
        await _module.InvokeVoidAsync("setAnimate", "abom-graph", _animate);
        _ready = true;
        await LoadGraph();
        ApplyFollow();
    }

    private async Task LoadGraph(bool force = false)
    {
        if (_module is null) return;
        _loading = true;
        Busy("Loading the whole graph…");

        var url = ShowSteps ? "/api/graph/full?steps=true" : "/api/graph/full";
        var loaded = await _module.InvokeAsync<LoadResult>("loadFull", "abom-graph", url, force);
        _ruleIds = loaded.Rules;

        // A cached copy comes back with its positions intact, which is what makes returning to
        // this page instant. It also comes back as old as the visit that built it, so the
        // generation it holds is the cursor to catch up from rather than the current one.
        var caughtUp = loaded.Cached && loaded.Generation > 0;
        if (caughtUp)
        {
            _generation = loaded.Generation;
        }
        else
        {
            _generation = (await Api.GetGraphVersionAsync()).Generation;
            await _module.InvokeVoidAsync("setGeneration", "abom-graph", _generation);
        }

        if (_view == "priority") await PushPriorities();
        await _module.InvokeVoidAsync("setView", "abom-graph", _view);

        _loading = false;
        Busy("Laying out the graph…");
        await Refilter();

        if (caughtUp) await FollowGraph();
    }

    /// <summary>
    /// Folds in what a running expansion has added since the last look.
    ///
    /// The version is checked first because it is a few bytes against a corpus, and because
    /// re-laying-out an unchanged graph every interval would move the picture for nothing.
    /// </summary>
    private async Task FollowGraph()
    {
        if (_module is null || !_ready || _loading) return;

        var version = await Api.GetGraphVersionAsync();
        _lastPoll = DateTime.UtcNow;
        if (version.Generation == _generation)
        {
            StateHasChanged();
            return;
        }

        var url = ShowSteps
            ? $"/api/graph/delta?since={_generation}&steps=true"
            : $"/api/graph/delta?since={_generation}";
        var merged = await _module.InvokeAsync<MergeResult>("mergeDelta", "abom-graph", url);
        if (merged.Reset)
        {
            // The cursor is older than the server will answer for, so the held copy cannot be
            // brought up to date and has to be replaced rather than reused.
            await LoadGraph(force: true);
            return;
        }

        _generation = merged.Generation;
        _arrived = merged.Nodes;
        if (merged.Rules.Count > 0) _ruleIds = merged.Rules;
        await Refilter();
    }

    /// <summary>
    /// Watches whether there is anything to follow, whether or not this view is following.
    ///
    /// Discovery is started from another page, and without this the follow control here would
    /// stay greyed out for as long as the tab was open.
    /// </summary>
    private async Task PollDiscovery()
    {
        var state = await Api.GetDiscoveryAsync();
        // A read that failed returns an empty result rather than throwing, so without this the
        // page would quietly decide discovery had stopped and grey the follow control.
        _pollError = Api.LastError;
        if (_pollError is not null)
        {
            StateHasChanged();
            return;
        }

        Follow.SetDiscoveryRunning(state.Status.IsRunning);
        if (Follow.Enabled)
        {
            await FollowGraph();
        }
    }

    private void OnFollowChanged()
    {
        ApplyFollow();
        InvokeAsync(StateHasChanged);
    }

    private void ApplyFollow()
    {
        _followTimer?.Dispose();
        // Polling continues while following is off: it is a few hundred bytes, and it is the
        // only way this page learns that a run started somewhere else.
        _followTimer = new Timer(async _ =>
        {
            // Nothing awaits a timer callback, so a failed fetch or a JS interop error raised
            // here is discarded, and the graph silently stops following.
            try
            {
                await InvokeAsync(PollDiscovery);
                _pollError = null;
            }
            catch (Exception ex)
            {
                _pollError = ex.Message;
                await InvokeAsync(StateHasChanged);
            }
        }, null, Follow.Interval, Follow.Interval);
    }

    private void Busy(string message)
    {
        _busy = true;
        _busyMessage = message;
        StateHasChanged();
    }

    /// <summary>The simulation is the only thing that knows when the picture has stopped moving.</summary>
    [JSInvokable]
    public Task OnLayoutSettled()
    {
        _busy = false;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private object FilterSpec() => new
    {
        search = _search,
        kinds = _kinds.ToArray(),
        origins = _origins.ToArray(),
        rules = _rules.ToArray(),
        edgeClasses = _edgeClasses.ToArray(),
        refStyle = _refStyle,
        minReach = _minReach ?? 0,
        hasFindings = _flags.Contains("findings"),
        hasAdvisory = _flags.Contains("advisory"),
        unanalyzedOnly = _flags.Contains("unanalyzed"),
        selection = _isolated,
        hops = _hops,
        direction = _direction,
    };

    private async Task Refilter()
    {
        if (_module is null || !_ready) return;
        _counts = await _module.InvokeAsync<Counts>("applyFilters", "abom-graph", FilterSpec());
        // Only the filter knows how many nodes the simulation was actually given; naming the
        // corpus size here claimed work that is not being done.
        if (_busy) _busyMessage = $"Laying out {_counts.Nodes:N0} nodes…";
        StateHasChanged();
    }

    /// <summary>
    /// A single click only highlights and moves the camera.
    ///
    /// Rebuilding the view is a large enough change that it should take a deliberate second
    /// action, so it is left to double-click and right-click.
    /// </summary>
    [JSInvokable]
    public Task OnNodeSelected(string[] keys)
    {
        _selected = [.. keys ?? []];
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>Narrows the view to everything touching a node, both directions.</summary>
    [JSInvokable]
    public async Task OnNodeIsolated(string key)
    {
        if (string.IsNullOrEmpty(key)) return;
        _isolated = key == _isolated ? string.Empty : key;
        _selected = string.IsNullOrEmpty(_isolated) ? [] : [_isolated];
        // Start at the immediate neighbors. The graph is largely one connected component, so an
        // unbounded walk from any node reaches nearly all of it and drilling in shows no change.
        _hops = string.IsNullOrEmpty(_isolated) ? 0 : 1;
        SyncAddress();
        await Refilter();
    }

    /// <summary>Escape, or a click on empty canvas: the short way back out of a selection.</summary>
    [JSInvokable]
    public async Task OnGraphCleared()
    {
        if (string.IsNullOrEmpty(_isolated) && _selected.Count == 0) return;
        // Only isolation changed which nodes are on screen, so only isolation has earned a camera
        // move. Recentering after merely dropping a highlight loses the reader's place for nothing.
        await ClearSelection(recenter: !string.IsNullOrEmpty(_isolated));
        StateHasChanged();
    }

    private void SyncAddress()
    {
        var query = string.IsNullOrEmpty(_isolated)
            ? $"/explore?view={_view}"
            : $"/explore?selection={Uri.EscapeDataString(_isolated)}&view={_view}";
        Nav.NavigateTo(query, forceLoad: false);
    }

    private async Task ClearSelection() => await ClearSelection(recenter: true);

    private async Task ClearSelection(bool recenter)
    {
        _isolated = string.Empty;
        _selected = [];
        _hops = 0;
        await FallBackFromSelectionOnlyView();
        SyncAddress();
        await Refilter();
        await _module!.InvokeVoidAsync("setSelection", "abom-graph", Array.Empty<string>());
        if (recenter) await _module!.InvokeVoidAsync("fit", "abom-graph");
    }

    /// <summary>Leaving a view that places nodes by hop distance, once there is nothing to measure from.</summary>
    private async Task FallBackFromSelectionOnlyView()
    {
        var active = Views.FirstOrDefault(v => v.Key == _view);
        if (active is { NeedsSelection: true } && !HasSelection)
        {
            _view = "neighborhood";
            await _module!.InvokeVoidAsync("setView", "abom-graph", _view);
        }
    }

    private async Task OnViewChanged(string value)
    {
        _view = value;
        if (value == "priority") await PushPriorities();
        await _module!.InvokeVoidAsync("setView", "abom-graph", value);
        SyncAddress();
    }

    /// <summary>Priority drives the Priority force, and is the same figure the table shows.</summary>
    private async Task PushPriorities()
    {
        var items = await Api.GetRemediationAsync(300);
        var map = new Dictionary<string, int>();
        foreach (var item in items)
        {
            foreach (var action in item.Actions)
            {
                map[action] = Math.Max(map.GetValueOrDefault(action), item.Priority);
            }
        }
        await _module!.InvokeVoidAsync("setPriorities", "abom-graph", map);
    }

    private async Task OnAnimateChanged(bool value)
    {
        _animate = value;
        await _module!.InvokeVoidAsync("setAnimate", "abom-graph", value);
    }

    private async Task OnGroupByChanged(string value)
    {
        _groupBy = value;
        // Collapsing by nothing would fold the whole graph into one node.
        if (_groupBy == "none" && _collapsed) await OnCollapsedChanged(false);
        await _module!.InvokeVoidAsync("setGroupBy", "abom-graph", _groupBy);
        if (_collapsed) await Refilter();
    }

    private async Task OnCollapsedChanged(bool value)
    {
        _collapsed = value;
        Busy(value ? "Folding groups…" : "Expanding groups…");
        await _module!.InvokeVoidAsync("setGroupBy", "abom-graph", _groupBy);
        await _module!.InvokeVoidAsync("setCollapsed", "abom-graph", value, FilterSpec());
        await Refilter();
    }

    private async Task On3dChanged(bool value)
    {
        _use3d = value;
        Busy(value ? "Rebuilding in 3D…" : "Rebuilding in 2D…");
        if (_module is null) return;
        var spec = new { selection = _isolated, hops = _hops };
        await _module.InvokeVoidAsync("setMode", "abom-graph", value, spec);
        await _module.InvokeVoidAsync("setPalette", "abom-graph", Theme.Palette);
        await Refilter();
    }

    private async Task OnSearchChanged(string value) { _search = value ?? string.Empty; await Refilter(); }
    private async Task OnOriginsChanged(IEnumerable<string> v) { _origins = v?.ToArray() ?? []; await Refilter(); }
    private async Task OnRulesChanged(IEnumerable<string> v) { _rules = v?.ToArray() ?? []; await Refilter(); }
    private async Task OnRefStyleChanged(string v) { _refStyle = v; await Refilter(); }
    private async Task OnMinReachChanged(int? v) { _minReach = v; await Refilter(); }
    private async Task OnHopsChanged(int v) { _hops = v; await Refilter(); }

    private async Task OnDirectionChanged(string v) { _direction = v; await Refilter(); }

    // Arriving from another page is a one-way trip otherwise: the browser's Back works, but
    // nothing on screen says so, and the reader has usually changed something by then.
    private bool CameFromDiscovery => FromParam == "discovery";

    private string BackToDiscovery =>
        string.IsNullOrEmpty(StatusParam) ? "/discovery" : $"/discovery?status={StatusParam}";

    private string DirectionMeaning =>
        Directions.FirstOrDefault(d => d.Key == _direction)?.Meaning ?? string.Empty;

    private async Task OnFlagsChanged(IEnumerable<string> v)
    {
        var wasShowingSteps = ShowSteps;
        _flags = v?.ToArray() ?? [];
        // Steps are a different payload, not a different predicate.
        if (ShowSteps != wasShowingSteps) await LoadGraph();
        else await Refilter();
    }

    private void OnThemeChanged()
    {
        if (_module is not null)
        {
            _ = _module.InvokeVoidAsync("setPalette", "abom-graph", Theme.Palette).AsTask();
        }
        StateHasChanged();
    }

    private sealed record LoadResult(
        int Nodes, int Edges, IReadOnlyList<string> Rules, bool Cached, long Generation);

    public async ValueTask DisposeAsync()
    {
        Theme.Changed -= OnThemeChanged;
        Follow.Changed -= OnFollowChanged;
        _followTimer?.Dispose();
        if (_module is not null)
        {
            try
            {
                // Keep the entry: it holds the parsed graph and the positions it settled into,
                // which is the whole cost of coming back to this page.
                await _module.InvokeVoidAsync("dispose", "abom-graph", true);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { /* the circuit is already gone */ }
        }
        _self?.Dispose();
    }
}
