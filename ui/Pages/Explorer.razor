@page "/explore"
@implements IAsyncDisposable
@inject AbomApi Api
@inject ThemeService Theme
@inject IJSRuntime Js
@inject NavigationManager Nav
@inject FollowService Follow
@inject ScopeService Scope
@inject TutorialService Tutorial

<PageTitle>Explorer — ABOM</PageTitle>

<MudPaper Elevation="0" Class="pa-2 mb-2 abom-filters" Outlined="true">
    <div class="d-flex flex-wrap align-center gap-2 abom-explore-scope">
        @* Every graph filter term lives behind one control. *@
        <FilterPicker Surface="graph" Changed="OnPickerChanged" />
        @* Available before drawing so a named scope can replace the current one. *@
        <NamedScopes Surface="graph" Chosen="LoadNamed" Presentation="@KeptPresentation" />
    </div>

    @if (Scope.LastError is { Length: > 0 } scopeRefusal)
    {
        <MudAlert Severity="MudBlazor.Severity.Warning" Dense="true" Class="mt-2">
            @scopeRefusal — the default scope is showing instead.
        </MudAlert>
    }

    @* Presentation controls wait for a picture; filters remain available to create one. *@
    @if (HasScope)
    {
    <div class="d-flex flex-wrap align-center gap-3 mt-2">
        @* Presentation, not a predicate; the option title states what position encodes. *@
        <MudSelect T="string" Label="View" Value="_view" ValueChanged="OnViewChanged"
                   Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                   ShrinkLabel="true" Class="abom-filter abom-view-select">
            @foreach (var v in Views)
            {
                <MudSelectItem T="string" Value="@v.Key"
                               Disabled="@(v.NeedsSelection && !HasSelection)">
                    <span class="abom-view-label" data-abom-view="@v.Key"
                          title="@v.Meaning">@ViewLabel(v, HasSelection)</span>
                </MudSelectItem>
            }
        </MudSelect>
        <MudCheckBox T="bool" Value="_use3d" ValueChanged="On3dChanged" Color="Color.Primary"
                     Size="Size.Small" Dense="true" Label="3D" />
        @* Native title survives the select popover where MudTooltip does not. *@
        <MudSelect T="string" Label="Group by" Value="_groupBy" ValueChanged="OnGroupByChanged"
                   Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                   ShrinkLabel="true" Class="abom-filter">
            @foreach (var (key, label) in GroupByOptions)
            {
                <MudSelectItem T="string" Value="@key">
                    <span title="@GroupByTooltip(key)">@label</span>
                </MudSelectItem>
            }
        </MudSelect>
        <MudTooltip Text="Collapse each group into a single node. Click one to open it again.">
            <MudCheckBox T="bool" Value="_collapsed" ValueChanged="OnCollapsedChanged"
                         Color="Color.Primary" Size="Size.Small" Dense="true" Label="Collapse"
                         Disabled="@(_groupBy == "none")" />
        </MudTooltip>
        <MudTooltip Text="Reach one hop beyond the scope and draw what a shown node uses, greyed. The scope's own relationships are drawn either way.">
            <MudCheckBox T="bool" Value="_dependencies" ValueChanged="OnDependenciesChanged"
                         Color="Color.Primary" Size="Size.Small" Dense="true" Label="What they use" />
        </MudTooltip>
        @if (_groupBy == "workflow" && !ShowSteps)
        {
            @* Workflow grouping needs steps to provide meaningful containers. *@
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                turn on Step to group by workflow
            </MudText>
        }
        @if (StepsNeedFocus)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                pick a node to see its steps
            </MudText>
        }
        <MudTooltip Text="Watch the layout arrange itself and the selection's dependencies flow, or hold everything still.">
            <MudCheckBox T="bool" Value="_animate" ValueChanged="OnAnimateChanged"
                         Color="Color.Primary" Size="Size.Small" Dense="true"
                         Label="Animate" />
        </MudTooltip>
        @* The simulation is the default and starts from a different place every load, so nothing
           downstream -- a screenshot, a printed report, a second look tomorrow -- can rest on
           where a node ended up. A computed layout is the same picture every time, and pays for
           it by being a picture of the scope it was computed for. *@
        <MudTooltip Text="Place the graph with Graphviz instead of the simulation, so the same scope draws the same picture every time. Recomputed when the scope changes.">
            <span data-abom-layout-toggle>
                <MudCheckBox T="bool" Value="_stableLayout" ValueChanged="OnStableLayoutChanged"
                             Color="Color.Primary" Size="Size.Small" Dense="true"
                             Label="Stable layout" />
            </span>
        </MudTooltip>
        @* Nothing else on the page distinguishes a layout that will be identical tomorrow from one
           that is reshuffled on every load, and a partial answer has to carry its own share. *@
        <MudText Typo="Typo.caption" Class="@(_layout?.Fault == true ? null : "mud-text-secondary")"
                 Color="@(_layout?.Fault == true ? Color.Warning : Color.Default)"
                 data-abom-layout-state data-abom-layout-fault="@(_layout?.Fault == true ? "true" : null)">
            @LayoutStateText
        </MudText>

        @if (!string.IsNullOrEmpty(_isolated))
        {
            <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined" Size="Size.Small"
                     OnClose="ClearSelection" CloseIcon="@Icons.Material.Filled.Close">
                only @_isolated
            </MudChip>
            @* A key handed over by another page may name nothing this graph holds — a different
               answer from a neighborhood that is genuinely empty, and one an empty canvas under a
               banner naming the node states as the opposite of what happened. *@
            @if (_counts.FocusFound == 0)
            {
                <MudText Typo="Typo.caption" Color="Color.Warning" data-abom-focus-unknown>
                    not in this view — it may sit outside the scope, or be filtered out by kind
                </MudText>
            }
            @* Naming a node is itself a scope; suspended filters must be visible. *@
            @if (SuspendedFilters is { Length: > 0 } suspended)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    @suspended suspended inside the focus
                </MudText>
            }
            <MudSelect T="int" Label="Hops" Value="_hops" ValueChanged="OnHopsChanged" Dense="true"
                       Margin="Margin.Dense" Variant="Variant.Outlined" ShrinkLabel="true"
                       Class="abom-filter-narrow">
                <MudSelectItem T="int" Value="0">all</MudSelectItem>
                @for (var h = 1; h <= 6; h++)
                {
                    var v = h;
                    <MudSelectItem T="int" Value="@v">@v</MudSelectItem>
                }
            </MudSelect>
            <MudTooltip Text="@DirectionMeaning">
                <MudSelect T="string" Label="Follow" Value="_direction"
                           ValueChanged="OnDirectionChanged" Dense="true" Margin="Margin.Dense"
                           Variant="Variant.Outlined" ShrinkLabel="true" Class="abom-filter">
                    @foreach (var d in Directions)
                    {
                        <MudSelectItem T="string" Value="@d.Key">@d.Label</MudSelectItem>
                    }
                </MudSelect>
            </MudTooltip>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="ClearSelection"
                       title="Clear the focused node and draw the whole graph for this view again.">
                Back to the whole graph
            </MudButton>
            @if (CameFromDiscovery)
            {
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Search" Href="@BackToDiscovery"
                           title="Return to the coverage view in Inventory.">
                    Back to Discovery
                </MudButton>
            }
        }
        else if (HasSelection)
        {
            <MudText Typo="Typo.caption" Class="abom-rule">@SelectionLabel</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                @(_selected.Count > 1
                    ? "cmd or ctrl click to add and remove"
                    : "double-click to show only its dependencies · cmd or ctrl click to compare")
            </MudText>
        }
        @if (_selected.Count == 1)
        {
            @* One node, one detail page: the link would be ambiguous for several. *@
            <MudLink Href="@($"/node/{_selected[0]}")" Typo="Typo.caption"
                     title="@($"Open the details page for {_selected[0]}.")">open details</MudLink>
        }
        <MudSpacer />
        <MudTooltip Text="@(_showLegend ? "Hide the key and give the graph the full width." : "Show the node and edge key, and filter by it.")">
            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ToggleKeyPanel"
                       EndIcon="@(_showLegend ? Icons.Material.Filled.ChevronRight : Icons.Material.Filled.ChevronLeft)">
                Nodes &amp; edges
            </MudButton>
        </MudTooltip>
    </div>
    }
</MudPaper>

@* Key and canvas side by side: there is far more room left-to-right than up-and-down, and the
   checkboxes are only useful while you can see what they are changing. *@
<div class="abom-explore">
    <MudPaper Elevation="0" Outlined="true" Class="pa-0 abom-explore-canvas">
        <div class="abom-graph-wrap">
            <div id="abom-graph" class="abom-graph-host"></div>
            @* Before the spinner, not after it. `_busy` is cleared only by the simulation calling
               OnLayoutSettled, and an empty graph gives it nothing to lay out — so a page with
               nothing to draw would otherwise claim to be laying it out forever. *@
            @if (Frame is not null)
            {
                <div class="abom-graph-busy abom-graph-busy-opaque" data-abom-explorer-frame="@Frame">
                    @if (Frame == "declare")
                    {
                        <MudText Typo="Typo.body1">Nothing is declared yet.</MudText>
                        <MudText Typo="Typo.caption" Class="mt-2 mud-text-secondary">
                            Declare the accounts you own in
                            <MudLink Href="/settings"
                                     title="Open Settings to declare the accounts to analyze.">Settings</MudLink>, and the repositories
                            under them appear here.
                        </MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.body1">
                            Waiting for @string.Join(", ", _declared!.Select(a => a.Owner)).
                        </MudText>
                        @* Names what has not happened rather than asserting a crawl is running:
                           the page cannot see the queue from here. *@
                        <MudText Typo="Typo.caption" Class="mt-2 mud-text-secondary">
                            Nothing has been drawn for it yet; analysis has not run.
                        </MudText>
                    }
                </div>
            }
            else if (!HasScope && _declarationRead)
            {
                @* The third empty frame, and the one that is not a failure. A reader has to be
                   able to tell "choose something" from "you chose too much" and from "there is
                   nothing here", so it is its own frame rather than a variant of either. *@
                <div class="abom-graph-busy abom-graph-busy-opaque" data-abom-no-scope>
                    <MudText Typo="Typo.body1">Choose what to look at.</MudText>
                    <MudText Typo="Typo.caption" Class="mt-2 mud-text-secondary abom-refusal-help">
                        This graph draws one scope at a time, not everything recorded. Pick a
                        named scope above, or build your own with the filter.
                    </MudText>
                </div>
            }
            else if (_refused.Count > 0)
            {
                @* Replaces the canvas rather than warning over it: drawn without the term, the
                   picture would answer a wider question than the chip beside it asks. *@
                <div class="abom-graph-busy abom-graph-busy-opaque" data-abom-graph-refused>
                    <MudText Typo="Typo.body1">
                        This graph does not apply @string.Join(", ", _refused).
                    </MudText>
                    <MudText Typo="Typo.caption" Class="mt-2 mud-text-secondary abom-refusal-help">
                        Drawn without it, this picture would answer a wider question than the
                        scope asks. Remove it from the filter to draw, or open the scope in the
                        Inventory, which applies it.
                    </MudText>
                </div>
            }
            else if (_counts.Withheld > 0)
            {
                @* A refusal rather than a warning over a drawn hairball, and it replaces the
                   canvas because the previous picture underneath would read as this one. *@
                <div class="abom-graph-busy abom-graph-busy-opaque" data-abom-draw-refused>
                    <MudIcon Icon="@Icons.Material.Filled.FilterAlt" Color="Color.Warning"
                             Size="Size.Large" />
                    <MudText Typo="Typo.body1" Class="mt-2">
                        @_counts.Withheld.ToString("N0") nodes is too many to draw.
                    </MudText>
                    @* Says what to do, not only what did not happen: the reader came to find
                       something, and the route to it is narrowing rather than a bigger canvas. *@
                    <MudText Typo="Typo.caption" Class="mt-2 mud-text-secondary abom-refusal-help">
                        A graph this size is a hairball rather than a picture. Use the filters
                        above — a rule, an advisory, a severity or a single node — to reach the
                        handful of relationships you came to look at.
                    </MudText>
                    <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                               Class="mt-2" OnClick="OpenDrawWarning"
                               title="Open a warning that explains the oversized graph before drawing it."
                               data-abom-draw-anyway>
                        Draw all @_counts.Withheld.ToString("N0") anyway
                    </MudButton>
                </div>
            }
            else if (_busy)
            {
                <div class="@(_animate ? "abom-graph-busy" : "abom-graph-busy abom-graph-busy-opaque")">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" />
                    <MudText Typo="Typo.caption" Class="mt-2">@_busyMessage</MudText>
                </div>
            }
        </div>
    </MudPaper>

    @if (_showLegend && HasScope)
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-2 abom-explore-key abom-keypanel"
                  data-abom-legend>
            @if (_view == "frontier")
            {
                @* Hue means something else in this view, so the key has to say so where the
                   reader is looking, not leave the kind colors below to be misread. *@
                <div class="d-flex align-center abom-key-head">
                    <span class="abom-key-title">COLOR: HOW MUCH IS ANALYZED</span>
                </div>
                @foreach (var state in ThemeService.DiscoveryNames)
                {
                    <div class="abom-key-row">
                        <span class="abom-legend-dot"
                              style="--abom-legend-color:@DiscoveryColor(state.Key)"></span>
                        <span class="abom-key-label">@state.Value</span>
                    </div>
                }
                @* Only a fold can be part-way: expanded, every node carries one reference and is
                   analyzed or not. A group sums its members', and reads between the two ends. *@
                <div class="abom-key-row">
                    <span class="abom-legend-dot"
                          style="--abom-legend-color:@DiscoveryColor("done")"></span>
                    <span class="abom-key-label">partly analyzed — between these, by share</span>
                </div>
                <div class="abom-key-row">
                    <span class="abom-legend-dot"
                          style="--abom-legend-color:@Theme.Palette.Muted"></span>
                    <span class="abom-key-label">never a dependency</span>
                </div>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">
                    Rings are how far each dependency sits from the repositories you review. The
                    colors below filter which nodes are shown, not what they are colored.
                </MudText>
            }
            @if (_detail is not null)
            {
                @* The node under the pointer, typeset rather than painted. On the canvas this box
                   was the largest thing on screen and covered the neighbors a reader hovers a node
                   to compare it against. *@
                <div class="d-flex align-center abom-key-head">
                    <span class="abom-key-title">NODE</span>
                    <MudSpacer />
                    <MudTooltip Text="Put this away. The panel stays after the pointer leaves, so it takes a deliberate act to clear.">
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                       OnClick="ClearNodeDetail" />
                    </MudTooltip>
                </div>
                <div class="abom-nodecard" style="--abom-node-color:@KindColor(_detail.Kind)">
                    <div class="abom-node-name">@DetailName</div>
                    @* An account's key is the graph's own address for it, `org:actions`, which is
                       not a name anybody uses and not a thing to go looking for. *@
                    @if (DetailName != _detail.Key && _detail.Kind != "org")
                    {
                        <div class="abom-node-key">@_detail.Key</div>
                    }
                    <dl class="abom-node-facts">
                        @foreach (var fact in DetailFacts)
                        {
                            <dt>@fact.Label</dt>
                            <dd data-abom-node-fact="@fact.Marker">@fact.Value</dd>
                        }
                    </dl>
                    <MudLink Href="@($"/node/{_detail.Key}")" Typo="Typo.caption"
                             title="@($"Open the details page for {_detail.Key}.")">open details</MudLink>
                </div>
            }
            <div class="d-flex align-center abom-key-head">
                @* The heading beside it is a span rather than a label, so the name has to be
                   carried by the control itself or a reader not using a mouse meets nothing. *@
                <MudCheckBox T="bool?" Value="@AllNodesChecked" ValueChanged="OnAllNodesChanged"
                             TriState="true" Dense="true" Size="Size.Small" Color="Color.Primary"
                             aria-label="Show all nodes" />
                <span class="abom-key-title">SHOW ALL NODES</span>
                @if (Theme.HasKindOverrides)
                {
                    <MudTooltip Text="Put every node kind back to its default color.">
                        <MudIconButton Icon="@Icons.Material.Filled.FormatColorReset" Size="Size.Small"
                                       OnClick="ResetColors" Class="ml-1" />
                    </MudTooltip>
                }
            </div>
            @foreach (var row in KindTree.Where(IsRowShown))
            {
                var k = row.Kind;
                @* The panel names a kind; the key is where the reader already learned what that
                   kind looks like. Marking the row ties the two together without a second legend. *@
                <div class="@(_detail?.Kind == k ? "abom-key-row abom-key-row-shown" : "abom-key-row")"
                     style="--abom-key-depth:@row.Depth">
                    <MudCheckBox T="bool" Value="@_kinds.Contains(k)" Dense="true"
                                 Size="Size.Small" Color="Color.Primary"
                                 ValueChanged="@(_ => ToggleKind(k))"
                                 aria-label="@($"Show {Kinds[k]} nodes")" />
                    @KindGlyph(k)
                    <MudTooltip Text="@KindHelp(k)" Placement="Placement.Left">
                        <span class="abom-key-label" @onclick="@(() => ToggleKind(k))">@Kinds[k]</span>
                    </MudTooltip>
                    @if (FoldGrouping.ContainsKey(k))
                    {
                        <MudTooltip Text="@FoldHelp(k)" Placement="Placement.Left">
                            @* A chevron, not the unfold glyphs: at this size those collapse into
                               something that reads as a close button. *@
                            <MudIconButton Icon="@(IsFoldedAt(k) ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ExpandLess)"
                                           Size="Size.Small" OnClick="@(() => ToggleFold(k))"
                                           aria-label="@FoldHelp(k)"
                                           Class="@(IsFoldedAt(k) ? "abom-key-fold abom-key-fold-on" : "abom-key-fold")" />
                        </MudTooltip>
                    }
                    @* Color is reassignable per kind and per scheme: a hue that reads well on
                       black rarely does on white. *@
                    <MudTooltip Text="Change this kind's color.">
                        <input type="color" class="abom-swatch" value="@KindColor(k)"
                               aria-label="@($"Color for {Kinds[k]} nodes")"
                               @onchange="@(e => SetColor(k, e.Value?.ToString()))" />
                    </MudTooltip>
                </div>
            }
            @if (FoldedKinds is { Count: > 0 } folded)
            {
                @* The rows are gone from the key because their nodes are gone from the canvas.
                   Naming what went, and what the next step opens into, keeps the fold from
                   reading as kinds having been switched off. *@
                <div class="abom-key-note" style="--abom-key-depth:@(FoldDepth + 1)">
                    <span>@string.Join(", ", folded.Select(k => Kinds[k].ToLowerInvariant()))
                          folded in &mdash; @NextStepLabel</span>
                </div>
            }

            <div class="d-flex align-center abom-key-head mt-3">
                <MudCheckBox T="bool?" Value="@AllEdgesChecked" ValueChanged="OnAllEdgesChanged"
                             TriState="true" Dense="true" Size="Size.Small" Color="Color.Primary"
                             aria-label="Show all relationships" />
                <span class="abom-key-title">SHOW ALL EDGES</span>
            </div>
            @foreach (var e in EdgeKinds)
            {
                var c = e.Key;
                <MudTooltip Text="@e.Help" Placement="Placement.Left">
                    <div class="abom-key-row" style="--abom-key-depth:@e.Depth"
                         @onclick="@(() => ToggleEdge(c))">
                        <MudCheckBox T="bool" Value="@_edgeClasses.Contains(c)" Dense="true"
                                     Size="Size.Small" Color="Color.Primary"
                                     ValueChanged="@(_ => ToggleEdge(c))"
                                     aria-label="@($"Show {e.Label.ToLowerInvariant()} relationships")" />
                        <span class="abom-legend-line" style="--abom-legend-color:@EdgeColor(c)"></span>
                        <span>@e.Label</span>
                    </div>
                </MudTooltip>
            }

            <div class="abom-key-head mt-3"><span class="abom-key-title">STATE</span></div>
            @* A caption, not a control: the rows above are clickable and this one never was. *@
            <div class="abom-key-note">
                <span class="abom-legend-ring" style="--abom-legend-color:@Theme.Palette.Focus"></span>
                @if (!HasSelection)
                {
                    <span>nothing selected &mdash; click a node to mark it and dim the rest</span>
                }
                else
                {
                    <span class="abom-key-selected">@SelectionLabel</span>
                }
            </div>
            @* Color carries kind and only kind. Saying so stops the key implying that a
               repository discovery started from and one fetched as a dependency look different
               here. *@
            <div class="abom-key-note">
                <span>starting points and upstream are not colored apart &mdash; use the Origin filter</span>
            </div>
            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2 d-block">
                @PositionMeaning
            </MudText>
        </MudPaper>
    }
</div>

<div class="d-flex flex-wrap align-center gap-3 mt-1">
    <MudText Typo="Typo.caption" Class="mud-text-secondary">
        @if (!HasScope)
        {
            @* "0 of 0" is a measurement of nothing written as a measurement. Nothing was asked,
               so there is no count to report. *@
            <span data-abom-nothing-counted>Nothing is drawn yet.</span>
        }
        else if (_refused.Count > 0)
        {
            <span>Nothing is drawn: this scope carries a term the graph does not apply.</span>
        }
        else if (_loading)
        {
            <span>@ScopeBusyMessage</span>
        }
        else if (_collapsed)
        {
            @* Grouping removes nothing, so the groups are not "hidden" — but a filter running
               underneath a fold still is, and omitting it reported a filtered view as whole. *@
            <span>
                <b>@CountText.Of(_counts.Nodes, "node", "nodes")</b> after grouping by @GroupByLabel,
                gathered from @CountText.Of(_counts.Total, "node", "nodes")
                @if (_counts.Hidden > 0)
                {
                    <span>(@CountText.Of(_counts.Hidden, "node", "nodes") hidden by filters)</span>
                }
                <span class="mud-text-secondary">· click a group to expand it</span>
            </span>
        }
        else
        {
            <span>
                Showing <b>@CountText.Of(_counts.Nodes, "node", "nodes")</b> out of
                @CountText.Number(_counts.Total) total
                @if (_counts.Hidden > 0)
                {
                    <span>(@CountText.Of(_counts.Hidden, "node", "nodes") hidden by filters)</span>
                }
                @* Folding is a different mechanism from the filters, so it gets its own clause
                   rather than being counted as "hidden". *@
                @if (!ShowSteps)
                {
                    <span class="mud-text-secondary">
                        · individual <code>uses:</code> steps counted as part of their workflow
                    </span>
                }
                @* An edge needs both its ends, so a scope keeping a sixth of the nodes keeps far
                   less than a sixth of the relationships. Without this the canvas reads as a
                   dependency graph that has lost its dependencies. *@
                @if (_counts.EdgeTotal > _counts.Edges)
                {
                    <span class="mud-text-secondary">
                        · @CountText.Number(_counts.Edges) of
                        @CountText.Of(_counts.EdgeTotal, "relationship", "relationships"),
                        because an edge is drawn only when both ends are
                    </span>
                }
                @* Greyed rather than removed. Cutting them took the relationships with them, and
                   an edge needs both of its ends. *@
                @if (_counts.Context > 0)
                {
                    <span class="mud-text-secondary">
                        · @_counts.Context.ToString("N0") greyed out: on screen so relationships
                        keep both ends, not because they matched
                    </span>
                }
            </span>
        }
        @if (_arrived > 0)
        {
            <span class="mud-text-secondary">
                · @_arrived.ToString("N0") arrived from a running expansion
            </span>
        }
        @* An emptied allow-list is not written down, so the link on screen asks for every one. *@
        @if (HasScope && (_kinds.Count == 0 || _edgeClasses.Count == 0))
        {
