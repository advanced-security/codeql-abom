    public static IReadOnlyList<string> ScopeKeys => [.. Scopes.Select(s => s.Key)];

    /// <summary>How something references a node. "any" is the absent question, not a fourth style.</summary>
    public static readonly string[] RefStyles = ["any", "sha", "tag"];

    private bool IsExposureScope => _scope == "exposure";

    private bool IsOwnedScope => _scope == "owned";

    private bool ShowSteps => (_kinds.Contains("step") || _kinds.Contains("job"))
                              && !string.IsNullOrEmpty(_isolated);

    // Steps exist to answer reachability, and reachability is only ever asked from the
    // perspective of one action or workflow. Loaded globally they are 54,508 nodes and 28.7 MB
    // that no view can draw, so they arrive only inside a focus.
    private bool StepsNeedFocus => (_kinds.Contains("step") || _kinds.Contains("job"))
                                   && string.IsNullOrEmpty(_isolated);

    // Kinds and edge classes are allow-lists that start full, so "narrowed" means something has
    // been switched *off*, not that a list is non-empty.
    private bool IsNarrowed =>
        !string.IsNullOrEmpty(_isolated) || !string.IsNullOrWhiteSpace(_search)
        || _origins.Any() || _rules.Any() || _flags.Any()
        || _refStyle != "any" || _minReach > 0
        || _edgeClasses.Count != EdgeKinds.Length
        || _kinds.Count != Kinds.Count - OffByDefault.Length;

    private string PositionMeaning =>
