    private bool HasSelection => _selected.Count > 0;

    /// <summary>
    /// The arrival-scope filters the focus is ignoring, named so the reader is not left comparing
    /// a chip that looks on against a view that is not applying it.
    /// </summary>
    private string SuspendedFilters
    {
        get
        {
            // A focus that named nothing suspends nothing, so saying it does describes a view
            // that is not on screen.
            if (string.IsNullOrEmpty(_isolated) || _counts.FocusFound == 0) return string.Empty;
            var off = new List<string>();
            if (_flags.Contains("findings")) off.Add("has findings");
            if (_flags.Contains("advisory")) off.Add("has advisory");
            if (_flags.Contains("unanalyzed")) off.Add("not analyzed");
            if (_minReach > 0) off.Add($"used by \u2265 {_minReach}");
            return off.Count == 0 ? string.Empty : string.Join(", ", off);
        }
    }

    // The node under the pointer, kept after the pointer leaves so a reader can move towards what
    // they are reading. Cleared only by the close button.
    private GraphNodeBrief? _detail;

    /// <summary>The panel's heading: the leaf name, with the container it already states removed.</summary>
    private string DetailName
    {
        get
        {
            if (_detail is null) return string.Empty;
            var key = _detail.Key;
            // A container's key is synthetic: `org:actions` is not a name anybody uses for that
            // account.
            if (_detail.Kind == "org") return _detail.Owner is { Length: > 0 } o ? o : key[4..];
            var leaf = key.Split('/')[^1];
            return ShortRef(string.IsNullOrEmpty(leaf) ? key : leaf);
        }
    }

    // A commit-pinned reference is forty hex characters of a name that is already long, and it is
    // repeated verbatim on the key line below.
    private static string ShortRef(string name)
    {
        var at = name.LastIndexOf('@');
        if (at < 0 || name.Length - at - 1 != 40) return name;
        var sha = name[(at + 1)..];
        return sha.All(Uri.IsHexDigit) ? $"{name[..at]}@{sha[..7]}" : name;
    }

    private sealed record Fact(string Label, string Value, string? Marker = null);

    /// <summary>
    /// What is known about the node under the pointer, and what is not.
    ///
    /// Absent is never printed as zero: a node ingested since reach was last rebuilt has no
    /// measurement, and a dependency nothing ever queued has no coverage. Both say so.
    /// </summary>
    private IEnumerable<Fact> DetailFacts
    {
        get
        {
            if (_detail is null) yield break;
            var d = _detail;

            if (Kinds.TryGetValue(d.Kind, out var kind)) yield return new Fact("Kind", kind);
            if (d.Owned || !string.IsNullOrEmpty(d.Origin))
            {
                yield return new Fact("Origin", OriginText.Of(d.Origin, d.Owned), "origin");
            }
            if (!string.IsNullOrEmpty(d.Repository) && d.Repository != d.Key)
            {
                yield return new Fact("Repository", d.Repository);
            }
            else if (!string.IsNullOrEmpty(d.Owner) && d.Owner != d.Key && d.Owner != DetailName)
            {
                yield return new Fact("Owner", d.Owner);
            }
            if (!string.IsNullOrEmpty(d.Grouping)) yield return new Fact("Grouping", d.Grouping);
            if (!string.IsNullOrEmpty(d.Ref)) yield return new Fact("Version", ShortRef($"@{d.Ref}")[1..]);
            if (!string.IsNullOrEmpty(d.Container) && d.Container != d.Repository)
            {
                yield return new Fact("In", d.Container);
            }

            yield return new Fact("Reach", d.ReachKnown
                ? $"{d.DependentRepos:N0} repositories reach it"
                : "not measured");

            if (d.Findings > 0)
            {
                var rules = d.Rules.Count > 0 ? $" · {string.Join(", ", d.Rules)}" : string.Empty;
                yield return new Fact("Findings", $"{d.Findings:N0}{rules}");
            }
            // Size says how far a node reaches; this is the other half of the blast.
            if (d.Facets.Count > 0)
            {
                yield return new Fact("Severity", SeverityText.Summary(d.Facets), "severity");
            }
            // A count of statements, not a judgement that any observed reference is affected.
            if (d.Advisories > 0) yield return new Fact("Advisories", $"{d.Advisories:N0} name it");

            // Coverage is a claim about a dependency. An account or a repository is a container the
            // graph draws, and "never queued" about one reads as a gap somebody should close.
            if (d.IsExternal && d.Kind is not ("org" or "repo"))
            {
                yield return new Fact("Analyzed", d.RefsInUse == 0 && d.RefsAnalyzed == 0
                    ? "never queued"
                    : $"{d.RefsAnalyzed:N0} of {d.RefsInUse:N0} references");
            }
            if (!string.IsNullOrEmpty(d.Discovery))
            {
                var depth = d.Depth > 0 ? $" · {d.Depth} hops out" : string.Empty;
                yield return new Fact("Discovery", $"{d.Discovery}{depth}");
            }
        }
    }

    private string SelectionLabel => _selected.Count switch
    {
        0 => string.Empty,
        1 => _selected[0],
        <= 3 => string.Join(", ", _selected),
        _ => $"{_selected.Count} nodes selected",
    };

    /// <summary>The canvas changes width when the key opens, so it has to be re-measured.</summary>
    private async Task ToggleKeyPanel()
    {
        _showLegend = !_showLegend;
        StateHasChanged();
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("resize", "abom-graph");
        }
    }

    private string KindColor(string kind) =>
        Theme.Palette.Kinds.TryGetValue(kind, out var c) ? c : Theme.Palette.Muted;

    private string DiscoveryColor(string state) =>
        Theme.Palette.Discovery.TryGetValue(state, out var c) ? c : Theme.Palette.Muted;

    protected override void OnInitialized()
    {
        ReadScopeFromAddress();

        // The whole drawing through one reader, checked against what is on offer: an unknown name
        // left the control with nothing selected and then rode out into every link shared from
        // here. Absent keeps this page's own default, because almost every link in is partial and
        // reading what it never mentioned as a choice would redraw the picture on arrival.
        var drawn = Presentation.Parse(new Uri(Nav.Uri).Query);
        if (Views.Any(v => v.Key == drawn.View)) _view = drawn.View;
        if (Directions.Any(d => d.Key == drawn.Direction)) _direction = drawn.Direction;
        if (GroupByOptions.Any(g => g.Key == drawn.GroupBy)) _groupBy = drawn.GroupBy;
        // After ReadScopeFromAddress, which sets one hop for an arrival that names a node. An
        // address that names a depth means it, and zero is this page's default rather than a
        // choice, so it does not overwrite that.
        if (drawn.Hops > 0) _hops = drawn.Hops;
        if (drawn.Use3d) _use3d = true;
        if (drawn.Collapsed) _collapsed = true;
        if (drawn.StableLayout) _stableLayout = true;

        Theme.Changed += OnThemeChanged;
        Follow.Changed += OnFollowChanged;
    }

    /// <summary>Reads scope through the same address parser as the API and gate.</summary>
    private void ReadScopeFromAddress()
    {
        Scope.ReadFrom(Nav.Uri);
        var spec = Scope.Spec;

        if (Scope.Names("q")) _search = spec.Search;
        if (Scope.Names("minReach")) _minReach = spec.MinReach > 0 ? spec.MinReach : null;
        if (Scope.Names("rules")) _rules = [.. spec.Rules];
        if (Scope.Names("origins")) _origins = [.. spec.Origins];
        _flags = [.. spec.Flags];
        if (Scope.Names("kinds")) _kinds = spec.Kinds.ToHashSet();
        if (Scope.Names("edges")) _edgeClasses = spec.EdgeClass.ToHashSet();

        // Two terms are checked against what is on offer rather than taken literally: an empty
        // scope asks the API for the whole corpus, and an unknown reference style filters nothing
        // while the control shows something else.
        if (ScopeKeys.Contains(spec.Scope)) _scope = spec.Scope;
        if (RefStyles.Contains(spec.RefStyle)) _refStyle = spec.RefStyle;

        _isolated = Scope.Selection.Count > 0 ? Scope.Selection[0] : string.Empty;
        _selected = string.IsNullOrEmpty(_isolated) ? [] : [_isolated];
        if (!string.IsNullOrEmpty(_isolated)) _hops = 1;

        // A hand-off from Discovery names a node and nothing else, and a node still has to be
        // drawn inside something. The declared closure is the one that is not a guess about size:
        // it is what the operator declared and what that runs, so a dependency named here is in
        // it. If it draws more than the ceiling renders, the refusal says so rather than this page
        // picking a smaller scope on their behalf.
        if (_scope.Length == 0 && _isolated.Length > 0) _scope = "supply-chain";
    }

    protected override async Task OnInitializedAsync()
    {
        // Blazor renders at this await, so every stage, the chooser included, waits on _declarationRead.
        _declared = await Api.ReadOwnedScopeAsync();
        _declarationRead = true;
    }

    // Null when the read failed: no stage frame then, where an empty list would claim nothing is declared.
    private IReadOnlyList<DeclaredAccount>? _declared;
    private bool _declarationRead;

    /// <summary>
    /// Draws a named scope in place of whatever is on screen: its question whole, and its picture
    /// where one was kept.
    /// </summary>
    private async Task LoadNamed(NamedView view)
    {
        Scope.Set(ViewSpec.Parse(view.Predicate));
        TakeWholeScope();
        // A kept scope names a node only through its picture, so a focus left from the scope on
        // screen would narrow this one to a neighborhood nobody chose.
        _isolated = string.Empty;
        _selected = [];
        _hops = 0;
        Scope.Select([]);
        await ApplyPresentation(Presentation.Parse(view.Presentation));
        await LoadGraph(force: true);
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("setSelection", "abom-graph", _selected.ToArray());
        }
    }

    /// <summary>
    /// Every term this page filters by, read out of the scope as one whole question. A term the
    /// scope does not name takes this page's arrival choice for it, never whatever the previous
    /// scope had set: carried over, it would narrow the new one without a word.
    /// </summary>
    private void TakeWholeScope()
    {
        var spec = Scope.Spec;
        _search = spec.Search;
        _minReach = spec.MinReach > 0 ? spec.MinReach : null;
        _rules = [.. spec.Rules];
        _origins = [.. spec.Origins];
        _flags = [.. spec.Flags];
        _kinds = KindsOf(spec);
        _edgeClasses = EdgeClassesOf(spec);
        _refStyle = RefStyles.Contains(spec.RefStyle) ? spec.RefStyle : "any";
        _scope = ScopeKeys.Contains(spec.Scope) ? spec.Scope : string.Empty;
    }

    /// <summary>What Keep stores beside the question: the picture on screen.</summary>
    private string KeptPresentation() => CurrentPresentation.ToQueryString();

    // Which of the three first-run stages the page is at, or none once there is a picture.
    //
    // Null until the declaration has been read: saying "nothing is here" before the answer
    // arrives is an absent measurement drawn as a measurement.
    private string? Frame =>
        _declared is null || _loading || _counts.Nodes > 0 ? null
        : _declared.Count == 0 ? "declare"
        // "Waiting" is a claim about what analysis has produced, and with no scope chosen this
        // page has not asked for anything to produce. Saying it here would report an empty
        // measurement as an empty corpus.
        : !HasScope ? null
        // A refused scope was never asked of the server, so nothing is being waited for.
        : _refused.Count > 0 ? null
        : "waiting";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/graph.js");
        _self = DotNetObjectReference.Create(this);
        await _module.InvokeAsync<bool>("create", "abom-graph", _use3d, _self);
        await _module.InvokeVoidAsync("setPalette", "abom-graph", Theme.Palette);
        await _module.InvokeVoidAsync("setAnimate", "abom-graph", _animate);
        // The fold is the arrival state, so the renderer has to be told before the first draw
        // rather than only when the checkbox is touched.
        await _module.InvokeVoidAsync("setGroupBy", "abom-graph", _groupBy);
        await _module.InvokeVoidAsync("setCollapsed", "abom-graph", _collapsed, FilterSpec());
        _ready = true;
        // Nothing is fetched for a scope nobody chose: a guessed one spends a whole graph load on
        // a question nobody asked, and teaches a reader that whatever appeared is what they ought
        // to be looking at. Loading is cleared here rather than in LoadGraph, because a page with
        // nothing to load would otherwise claim to be loading it forever.
        if (HasScope)
        {
            await LoadGraph();
        }
        else
        {
            _loading = false;
            _busy = false;
            StateHasChanged();
        }
        ApplyFollow();
    }

    /// <summary>
    /// The terms the server applies, built once because both the payload and every delta that
    /// follows it have to ask the same question. A delta built from fewer terms is answered for
    /// the default shape and the whole corpus, so arrivals from outside the picture merge into it
    /// under an address that still names the narrowing.
    /// </summary>
    private List<string> ServerTerms()
    {
        var query = new List<string>();
        if (ShowSteps) query.Add("steps=true");
        if (!string.IsNullOrEmpty(_scope)) query.Add("scope=" + _scope);
        // Applied by the server, not handed over: the browser cannot filter by a shape the
        // payload never carried, because the edges the other shape observed never arrived.
        if (!string.IsNullOrEmpty(Scope.Spec.Mode)) query.Add("mode=" + Scope.Spec.Mode);
        // A node carries one grouping value, for the configured key only, so the browser cannot
        // narrow by an arbitrary property at all. These two terms are asked of the server or they
        // are not applied anywhere. The URL is the payload cache key, so a change refetches.
        query.AddRange(Scope.Spec.Properties.Select(p => "properties=" + Uri.EscapeDataString(p.ToString())));
        query.AddRange(Scope.Spec.NotProperties.Select(p => "notProperties=" + Uri.EscapeDataString(p.ToString())));
        // What a relationship crosses and what it is are facts of edges the payload merges, so the
        // server that holds them unmerged applies them.
        if (!string.IsNullOrEmpty(Scope.Spec.Boundary)) query.Add("boundary=" + Scope.Spec.Boundary);
        if (Scope.Spec.EdgeKinds.Count > 0) query.Add("edgeKinds=" + string.Join(",", Scope.Spec.EdgeKinds));
        return query;
    }

    /// <summary>
    /// The labels of the terms the scope carries that the graph applies on neither side, read from
    /// the catalog the server declares rather than from a list kept here.
    /// </summary>
    private async Task<IReadOnlyList<string>> RefusedHere()
    {
        _catalog ??= Api.GetFilterTermsAsync();
        var carried = Scope.Spec.ToQueryString()
            .Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Select(pair => Uri.UnescapeDataString(pair.Split('=')[0]))
            .ToHashSet(StringComparer.Ordinal);
        return [.. (await _catalog)
            .Where(t => carried.Contains(t.Name) && !t.Surfaces.Contains("graph"))
            .Select(t => t.Label)];
    }

    private async Task LoadGraph(bool force = false)
    {
        if (_module is null) return;
        // Refused rather than drawn around: the whole scope's picture under a chip naming one
        // source is the wider answer a refusal exists to prevent.
        _refused = await RefusedHere();
        if (_refused.Count > 0)
        {
            _requestedTerms = null;
            _loading = false;
            _busy = false;
            StateHasChanged();
            return;
        }
        _loading = true;
        Busy(ScopeBusyMessage);

        var query = ServerTerms();
        _requestedTerms = string.Join("&", query);
        var url = "/api/graph/full" + (query.Count > 0 ? "?" + string.Join("&", query) : "");
        var loaded = await _module.InvokeAsync<LoadResult>("loadFull", "abom-graph", url, force);
        _ruleIds = loaded.Rules;

        // A cached copy comes back with its positions intact, which is what makes returning to
        // this page instant. It also comes back as old as the visit that built it, so the
        // generation it holds is the cursor to catch up from rather than the current one.
        var caughtUp = loaded.Cached && loaded.Generation > 0;
        if (caughtUp)
        {
            _generation = loaded.Generation;
        }
        else
        {
            _generation = (await Api.GetGraphVersionAsync()).Generation;
            await _module.InvokeVoidAsync("setGeneration", "abom-graph", _generation);
        }

        if (_view == "priority") await PushPriorities();
        await _module.InvokeVoidAsync("setView", "abom-graph", _view);

        _loading = false;
        Busy("Laying out the graph…");
        await Refilter();
        // A server term changed what was fetched, so the engine placed a different graph. A
        // browser filter deliberately does not come through here: it thins what is drawn without
        // moving anything, and a box left enclosing a stranger is refused rather than redrawn.
        await ApplyStableLayout();

        if (caughtUp) await FollowGraph();
    }

    /// <summary>
    /// Folds in what a running expansion has added since the last look.
    ///
    /// The version is checked first because it is a few bytes against a corpus, and because
    /// re-laying-out an unchanged graph every interval would move the picture for nothing.
    /// </summary>
    private async Task FollowGraph()
    {
        if (_module is null || !_ready || _loading) return;

        var version = await Api.GetGraphVersionAsync();
        _lastPoll = DateTime.UtcNow;
        if (version.Generation == _generation)
        {
            StateHasChanged();
            return;
        }

        var terms = ServerTerms();
        var url = $"/api/graph/delta?since={_generation}"
                  + (terms.Count > 0 ? "&" + string.Join("&", terms) : "");
        var merged = await _module.InvokeAsync<MergeResult>("mergeDelta", "abom-graph", url);
        if (merged.Reset)
        {
            // The cursor is older than the server will answer for, so the held copy cannot be
            // brought up to date and has to be replaced rather than reused.
            await LoadGraph(force: true);
            return;
        }

        _generation = merged.Generation;
        _arrived = merged.Nodes;
        if (merged.Rules.Count > 0) _ruleIds = merged.Rules;
        await Refilter();
    }

    private void OnFollowChanged()
    {
        ApplyFollow();
        InvokeAsync(StateHasChanged);
    }

    private void ApplyFollow()
    {
        _followTimer?.Dispose();
        _followTimer = new Timer(async _ =>
        {
            // Timer callbacks are unobserved unless exceptions are caught here.
            try
            {
                await InvokeAsync(FollowGraph);
                // A read that failed returns an empty result rather than throwing, so the
                // transport's own account is the only sign the picture has stopped moving.
                _pollError = Api.LastError;
            }
            catch (Exception ex)
            {
                _pollError = ex.Message;
            }
            await InvokeAsync(StateHasChanged);
        }, null, Follow.Interval, Follow.Interval);
    }

    private void Busy(string message)
    {
        _busy = true;
        _busyMessage = message;
        StateHasChanged();
    }

    /// <summary>The simulation is the only thing that knows when the picture has stopped moving.</summary>
    [JSInvokable]
    public Task OnLayoutSettled()
    {
        _busy = false;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private object FilterSpec() => new
    {
        search = _search,
        kinds = _kinds.ToArray(),
        origins = _origins.ToArray(),
        rules = _rules.ToArray(),
        // Handed over by the graph rather than applied by it, and applied per finding from the
        // kinds each node carries, the way the set path reads them.
        notRules = Scope.Spec.NotRules.ToArray(),
        provider = Scope.Spec.Provider,
        severity = Scope.Spec.Severity,
        bands = Scope.Spec.SecuritySeverities.ToArray(),
        edgeClasses = _edgeClasses.ToArray(),
        refStyle = _refStyle,
        minReach = _minReach ?? 0,
        hasFindings = _flags.Contains("findings"),
        hasAdvisory = _flags.Contains("advisory"),
        unanalyzedOnly = _flags.Contains("unanalyzed"),
        grouped = _groupBy != "none",
        dependencies = _dependencies,
        selection = _isolated,
        hops = _hops,
        direction = _direction,
    };

    private async Task Refilter()
    {
        if (_module is null || !_ready) return;
        // Every control that narrows the view goes through here, and until it synced, nine of them
        // changed what was on screen without changing the link the reader would share.
        SyncAddress();
        _counts = await _module.InvokeAsync<Counts>("applyFilters", "abom-graph", FilterSpec());
        // Only the filter knows how many nodes the simulation was actually given; naming the
        // corpus size here claimed work that is not being done.
        if (_busy) _busyMessage = $"Laying out {_counts.Nodes:N0} nodes…";
        StateHasChanged();
    }

    /// <summary>
    /// A single click only highlights and moves the camera.
    ///
    /// Rebuilding the view is a large enough change that it should take a deliberate second
    /// action, so it is left to double-click and right-click.
    /// </summary>
    [JSInvokable]
    public Task OnNodeSelected(string[] keys)
    {
        _selected = [.. keys ?? []];
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>
    /// The node under the pointer, for the panel beside the graph.
    ///
    /// <para>Only arrivals are reported. The panel outlives the pointer on purpose — a reader has
    /// to be able to move towards what they are reading — so a leave would blank it exactly when
    /// it became useful.</para>
    /// </summary>
    [JSInvokable]
    public Task OnNodeHovered(GraphNodeBrief? node)
    {
        if (node is null || string.IsNullOrEmpty(node.Key)) return Task.CompletedTask;
        _detail = node;
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>Dismisses the node panel, which the pointer never does on its own.</summary>
    public Task ClearNodeDetail()
    {
        _detail = null;
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>Narrows the view to everything touching a node, both directions.</summary>
    [JSInvokable]
    public async Task OnNodeIsolated(string key)
    {
        if (string.IsNullOrEmpty(key)) return;
        var wasShowingSteps = ShowSteps;
        _isolated = key == _isolated ? string.Empty : key;
        _selected = string.IsNullOrEmpty(_isolated) ? [] : [_isolated];
        // Start at the immediate neighbors. The graph is largely one connected component, so an
        // unbounded walk from any node reaches nearly all of it and drilling in shows no change.
        _hops = string.IsNullOrEmpty(_isolated) ? 0 : 1;
        SyncAddress();
        // Gaining or losing a focus is what makes steps available, so the payload changes with it.
        if (ShowSteps != wasShowingSteps) await LoadGraph();
        await Refilter();
    }

    /// <summary>Escape, or a click on empty canvas: the short way back out of a selection.</summary>
    [JSInvokable]
    public async Task OnGraphCleared()
    {
        if (string.IsNullOrEmpty(_isolated) && _selected.Count == 0) return;
        // Only isolation changed which nodes are on screen, so only isolation has earned a camera
        // move. Recentering after merely dropping a highlight loses the reader's place for nothing.
        await ClearSelection(recenter: !string.IsNullOrEmpty(_isolated));
        StateHasChanged();
    }

    /// <summary>
    /// Puts the whole view back in the address: the scope in its canonical form, and the
    /// presentation that decides how it is drawn.
    ///
    /// <para>
    /// Written through <see cref="ScopeService"/> rather than assembled inline because the same
    /// text is read by the graph API and by the pull request gate, and three hand-rolled
    /// serializers drift without anything reporting it — which is how this page came to write
    /// <c>ref</c> and read <c>refStyle</c>.
    /// </para>
    /// </summary>
    public void SyncAddress()
    {
        Scope.Set(CurrentSpec());
        Scope.Select(string.IsNullOrEmpty(_isolated) ? [] : [_isolated]);

        var presentation = new List<string> { $"view={_view}" };
        if (_direction != "both") presentation.Add($"direction={_direction}");
        // Drawing choices are serialized through the same record saved views use.
        var drawn = CurrentPresentation with
        {
            View = string.Empty, Direction = string.Empty, Selection = string.Empty,
        };
        if (drawn.ToQueryString() is { Length: > 0 } rest) presentation.Add(rest);
        // Where the reader came from, so the way back out survives touching a filter.
        if (!string.IsNullOrEmpty(FromParam)) presentation.Add($"from={Uri.EscapeDataString(FromParam)}");
        if (!string.IsNullOrEmpty(StatusParam)) presentation.Add($"status={Uri.EscapeDataString(StatusParam)}");

        var scope = Scope.ToQueryString();
        var query = string.Join("&", presentation);
        if (scope.Length > 0) query = $"{query}&{scope}";

        // Replaced rather than pushed: the address mirrors what is on screen, and now that every
        // control syncs, pushing would cost a press of Back for each checkbox touched.
        if (Tutorial.IsReadOnly)
            Tutorial.Navigate($"/explore?{query}");
        else
            Nav.NavigateTo($"/explore?{query}", new NavigationOptions { ReplaceHistoryEntry = true });
    }

    /// <summary>The portable half of what is on screen. Presentation is deliberately absent.</summary>
    private ViewSpec CurrentSpec() => new()
    {
        // Terms this page has no control for still travel. A scope built on another surface, or
        // by hand, must not be quietly widened by being looked at here.
        Provider = Scope.Spec.Provider,
        Severity = Scope.Spec.Severity,
        SecuritySeverities = Scope.Spec.SecuritySeverities,
        Sources = Scope.Spec.Sources,
        Boundary = Scope.Spec.Boundary,
        Repositories = Scope.Spec.Repositories,
        NotRules = Scope.Spec.NotRules,
        Properties = Scope.Spec.Properties,
        NotProperties = Scope.Spec.NotProperties,
        Steps = Scope.Spec.Steps,
        Mode = Scope.Spec.Mode,
        EdgeKinds = Scope.Spec.EdgeKinds,

        Scope = _scope,
        Search = _search,
        // The arrival set is what the payload holds without a focus, so spelled out it narrows
        // nothing here, and on any other page the scope opens on it lists kinds that page never
        // shows.
        Kinds = ArrivalKinds().SetEquals(_kinds) ? [] : [.. _kinds],
        Origins = [.. _origins],
        Rules = [.. _rules],
        // Selecting every value of a term is the same question as selecting none, and writing it
        // out makes a filter of something that excludes nothing. Compared against this page's own
        // list rather than a vocabulary restated here.
        EdgeClass = _edgeClasses.Count == EdgeKinds.Length ? [] : [.. _edgeClasses],
        // "any" is the absence of a reference-style question, not a third style.
        RefStyle = _refStyle == "any" ? string.Empty : _refStyle,
        MinReach = _minReach ?? 0,
        Flags = [.. _flags],
    };

    private async Task ClearSelection() => await ClearSelection(recenter: true);

    private async Task ClearSelection(bool recenter)
    {
        var wasShowingSteps = ShowSteps;
        _isolated = string.Empty;
        _selected = [];
        _hops = 0;
        await FallBackFromSelectionOnlyView();
        SyncAddress();
        if (ShowSteps != wasShowingSteps) await LoadGraph();
        await Refilter();
        await _module!.InvokeVoidAsync("setSelection", "abom-graph", Array.Empty<string>());
        if (recenter) await _module!.InvokeVoidAsync("fit", "abom-graph");
    }

    /// <summary>Leaving a view that places nodes by hop distance, once there is nothing to measure from.</summary>
    private async Task FallBackFromSelectionOnlyView()
    {
        var active = Views.FirstOrDefault(v => v.Key == _view);
        if (active is { NeedsSelection: true } && !HasSelection)
        {
            _view = "neighborhood";
            await _module!.InvokeVoidAsync("setView", "abom-graph", _view);
        }
    }

    /// <summary>
    /// How this page is drawing the scope, so a saved view can record the picture and not only
    /// the question. Read from the page's own state: anywhere else and a view could record a
    /// drawing nobody was looking at.
    /// </summary>
    public Presentation CurrentPresentation => new()
    {
        View = _view,
        GroupBy = _groupBy,
        Hops = _hops,
        Direction = _direction,
        Use3d = _use3d,
        Collapsed = _collapsed,
        StableLayout = _stableLayout,
        Selection = _isolated,
    };

    /// <summary>
    /// Draws the scope the way a saved view was drawn. Nothing saved leaves the reader's own
    /// choices alone rather than resetting them to defaults — which is what every view saved
    /// before presentation existed carries, so treating absent as "all defaults" would change the
    /// picture under everybody who applied one.
    /// </summary>
    public async Task ApplyPresentation(Presentation drawn)
    {
        if (!drawn.HasAny) return;
        if (drawn.Selection.Length > 0 && drawn.Selection != _isolated)
        {
            _isolated = drawn.Selection;
            _selected = [_isolated];
            Scope.Select(_selected);
            // A focus starts at its immediate neighbors unless the picture says how far it went.
            if (drawn.Hops == 0) _hops = 1;
        }
        if (drawn.View.Length > 0 && drawn.View != _view) await OnViewChanged(drawn.View);
        if (drawn.GroupBy.Length > 0 && drawn.GroupBy != _groupBy) await OnGroupByChanged(drawn.GroupBy);
        if (drawn.Direction.Length > 0 && drawn.Direction != _direction) await OnDirectionChanged(drawn.Direction);
        if (drawn.Use3d != _use3d) await On3dChanged(drawn.Use3d);
        if (drawn.Collapsed != _collapsed) await OnCollapsedChanged(drawn.Collapsed);
        if (drawn.StableLayout != _stableLayout) await OnStableLayoutChanged(drawn.StableLayout);
        if (drawn.Hops != _hops) await OnHopsChanged(drawn.Hops);
        SyncAddress();
    }

    private async Task OnViewChanged(string value)
    {
        _view = value;
        if (value == "priority") await PushPriorities();
        await _module!.InvokeVoidAsync("setView", "abom-graph", value);
        SyncAddress();
    }

    /// <summary>The advisories unit's rank drives the Priority force: the first-ranked sits closest in.</summary>
    private async Task PushPriorities()
    {
        var items = await Api.GetRemediationAsync(300);
        var map = new Dictionary<string, int>();
        foreach (var item in items)
        {
            foreach (var action in item.Actions)
            {
                map[action] = Math.Max(map.GetValueOrDefault(action), items.Count + 1 - item.Rank);
            }
        }
        await _module!.InvokeVoidAsync("setPriorities", "abom-graph", map);
    }

    /// <summary>The picker changed a term, so the page reads its own state back out of the scope.</summary>
    ///
    /// <para>The page keeps a field per term because the browser filters with them, and
    /// <c>CurrentSpec()</c> writes every one of them into the shared scope. That makes the round
    /// trip complete: whatever the picker changed, everything else in the spec is still this
    /// page's own answer, so mirroring the whole thing back cannot lose a term.</para>
    ///
    /// <para>Changing the scope term refetches, because it decides what the payload contains
    /// rather than what is drawn from it. Everything else is a filter over what already arrived.</para>
    private async Task OnPickerChanged()
    {
        var spec = Scope.Spec;
        _search = spec.Search;
        _minReach = spec.MinReach > 0 ? spec.MinReach : null;
        _rules = [.. spec.Rules];
        _origins = [.. spec.Origins];
        _flags = [.. spec.Flags];
        _kinds = KindsOf(spec);
        _edgeClasses = EdgeClassesOf(spec);
        // Taken as written, so closing either chip removes the term. `any` is what no reference
        // style asked means; no scope is drawn the way a named scope without one already is.
        _refStyle = RefStyles.Contains(spec.RefStyle) ? spec.RefStyle : "any";
        _scope = ScopeKeys.Contains(spec.Scope) ? spec.Scope : string.Empty;

        // Nothing left is nothing asked: the frame says to choose, and no payload is fetched for
        // a question nobody wrote.
        if (!HasScope)
        {
            _requestedTerms = null;
            _refused = [];
            _counts = new Counts(0, 0, 0, 0);
            StateHasChanged();
            return;
        }

        // Refetch when server-side terms changed; browser filtering cannot narrow data it never loaded.
        if (_requestedTerms is null || string.Join("&", ServerTerms()) != _requestedTerms)
        {
            await LoadGraph(force: true);
            return;
        }
        await Refilter();
    }

    private async Task OnAnimateChanged(bool value)
    {
        _animate = value;
        await _module!.InvokeVoidAsync("setAnimate", "abom-graph", value);
    }

    private bool _drawWarning;

    private void OpenDrawWarning() => _drawWarning = true;

    /// <summary>Accepts one oversized picture until the node set is replaced.</summary>
    private async Task ConfirmDrawAnyway()
    {
        _drawWarning = false;
        if (_module is null) return;
        Busy("Drawing every node\u2026");
        try
        {
            _counts = await _module.InvokeAsync<Counts>(
                "approveLargeGraph", "abom-graph", FilterSpec());
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    /// <summary>Where positions come from: server layout engine or simulation.</summary>
    public sealed record LayoutState(bool Stable, string Text, int Pinned, int Free, bool Fault = false);

    private bool _stableLayout;
    private LayoutState? _layout;

    /// <summary>Names the simulation fallback while no server layout is active.</summary>
    private string LayoutStateText =>
        _layout?.Text ?? "Force layout — positions change on every reload";

    private async Task OnStableLayoutChanged(bool value)
    {
        _stableLayout = value;
        if (!value)
        {
            _layout = null;
            await _module!.InvokeVoidAsync("clearServerLayout", "abom-graph");
            return;
        }
        await ApplyStableLayout();
    }

    /// <summary>Asks the server to place the scope currently on screen.</summary>
    private async Task ApplyStableLayout()
    {
        if (_module is null || !_stableLayout) return;

        var query = ServerTerms();
        if (_groupBy != "none") query.Add("groupBy=" + _groupBy);
        var url = "/api/graph/layout" + (query.Count > 0 ? "?" + string.Join("&", query) : "");

        Busy("Placing the graph…");
        try
        {
            _layout = await _module.InvokeAsync<LayoutState>("applyServerLayout", "abom-graph", url);
        }
        finally
        {
            // Pinned nodes may leave the engine already stopped, so no settle callback is guaranteed.
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task OnGroupByChanged(string value)
    {
        var wasGrouped = _groupBy != "none";
        _groupBy = value;
        // Collapsing by nothing would fold the whole graph into one node.
        if (_groupBy == "none" && _collapsed) await OnCollapsedChanged(false);
        await _module!.InvokeVoidAsync("setGroupBy", "abom-graph", _groupBy);
        // Crossing in or out of None changes the filtered node set.
        if (_collapsed || wasGrouped != (_groupBy != "none")) await Refilter();
        // Server layout boxes are tied to the grouping level.
        await ApplyStableLayout();
    }

    private string ScopeBusyMessage => _scope switch
    {
        "owned" => "Loading what you own…",
        "supply-chain" => "Loading what you own and what it runs…",
        "exposure" => "Loading what reaches an advisory…",
        _ => "Loading…",
    };

    private async Task OnScopeChanged(string value)
    {
        _scope = value;
        await LoadGraph(force: true);
        _groupBy = "owner";
        await OnCollapsedChanged(false);
    }
    private async Task OnCollapsedChanged(bool value)
    {
        _collapsed = value;
        Busy(value ? "Folding groups…" : "Expanding groups…");
        await _module!.InvokeVoidAsync("setGroupBy", "abom-graph", _groupBy);
        await _module!.InvokeVoidAsync("setCollapsed", "abom-graph", value, FilterSpec());
        await Refilter();
    }

    private async Task On3dChanged(bool value)
    {
        _use3d = value;
        Busy(value ? "Rebuilding in 3D…" : "Rebuilding in 2D…");
        if (_module is null) return;
        var spec = new { selection = _isolated, hops = _hops };
        await _module.InvokeVoidAsync("setMode", "abom-graph", value, spec);
        await _module.InvokeVoidAsync("setPalette", "abom-graph", Theme.Palette);
        await Refilter();
    }

    private async Task OnHopsChanged(int v) { _hops = v; await Refilter(); }

    private async Task OnDirectionChanged(string v) { _direction = v; await Refilter(); }

    // Arriving from another page is a one-way trip otherwise: the browser's Back works, but
    // nothing on screen says so, and the reader has usually changed something by then.
    private bool CameFromDiscovery => FromParam == "discovery";

    private string BackToDiscovery => "/inventory?unit=coverage";

    private string DirectionMeaning =>
        Directions.FirstOrDefault(d => d.Key == _direction)?.Meaning ?? string.Empty;

    private async Task OnFlagsChanged(IEnumerable<string> v)
    {
        var wasShowingSteps = ShowSteps;
        _flags = v?.ToArray() ?? [];
        // Steps are a different payload, not a different predicate.
        if (ShowSteps != wasShowingSteps) await LoadGraph();
        else await Refilter();
    }

    private void OnThemeChanged()
    {
        if (_module is not null)
        {
            _ = _module.InvokeVoidAsync("setPalette", "abom-graph", Theme.Palette).AsTask();
        }
        StateHasChanged();
    }

    internal sealed record LoadResult(
        int Nodes, int Edges, IReadOnlyList<string> Rules, bool Cached, long Generation);

    public async ValueTask DisposeAsync()
    {
        Theme.Changed -= OnThemeChanged;
        Follow.Changed -= OnFollowChanged;
        _followTimer?.Dispose();
        if (_module is not null)
        {
            try
            {
                // Keep the entry: it holds the parsed graph and the positions it settled into,
                // which is the whole cost of coming back to this page.
                await _module.InvokeVoidAsync("dispose", "abom-graph", true);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { /* the circuit is already gone */ }
        }
        _self?.Dispose();
    }
}
