<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <AssemblyName>Abom.WebAssembly</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <RootNamespace>Abom.WebAssembly</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <!-- AOT is deliberately off: it needs the wasm-tools workload, and `abom serve` is a local
         binary where startup latency matters less than a build anyone can reproduce. -->
    <RunAOTCompilation>false</RunAOTCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.1" PrivateAssets="all" />
    <PackageReference Include="MudBlazor" Version="8.15.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The bUnit harness has to supply a result for every typed call into ./js/graph.js, and it
         cannot name a private nested record. Visibility only; nothing changes at runtime. -->
    <InternalsVisibleTo Include="Abom.WebAssembly.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests run under node, not in the browser; shipping them would serve dead bytes. -->
    <Content Remove="wwwroot/js/*.test.js" />
  </ItemGroup>

  <ItemGroup>
    <!-- The component tests live under this directory but are not part of the app. Without this
         the SDK's `**/*.cs` glob compiles them into the assembly, which then fails on the test
         framework it cannot see. -->
    <Compile Remove="tests/**" />
    <Content Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>

</Project>
