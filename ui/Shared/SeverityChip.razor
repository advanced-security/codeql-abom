@inject ThemeService Theme

@* Severity always carries its label. Colour alone excludes anyone who cannot distinguish these
   hues, and the ranking has to survive a greyscale screenshot. *@
<span style="display:inline-flex;align-items:center;gap:0.35rem;">
    <span style="@DotStyle"></span>
    <span style="font-size:0.8rem;font-weight:500;">@Display</span>
</span>

@code {
    [Parameter, EditorRequired] public string Severity { get; set; } = string.Empty;

    private string Display => string.IsNullOrWhiteSpace(Severity)
        ? "unrated"
        : char.ToUpperInvariant(Severity[0]) + Severity[1..].ToLowerInvariant();

    private string DotStyle =>
        $"width:9px;height:9px;border-radius:50%;flex:none;background:{Theme.SeverityColour(Severity)};";
}
