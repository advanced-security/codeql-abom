@inject ThemeService Theme

@* Severity always carries its label. Color alone excludes anyone who cannot distinguish these
   hues, and the ranking has to survive a greyscale screenshot. *@
<span class="abom-sev">
    @* The one inline declaration in the interface: the hue is theme-dependent and lives in
       ThemeService, so restating it in CSS would create a second source for the same fact. *@
    <span class="abom-sev-dot" style="--abom-sev-color:@Theme.SeverityColor(Severity)"></span>
    <span class="abom-sev-label">@Display</span>
</span>

@code {
    [Parameter, EditorRequired] public string Severity { get; set; } = string.Empty;

    private string Display => string.IsNullOrWhiteSpace(Severity)
        ? "unrated"
        : char.ToUpperInvariant(Severity[0]) + Severity[1..].ToLowerInvariant();
}
