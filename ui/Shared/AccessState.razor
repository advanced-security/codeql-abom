@using Abom.WebAssembly.Models
@using Abom.WebAssembly.Services
@inject RoleService Roles

@* No page is drawn until ABOM has said who is asking: drawn first, a page fetches figures the server
   may refuse and shows them as none. An account with no ABOM role sees one state for the whole page,
   rather than every page failing on its own. *@
@if (!_known)
{
    <MudProgressLinear Indeterminate="true" Class="my-8" data-abom-access-pending />
}
else if (_noRole)
{
    <MudAlert Severity="Severity.Info" Class="my-4" data-abom-no-role>
        <MudText Typo="Typo.subtitle1">Your account has no ABOM role</MudText>
        <MudText Typo="Typo.body2">
            You are signed in, and your identity provider grants you none of ABOM's roles, so there is
            nothing here you can read yet. Ask an administrator to assign you one.
        </MudText>
    </MudAlert>
}
else
{
    @ChildContent
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _known;
    private bool _noRole;

    protected override async Task OnInitializedAsync()
    {
        _noRole = await Roles.MeAsync() is { Mode: "signed-in", User.Role.Length: 0 };
        _known = true;
    }
}
