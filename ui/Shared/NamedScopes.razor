@* Every named scope, on every page that builds one: a built-in or a kept scope is opened here, and
   the scope on screen is kept here under a name. One control rather than a copy per page, because
   hand-rolled copies of one serializer are how the Explorer came to write `ref` and read
   `refStyle`.

   Chips rather than a menu, for the reason the exports are not in one either: MudMenu renders its
   items only once opened, so what is on offer is neither discoverable nor checkable.

   Whether this page can open a scope is the server's answer for this page. A client deciding it
   would be a capability that exists only in a client, and the first refusal it got wrong would
   widen a scope without a word. *@

@inject AbomApi Api
@inject ScopeService Scope
@implements IDisposable

@* No box of its own: the chips, the name and Keep lay out in the host's scope bar as they did
   before they were one component. *@
<div class="abom-named-scopes" data-abom-named-scopes="@Surface">
    <div class="abom-views d-flex flex-wrap align-center gap-1" data-abom-views="@Surface">
        @foreach (var view in _views)
        {
            var reason = Refusal(view);
            @* The reason sits on a span outside the chip: a disabled chip takes no pointer events,
               so a title on it never shows, and that is the title a reader needs most. Forget
               shares the span so a wrapping row cannot part it from the scope it forgets. *@
            <span class="abom-view" title="@(reason.Length > 0 ? Tooltip(view, reason) : null)"
                  data-abom-view-reason="@view.Name">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                         Color="@(IsSelected(view) ? Color.Primary : Color.Default)"
                         Class="@(IsSelected(view) ? "abom-view-selected" : null)"
                         Disabled="@(reason.Length > 0)"
                         OnClick="@(() => Chosen.InvokeAsync(view))"
                         title="@Tooltip(view, reason)"
                         data-abom-view="@view.Name">@view.Label</MudChip>
                @* A built-in is code: the server refuses to delete it, so offering the control
                   would be an affordance that cannot work. *@
                @if (!view.Builtin)
                {
                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.Close"
                                   aria-label="@($"Forget {view.Label}")"
                                   title="@($"Forget the saved scope {view.Label}. The filters on this page stay as they are.")"
                                   OnClick="@(() => Forget(view))"
                                   data-abom-forget-view="@view.Name" />
                }
            </span>
        }
    </div>
    <MudTextField T="string" @bind-Value="_name" Placeholder="Name this scope"
                  Immediate="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                  Class="abom-scope-name" data-abom-scope-name="1" />
    <MudButton Size="Size.Small" DropShadow="false" Variant="Variant.Outlined"
               StartIcon="@Icons.Material.Outlined.BookmarkAdd" OnClick="Keep"
               Disabled="@(_name.Trim().Length == 0 || Scope.Spec.ToQueryString().Length == 0)"
               title="Save the current filters under this name for reuse on pages that can open them."
               data-abom-save-scope="1">Keep</MudButton>
    @if (_refused is { Length: > 0 } refused)
    {
        <MudText Typo="Typo.caption" Color="Color.Warning" data-abom-scope-refused>@refused</MudText>
    }
</div>

@code {
    /// <summary>Which page this is, so a scope it would refuse is disabled here rather than refused on use.</summary>
    [Parameter, EditorRequired]
    public string Surface { get; set; } = string.Empty;

    /// <summary>Raised when a scope is chosen. The page opens it: its question, and its picture if it draws.</summary>
    [Parameter]
    public EventCallback<NamedView> Chosen { get; set; }

    /// <summary>How the page is drawing the scope, kept beside it. None on a page that draws nothing.</summary>
    [Parameter]
    public Func<string>? Presentation { get; set; }

    // What a reader calls each page a scope opens on, in the order the Inventory lists its units.
    private IReadOnlyList<NamedView> _views = [];
    private IReadOnlyDictionary<string, string> _labels = new Dictionary<string, string>();
    private string _name = string.Empty;
    private string? _refused;

    protected override async Task OnInitializedAsync()
    {
        // A page loads a scope from outside this control, so what is marked in force is a reading
        // of the scope rather than a memory of the last click.
        Scope.Changed += Redraw;
        _views = await Api.GetViewsAsync();
        _labels = (await Api.GetFilterTermsAsync())
            .ToDictionary(t => t.Name, t => t.Label, StringComparer.Ordinal);
    }

    private void Redraw() => InvokeAsync(StateHasChanged);

    public void Dispose() => Scope.Changed -= Redraw;

    // Compared as canonical text, which is the whole reason a built-in's predicate is stored
    // canonical rather than however it was typed.
    private bool IsSelected(NamedView view) => Scope.Spec.ToQueryString() == view.Predicate;

    // What the scope holds, then why this page cannot open it, if it cannot.
    private static string Tooltip(NamedView view, string reason)
    {
        var holds = view.Description.Length > 0 ? view.Description : $"Open {view.Label} on this page.";
        return reason.Length > 0 ? $"{holds} {reason}" : holds;
    }

    /// <summary>Why this page cannot open a scope, or empty when it can.</summary>
    private string Refusal(NamedView view)
    {
        if (!view.Refuses.TryGetValue(Surface, out var refused))
        {
            return "ABOM cannot read this scope's filter, so no page opens it.";
        }
        if (refused.Count == 0) return string.Empty;

        var terms = refused.Select(t => Quote(view, t)).ToList();
        var opens = RefusalText.Pages
            .Where(p => p.Surface != Surface)
            .Where(p => view.Refuses.TryGetValue(p.Surface, out var r) && r.Count == 0)
            .Select(p => p.Name)
            .ToList();
        var sentence = RefusalText.CannotNarrow(Surface, terms);
        return opens.Count == 0
            ? sentence
            : $"{sentence} {RefusalText.Capitalized(RefusalText.Join(opens, "and"))} can.";
    }

    // A surface answering part of a list term refuses the rest one member at a time, as `term=member`.
    private string Quote(NamedView view, string refused) =>
        refused.Split('=', 2) is [var term, var member]
            ? RefusalText.Quoted(Label(term), member)
            : RefusalText.Quoted(Label(refused), Values(view.Predicate, refused));

    private string Label(string term) => _labels.TryGetValue(term, out var label) ? label : term;

    private static string Values(string predicate, string term) =>
        string.Join(", ", predicate.Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Select(pair => pair.Split('=', 2))
            .Where(kv => kv.Length == 2 && ViewSpec.Unescape(kv[0]) == term)
            .Select(kv => ViewSpec.Unescape(kv[1])));

    /// <summary>
    /// Keeps the scope on screen under a name: its predicate, never the selection riding beside
    /// it, which the server would refuse as a filter it has never heard of.
    /// </summary>
    private async Task Keep()
    {
        var saved = await Api.SaveViewAsync(_name.Trim(), Scope.Spec.ToQueryString(), Presentation?.Invoke());
        _refused = saved is null ? $"This scope could not be saved: {Api.LastError}" : null;
        if (saved is null) return;
        _views = saved;
        _name = string.Empty;
    }

    private async Task Forget(NamedView view)
    {
        var left = await Api.ForgetViewAsync(view.Name);
        _refused = left is null ? $"{view.Label} could not be forgotten: {Api.LastError}" : null;
        if (left is not null) _views = left;
    }
}
