@using Abom.WebAssembly.Models
@using Abom.WebAssembly.Services
@implements IDisposable
@inject AbomApi Api
@inject AccountService Accounts
@inject FollowService Follow
@inject NavigationManager Nav
@inject RunDraft Draft
@inject ScopeService Scope

@if (_refusal is not null)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" ShowCloseIcon="true"
              CloseIconClicked="@(() => _refusal = null)" data-abom-queries-refusal>@_refusal</MudAlert>
}

@* The draft the Inventory holds, over a named scope rather than repositories ticked one by one. *@
@if (_drafting)
{
    <RunDraftPanel Predicate="@DraftPredicate" Closed="CloseDraft">
        <Scope>
            @if (_view is null)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary" data-abom-run-scope>None chosen yet</MudText>
            }
            else
            {
                <MudText Typo="Typo.body2" title="@_view.Description" data-abom-run-scope><strong>@_view.Label</strong></MudText>
            }
        </Scope>
        <ChildContent>
            <div class="d-flex flex-wrap align-center gap-2">
                <NamedScopes Surface="run" Chosen="ChooseScope" />
                <Tip Text="Pick repositories one by one in the Inventory instead of a named scope.">
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" DropShadow="false"
                               StartIcon="@Icons.Material.Outlined.Checklist"
                               OnClick="ChooseInInventory" data-abom-run-in-inventory>
                        Pick repositories
                    </MudButton>
                </Tip>
            </div>
        </ChildContent>
    </RunDraftPanel>
}

@if (_catalog is null)
{
    <MudProgressLinear Indeterminate="true" data-abom-queries-loading />
}
else if (_catalog.Queries.Count == 0)
{
    @* Says what would fill the catalog rather than rendering an empty table. *@
    <MudPaper Class="pa-6" Outlined="true" data-abom-queries-empty>
        <MudText Typo="Typo.h6">No query has run yet</MudText>
        <MudText Typo="Typo.body2" Class="mt-2 mud-text-secondary">
            A version appears here once a run is on record for it. Start discovery, or run a
            query on repositories chosen in the Inventory, and each version is catalogued as it runs.
        </MudText>
        <Tip Text="Set up the crawl that runs queries as it finds repositories.">
            <MudButton Href="/settings" Variant="Variant.Outlined" Class="mt-4"
                       StartIcon="@Icons.Material.Outlined.Settings">Discovery</MudButton>
        </Tip>
    </MudPaper>
}
else
{
    <div class="abom-queries-counts mb-3 d-flex align-center" data-abom-queries-counts>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            @CountText.Of(Shown.Count, "query version", "query versions"), @Unstaged not yet staged.
            @if (Hidden > 0 && !_showDiscovery)
            {
                @* Says what the default hides, or this reads as the whole catalog. *@
                <span data-abom-queries-hidden>
                    @Hidden more are not single queries: graph-building queries, and whole suites or
                    sets of queries run in one evaluation.
                </span>
            }
            else if (Hidden > 0)
            {
                <span>@Hidden of them are not single queries.</span>
            }
        </MudText>
        @if (Hidden > 0)
        {
            @* On a wrapper: MudBlazor splats the attribute onto a hidden input. *@
            <Tip Text="Include graph-building queries and whole suites, not just single queries." Class="ml-4">
                <span data-abom-queries-discovery-toggle>
                    <MudSwitch T="bool" Value="_showDiscovery" ValueChanged="@((bool v) => { _showDiscovery = v; })"
                               Color="Color.Primary" Size="Size.Small"
                               Label="Show everything that ran" />
                </span>
            </Tip>
        }
    </div>

    @* Above the grid, not under it: the grid is sized to end at the window's foot, and a notice
       below it scrolled the page and carried the pinned header under the bar. *@
    @if (!CanAdvance)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2" data-abom-queries-unsigned>
            Advancing a stage and asking for a run both record who did it. Sign in with
            <code>gh</code> and refresh your identity in Settings to enable them.
        </MudAlert>
    }

    <MudDataGrid T="CatalogQuery" Items="Shown" Dense="true" Hover="true" Bordered="false"
                 SortMode="SortMode.Single" Filterable="false" ShowColumnOptions="false"
                 FixedHeader="true" RowsPerPage="30" Class="abom-grid abom-grid-windowed"
                 data-abom-queries-table>
        <Columns>
            <HierarchyColumn T="CatalogQuery" InitiallyExpandedFunc="@Focused">
                <CellTemplate>
                    <Tip Text="@(context.Open ? "Hide where this version ran." : "Show where this version ran and what is recorded for it.")">
                        <MudIconButton Size="Size.Small"
                                       Icon="@(context.Open ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)"
                                       aria-label="@($"Show where {context.Item.QueryId} ran")"
                                       aria-expanded="@(context.Open ? "true" : "false")"
                                       OnClick="@(() => context.Actions.ToggleHierarchyVisibilityForItemAsync())"
                                       data-abom-query-detail />
                    </Tip>
                </CellTemplate>
            </HierarchyColumn>

            <PropertyColumn Property="x => x.QueryId" Title="Query"
                            HeaderClass="abom-identity-col" CellClass="abom-identity-col">
                <HeaderTemplate><HeaderTip Tip="The query's identifier, with its authoring steps while it is being written.">Query</HeaderTip></HeaderTemplate>
                <CellTemplate>
                    <div class="abom-query-id" data-abom-query-id="@context.Item.QueryId">
                        @context.Item.QueryId
                    </div>
                    @* Under the id rather than in the action column, which would widen every row for one. *@
                    @if (context.Item.Working && context.Item.Steps.Count > 0)
                    {
                        <AuthoringSteps Steps="@context.Item.Steps" QueryId="@context.Item.QueryId"
                                        CanTest="@CanTest(context.Item)"
                                        TestRefusal="@TestRefusal(context.Item)"
                                        OnTest="@(() => Test(context.Item))"
                                        CanPrint="@CanTest(context.Item)"
                                        OnPrint="@(() => Print(context.Item))" />
                    }
                </CellTemplate>
            </PropertyColumn>

            @* Beside the thing it acts on, like every other grid in the interface. *@
            <TemplateColumn Title="" Sortable="false" HeaderClass="abom-row-actions-head"
                            CellClass="abom-row-actions">
                <CellTemplate>
                    <div class="abom-query-actions">
                        @if (context.Item.Source == "custom" && !(context.Item.Working && context.Item.Steps.Count > 0))
                        {
                            @* What an older version's tests said is history, and cannot be re-run. *@
                            <Tip Text="@SupersededTooltip(context.Item)">
                                <MudIconButton Icon="@Icons.Material.Outlined.Science"
                                               Size="Size.Small" Color="@TestColor(context.Item)"
                                               Disabled="true"
                                               aria-label="Tests of an older version"
                                               data-abom-query-superseded-test />
                            </Tip>
                        }
                        <Tip Text="@RunTooltip(context.Item)">
                            <MudIconButton Icon="@Icons.Material.Outlined.PlayArrow"
                                           Size="Size.Small" Color="Color.Primary"
                                           Disabled="@(!CanRun(context.Item))"
                                           OnClick="@(() => AddToRun(context.Item))"
                                           aria-label="Add this version to a run"
                                           data-abom-query-run />
                        </Tip>
                    </div>
                </CellTemplate>
            </TemplateColumn>

            @* What the version would report at, before anything runs it, in its own column so it
               sorts. A version without a declaration says why in the server's words: being read,
               gone from disk and never versioned are three states, and only the first ends in a read. *@
            <TemplateColumn T="CatalogQuery" Title="Severity" Sortable="true" SortBy="q => SeverityText.Order(q.Band)">
                <HeaderTemplate><HeaderTip Tip="The severity this query declares for what it reports, with its declared level and score, before anything runs it.">Severity</HeaderTip></HeaderTemplate>
                <CellTemplate>
                    @if (!context.Item.Lane && context.Item.Metadata is null)
                    {
                        @* The server's reason, whole, in the tip: in the cell it set every row's height. *@
                        <span class="abom-coverage-unknown abom-nowrap" data-abom-query-metadata-absent="@context.Item.QueryId"
                              title="@(context.Item.MetadataUnread.Length > 0 ? context.Item.MetadataUnread
                                  : "ABOM has not read the metadata this version declares yet.")">@(context.Item.MetadataUnread.Length > 0
                                  ? "cannot be read" : "not read yet")</span>
                    }
                    else if (context.Item.Band.Length > 0)
                    {
                        @* Stacked, each part on one line: side by side they wrapped a narrow column onto four. *@
                        <div class="d-flex flex-column align-start" data-abom-query-band="@context.Item.QueryId">
                            <SeverityChip Severity="@context.Item.Band" />
                            <MudText Typo="Typo.caption" Class="mud-text-secondary abom-nowrap">@DeclaredLevel(context.Item)</MudText>
                        </div>
                    }
                </CellTemplate>
            </TemplateColumn>

            <PropertyColumn Property="x => x.QueryVersion" Title="Version">
                <HeaderTemplate><HeaderTip Tip="The version of the query that ran, or a note that none was recorded.">Version</HeaderTip></HeaderTemplate>
                <CellTemplate>
                    @if (context.Item.QueryVersion.Length == 0)
                    {
                        @* These ran before versions were recorded; not a version anyone chose. *@
                        <MudText Typo="Typo.caption" Class="mud-text-secondary"
                                 data-abom-query-unversioned>not recorded</MudText>
                    }
                    else
                    {
                        <code data-abom-query-version="@context.Item.QueryVersion">@Short(context.Item.QueryVersion)</code>
                    }
                </CellTemplate>
            </PropertyColumn>

            @* Own name only: ABOM packs share a scope and prefix, so truncated they read alike. *@
            <PropertyColumn Property="x => x.Pack" Title="Pack" CellClass="abom-nowrap">
                <HeaderTemplate><HeaderTip Tip="The CodeQL pack that supplied this version of the query.">Pack</HeaderTip></HeaderTemplate>
                <CellTemplate>
                    <span class="abom-path" title="@context.Item.Pack" data-abom-query-pack="@context.Item.Pack">@PackText(context.Item.Pack)</span>@if (context.Item.PackVersion.Length > 0) { <code class="abom-faint" data-abom-query-pack-version>@("@" + context.Item.PackVersion)</code> }
                </CellTemplate>
            </PropertyColumn>

            @* Which suite the crawl ran it in. A query that only ever ran on demand has none. *@
            <PropertyColumn Property="x => x.Suite" Title="Crawl suite" CellClass="abom-nowrap">
                <HeaderTemplate><HeaderTip Tip="The crawl suite that runs this query, or a dash when it has only run on request.">Crawl suite</HeaderTip></HeaderTemplate>
                <CellTemplate>
                    @if (context.Item.Suite.Length == 0)
                    {
                        <MudText Typo="Typo.caption" Class="abom-faint">—</MudText>
                    }
                    else
                    {
                        <span class="abom-path" title="@context.Item.Suite"
                              data-abom-query-suite>@SuiteText(context.Item.Suite)</span>
                    }
                </CellTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.Source" Title="Source">
                <HeaderTemplate><HeaderTip Tip="Where the query came from: upstream CodeQL, ABOM's own pack, a custom pack, or several of them.">Source</HeaderTip></HeaderTemplate>
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             data-abom-query-source="@context.Item.Source">@SourceText(context.Item.Source)</MudChip>
                </CellTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.LastRunAt" Title="Last run" CellClass="abom-nowrap">
                <HeaderTemplate><HeaderTip Tip="When this version of the query last ran.">Last run</HeaderTip></HeaderTemplate>
                <CellTemplate>
                    @if (context.Item.Runs == 0 && context.Item.LastRunAt.Length == 0)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary"
                                 data-abom-query-never-run>not run yet</MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption">@TimeText.DayAndTime(context.Item.LastRunAt)</MudText>
                    }
                </CellTemplate>
            </PropertyColumn>

            @* The stage is its own control; a menu at the row's start had no evident purpose. *@
            <PropertyColumn Property="x => x.Stage" Title="Stage">
                <HeaderTemplate><HeaderTip Tip="The stage this version of the query is in. Click it to move the version to another stage.">Stage</HeaderTip></HeaderTemplate>
                <CellTemplate>
                    @if (context.Item.Stage.Length == 0)
                    {
                        <span class="abom-stage" data-abom-query-unstaged>
                            <Tip Text="Put this version in a stage. Nobody has yet.">
                                <MudMenu Label="not staged" EndIcon="@Icons.Material.Filled.ArrowDropDown"
                                         Size="Size.Small" Variant="Variant.Text" Dense="true"
                                         Disabled="@(!CanAdvance)" Class="abom-stage-menu"
                                         data-abom-query-advance>
                                    @StageItems(context.Item)
                                </MudMenu>
                            </Tip>
                        </span>
                    }
                    else
                    {
                        <span class="abom-stage" data-abom-query-stage="@context.Item.Stage">
                            <Tip Text="@StagedTitle(context.Item)">
                                <MudMenu Label="@context.Item.Stage" EndIcon="@Icons.Material.Filled.ArrowDropDown"
                                         Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                         Dense="true" Disabled="@(!CanAdvance)" Class="abom-stage-menu"
                                         data-abom-query-advance>
                                    @StageItems(context.Item)
                                </MudMenu>
                            </Tip>
                        </span>
                    }
                </CellTemplate>
            </PropertyColumn>
        </Columns>
        <ChildRowContent>
            <div class="abom-row-detail">
                @if (context.Item.Metadata is { Count: > 0 } declared)
                {
                    <dl class="abom-query-metadata" data-abom-query-metadata>
                        @foreach (var (name, value) in declared.OrderBy(p => p.Key, StringComparer.Ordinal))
                        {
                            <dt>@name</dt>
                            <dd>@value</dd>
                        }
                    </dl>
                }
                @if (context.Item.Requests.Count > 0)
                {
                    <MudText Typo="Typo.caption" Class="d-block mb-2" data-abom-query-requests>
                        Asked for in
                        @foreach (var (id, at) in context.Item.Requests.Select((id, at) => (id, at)))
                        {
                            @(at == 0 ? "" : ", ")
                            <Tip Text="Open the request that asked for this query.">
                                <MudLink Href="@($"/codeql?tab=requests&request={id}")" Typo="Typo.caption"
                                         data-abom-query-request="@id">request #@id</MudLink>
                            </Tip>
                        }
                    </MudText>
                }
                <QueryRuns Query="@context.Item" />
                @if (context.Item.Working && context.Item.Steps.Count > 0)
                {
                    <QueryTrees Query="@context.Item" />
                }
            </div>
        </ChildRowContent>
        <PagerContent><MudDataGridPager T="CatalogQuery" /></PagerContent>
    </MudDataGrid>

}

@code {
    /// <summary>A query to open on arrival, such as the one a request or a run named.</summary>
    [Parameter] public string FocusQuery { get; set; } = string.Empty;

    private QueryCatalog? _catalog;
    private string? _refusal;
    private bool _showDiscovery;
    private Timer? _timer;

    private string Operator => Accounts.Identity.Login;

    private bool CanAdvance => Operator.Length > 0;

    protected override async Task OnInitializedAsync()
    {
        Follow.Changed += Arm;
        // A draft left on either page opens on this one too, over no scope until one is chosen.
        if (Draft.Queries.Count > 0)
        {
            OpenDraft();
        }
        await Accounts.EnsureLoadedAsync();
        await Load();
        Arm();
    }

    private async Task Load() => _catalog = await Api.GetQueryCatalogAsync();

    private void Arm()
    {
        _timer?.Dispose();
        _timer = new Timer(async _ =>
        {
            try
            {
                await Load();
            }
            catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
            {
                return;
            }
            await InvokeAsync(StateHasChanged);
        }, null, Follow.Interval, Follow.Interval);
    }

    /// <summary>The crawl's own queries are out by default, and the count says so.</summary>
    private List<CatalogQuery> Shown => _catalog is null
        ? []
        : _catalog.Queries.Where(q => _showDiscovery || !(q.Discovery || q.Lane)).ToList();

    private int Hidden => _catalog?.Queries.Count(q => q.Discovery || q.Lane) ?? 0;

    private int Unstaged => Shown.Count(q => q.Stage.Length == 0);

    /// <summary>The named query's version on disk, or every version of it when none is.</summary>
    private bool Focused(CatalogQuery q) =>
        FocusQuery.Length > 0 && q.QueryId == FocusQuery &&
        (q.Working || _catalog?.Queries.Any(o => o.QueryId == FocusQuery && o.Working) != true);

    /// <summary>A discovery query builds the graph, so running one on demand answers nothing.</summary>
    private bool CanRun(CatalogQuery q) =>
        CanAdvance && !q.Discovery && !q.Lane && q.QueryVersion.Length > 0;

    private string RunTooltip(CatalogQuery q) =>
        !CanAdvance ? "Sign in to ask for a run."
        : q.Lane ? "This is a whole suite the crawl invoked, not a query to run on its own."
        : q.Discovery ? "This query builds the dependency graph; it reports no findings to review."
        : q.QueryVersion.Length == 0 ? "This ran before versions were recorded, so there is no version to run."
        : "Add this version to a run, over a named scope or repositories chosen in the Inventory.";

    // A run drafted here, and the named scope it is over. The versions are the shared draft's.
    private bool _drafting;
    private NamedView? _view;

    // By name, so the server resolves it and records the name beside what it resolved to.
    private string DraftPredicate => _view is null ? string.Empty : "view=" + Uri.EscapeDataString(_view.Name);

    private void AddToRun(CatalogQuery query)
    {
        if (!CanRun(query))
        {
            return;
        }
        if (!_drafting)
        {
            OpenDraft();
        }
        Draft.Add(new AnalysisQueryRef { QueryId = query.QueryId, QueryVersion = query.QueryVersion });
    }

    // This page holds no scope until a named one is chosen, whatever another page left in force,
    // so Keep here keeps only what the draft is over.
    private void OpenDraft()
    {
        _drafting = true;
        _view = null;
        Scope.Set(new ViewSpec());
    }

    private void ChooseScope(NamedView view)
    {
        _view = view;
        Scope.Set(ViewSpec.Parse(view.Predicate));
    }

    private void CloseDraft()
    {
        _drafting = false;
        _view = null;
        Scope.Set(new ViewSpec());
    }

    /// <summary>Repositories one by one are chosen on the Inventory, and the draft goes with them.</summary>
    private void ChooseInInventory() => Nav.NavigateTo("/inventory?unit=repositories");

    private RenderFragment StageItems(CatalogQuery query) => __builder =>
    {
        foreach (var stage in _catalog!.Stages)
        {
            var refused = stage == query.Stage ? string.Empty
                : stage == ExtendedTest ? query.ExtendedTestRefusal
                : stage == Review ? query.ReviewRefusal
                : string.Empty;
            <MudMenuItem Disabled="@(stage == query.Stage || refused.Length > 0)" OnClick="@(() => Advance(query, stage))"
                         title="@(stage == query.Stage ? $"This query version is already in the {stage} stage." : refused.Length > 0 ? $"This query version cannot move to the {stage} stage yet: {refused}." : $"Move this query version to the {stage} stage.")"
                         data-abom-stage-item="@stage">
                @stage
                @if (refused.Length > 0)
                {
                    <MudText Typo="Typo.caption" Class="d-block mud-text-secondary abom-stage-refused"
                             data-abom-stage-refused>Not yet: @refused</MudText>
                }
            </MudMenuItem>
        }
    };

    /// <summary>The stage the server refuses until the working copy's steps have all passed.</summary>
    private const string ExtendedTest = "extended-test";

    /// <summary>The stage the server refuses until a run of the version is compared with the alerts.</summary>
    private const string Review = "review";

    private static string StagedTitle(CatalogQuery q) => "Move this version to another stage. " + (q.StagedBy.Length == 0
        ? $"It is in the {q.Stage} stage."
        : $"Put in the {q.Stage} stage by {q.StagedBy}, {TimeText.DayAndTime(q.StagedAt)}.");

    private async Task Advance(CatalogQuery query, string stage)
    {
        if (!CanAdvance)
        {
            return;
        }
        var (catalog, refusal) = await Api.AdvanceQueryStageAsync(
            query.QueryId, query.QueryVersion, stage, Operator);
        _refusal = refusal;
        if (catalog is not null)
        {
            _catalog = catalog;
        }
    }

    /// <summary>Only the working copy of the operator's own query has tests ABOM can run.</summary>
    private bool CanTest(CatalogQuery q) =>
        CanAdvance && q.Source == "custom" && q.Working && q.QueryVersion.Length > 0;

    private static Color TestColor(CatalogQuery q) =>
        !q.Tested ? Color.Default : q.Passing ? Color.Success : Color.Error;

    /// <summary>Empty when the Test action is available, so the tests' own evidence is shown.</summary>
    private string TestRefusal(CatalogQuery q) =>
        !CanAdvance ? "Sign in to run tests" : string.Empty;

    private static string SupersededTooltip(CatalogQuery q) =>
        "Only the version on disk can be tested. " + (
            !q.Tested ? "Nothing ran this one's tests."
            : q.Passing ? $"This one's tests passed: {q.TestDetail}"
            : $"This one's tests failed: {q.TestDetail}");

    private async Task Test(CatalogQuery query)
    {
        if (!CanTest(query))
        {
            return;
        }
        var (catalog, refusal) = await Api.TestQueryAsync(query.QueryId, query.QueryVersion);
        _refusal = refusal;
        if (catalog is not null)
        {
            _catalog = catalog;
        }
    }

    // ABOM prints the tree itself, so a query nobody drove a session over can earn its AST step.
    private async Task Print(CatalogQuery query)
    {
        if (!CanTest(query))
        {
            return;
        }
        var (catalog, refusal) = await Api.PrintQueryAstAsync(query.QueryId, query.QueryVersion, Operator);
        _refusal = refusal;
        if (catalog is not null)
        {
            _catalog = catalog;
        }
    }

    /// <summary>Short enough to read; the full hash stays on the element for copying.</summary>
    private static string Short(string version) =>
        version.Length <= 12 ? version : version[..12];

    /// <summary>The level a result reports at and the score behind the band, as the query declares them.</summary>
    private static string DeclaredLevel(CatalogQuery q)
    {
        var level = q.Metadata!.TryGetValue("problem.severity", out var l) ? l : "no level declared";
        var score = q.Metadata.TryGetValue("security-severity", out var s) ? s : "no score declared";
        return $"{level} \u00b7 {score}";
    }

    /// <summary>"Yours" is the word for what the operator owns; a query they wrote is custom.</summary>
    public static string SourceText(string source) => source switch
    {
        "upstream" => "upstream",
        "abom" => "ABOM",
        "custom" => "custom",
        "mixed" => "several packs",
        _ => "unknown",
    };

    private static string PackText(string pack)
    {
        if (pack.Length == 0)
        {
            return "not recorded";
        }
        var names = pack.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Select(n => n.Contains('/') ? n[(n.LastIndexOf('/') + 1)..] : n);
        return string.Join(" + ", names);
    }

    /// <summary>The suite's own name, as the Suites tab spells it; the full reference is the title.</summary>
    private static string SuiteText(string suite) => string.Join(" ",
        suite.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(SuiteBindingText.Label));

    public void Dispose()
    {
        Follow.Changed -= Arm;
        _timer?.Dispose();
    }
}
