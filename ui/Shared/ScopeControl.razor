@* Builds `properties=key:value`, the term every filtering endpoint applies.

   ABOM is told a key and knows nothing about what it means. An organization running `business_id`
   gets business units and one running `team` gets teams, so the key is rendered verbatim and never
   glossed. *@

@inject AbomApi Api
@inject ScopeService Scope

<div class="abom-scope">
    @if (SupportsAnalysisMode || Scope.Spec.Mode.Length > 0)
    {
        <div class="d-flex flex-wrap align-center gap-2 mb-2">
            <MudText Typo="Typo.caption" Class="mud-text-secondary abom-scope-label">
                Analysis mode
            </MudText>
            <MudToggleGroup T="string" Value="@(Scope.Spec.Mode.Length == 0 ? "regular" : Scope.Spec.Mode)"
                            ValueChanged="ChooseMode" Size="Size.Small" Color="Color.Primary"
                            CheckMark="true" SelectionMode="SelectionMode.SingleSelection"
                            aria-label="Analysis mode" data-abom-analysis-mode="1">
                <MudToggleItem T="string" Value="@("regular")" data-abom-mode="regular">
                    <span title="The repository's own checkout">Regular</span>
                </MudToggleItem>
                <MudToggleItem T="string" Value="@("extended")" Disabled="@(!SupportsAnalysisMode)"
                               data-abom-mode="extended">
                    <span title="The repository and its staged dependency closure">Extended</span>
                </MudToggleItem>
            </MudToggleGroup>
            @if (Scope.Spec.Mode == "extended")
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Coverage and dependency reach use regular analysis.
                </MudText>
            }
        </div>
    }
    <div class="d-flex flex-wrap align-center gap-2">
        <MudText Typo="Typo.caption" Class="mud-text-secondary abom-scope-label">
            Repository property
        </MudText>

        @foreach (var key in _keys)
        {
            <MudButton Size="Size.Small" DropShadow="false"
                       Variant="@(key == _key ? Variant.Filled : Variant.Outlined)"
                       Color="Color.Default" OnClick="@(() => ChooseKey(key))"
                       data-abom-property-key="@key">@key</MudButton>
        }

        @foreach (var (match, excluded) in Chosen)
        {
            <MudButton Size="Size.Small" DropShadow="false" Variant="Variant.Filled"
                       Color="@(excluded ? Color.Error : Color.Primary)"
                       EndIcon="@Icons.Material.Filled.Close"
                       OnClick="@(() => Drop(match, excluded))"
                       data-abom-property-drop="@Label(match, excluded)">
                @Label(match, excluded)
            </MudButton>
        }
    </div>

    @if (_keys.Count == 0)
    {
        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">
            The organization sets no custom property on any repository you own, so there is nothing
            here to narrow by.
        </MudText>
    }
    else if (_breakdown is { Values.Count: 0, Name.Length: > 0 })
    {
        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">
            No repository you own carries a value for @_breakdown.Name.
        </MudText>
    }
    else if (_breakdown is { } breakdown)
    {
        <div class="d-flex flex-wrap align-center gap-1 mt-1">
            @foreach (var value in breakdown.Values)
            {
                <MudButtonGroup Size="Size.Small" Variant="Variant.Outlined">
                    <MudButton OnClick="@(() => Narrow(value.Value, exclude: false))"
                               data-abom-property-include="@($"{breakdown.Name}:{value.Value}")">
                        @value.Value@(value.IsDefault ? " (organization default)" : "")
                        · @value.Repositories.ToString("N0")
                    </MudButton>
                    <MudTooltip Text="@($"Exclude {breakdown.Name}:{value.Value}")">
                        @* The tooltip is a hover popover, so the same words have to be on the
                           button itself: it carries an icon and no text. *@
                        <MudButton StartIcon="@Icons.Material.Filled.Block"
                                   OnClick="@(() => Narrow(value.Value, exclude: true))"
                                   aria-label="@($"Exclude {breakdown.Name}:{value.Value}")"
                                   data-abom-property-exclude="@($"{breakdown.Name}:{value.Value}")" />
                    </MudTooltip>
                </MudButtonGroup>
            }
        </div>

        @* Stated, not tooltipped: a key most of the organization does not carry answers about a
           fraction of it, and a reader who is not told reads the filtered total as the whole. *@
        @if (breakdown.WithoutValue > 0)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">
                @breakdown.WithoutValue.ToString("N0") of @breakdown.Repositories.ToString("N0")
                repositories you own carry no @breakdown.Name at all, so narrowing by it leaves
                them out.
            </MudText>
        }
    }
</div>

@code {
    /// <summary>Raised after the scope changed, so the host can re-read and re-draw.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    [Parameter] public bool SupportsAnalysisMode { get; set; }

    private IReadOnlyList<string> _keys = [];
    private string _key = string.Empty;
    private PropertyBreakdown? _breakdown;

    private List<(PropertyMatch Match, bool Excluded)> Chosen =>
    [
        .. Scope.Spec.Properties.Select(m => (m, false)),
        .. Scope.Spec.NotProperties.Select(m => (m, true)),
    ];

    private static string Label(PropertyMatch match, bool excluded) =>
        excluded ? $"not {match}" : match.ToString();

    protected override async Task OnInitializedAsync() => await Read(null);

    private async Task ChooseMode(string mode)
    {
        if (mode is not ("regular" or "extended")) return;
        Scope.Set(Scope.Spec with { Mode = mode == "regular" ? "" : mode });
        await Changed.InvokeAsync();
    }

    /// <summary>
    /// Reads the breakdown for one key. A null key takes the server's configured one, which is a
    /// convenience and not an answer: nothing is written to the scope until somebody picks a value.
    /// </summary>
    private async Task Read(string? key)
    {
        var view = await Api.GetPropertiesAsync(key);
        if (view is null) return;
        _keys = view.Keys;
        _breakdown = view.Breakdown;
        _key = view.Breakdown.Name;
    }

    private async Task ChooseKey(string key)
    {
        if (key == _key) return;
        await Read(key);
    }

    private async Task Narrow(string value, bool exclude)
    {
        if (_breakdown is not { } breakdown) return;
        var match = new PropertyMatch(breakdown.Name, value);
        var include = Scope.Spec.Properties.ToList();
        var omit = Scope.Spec.NotProperties.ToList();
        var side = exclude ? omit : include;
        if (side.Contains(match)) return;
        side.Add(match);
        await Apply(include, omit);
    }

    private async Task Drop(PropertyMatch match, bool excluded)
    {
        var include = Scope.Spec.Properties.ToList();
        var omit = Scope.Spec.NotProperties.ToList();
        (excluded ? omit : include).Remove(match);
        await Apply(include, omit);
    }

    private async Task Apply(List<PropertyMatch> include, List<PropertyMatch> omit)
    {
        Scope.Set(Scope.Spec with { Properties = include, NotProperties = omit });
        await Changed.InvokeAsync();
    }
}
