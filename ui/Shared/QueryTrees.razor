@using Abom.WebAssembly.Models
@using Abom.WebAssembly.Services
@inject AbomApi Api

@* A query's trees, by a session or by ABOM, read on its catalog row. *@
<div class="mt-2" data-abom-query-trees>
    @if (_trees is null)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_trees.Count == 0)
    {
        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            No tree has been printed over this query's test database. The AST mark prints one.
        </MudText>
    }
    else
    {
        <MudText Typo="Typo.caption" Class="mud-text-secondary">Trees CodeQL printed over the test database</MudText>
        <PrintedTrees Trees="@_trees" />
    }
</div>

@code {
    [Parameter, EditorRequired] public CatalogQuery Query { get; set; } = new();

    private IReadOnlyList<AuthoringAst>? _trees;

    protected override async Task OnParametersSetAsync() => _trees = await Api.GetQueryAstsAsync(Query.QueryId);
}
