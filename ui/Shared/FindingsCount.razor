@if (Review.HasDelegate && Count > 0)
{
    <span class="abom-findings-count">
        <button type="button" class="abom-count-review abom-num" data-abom-review-asset="@Asset"
                aria-label="@($"Review {Count:N0} findings for {Asset}")" title="@($"Review the findings reported for {Asset}, beside this list.")"
                @onclick="Review">@Count.ToString("N0")</button>
        <SeverityIcons Severity="@Severity" />
    </span>
}
else
{
    <span class="abom-findings-count">
        <span class="abom-num">@Count.ToString("N0")</span>
        <SeverityIcons Severity="@Severity" />
    </span>
}

@code {
    [Parameter, EditorRequired] public int Count { get; set; }
    [Parameter, EditorRequired] public SeverityCounts Severity { get; set; } = new();
    [Parameter] public string Asset { get; set; } = "";
    [Parameter] public EventCallback Review { get; set; }
}
