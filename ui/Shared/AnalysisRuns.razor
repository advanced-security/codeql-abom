@using Abom.WebAssembly.Models
@using Abom.WebAssembly.Services
@implements IDisposable
@inject AbomApi Api
@inject FollowService Follow

@* A run's results open under its own row, never on a panel matched back to it. *@
<div data-abom-runs>
    @if (_refusal is { Length: > 0 } refused)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" ShowCloseIcon="true"
                  CloseIconClicked="@(() => _refusal = null)" data-abom-runs-refusal>@refused</MudAlert>
    }

    @if (_runs is null)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_runs.Count == 0)
    {
        <MudPaper Class="pa-6" Outlined="true" data-abom-runs-empty>
            <MudText Typo="Typo.h6">No run has been asked for yet</MudText>
            <MudText Typo="Typo.body2" Class="mt-2 mud-text-secondary">
                A run is a set of query versions over repositories somebody chose. Choose them in
                the <MudLink Href="/inventory?unit=repositories"
                             title="Open the Inventory page so you can choose repositories for a run.">Inventory</MudLink>, or press Run
                on a query in the catalog.
            </MudText>
        </MudPaper>
    }
    else
    {
        <MudDataGrid T="AnalysisRun" Items="_runs" Dense="true" Hover="true" Bordered="false"
                     SortMode="SortMode.None" Filterable="false" ShowColumnOptions="false"
                     FixedHeader="true" RowsPerPage="20" Class="abom-grid abom-grid-windowed"
                     data-abom-runs-table>
            <Columns>
                <HierarchyColumn T="AnalysisRun" InitiallyExpandedFunc="@(r => r.RowId == FocusRun)">
                    <CellTemplate>
                        <MudIconButton Size="Size.Small"
                                       Icon="@(context.Open ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)"
                                       title="@($"Show or hide the results for run #{context.Item.RowId}.")"
                                       aria-label="@($"Show what run #{context.Item.RowId} found")"
                                       aria-expanded="@(context.Open ? "true" : "false")"
                                       OnClick="@(() => context.Actions.ToggleHierarchyVisibilityForItemAsync())"
                                       data-abom-run-detail />
                    </CellTemplate>
                </HierarchyColumn>

                <PropertyColumn Property="x => x.RowId" Title="Run" CellClass="abom-nowrap">
                    <HeaderTemplate><HeaderTip Tip="The number ABOM gave this run.">Run</HeaderTip></HeaderTemplate>
                    <CellTemplate>
                        <span data-abom-run-id="@context.Item.RowId">#@context.Item.RowId</span>
                        @if (context.Item.Held)
                        {
                            <MudText Typo="Typo.caption" Class="d-block mud-text-secondary"
                                     title="What this run's queries report is held until somebody converts it to findings."
                                     data-abom-run-held>findings off</MudText>
                        }
                    </CellTemplate>
                </PropertyColumn>

                <TemplateColumn Title="" HeaderClass="abom-row-actions-head" CellClass="abom-row-actions">
                    <CellTemplate>
                        <div class="abom-query-actions">
                            @switch (context.Item.State)
                            {
                                case "running":
                                    <MudTooltip Text="Stop this run. What it has already analyzed is kept.">
                                        <MudIconButton Icon="@Icons.Material.Outlined.Stop" Size="Size.Small"
                                                       Color="Color.Warning" OnClick="@(() => Cancel(context.Item))"
                                                       aria-label="@($"Stop run #{context.Item.RowId}")"
                                                       data-abom-run-cancel />
                                    </MudTooltip>
                                    break;
                                case "pending":
                                    <MudTooltip Text="@StartText(context.Item)">
                                        <MudIconButton Icon="@Icons.Material.Outlined.PlayArrow" Size="Size.Small"
                                                       Color="Color.Primary" OnClick="@(() => Execute(context.Item))"
                                                       aria-label="@($"Start run #{context.Item.RowId}")"
                                                       data-abom-run-start />
                                    </MudTooltip>
                                    break;
                                default:
                                    @* Not a start: it re-analyzes every repository and replaces its counts. *@
                                    <MudTooltip Text="@AgainText(context.Item)">
                                        <MudIconButton Icon="@Icons.Material.Outlined.Replay" Size="Size.Small"
                                                       OnClick="@(() => Execute(context.Item))"
                                                       aria-label="@($"Run #{context.Item.RowId} again")"
                                                       data-abom-run-again />
                                    </MudTooltip>
                                    break;
                            }
                        </div>
                    </CellTemplate>
                </TemplateColumn>

                <PropertyColumn Property="x => x.State" Title="State">
                    <HeaderTemplate><HeaderTip Tip="What state the run is in, and which CodeQL version is recorded for it.">State</HeaderTip></HeaderTemplate>
                    <CellTemplate>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                 Color="@StateColor(context.Item.State)"
                                 data-abom-run-state="@context.Item.State">@context.Item.State</MudChip>
                        <MudText Typo="Typo.caption" Class="d-block mud-text-secondary abom-nowrap"
                                 data-abom-run-codeql>@CodeQLText(context.Item)</MudText>
                        @if (context.Item.Refusal.Length > 0)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Error" Class="abom-run-refused"
                                     title="@context.Item.Refusal" data-abom-run-refused>@context.Item.Refusal</MudText>
                        }
                    </CellTemplate>
                </PropertyColumn>

                <TemplateColumn Title="Queries" CellClass="abom-run-text">
                    <HeaderTemplate><HeaderTip Tip="The queries, at their versions, that this run evaluates.">Queries</HeaderTip></HeaderTemplate>
                    <CellTemplate>
                        @foreach (var q in context.Item.Queries)
                        {
                            <div>
                                <MudLink Href="@($"/codeql?tab=catalog&query={Uri.EscapeDataString(q.QueryId)}")"
                                         Typo="Typo.body2" Class="abom-path"
                                         title="@($"Open the catalog entry for {q.QueryId} at version {q.QueryVersion}.")"
                                         data-abom-run-query-link>@q.QueryId</MudLink>
                            </div>
                        }
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Title="Scope" CellClass="abom-run-text">
                    <HeaderTemplate><HeaderTip Tip="Which repositories this run was asked to analyze.">Scope</HeaderTip></HeaderTemplate>
                    <CellTemplate>
                        @if (context.Item.ScopeName.Length > 0)
                        {
                            @* How it was chosen, beside what it resolved to, which is what it covers. *@
                            <MudText Typo="Typo.body2" title="@($"This run was chosen as the named scope {context.Item.ScopeName}.")"
                                     data-abom-run-scope-name>@ScopeLabel(context.Item.ScopeName)</MudText>
                        }
                        <MudText Typo="Typo.caption" title="@($"This is the exact selection string the run used: {context.Item.Predicate}.")"
                                 data-abom-run-scope>@ScopeText(context.Item.Predicate)</MudText>
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Title="Progress" CellClass="abom-nowrap">
                    <HeaderTemplate><HeaderTip Tip="How much of this run is still waiting, running, analyzed or stopped.">Progress</HeaderTip></HeaderTemplate>
                    <CellTemplate>
                        <MudText Typo="Typo.caption" data-abom-run-tally>@TallyText(context.Item)</MudText>
                    </CellTemplate>
                </TemplateColumn>

                <PropertyColumn Property="x => x.Results" Title="Results"
                                HeaderClass="abom-cell-right" CellClass="abom-cell-right">
                    <HeaderTemplate><HeaderTip Tip="How many results this run recorded across repositories it analyzed.">Results</HeaderTip></HeaderTemplate>
                    <CellTemplate>
                        <span class="abom-num" data-abom-run-results>@context.Item.Results</span>
                    </CellTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.RequestedBy" Title="Asked by" CellClass="abom-nowrap">
                    <HeaderTemplate><HeaderTip Tip="Which signed-in user asked ABOM to create this run.">Asked by</HeaderTip></HeaderTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.CreatedAt" Title="Asked" CellClass="abom-nowrap">
                    <HeaderTemplate><HeaderTip Tip="When ABOM recorded the request for this run.">Asked</HeaderTip></HeaderTemplate>
                    <CellTemplate>
                        <MudText Typo="Typo.caption">@TimeText.DayAndTime(context.Item.CreatedAt)</MudText>
                    </CellTemplate>
                </PropertyColumn>
            </Columns>
            <ChildRowContent>
                <div class="abom-row-detail">
                    <RunResults RunId="@context.Item.RowId" />
                </div>
            </ChildRowContent>
            <PagerContent><MudDataGridPager T="AnalysisRun" /></PagerContent>
        </MudDataGrid>
    }
</div>

@code {
    /// <summary>A run to open on arrival, such as the one just asked for.</summary>
    [Parameter] public long FocusRun { get; set; }

    private IReadOnlyList<AnalysisRun>? _runs;
    private string? _refusal;
    private Timer? _timer;
    private TimeSpan _beat;

    private static readonly TimeSpan WhileRunning = TimeSpan.FromSeconds(5);

    /// <summary>How often the list is read again.</summary>
    public TimeSpan Beat => _beat;

    protected override async Task OnInitializedAsync()
    {
        Follow.Changed += Arm;
        await Load();
        if (_runs?.Any(r => r.ScopeName.Length > 0) == true)
        {
            _scopeLabels = (await Api.GetViewsAsync())
                .ToDictionary(v => v.Name, v => v.Label, StringComparer.Ordinal);
        }
    }

    // What a reader calls each named scope. A name no longer kept reads as itself.
    private IReadOnlyDictionary<string, string> _scopeLabels = new Dictionary<string, string>();

    private string ScopeLabel(string name) => _scopeLabels.TryGetValue(name, out var label) ? label : name;

    private async Task Load()
    {
        _runs = await Api.GetAnalysisRunsAsync();
        Arm();
    }

    // A run in flight is watched closely, and so is one asked for, which the executor starts a
    // beat later; otherwise the reader's own beat.
    private void Arm()
    {
        var beat = _runs?.Any(r => r.State is "running" or "pending") == true && Follow.Interval > WhileRunning
            ? WhileRunning
            : Follow.Interval;
        if (_timer is not null && beat == _beat)
        {
            return;
        }
        _timer?.Dispose();
        _beat = beat;
        _timer = new Timer(async _ =>
        {
            try
            {
                await Load();
            }
            catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
            {
                return;
            }
            await InvokeAsync(StateHasChanged);
        }, null, beat, beat);
    }

    private async Task Execute(AnalysisRun run)
    {
        var (_, refusal) = await Api.ExecuteAnalysisRunAsync(run.RowId);
        _refusal = refusal;
        await Load();
    }

    private async Task Cancel(AnalysisRun run)
    {
        var (_, refusal) = await Api.CancelAnalysisRunAsync(run.RowId);
        _refusal = refusal;
        await Load();
    }

    // Work already answered is skipped when a run goes again, which is what makes a stop resumable.
    /// <summary>
    /// A run that has not started has not chosen its CodeQL yet; any other without one was recorded
    /// before the version was kept, which is not a run under no CodeQL.
    /// </summary>
    private static string CodeQLText(AnalysisRun run) =>
        run.CliVersion.Length > 0 ? $"CodeQL {run.CliVersion}"
        : run.State is "pending" or "refused" ? "CodeQL chosen when it runs"
        : "CodeQL not recorded";

    private static string AgainText(AnalysisRun run) => run.State switch
    {
        "refused" => "It did not start. Run it again once what refused it is fixed.",
        // Nothing is skipped: a stored answer lists findings, and a held run keeps its own list.
        _ when run.Held => "Run it again over the same repositories. Every one is evaluated again, and " +
            "what it reports replaces what this run held; what somebody converted stays a finding.",
        "interrupted" => "The server stopped while this ran. Run it again: what it already analyzed is skipped.",
        "canceled" => "Run it again: what it already analyzed is skipped.",
        _ => "Run it again over the same repositories. What was analyzed with these versions is skipped; " +
             "the rest replaces what this run recorded.",
    };

    private static string StartText(AnalysisRun run) => run.Held
        ? "Start this run over the repositories it names. What it finds is held until somebody converts it."
        : "Start this run over the repositories it names.";

    private static Color StateColor(string state) => state switch
    {
        "complete" => Color.Success,
        "running" => Color.Info,
        "canceled" or "interrupted" => Color.Warning,
        "refused" => Color.Error,
        _ => Color.Default,
    };

    /// <summary>The predicate in words: a selection reads as the repositories it named.</summary>
    private static string ScopeText(string predicate)
    {
        var parts = new List<string>();
        foreach (var term in predicate.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var (key, value) = term.IndexOf('=') is var at and >= 0
                ? (term[..at], term[(at + 1)..])
                : (term, string.Empty);
            // The canonical text escapes a list's commas; a property value may hold one of its own.
            var text = Uri.UnescapeDataString(value.Replace('+', ' '));
            var values = key is "properties" or "notProperties" ? [text] : text.Split(',').ToList();
            if (key == "repositories")
            {
                parts.Add(values.Count <= 3
                    ? string.Join(", ", values)
                    : $"{string.Join(", ", values.Take(3))} and {values.Count - 3} more");
                continue;
            }
            parts.Add($"{key}: {string.Join(", ", values)}");
        }
        return string.Join("; ", parts);
    }

    private static string TallyText(AnalysisRun run)
    {
        int Of(string status) => run.Tally.TryGetValue(status, out var n) ? n : 0;
        var parts = new List<string>();
        // What is left first while a run is under way; a time only once this start has a pace.
        if (run.Left is { } left)
        {
            parts.Add($"{left.Members:N0} still to do");
            if (left.RemainingSeconds is { } remaining)
            {
                parts.Add($"{TimeText.Roughly(remaining)} left");
            }
        }
        if (Of("succeeded") > 0) parts.Add($"{Of("succeeded"):N0} analyzed");
        if (Of("running") > 0) parts.Add($"{Of("running"):N0} running");
        if (Of("pending") > 0) parts.Add($"{Of("pending"):N0} waiting");
        if (Of("failed") > 0) parts.Add($"{Of("failed"):N0} failed");
        if (Of("no_database") > 0) parts.Add($"{Of("no_database"):N0} with no database");
        foreach (var (status, n) in run.Tally.Where(t =>
                     t.Key is not ("succeeded" or "running" or "pending" or "failed" or "no_database")))
        {
            parts.Add($"{n:N0} {status}");
        }
        return string.Join(" · ", parts);
    }

    public void Dispose()
    {
        Follow.Changed -= Arm;
        _timer?.Dispose();
    }
}
