@* The actions a single row carries, as icons.
   
   Icons rather than words because this column sits between Name and Type, and a column of labels
   there costs more width than the columns it separates — at organization scale width is the scarce
   thing. An icon with no accessible name is a button nobody can identify, so every one carries a
   tooltip, and the tooltip is the label rather than a decoration. *@

<span class="abom-row-actions-group d-inline-flex align-center" role="group">
    @* Scoped to this row, not to the page: handing over the listing's scope would open the
       Explorer on everything the reader just narrowed away from. *@
    <MudIconButton Icon="@Icons.Material.Outlined.Hub" Size="Size.Small"
                   Href="@($"/explore?selection={Uri.EscapeDataString(NodeKey)}&direction=both")"
                   title="@($"Show {NodeKey} in the Explorer")"
                   aria-label="@($"Show {NodeKey} in the Explorer")"
                   data-abom-row-action="open-in-explorer" />
</span>

@code {
    /// <summary>The node this row stands for, which is what the actions are scoped to.</summary>
    [Parameter, EditorRequired]
    public string NodeKey { get; set; } = string.Empty;
}
