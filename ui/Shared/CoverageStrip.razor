@* Coverage is stated on every page: silence about what was not analyzed reads as completeness. *@

@if (Summary is null)
{
    <div class="abom-coverage">
        <span class="abom-coverage-unknown">Reading coverage…</span>
    </div>
}
else
{
    <div class="abom-coverage">
        @* Ownership and the corpus in one cell, because they are only meaningful against each
           other and because the grid below is tuned for six. The noun lives in the tooltip: at
           the six-column breakpoint a cell is 205px, and spelling it out needs 219px. *@
        <MudTooltip Text="Repositories under an account you declared, against the number discovery started from. Nothing else on this strip is a claim about who owns anything.">
            <span class="abom-coverage-item" data-abom-owned-count>
                @if (Summary.OwnedRepos > 0)
                {
                    <span class="abom-coverage-value">@Summary.OwnedRepos.ToString("N0")</span>
                    <span class="abom-coverage-label">
                        yours of @Summary.SeedRepos.ToString("N0")
                    </span>
                }
                else
                {
                    @* Not "0 repositories": nothing declared is an absence of a claim, not a
                       measured emptiness. *@
                    <span class="abom-coverage-value abom-coverage-unknown">none</span>
                    <span class="abom-coverage-label">
                        declared of @Summary.SeedRepos.ToString("N0")
                    </span>
                }
            </span>
        </MudTooltip>
        <span class="abom-coverage-item">
            <span class="abom-coverage-value">@Summary.UpstreamRepos.ToString("N0")</span>
            <span class="abom-coverage-label">upstream analyzed</span>
        </span>
        <span class="abom-coverage-item">
            <span class="abom-coverage-value">@Summary.Findings.ToString("N0")</span>
            <span class="abom-coverage-label">findings across @Summary.Rules rules</span>
        </span>
        <span class="abom-coverage-item">
            <span class="abom-coverage-value">@Summary.Advisories.ToString("N0")</span>
            <span class="abom-coverage-label">live advisories</span>
        </span>

        @if (Summary.PendingDependencies > 0)
        {
            <MudTooltip Text="These dependencies have not been analyzed, so anything they pull in is not represented anywhere in this interface.">
                <span class="abom-coverage-item abom-coverage-unknown">
                    <span class="abom-coverage-value">@Summary.PendingDependencies.ToString("N0")</span>
                    <span class="abom-coverage-label">dependencies unresolved</span>
                </span>
            </MudTooltip>
        }

        @if (Summary.Findings > Summary.LinkedFindings)
        {
            <MudTooltip Text="Findings in files that name no dependency. They are counted for their repository, but there is nothing in the Explorer to attach them to.">
                <span class="abom-coverage-item abom-coverage-unknown">
                    <span class="abom-coverage-value">@((Summary.Findings - Summary.LinkedFindings).ToString("N0"))</span>
                    <span class="abom-coverage-label">findings not in the Explorer</span>
                </span>
            </MudTooltip>
        }
    </div>
}

@code {
    [Parameter] public Summary? Summary { get; set; }
}
