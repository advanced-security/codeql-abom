@using Abom.WebAssembly.Models
@using Abom.WebAssembly.Services
@inject AbomApi Api

@* Renders one level and, in each expanded row, itself for the next: owner, repository,
   workflow, reference. Every level shows the same five measures, because a reference group is
   simply the smallest scope. *@

@if (_rows is null)
{
    <MudProgressLinear Indeterminate="true" Class="my-2" />
}
else if (_rows.Count == 0)
{
    <MudText Typo="Typo.body2" Class="pa-3 mud-text-secondary">
        No pinnable references here. That is not the same as everything being pinned.
    </MudText>
}
else
{
    <MudDataGrid T="PinningRow" Items="_rows" Dense="true" Hover="true" Bordered="false"
                 SortMode="SortMode.Multiple" Filterable="false" Class="abom-grid"
                 RowsPerPage="@RowsPerPage">
        <Columns>
            @if (_rows[0].HasChildren)
            {
                <HierarchyColumn T="PinningRow" />
            }
            <PropertyColumn Property="x => x.Label" Title="@Title">
                <CellTemplate>
                    @if (context.Item.HasChildren)
                    {
                        <span class="d-inline-flex align-center gap-1">
                            @if (context.Item.Owned)
                            {
                                <MudTooltip Text="An account you declared: this is yours to change.">
                                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small"
                                             Color="Color.Primary" />
                                </MudTooltip>
                            }
                            <span>@context.Item.Label</span>
                        </span>
                    }
                    else
                    {
                        <span class="abom-ref">
                            <MudLink Href="@($"/node/{context.Item.ScopeKey}")">@context.Item.Label</MudLink>@("@")@context.Item.Ref
                        </span>
                    }
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Pinnable" Title="@(_rows[0].HasChildren ? "Pinnable refs" : "Uses")" />
            @if (Scope == "owner")
            {
                @* Every nesting step is narrower than the last, and the share bar already carries
                   the split. Only the widest level can afford both counts. *@
                <PropertyColumn Property="x => x.Commit" Title="Naming a commit" />
            }
            <PropertyColumn Property="x => x.Floating" Title="Naming a tag" />
            <PropertyColumn Property="x => x.CommitShare" Title="Commit share">
                <CellTemplate>
                    <div class="d-flex align-center gap-2" style="min-width:120px">
                        <MudProgressLinear Value="@(context.Item.CommitShare * 100)" Rounded="true"
                                           Size="Size.Small" Style="flex:1"
                                           Color="@ShareColour(context.Item.CommitShare)" />
                        <span>@context.Item.CommitShare.ToString("P0")</span>
                    </div>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Flagged" Title="Flagged">
                <CellTemplate>
                    @if (context.Item.Flagged > 0)
                    {
                        <MudTooltip Text="@($"actions/unpinned-tag objected to {context.Item.Flagged} of these references")">
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning"
                                     Variant="Variant.Outlined">@context.Item.Flagged</MudChip>
                        </MudTooltip>
                    }
                    else
                    {
                        <span class="mud-text-secondary">&mdash;</span>
                    }
                </CellTemplate>
            </PropertyColumn>
            <TemplateColumn Title="" Sortable="false">
                <CellTemplate>
                    <MudTooltip Text="Open this in the Explorer with the same filters applied.">
                        <MudIconButton Icon="@Icons.Material.Filled.Hub" Size="Size.Small"
                                       Href="@ExplorerLink(context.Item)" />
                    </MudTooltip>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <ChildRowContent>
            @if (context.Item.HasChildren)
            {
                <div class="abom-pinning-child">
                    <PinningLevel Scope="@NextScope" Parent="@context.Item.ScopeKey"
                                  Filter="Filter" RowsPerPage="15" />
                </div>
            }
        </ChildRowContent>
        <PagerContent>
            @if (_rows.Count > RowsPerPage)
            {
                <MudDataGridPager T="PinningRow" />
            }
        </PagerContent>
    </MudDataGrid>
}

@code {
    [Parameter, EditorRequired] public string Scope { get; set; } = "owner";
    [Parameter] public string? Parent { get; set; }
    [Parameter, EditorRequired] public PinningQuery Filter { get; set; } = new();
    [Parameter] public int RowsPerPage { get; set; } = 25;

    private IReadOnlyList<PinningRow>? _rows;
    private string _loadedFor = string.Empty;

    private string Title => Scope switch
    {
        "owner" => "Owner",
        "repo" => "Repository",
        "workflow" => "Workflow",
        _ => "Reference",
    };

    private string NextScope => Scope switch
    {
        "owner" => "repo",
        "repo" => "workflow",
        _ => "reference",
    };

    private static Color ShareColour(double share) => share switch
    {
        >= 0.8 => Color.Success,
        >= 0.4 => Color.Warning,
        _ => Color.Error,
    };

    /// <summary>Carries the row's scope and the active filters into the graph.</summary>
    private string ExplorerLink(PinningRow row)
    {
        var query = new List<string>();
        if (row.HasChildren)
        {
            query.Add($"q={Uri.EscapeDataString(row.ScopeKey)}");
        }
        else
        {
            query.Add($"selection={Uri.EscapeDataString(row.ScopeKey)}");
        }
        if (Filter.RefStyle == "commit") query.Add("refStyle=sha");
        if (Filter.RefStyle == "tag") query.Add("refStyle=tag");
        if (Filter.FlaggedOnly) query.Add("rules=actions%2Funpinned-tag");
        return "/explore?" + string.Join("&", query);
    }

    protected override async Task OnParametersSetAsync()
    {
        var key = $"{Scope}|{Parent}|{Filter.Query}";
        if (key == _loadedFor) return;
        _loadedFor = key;
        _rows = null;
        _rows = await Api.GetPinningAsync(Scope, Parent, Filter);
    }
}
