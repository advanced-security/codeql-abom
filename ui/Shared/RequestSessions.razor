@using System.Globalization
@using Abom.WebAssembly.Models
@using Abom.WebAssembly.Services
@inject AbomApi Api
@inject AccountService Accounts
@inject FollowService Follow
@implements IDisposable

@* The agent's work on one request: its sessions, the CodeQL it has under way, every call the gate
   decided, and the trees PrintAST printed, which outlive the session that printed them. *@
<div class="abom-request-sessions" data-abom-request-sessions>
    <div class="abom-request-sessions-head">
        <MudText Typo="Typo.subtitle2">Agent Sessions</MudText>
        <MudSpacer />
        @if (Live is not null)
        {
            <Tip Text="End the agent's work on this request. What it wrote stays.">
                <MudButton Size="Size.Small" Variant="Variant.Outlined" DropShadow="false"
                           StartIcon="@Icons.Material.Outlined.StopCircle" Disabled="@_busy" OnClick="Stop"
                           data-abom-session-stop>Stop the session</MudButton>
            </Tip>
        }
        else
        {
            <Tip Text="@StartTip">
                <MudButton Size="Size.Small" Variant="Variant.Outlined" DropShadow="false"
                           StartIcon="@Icons.Material.Outlined.SmartToy" Disabled="@(!CanStart || Blocking is not null || _busy)"
                           OnClick="Start" data-abom-session-start>Work it with an agent</MudButton>
            </Tip>
        }
    </div>
    @if (Live is null && Blocking is { } blocking)
    {
        <MudText Typo="Typo.caption" Class="abom-unconfirmed d-block mt-1" data-abom-session-blocked>
            Cannot start: @blocking.Name: @blocking.Reason. What every check found is listed above.
        </MudText>
    }
    @if (_refusal is { Length: > 0 } refused)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2" data-abom-session-refusal>@refused</MudAlert>
    }
    @if (_unread is { Length: > 0 } unread)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2" data-abom-sessions-unread>@unread</MudAlert>
    }

    @if (_sessions is null)
    {
        @if (_unread is null)
        {
            <MudProgressLinear Indeterminate="true" Class="mt-2" />
        }
    }
    else if (_sessions.Sessions.Count == 0)
    {
        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1" data-abom-sessions-empty>
            No agent has worked this request. A session writes only the query this request is about,
            and its help, fixtures and expected results, in your pack.
        </MudText>
    }
    else
    {
        @if (_sessions.InFlight.Count > 0)
        {
            <div class="abom-inflight mt-1" data-abom-session-inflight>
                @foreach (var flight in _sessions.InFlight)
                {
                    <MudText Typo="Typo.caption" Class="d-block">
                        The agent's <span class="abom-path">@flight.Tool</span> call
                        @if (flight.Subject.Length > 0)
                        {
                            <text>on <span class="abom-path">@flight.Subject</span></text>
                        }
                        has been running since @TimeText.DayAndTime(flight.Since, "HH:mm:ss").
                    </MudText>
                }
            </div>
        }
        <div class="abom-session-cards">
            @foreach (var session in _sessions.Sessions)
            {
                <SessionCard @key="session.RowId" SessionId="@session.RowId" Summary="@session"
                             Metadata="@_meta.GetValueOrDefault(session.RowId)" InRequest="true"
                             Trees="@_asts.Where(a => a.SessionId == session.RowId).ToList()" />
            }
        </div>
    }

    @if (Unattributed.Count > 0)
    {
        <div class="mt-2" data-abom-asts>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Syntax trees printed outside an agent session
            </MudText>
            <PrintedTrees Trees="@Unattributed" />
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public QueryRequest Request { get; set; } = new();

    /// <summary>What the server last said a session needs; null or unknown leaves it to the server's refusal.</summary>
    [Parameter] public AuthoringReadiness? Readiness { get; set; }

    /// <summary>Counts sessions started from elsewhere, such as the request's row; a change reloads.</summary>
    [Parameter] public int Started { get; set; }

    /// <summary>Raised when a session starts or ends, which changes where the request stands.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    private int _started;
    private string? _states;

    private AuthoringSessionList? _sessions;
    private IReadOnlyList<AuthoringAst> _asts = [];
    private Dictionary<long, AuditSession> _meta = [];
    private string? _refusal;
    private string? _unread;
    private bool _busy;
    private Timer? _timer;
    private TimeSpan _beat;

    private static readonly TimeSpan WhileRunning = TimeSpan.FromSeconds(3);

    private AuthoringSession? Live => _sessions?.Sessions.FirstOrDefault(s => s.State == "running");

    // A tree belongs on the card of the session that printed it; the rest are listed beneath.
    private List<AuthoringAst> Unattributed => _asts
        .Where(a => a.SessionId == 0 || _sessions?.Sessions.Any(s => s.RowId == a.SessionId) != true).ToList();

    private bool CanStart => Accounts.Identity.Login.Length > 0;

    private ReadinessCheck? Blocking => Readiness?.FirstProblem;

    private string StartTip =>
        !CanStart ? "Sign in with gh to record who started it."
        : Blocking is { } b ? $"No session can start until this is fixed: {b.Name}: {b.Reason}."
        : "Have an agent write and test this query in your pack.";

    protected override async Task OnInitializedAsync()
    {
        Follow.Changed += Arm;
        _started = Started;
        await Accounts.EnsureLoadedAsync();
        await Load();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Started != _started)
        {
            _started = Started;
            await Load();
        }
    }

    private async Task Load()
    {
        var read = await Api.GetAuthoringSessionsAsync(Request.RowId);
        if (read is null)
        {
            // Said apart from a refusal to start, which a later read does not answer. What was read
            // before stays: a failed re-read is not evidence that the sessions went.
            _unread = _sessions is null
                ? "Cannot load sessions. This is not evidence that no agent worked here. Trying again."
                : "Cannot reload sessions; what is shown was read earlier. Trying again.";
            Arm();
            return;
        }
        _unread = null;
        _sessions = read;
        _asts = await Api.GetAuthoringAstsAsync(Request.RowId);
        await LoadLimits();
        var was = _states;
        _states = string.Join(",", _sessions.Sessions.Select(s => $"{s.RowId}:{s.State}"));
        if (was is not null && was != _states)
        {
            await InvokeAsync(() => Changed.InvokeAsync());
        }
        Arm();
    }

    // Limits and relations for every session of this request, in one read. A card whose limits
    // could not be read says so itself rather than reading as a session without any.
    private async Task LoadLimits()
    {
        try
        {
            var list = await Api.GetAuditSessionsAsync($"request={Request.RowId}");
            _meta = list.Items.ToDictionary(s => s.RowId);
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException or OperationCanceledException)
        {
            _meta = [];
        }
    }

    private async Task Start()
    {
        _busy = true;
        try
        {
            var (_, refusal) = await Api.StartAuthoringSessionAsync(Request.RowId, Accounts.Identity.Login);
            _refusal = refusal;
            await Load();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Stop()
    {
        _busy = true;
        try
        {
            var (_, refusal) = await Api.StopAuthoringSessionAsync(Request.RowId);
            _refusal = refusal;
            await Load();
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>How often the sessions are read again; zero until a read has armed it.</summary>
    public TimeSpan Beat => _beat;

    // A live session is watched closely; otherwise the reader's own beat.
    private void Arm()
    {
        var beat = Live is not null && Follow.Interval > WhileRunning ? WhileRunning : Follow.Interval;
        if (_timer is not null && beat == _beat)
        {
            return;
        }
        _timer?.Dispose();
        _beat = beat;
        _timer = new Timer(async _ =>
        {
            try
            {
                await Load();
            }
            catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
            {
                return;
            }
            await InvokeAsync(StateHasChanged);
        }, null, beat, beat);
    }

    public void Dispose()
    {
        Follow.Changed -= Arm;
        _timer?.Dispose();
    }
}
