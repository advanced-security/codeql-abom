@using System.Globalization
@using Abom.WebAssembly.Models
@using Abom.WebAssembly.Services
@inject AbomApi Api
@inject AccountService Accounts
@inject FollowService Follow
@implements IDisposable

@* The agent's work on one request: its sessions, the CodeQL it has under way, every call the gate
   decided, and the trees PrintAST printed, which outlive the session that printed them. *@
<div class="abom-request-sessions" data-abom-request-sessions>
    <div class="d-flex align-center gap-2">
        <MudText Typo="Typo.subtitle2">Agent sessions</MudText>
        <MudSpacer />
        @if (Live is not null)
        {
            <MudButton Size="Size.Small" Variant="Variant.Outlined" DropShadow="false"
                       StartIcon="@Icons.Material.Outlined.StopCircle" Disabled="@_busy" OnClick="Stop"
                       title="Stop the authoring agent session for this request."
                       data-abom-session-stop>Stop the session</MudButton>
        }
        else
        {
            @* The reason is on a span outside the button: a disabled button swallows the pointer. *@
            <span title="@(CanStart ? "Start an authoring agent session for this request inside your query pack." : "Sign in with gh to record who started it.")">
                <MudButton Size="Size.Small" Variant="Variant.Outlined" DropShadow="false"
                           StartIcon="@Icons.Material.Outlined.SmartToy" Disabled="@(!CanStart || _busy)"
                           title="@(CanStart ? "Start an authoring agent session for this request inside your query pack." : "Sign in with gh to record who started it.")"
                           OnClick="Start" data-abom-session-start>Work it with an agent</MudButton>
            </span>
        }
    </div>
    @if (_refusal is { Length: > 0 } refused)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2" data-abom-session-refusal>@refused</MudAlert>
    }

    @if (_sessions is null)
    {
        <MudProgressLinear Indeterminate="true" Class="mt-2" />
    }
    else if (_sessions.Sessions.Count == 0)
    {
        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1" data-abom-sessions-empty>
            No agent has worked this request. A session writes only the query this request is about,
            in your pack, and stops before its output is accepted as the expected result.
        </MudText>
    }
    else
    {
        @if (_sessions.InFlight.Count > 0)
        {
            <div class="abom-inflight mt-1" data-abom-session-inflight>
                @foreach (var flight in _sessions.InFlight)
                {
                    <MudText Typo="Typo.caption" Class="d-block">
                        CodeQL is running <span class="abom-path">@flight.Tool</span> on
                        <span class="abom-path">@flight.Subject</span> for the agent, since
                        @TimeText.DayAndTime(flight.Since, "HH:mm:ss").
                    </MudText>
                }
            </div>
        }
        @foreach (var session in _sessions.Sessions)
        {
            <div class="abom-session" data-abom-session="@session.RowId">
                <div class="d-flex align-center flex-wrap gap-2">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Color="@StateColor(session.State)">@session.State</MudChip>
                    <MudText Typo="Typo.caption">
                        Session #@session.RowId, started by @session.StartedBy
                        @TimeText.DayAndTime(session.StartedAt) with @session.Model:
                        @CountText.Of(session.Events, "call", "calls"), @session.Refused refused;
                        <span data-abom-session-spend>@SpendText(session)</span>
                    </MudText>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Class="abom-plain-button"
                               title="@(_open == session.RowId ? $"Hide the calls and decisions for session #{session.RowId}." : $"Show the calls and decisions for session #{session.RowId}.")"
                               OnClick="@(() => Toggle(session))" data-abom-session-timeline>
                        @(_open == session.RowId ? "Hide what it did" : "What it did")
                    </MudButton>
                </div>
                @if (session.Detail.Length > 0)
                {
                    <pre class="abom-session-detail">@session.Detail</pre>
                }
                @if (_open == session.RowId)
                {
                    <div class="abom-timeline" data-abom-timeline>
                        @foreach (var e in _events)
                        {
                            <div class="abom-event" data-abom-event="@e.RowId" data-abom-decision="@e.Decision">
                                <span class="abom-event-time">@TimeText.Clock(e.At)</span>
                                <span class="abom-event-decision">@e.Decision</span>
                                <span class="abom-path">@e.Tool</span>
                                <span class="abom-event-subject">@e.Subject</span>
                                @if (e.TookMs is long ms)
                                {
                                    <span class="abom-event-took">@DurationText(ms)</span>
                                }
                                @if (e.Reason.Length > 0)
                                {
                                    <div class="abom-event-reason">@e.Reason</div>
                                }
                                @if (ShowsDetail(e))
                                {
                                    <div class="abom-event-detail">@e.Detail</div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }

    @if (_asts.Count > 0)
    {
        <div class="mt-2" data-abom-asts>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Trees CodeQL printed over the test database, as the agent read them
            </MudText>
            <PrintedTrees Trees="@_asts" />
        </div>
    }

    @* ABOM accepts a report only as a person read it, and then runs the tests itself. *@
    @if (_review is { } review && (review.Reviews.Count > 0 || review.Tests.Any(t => t.Actual is not null)))
    {
        <div class="abom-review mt-2" data-abom-review>
            <MudText Typo="Typo.subtitle2">What the query reported</MudText>
            @if (review.Tests.Any(t => t.Actual is not null))
            {
                <div class="abom-review-sides">
                    <div class="abom-review-side">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Should be reported (NON_COMPLIANT)</MudText>
                        <pre class="abom-code" data-abom-review-noncompliant>@Request.NonCompliant</pre>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Should not be reported (COMPLIANT)</MudText>
                        <pre class="abom-code" data-abom-review-compliant>@Request.Compliant</pre>
                    </div>
                    <div class="abom-review-side">
                        @foreach (var test in review.Tests.Where(t => t.Actual is not null))
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                What @review.QueryId reported, in <span class="abom-path">@test.Test</span>
                            </MudText>
                            <pre class="abom-code" data-abom-review-actual>@test.Actual</pre>
                            @if (test.Expected is { } expected)
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Expected until now</MudText>
                                <pre class="abom-code" data-abom-review-expected>@expected</pre>
                            }
                        }
                    </div>
                </div>
                @if (!review.Reviewable)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-1" data-abom-review-stale>@review.Reason</MudAlert>
                }
                else
                {
                    @if (review.CannotAccept.Length > 0)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-1"
                                  data-abom-review-unacceptable>@review.CannotAccept</MudAlert>
                    }
                    <div data-abom-review-reason>
                        <MudTextField T="string" @bind-Value="_reason" Label="Why, if you reject it" Immediate="true"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-1" />
                    </div>
                    <div class="d-flex flex-wrap gap-2 mt-1">
                        <span title="@AcceptTitle(review)">
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" DropShadow="false"
                                       StartIcon="@Icons.Material.Outlined.FactCheck"
                                       Disabled="@(!CanStart || _busy || review.CannotAccept.Length > 0)"
                                       title="@AcceptTitle(review)"
                                       OnClick="@(() => Decide(review, "approved"))" data-abom-review-accept>Accept as the expected result</MudButton>
                        </span>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" DropShadow="false"
                                   StartIcon="@Icons.Material.Outlined.Undo"
                                   Disabled="@(!CanStart || _busy || string.IsNullOrWhiteSpace(_reason))"
                                   title="@(!CanStart ? "Sign in with gh to record who decided." : string.IsNullOrWhiteSpace(_reason) ? "Enter a rejection reason before rejecting this report." : "Record this report as rejected with the reason you entered.")"
                                   OnClick="@(() => Decide(review, "rejected"))" data-abom-review-reject>Reject it</MudButton>
                    </div>
                }
            }
            @if (_reviewRefusal is { Length: > 0 } refusedReview)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-1" data-abom-review-refusal>@refusedReview</MudAlert>
            }
            @if (_tested is { Length: > 0 } tested)
            {
                <MudText Typo="Typo.caption" Class="d-block mt-1" data-abom-review-tested>@tested</MudText>
            }
            @foreach (var past in review.Reviews)
            {
                <MudText Typo="Typo.caption" Class="d-block mud-text-secondary" data-abom-review-record="@past.RowId">
                    @(past.Verdict == "approved" ? "Accepted" : "Rejected") by @past.ReviewedBy
                    @TimeText.DayAndTime(past.ReviewedAt)@(past.Reason.Length > 0 ? $": {past.Reason}" : "")
                </MudText>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public QueryRequest Request { get; set; } = new();

    private AuthoringSessionList? _sessions;
    private IReadOnlyList<AuthoringAst> _asts = [];
    private long _open;
    private List<AuthoringEvent> _events = [];
    private long _after;
    private string? _refusal;
    private bool _busy;
    private Timer? _timer;
    private TimeSpan _beat;
    private ReviewState? _review;
    private string _reason = string.Empty;
    private string? _reviewRefusal;
    private string? _tested;

    private static readonly TimeSpan WhileRunning = TimeSpan.FromSeconds(3);

    private AuthoringSession? Live => _sessions?.Sessions.FirstOrDefault(s => s.State == "running");

    private bool CanStart => Accounts.Identity.Login.Length > 0;

    private string AcceptTitle(ReviewState review) =>
        review.CannotAccept.Length > 0 ? "A report with failed expectations can be rejected, not accepted."
        : CanStart ? "ABOM makes this report the expected result, then runs the tests itself."
        : "Sign in with gh to record who decided.";

    protected override async Task OnInitializedAsync()
    {
        Follow.Changed += Arm;
        await Accounts.EnsureLoadedAsync();
        await Load();
    }

    private async Task Load()
    {
        _sessions = await Api.GetAuthoringSessionsAsync(Request.RowId) ?? new AuthoringSessionList();
        _asts = await Api.GetAuthoringAstsAsync(Request.RowId);
        _review = await Api.GetReviewAsync(Request.RowId);
        if (_open != 0)
        {
            await ReadOn();
        }
        Arm();
    }

    // Only what came after the last event held: a live timeline is read on, never read again.
    private async Task ReadOn()
    {
        if (await Api.GetAuthoringEventsAsync(_open, _after) is { } page)
        {
            _events.AddRange(page.Events);
            _after = page.Next;
        }
    }

    private async Task Toggle(AuthoringSession session)
    {
        var opening = _open != session.RowId;
        _open = opening ? session.RowId : 0;
        _events = [];
        _after = 0;
        if (opening)
        {
            await ReadOn();
        }
    }

    private async Task Start()
    {
        _busy = true;
        try
        {
            var (_, refusal) = await Api.StartAuthoringSessionAsync(Request.RowId, Accounts.Identity.Login);
            _refusal = refusal;
            await Load();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Stop()
    {
        _busy = true;
        try
        {
            var (_, refusal) = await Api.StopAuthoringSessionAsync(Request.RowId);
            _refusal = refusal;
            await Load();
        }
        finally
        {
            _busy = false;
        }
    }

    // The digest sent back is the report as read, so a report that changed since is refused.
    private async Task Decide(ReviewState review, string verdict)
    {
        _busy = true;
        try
        {
            var reason = verdict == "rejected" ? _reason.Trim() : string.Empty;
            var (state, refusal) = await Api.ReviewAsync(Request.RowId, verdict, reason,
                Accounts.Identity.Login, review.Digest);
            _reviewRefusal = refusal;
            _tested = state?.Tested;
            if (state is not null)
            {
                _review = state;
                _reason = string.Empty;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    // Absent until the CLI reports it: a cost nobody reported is not a session that cost nothing.
    private static string SpendText(AuthoringSession s)
    {
        if (s.NanoAiu is null && s.InputTokens is null && s.OutputTokens is null)
        {
            return "what it spent was not reported";
        }
        var parts = new List<string>();
        if (s.NanoAiu is long nano)
        {
            parts.Add((nano / 1e9).ToString("0.##", CultureInfo.CurrentCulture) + " AI units");
        }
        if (s.ModelCalls is long calls)
        {
            parts.Add(CountText.Of((int)calls, "model call", "model calls"));
        }
        if (s.InputTokens is long input)
        {
            parts.Add(input.ToString("N0", CultureInfo.CurrentCulture) + " tokens in");
        }
        if (s.OutputTokens is long output)
        {
            parts.Add(output.ToString("N0", CultureInfo.CurrentCulture) + " out");
        }
        return "spent " + string.Join(", ", parts);
    }

    // A live session is watched closely; otherwise the reader's own beat.
    private void Arm()
    {
        var beat = Live is not null && Follow.Interval > WhileRunning ? WhileRunning : Follow.Interval;
        if (_timer is not null && beat == _beat)
        {
            return;
        }
        _timer?.Dispose();
        _beat = beat;
        _timer = new Timer(async _ =>
        {
            try
            {
                await Load();
            }
            catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
            {
                return;
            }
            await InvokeAsync(StateHasChanged);
        }, null, beat, beat);
    }

    // The agent's words, what was kept, how a session ended and why a call failed are the detail; a
    // call's arguments are not.
    private static bool ShowsDetail(AuthoringEvent e) =>
        e.Detail.Length > 0 && (e.Decision == "failed"
            || e.Hook is "message" or "artifact" or "mcp-server" or "session-end" or "error" or "spend");

    private static string DurationText(long ms) =>
        ms < 1000 ? $"{ms} ms"
        : ms < 60_000 ? (ms / 1000.0).ToString("0.0", CultureInfo.CurrentCulture) + " s"
        : $"{ms / 60_000} min {ms % 60_000 / 1000} s";

    private static Color StateColor(string state) => state switch
    {
        "running" => Color.Info,
        "finished" => Color.Success,
        "stopped" or "interrupted" => Color.Warning,
        "failed" => Color.Error,
        _ => Color.Default,
    };

    public void Dispose()
    {
        Follow.Changed -= Arm;
        _timer?.Dispose();
    }
}
