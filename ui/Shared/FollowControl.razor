@* One refresh control for every view that watches a running expansion. *@
@implements IDisposable
@inject FollowService Follow

<div class="d-flex align-center gap-2">
    <MudTooltip Text="@Hint">
        <MudText Typo="Typo.caption" Class="mud-text-secondary">refresh every</MudText>
    </MudTooltip>
    <MudSelect T="int" Value="Follow.Seconds" ValueChanged="OnSecondsChanged"
               Dense="true" Margin="Margin.Dense" Variant="Variant.Text"
               Class="abom-filter-narrow">
        @foreach (var seconds in FollowService.Choices)
        {
            <MudSelectItem T="int" Value="@seconds">@FollowService.Describe(seconds)</MudSelectItem>
        }
    </MudSelect>

    @if (LastUpdated is { } at)
    {
        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            @($"updated {TimeText.DayAndTime(at, "HH:mm:ss")}")
        </MudText>
    }
</div>

@code {
    /// <summary>When the hosting view last took data, so the beat shows evidence of working.</summary>
    [Parameter] public DateTime? LastUpdated { get; set; }

    private const string Hint =
        "This view keeps itself current for as long as it is open. Leave the page to stop it.";

    protected override void OnInitialized() => Follow.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private async Task OnSecondsChanged(int seconds) => await Follow.SetSecondsAsync(seconds);

    public void Dispose() => Follow.Changed -= OnChanged;
}
