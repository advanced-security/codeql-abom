; Scoped to the harness, which is the only npm project in this repository. A root .npmrc would
; silently govern any npm command run anywhere in the tree, including one nobody meant to be
; governed by the test suite's settings.

; `engines` in package.json is advisory on its own -- npm warns and installs anyway. A Node that
; cannot run the suite should stop at install, where the message names the version, rather than
; part-way through a browser test where it looks like a flake.
engine-strict=true

; No install runs arbitrary code. Measured 2026-09-17: @playwright/test, playwright and
; playwright-core declare no lifecycle scripts at all, so this costs nothing today and refuses the
; whole class if a future version adds one. The browser is fetched by an explicit
; `npx playwright install`, never as a side effect of `npm ci`.
ignore-scripts=true
